---
import FAQSection from '../components/sections/FAQSection.astro';
import FinalCTASection from '../components/sections/FinalCTASection.astro';
import GarnaBookingWidget from '../components/ui/GarnaBookingWidget.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageFinalCtas } from '../content/page-final-ctas';
import { pageShells } from '../content/page-shells';
import type { FAQItem } from '../types/faq-section';
import EorHeroSection from '../components/sections/payroll/EorHeroSection.astro';
import ProofStatsCardsSection from '../components/sections/payroll/ProofStatsCardsSection.astro';
import EorCountriesSection from '../components/sections/payroll/EorCountriesSection.astro';
import GlobalWorkforceBenefitsSection from '../components/sections/payroll/GlobalWorkforceBenefitsSection.astro';
import EorWhyGarnaSection from '../components/sections/payroll/EorWhyGarnaSection.astro';
import EorCostEstimatorSection from '../components/sections/payroll/EorCostEstimatorSection.astro';
import EorDashboardCtaSection from '../components/sections/payroll/EorDashboardCtaSection.astro';
import EmployerOfRecordSectionStyles from '../components/sections/payroll/EmployerOfRecordSectionStyles.astro';
import EmployerOfRecordInteractions from '../components/sections/payroll/EmployerOfRecordInteractions.astro';

const eorProofStats = [
	{
		value: '150+',
		label: 'countries covered',
		labelKey: 'eorProof.stats.countries.label',
		image: '/pages/payroll-solution-new/assets/eor-proof-phone-hands-cafe-v1.png',
		alt: 'Professional hands using a smartphone at a cafe table',
		imagePosition: 'center center',
		imageOrigin: 'center center',
		imageScale: 1.03,
		notice: {
			icon: 'contract',
			title: 'Contract ready',
			titleKey: 'eorProof.stats.countries.notice.title',
			meta: 'Country terms checked',
			metaKey: 'eorProof.stats.countries.notice.meta',
			tone: 'bank',
		},
	},
	{
		value: '1',
		label: 'platform for global hiring',
		labelKey: 'eorProof.stats.platform.label',
		image: '/pages/payroll-solution-new/assets/eor-proof-running-water-light-v1.png',
		alt: 'A man with a backpack running through shallow coastal water',
		featured: true,
		imagePosition: '58% center',
		imageOrigin: 'center center',
		imageScale: 1.03,
		notice: {
			icon: 'payroll',
			title: 'Payroll profile set',
			titleKey: 'eorProof.stats.platform.notice.title',
			meta: 'Salary, tax, benefits',
			metaKey: 'eorProof.stats.platform.notice.meta',
			tone: 'card',
		},
	},
	{
		value: '0',
		label: 'local entities to open',
		labelKey: 'eorProof.stats.entities.label',
		image: '/pages/payroll-solution-new/assets/eor-proof-sofa-laptop-woman-final.jpg',
		alt: 'A woman working on a laptop while sitting on a sofa',
		imagePosition: 'center center',
		imageOrigin: 'center center',
		notice: {
			icon: 'calculator',
			title: 'Cost estimate ready',
			titleKey: 'eorProof.stats.entities.notice.title',
			meta: 'Local costs included',
			metaKey: 'eorProof.stats.entities.notice.meta',
			tone: 'crypto',
		},
	},
];

const eorFaqItems = [
	{
		question: 'What is an Employer of Record (EOR)?',
		answer:
			"An Employer of Record lets you hire full-time employees in countries where you don't have a legal entity. Garna becomes the legal employer, handling payroll, contracts, taxes, and local compliance, while you manage an employee's day-to-day work.",
		questionTranslateKey: 'faq.items.q1.question',
		answerTranslateKey: 'faq.items.q1.answer',
	},
	{
		question: 'Who manages the employee?',
		answer:
			'You do. You set their responsibilities, working hours, goals, and career path. Garna handles contracts, statutory benefits, salary payments, and local compliance.',
		questionTranslateKey: 'faq.items.q2.question',
		answerTranslateKey: 'faq.items.q2.answer',
	},
	{
		question: "What's the difference between hiring through an EOR and a contractor?",
		answer:
			'An EOR employee is a full-time employee under local labor law, with statutory benefits, legal protections, and full compliance, ideal for long-term, full-time roles. A contractor is self-employed, without those protections, and treating someone working full-time hours under your direction as a contractor can lead to compliance risk and penalties.',
		questionTranslateKey: 'faq.items.q3.question',
		answerTranslateKey: 'faq.items.q3.answer',
	},
	{
		question: 'EOR vs setting up your own entity, which is better?',
		answer:
			"Your own entity means you own incorporation, tax filings, and local compliance. An EOR is faster to start and more flexible if you're still testing where to grow.",
		questionTranslateKey: 'faq.items.q4.question',
		answerTranslateKey: 'faq.items.q4.answer',
	},
	{
		question: 'How quickly can I start hiring through Garna?',
		answer: 'In most countries, we can onboard your new employee in as little as X business day(s), once the offer is confirmed and onboarding documents are signed.',
		questionTranslateKey: 'faq.items.q5.question',
		answerTranslateKey: 'faq.items.q5.answer',
	},
	{
		question: 'Can I hire international workers without an EOR?',
		answer:
			"Yes, by setting up a local legal entity or hiring the person as a contractor. Both have trade-offs: an entity is slow and expensive, a contractor role carries compliance risk if it resembles full-time employment. Garna's EOR is the faster, fully compliant alternative.",
		questionTranslateKey: 'faq.items.q6.question',
		answerTranslateKey: 'faq.items.q6.answer',
	},
	{
		question: 'Is it legally compliant to hire through an EOR?',
		answer: 'Yes, EOR is a legally recognized employment model in most countries.',
		questionTranslateKey: 'faq.items.q7.question',
		answerTranslateKey: 'faq.items.q7.answer',
	},
	{
		question: 'How much does an Employer of Record cost?',
		answer:
			'Pricing starts at $200 but may vary depending on the country, salary level, and team size. There are no hidden fees or FX markups. Get a quote based on your team.',
		questionTranslateKey: 'faq.items.q8.question',
		answerTranslateKey: 'faq.items.q8.answer',
	},
] satisfies FAQItem[];
---

<BaseLayout shell={pageShells.eor}>
	<EorHeroSection />
	<ProofStatsCardsSection
		title={{ text: 'Hire Abroad Without Guesswork', translateKey: 'eorProof.title' }}
		description={{ text: 'Garna keeps international hiring transparent, from local contracts to payroll and compliance. When you are ready, compare your options in the cost calculator', translateKey: 'eorProof.description' }}
		action={{ label: { text: 'Calculate your options', translateKey: 'eorProof.button' }, href: '#eor-cost-estimator', variant: 'primary', icon: 'arrow-right', effect: 'none' }}
		stats={eorProofStats}
		carouselLabel="Choose an EOR proof card"
		carouselLabelKey="eorProof.carousel.ariaLabel"
	/>
	<EorCountriesSection />
	<GlobalWorkforceBenefitsSection />
	<EorWhyGarnaSection />
	<EmployerOfRecordSectionStyles />
	<EorCostEstimatorSection />
	<EorDashboardCtaSection />
	<FAQSection
		title={{ text: 'FAQ on Employer of Record', translateKey: 'faq.title' }}
		items={eorFaqItems}
		variant="eor"
		class="py-16 lg:py-32"
		containerClass="garna-container"
	/>
	<FinalCTASection {...pageFinalCtas.eor} />
	<Fragment slot="widgets">
		<EmployerOfRecordInteractions />
		<GarnaBookingWidget
			trackingSource="eor"
			trackingPage="eor"
			titleFallback="Book a free 30-minute product demo"
			subtitleFallback="Get all your questions answered by our experts"
		/>
	</Fragment>
</BaseLayout>
