---
import BaseLayout from '../layouts/BaseLayout.astro';
import TaxCalculatorHeroSection from '../components/sections/tax-calculator/TaxCalculatorHeroSection.astro';
import TaxCalculatorExplainerSection from '../components/sections/tax-calculator/TaxCalculatorExplainerSection.astro';
import TaxCalculatorExpertSection from '../components/sections/tax-calculator/TaxCalculatorExpertSection.astro';
import TaxCalculatorPageStyles from '../components/sections/tax-calculator/TaxCalculatorPageStyles.astro';
import FAQSection from '../components/sections/FAQSection.astro';
import GarnaBookingWidget from '../components/ui/GarnaBookingWidget.astro';
import { pageShells } from '../content/page-shells';
import type { FAQItem } from '../types/faq-section';
import '../styles/tax-calculator.css';
import '../styles/tax-calculator-seo.css';
import '../styles/eor-calculator.css';

const questions = ['What is an employee cost calculator?','How do you calculate the total cost of an employee?','How much does an employee cost a company beyond salary?','Does employee cost vary by country?','What is the difference between salary and total employee cost?','How can I reduce employee hiring costs?','How do I calculate the cost of hiring an employee internationally?','Can Garna help manage employee payroll costs?','How accurate are the results?'];
const answers = ['An employee cost calculator helps businesses estimate employment-related costs, including salary, taxes, social contributions and other required expenses.','Start with gross salary, then account for applicable taxes, contributions, benefits and other employment expenses. The exact total depends on the location and employment arrangement.','Costs beyond salary vary by country and may include taxes, insurance, social contributions and benefits.','Yes. Payroll taxes, social security, mandatory benefits, healthcare systems and employment rules differ significantly between countries.','Salary is the compensation paid directly to an employee. Total employee cost also includes the additional expenses connected with maintaining employment.','Businesses can automate payroll, select the right employment model, optimize benefits and reduce administrative overhead with a global payroll platform.','Consider salary expectations, local taxes, contributions, mandatory benefits, exchange rates and compliance requirements before entering a new market.','Yes. Garna helps businesses manage global payroll, payments and compliance across multiple countries in one platform.','Results are estimates based on available rates and typical requirements. The exact price will be confirmed in your offer.'];
const faqItems = questions.map((question, index) => ({ question, answer: answers[index], questionTranslateKey: `faq.q${index + 1}`, answerTranslateKey: `faq.a${index + 1}` })) satisfies FAQItem[];
---

<BaseLayout shell={pageShells.taxCalculator}>
	<TaxCalculatorHeroSection />
	<TaxCalculatorExplainerSection />
	<TaxCalculatorExpertSection />
	<FAQSection title={{ text: 'Employee Cost Calculator FAQs', translateKey: 'faq.title' }} items={faqItems} variant="eor" class="tax-faq" containerClass="garna-container" />
	<div id="tax-i18n" hidden>
		<span data-key="loading" data-translate="messages.loading">Calculating live employment costs…</span><span data-key="configError" data-translate="messages.configError">Could not load country details. Please try again.</span><span data-key="calcError" data-translate="messages.calcError">Could not calculate right now. Please try again.</span>
		<span data-key="selectCountry" data-translate="calculator.selectCountry">Select a country</span><span data-key="selectState" data-translate="calculator.selectState">Select a state or region</span><span data-key="minimumSalary" data-translate="calculator.minimumSalary">Minimum annual gross salary</span><span data-key="payments" data-translate="calculator.payments">salary payments per year</span>
		<span data-key="estimate" data-translate="results.estimate">Estimated employment cost</span><span data-key="country" data-translate="calculator.country">Employment country</span><span data-key="state" data-translate="calculator.state">State or region</span><span data-key="annualAmount" data-translate="calculator.annualAmount">Annual amount</span><span data-key="currency" data-translate="calculator.currency">Currency</span><span data-key="period" data-translate="calculator.period">Period</span><span data-key="monthly" data-translate="calculator.monthly">Monthly</span><span data-key="annual" data-translate="calculator.annual">Annual</span><span data-key="clear" data-translate="calculator.clear">Clear</span><span data-key="gross" data-translate="results.gross">Gross annual salary</span><span data-key="takeHome" data-translate="results.takeHome">Estimated take-home pay</span><span data-key="breakdown" data-translate="results.breakdown">Cost breakdown</span><span data-key="editInputs" data-translate="calculator.editInputs">Change inputs</span>
		<span data-key="bookDemo" data-translate="results.bookDemo">Book a demo</span><span data-key="signUp" data-translate="results.signUp">Sign Up</span><span data-key="estimatedNote" data-translate="results.estimatedNote">This is an estimated cost. Your exact price will be confirmed in the offer.</span><span data-key="mandatoryAuto" data-translate="calculator.mandatoryAuto">Automatically selected</span><span data-key="noAdditionalBenefit" data-translate="calculator.noAdditionalBenefit">No additional benefit</span><span data-key="provider" data-translate="calculator.provider">Provider</span><span data-key="plan" data-translate="calculator.plan">Plan</span><span data-key="contribution" data-translate="calculator.contribution">Employer contribution</span>
	</div>
	<Fragment slot="widgets"><GarnaBookingWidget trackingSource="employee-cost-calculator" trackingPage="employee-cost-calculator" trackingCta="employee_cost_calculator_result_demo" titleFallback="Book a free 30-minute product demo" subtitleFallback="Get all your questions answered by our experts" /></Fragment>
</BaseLayout>

<TaxCalculatorPageStyles />

<script>
	type EorCountry = { code: string; name: string; currency: string; state_type?: string | null; states: Array<{ code: string; name: string }> };
	type BenefitProvider = { id: string; name: string; kind: 'plan' | 'contribution'; plans?: Array<{ id: string; name: string; price?: string | null; currency?: string }>; contribution?: { min: number; max: number; options?: number[] } };
	type BenefitGroup = { name: string; description?: string; is_mandatory?: boolean; providers: BenefitProvider[] };
	type CountryDetails = EorCountry & { salary: { min?: string | null; max?: string | null }; salary_payments_per_year?: number | null; benefits: BenefitGroup[] };
	const form = document.querySelector<HTMLFormElement>('#tax-form');
	const calculator = document.querySelector<HTMLElement>('#calculator');
	const calculatorCard = calculator?.querySelector<HTMLElement>('.tax-card');
	const formView = calculator?.querySelector<HTMLElement>('.tax-form-view');
	const loadingView = calculator?.querySelector<HTMLElement>('.tax-loading-view');
	const results = document.querySelector<HTMLElement>('#tax-results');
	const status = document.querySelector<HTMLElement>('#tax-status');
	const countrySelect = document.querySelector<HTMLSelectElement>('#eor-country');
	const stateSelect = document.querySelector<HTMLSelectElement>('#eor-state');
	const stateField = stateSelect?.closest<HTMLElement>('.tax-region-field');
	const currencySelect = document.querySelector<HTMLSelectElement>('#eor-currency');
	const currencyValue = document.querySelector<HTMLElement>('#tax-currency-value');
	const salaryDisplay = document.querySelector<HTMLInputElement>('#tax-salary-display');
	const salaryValue = document.querySelector<HTMLInputElement>('#tax-salary-value');
	const submitButton = form?.querySelector<HTMLButtonElement>('.tax-submit');
	const countryHint = document.querySelector<HTMLElement>('#eor-country-hint');
	const benefitsRoot = document.querySelector<HTMLElement>('#eor-benefits');
	const locale = document.documentElement.lang || 'en';
	const currencyNames = (() => { try { return new Intl.DisplayNames([locale], { type: 'currency' }); } catch { return null; } })();
	const regionNames = (() => { try { return new Intl.DisplayNames([locale], { type: 'region' }); } catch { return null; } })();
	const t = (key: string) => document.querySelector(`#tax-i18n [data-key="${key}"]`)?.textContent?.trim() || key;
	const esc = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#039;' })[char] || char);
	const money = (value: unknown, currency: string, decimals = 0) => new Intl.NumberFormat(locale, { style: 'currency', currency, maximumFractionDigits: decimals }).format(Number(value) || 0);
	const currencyLabel = (code: string) => { const name = currencyNames?.of(code); return name && name !== code ? `${code} — ${name}` : code; };
	const countryLabel = (country: EorCountry) => regionNames?.of(country.code) || country.name;
	const formatAmount = (value: string) => { const [whole, decimal] = value.replace(/[^\d.]/g, '').split('.'); return `${(whole || '').replace(/\B(?=(\d{3})+(?!\d))/g, ',')}${decimal !== undefined ? `.${decimal.slice(0, 2)}` : ''}`; };
	const setState = (state: 'idle' | 'loading' | 'results') => { if (!calculator) return; calculator.dataset.calculatorState = state; calculatorCard?.setAttribute('aria-busy', String(state === 'loading')); formView?.toggleAttribute('inert', state !== 'idle'); formView?.setAttribute('aria-hidden', String(state !== 'idle')); loadingView?.setAttribute('aria-hidden', String(state !== 'loading')); results?.toggleAttribute('inert', state !== 'results'); results?.setAttribute('aria-hidden', String(state !== 'results')); if (results) results.hidden = state !== 'results'; };
	const clearStatus = () => { if (status) status.textContent = ''; };
	const api = async (url: string, options?: RequestInit) => { const response = await fetch(url, { headers: { Accept: 'application/json', 'Content-Type': 'application/json' }, ...options }); const body = await response.json().catch(() => ({})); if (!response.ok) throw new Error(body.errors ? Object.values(body.errors).flat().join(' ') : body.message || t('calcError')); return body.data ?? body; };
	let countries: EorCountry[] = [], countryDetails: CountryDetails | null = null, calculation: any = null, activeCurrency = '';
	let countryRequestId = 0;
	let activePeriod: 'monthly' | 'annual' = 'monthly';
	type TaxSelectWidget = { root: HTMLElement; trigger: HTMLButtonElement; value: HTMLElement; menu: HTMLElement; observer: MutationObserver };
	const selectWidgets = new Map<HTMLSelectElement, TaxSelectWidget>();
	let selectWidgetId = 0;
	const closeTaxSelect = (widget: TaxSelectWidget, restoreFocus = false) => {
		widget.root.dataset.open = 'false';
		widget.trigger.setAttribute('aria-expanded', 'false');
		widget.menu.hidden = true;
		if (restoreFocus) widget.trigger.focus();
	};
	const closeTaxSelects = (except?: TaxSelectWidget) => selectWidgets.forEach((widget) => { if (widget !== except) closeTaxSelect(widget); });
	const fitTaxSelectMenuInsideCard = (select: HTMLSelectElement, widget: TaxSelectWidget) => {
		const card = widget.root.closest<HTMLElement>('.tax-card');
		if (!card) return;
		const cardBounds = card.getBoundingClientRect(), triggerBounds = widget.trigger.getBoundingClientRect();
		const availableBelow = Math.max(0, cardBounds.bottom - triggerBounds.bottom - 24), availableAbove = Math.max(0, triggerBounds.top - cardBounds.top - 24);
		const placeAbove = availableAbove > availableBelow, availableHeight = placeAbove ? availableAbove : availableBelow;
		const preferredHeight = select.matches('.tax-country-select') ? 340 : 240;
		widget.menu.dataset.placement = placeAbove ? 'top' : 'bottom';
		widget.menu.style.maxHeight = `${Math.min(preferredHeight, Math.max(96, availableHeight))}px`;
	};
	const syncTaxSelect = (select: HTMLSelectElement) => {
		const widget = selectWidgets.get(select); if (!widget) return;
		const selected = select.selectedOptions[0];
		widget.value.textContent = select.matches('.tax-currency-select, .tax-result-currency-select') && select.value ? select.value : selected?.textContent?.trim() || select.getAttribute('aria-label') || '';
		widget.value.dataset.placeholder = String(!select.value);
		widget.root.dataset.hasValue = String(Boolean(select.value));
		widget.trigger.disabled = select.disabled;
		widget.trigger.setAttribute('aria-disabled', String(select.disabled));
		widget.menu.querySelectorAll<HTMLButtonElement>('[data-tax-select-option]').forEach((option) => option.setAttribute('aria-selected', String(option.dataset.value === select.value)));
	};
	const rebuildTaxSelect = (select: HTMLSelectElement) => {
		const widget = selectWidgets.get(select); if (!widget) return;
		const hidesEmptyOption = select.matches('.tax-country-select, .tax-region-select');
		const visibleOptions = [...select.options].filter((option) => !hidesEmptyOption || Boolean(option.value));
		widget.menu.replaceChildren(...visibleOptions.map((option) => {
			const button = document.createElement('button');
			button.type = 'button'; button.dataset.taxSelectOption = ''; button.dataset.value = option.value;
			button.setAttribute('role', 'option'); button.setAttribute('aria-selected', String(option.selected)); button.tabIndex = -1;
			button.textContent = option.textContent?.trim() || option.value; button.disabled = option.disabled;
			return button;
		}));
		syncTaxSelect(select);
	};
	const openTaxSelect = (select: HTMLSelectElement, focusSelected = false) => {
		const widget = selectWidgets.get(select); if (!widget || select.disabled) return;
		closeTaxSelects(widget); widget.root.dataset.open = 'true'; widget.trigger.setAttribute('aria-expanded', 'true'); widget.menu.hidden = false; fitTaxSelectMenuInsideCard(select, widget);
		if (focusSelected) window.requestAnimationFrame(() => (widget.menu.querySelector<HTMLButtonElement>('[aria-selected="true"]') || widget.menu.querySelector<HTMLButtonElement>('[data-tax-select-option]'))?.focus());
	};
	const enhanceTaxSelect = (select: HTMLSelectElement) => {
		if (selectWidgets.has(select)) { rebuildTaxSelect(select); return; }
		const id = `tax-select-list-${++selectWidgetId}`, label = select.getAttribute('aria-label') || select.title || 'Select an option';
		const root = document.createElement('div'); root.className = 'tax-custom-select'; root.dataset.open = 'false';
		const trigger = document.createElement('button'); trigger.type = 'button'; trigger.className = 'tax-select-trigger'; trigger.setAttribute('aria-haspopup', 'listbox'); trigger.setAttribute('aria-expanded', 'false'); trigger.setAttribute('aria-controls', id); trigger.setAttribute('aria-label', label);
		const value = document.createElement('span'); value.className = 'tax-select-value'; trigger.append(value); trigger.insertAdjacentHTML('beforeend', '<svg aria-hidden="true" viewBox="0 0 16 16"><path d="m3.5 6 4.5 4 4.5-4"/></svg>');
		const menu = document.createElement('div'); menu.id = id; menu.className = 'tax-select-menu'; menu.setAttribute('role', 'listbox'); menu.setAttribute('aria-label', label); menu.hidden = true;
		const clearButton = select.matches('.tax-country-select, .tax-region-select') ? document.createElement('button') : null;
		if (clearButton) { clearButton.type = 'button'; clearButton.className = 'tax-select-clear'; clearButton.setAttribute('aria-label', `${t('clear')} ${label}`); clearButton.innerHTML = '<svg aria-hidden="true" viewBox="0 0 24 24"><path d="m18 6-12 12"></path><path d="m6 6 12 12"></path></svg>'; }
		root.append(trigger, ...(clearButton ? [clearButton] : []), menu); select.insertAdjacentElement('afterend', root); select.classList.add('tax-native-select');
		const observer = new MutationObserver(() => rebuildTaxSelect(select)), widget = { root, trigger, value, menu, observer }; selectWidgets.set(select, widget); observer.observe(select, { childList: true, subtree: true, characterData: true }); rebuildTaxSelect(select);
		trigger.addEventListener('click', () => widget.menu.hidden ? openTaxSelect(select) : closeTaxSelect(widget));
		clearButton?.addEventListener('click', (event) => { event.preventDefault(); event.stopPropagation(); select.value = ''; syncTaxSelect(select); closeTaxSelect(widget); select.dispatchEvent(new Event('change', { bubbles: true })); trigger.focus(); });
		select.addEventListener('change', () => queueMicrotask(() => syncTaxSelect(select)));
		select.addEventListener('invalid', (event) => { event.preventDefault(); trigger.focus(); });
		root.addEventListener('click', (event) => { const option = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-tax-select-option]') : null; if (!option) return; select.value = option.dataset.value || ''; closeTaxSelect(widget, true); select.dispatchEvent(new Event('change', { bubbles: true })); });
		root.addEventListener('keydown', (event) => {
			const option = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-tax-select-option]') : null;
			if (event.target === trigger && ['ArrowDown', 'ArrowUp', 'Enter', ' '].includes(event.key)) { event.preventDefault(); openTaxSelect(select, true); return; }
			if (event.key === 'Escape') { event.preventDefault(); closeTaxSelect(widget, true); return; }
			if (!option) return;
			if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); option.click(); return; }
			if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
			event.preventDefault(); const options = [...menu.querySelectorAll<HTMLButtonElement>('[data-tax-select-option]:not(:disabled)')], index = options.indexOf(option);
			const nextIndex = event.key === 'Home' ? 0 : event.key === 'End' ? options.length - 1 : event.key === 'ArrowDown' ? (index + 1) % options.length : (index - 1 + options.length) % options.length; options[nextIndex]?.focus();
		});
	};
	const enhanceTaxSelects = () => document.querySelectorAll<HTMLSelectElement>('.tax-country-select, .tax-region-select, .tax-currency-select, .tax-result-currency-select').forEach(enhanceTaxSelect);
	const updateCurrencyLabel = () => { if (currencyValue) currencyValue.textContent = currencySelect?.value || 'USD'; };
	const updateCurrencyOptions = (country?: EorCountry) => { if (!currencySelect) return; const values = [...new Set([country?.currency, 'USD', 'EUR'].filter(Boolean))] as string[]; currencySelect.replaceChildren(...values.map((code) => Object.assign(document.createElement('option'), { value: code, textContent: currencyLabel(code) }))); currencySelect.value = country?.currency || 'USD'; updateCurrencyLabel(); };
	const benefitMode = () => form?.querySelector<HTMLInputElement>('[name="benefit-level"]:checked')?.value || 'mandatory';
	const renderBenefits = () => {
		if (!benefitsRoot) return; benefitsRoot.hidden = benefitMode() !== 'custom'; benefitsRoot.replaceChildren(); if (benefitsRoot.hidden || !countryDetails) return;
		countryDetails.benefits.forEach((group, index) => { const article = document.createElement('article'); article.className = 'tax-benefit-card'; article.innerHTML = `<div class="tax-benefit-card__head"><strong>${esc(group.name)}</strong>${group.is_mandatory ? `<span>${esc(t('mandatoryAuto'))}</span>` : ''}</div>${group.description ? `<p>${esc(group.description)}</p>` : ''}<label><span>${esc(t('provider'))}</span><select data-benefit-provider="${index}"><option value="">${esc(group.is_mandatory ? t('mandatoryAuto') : t('noAdditionalBenefit'))}</option>${group.providers.map((provider) => `<option value="${esc(provider.id)}">${esc(provider.name)}</option>`).join('')}</select></label><div data-benefit-detail="${index}"></div>`; benefitsRoot.append(article); });
	};
	const renderBenefitDetail = (select: HTMLSelectElement) => {
		const index = Number(select.dataset.benefitProvider), group = countryDetails?.benefits[index], provider = group?.providers.find((item) => item.id === select.value), detail = benefitsRoot?.querySelector<HTMLElement>(`[data-benefit-detail="${index}"]`); if (!detail) return; detail.replaceChildren(); if (!provider) return;
		if (provider.kind === 'contribution' && provider.contribution) { const values = provider.contribution.options || []; detail.innerHTML = values.length ? `<label><span>${esc(t('contribution'))}, %</span><select data-benefit-contribution>${values.map((value) => `<option value="${value}">${value}%</option>`).join('')}</select></label>` : `<label><span>${esc(t('contribution'))}, %</span><input data-benefit-contribution type="number" min="${provider.contribution.min}" max="${provider.contribution.max}" step="0.01" value="${provider.contribution.min}"/></label>`; }
		else detail.innerHTML = `<label><span>${esc(t('plan'))}</span><select data-benefit-plan>${(provider.plans || []).map((plan) => `<option value="${esc(plan.id)}">${esc(plan.name)}${plan.price != null ? ` — ${esc(money(plan.price, plan.currency || countryDetails?.currency || 'USD', 2))}` : ''}</option>`).join('')}</select></label>`;
	};
	const selectedBenefits = () => benefitMode() !== 'custom' || !benefitsRoot ? [] : [...benefitsRoot.querySelectorAll<HTMLSelectElement>('[data-benefit-provider]')].flatMap((select) => { if (!select.value) return []; const card = select.closest<HTMLElement>('.tax-benefit-card'), plan = card?.querySelector<HTMLSelectElement>('[data-benefit-plan]')?.value, contribution = card?.querySelector<HTMLInputElement | HTMLSelectElement>('[data-benefit-contribution]')?.value; return [{ provider_id: select.value, ...(plan ? { plan_id: plan } : {}), ...(contribution ? { contribution: Number(contribution) } : {}) }]; });
	const selectCountry = async (code: string) => {
		const requestId = ++countryRequestId;
		countryDetails = null; if (submitButton) submitButton.disabled = Boolean(code); if (benefitsRoot) { benefitsRoot.hidden = true; benefitsRoot.replaceChildren(); } const country = countries.find((item) => item.code === code); if (!country) { if (submitButton) submitButton.disabled = false; updateCurrencyOptions(); if (stateSelect && stateField) { stateSelect.value = ''; stateSelect.required = false; stateField.hidden = true; syncTaxSelect(stateSelect); } if (countryHint) countryHint.textContent = ''; return; } updateCurrencyOptions(country);
		if (stateSelect && stateField) { stateSelect.replaceChildren(Object.assign(document.createElement('option'), { value: '', textContent: t('selectState') }), ...country.states.map((state) => Object.assign(document.createElement('option'), { value: state.code, textContent: state.name }))); stateSelect.required = country.states.length > 0; stateField.hidden = !country.states.length; }
		if (countryHint) countryHint.textContent = t('loading');
		try { const details: CountryDetails = await api(`/api/eor/countries/${code}`); if (requestId !== countryRequestId) return; countryDetails = details; const hints: string[] = []; if (countryDetails.salary?.min) hints.push(`${t('minimumSalary')}: ${money(countryDetails.salary.min, countryDetails.currency)}`); if ((countryDetails.salary_payments_per_year || 0) > 12) hints.push(`${countryDetails.salary_payments_per_year} ${t('payments')}`); if (countryHint) countryHint.textContent = hints.length ? `${hints.join(' · ')}.` : ''; renderBenefits(); } catch (error) { if (requestId !== countryRequestId) return; if (countryHint) countryHint.textContent = error instanceof Error ? error.message : t('configError'); } finally { if (requestId === countryRequestId && submitButton) submitButton.disabled = false; }
	};
	const costRows = (costs: any[], currency: string) => (costs || []).map((row) => `<tr><th>${esc(row.name)}</th><td>${money(row.amount, currency, 2)}</td></tr>${(row.items || []).map((item: any) => `<tr class="tax-result-child"><th>${esc(item.name)}${item.frequency && item.frequency !== 'Monthly' ? `<small>${esc(item.frequency)}</small>` : ''}</th><td>${item.amount == null ? '—' : money(item.amount, currency, 2)}</td></tr>`).join('')}`).join('');
	const renderResult = () => {
		if (!results || !calculation) return; const available = calculation.calculations || [], calc = available.find((item: any) => item.currency === activeCurrency) || available[0]; if (!calc) return; activeCurrency = calc.currency; const costs = activePeriod === 'monthly' ? calc.monthly_costs : calc.yearly_costs, total = activePeriod === 'monthly' ? calc.monthly_total : calc.yearly_total, takeHome = calc.take_home?.net?.[activePeriod];
		const filtersMarkup = `<div class="tax-result-toolbar"><label class="tax-result-currency"><select class="tax-result-currency-select" aria-label="${esc(t('currency'))}">${available.map((item: any) => `<option value="${esc(item.currency)}"${item.currency === calc.currency ? ' selected' : ''}>${esc(currencyLabel(item.currency))}</option>`).join('')}</select></label><div class="tax-result-period-filter"><div class="tax-result-period" role="group" aria-label="${esc(t('period'))}"><button type="button" data-result-period="monthly" class="${activePeriod === 'monthly' ? 'is-active' : ''}">${esc(t('monthly'))}</button><button type="button" data-result-period="annual" class="${activePeriod === 'annual' ? 'is-active' : ''}">${esc(t('annual'))}</button></div></div></div>`;
		results.querySelectorAll<HTMLSelectElement>('.tax-result-currency-select').forEach((select) => { selectWidgets.get(select)?.observer.disconnect(); selectWidgets.delete(select); });
		results.innerHTML = `<div class="tax-result-header"><div class="tax-result-summary"><button type="button" class="tax-result-edit" data-edit-calculator><svg aria-hidden="true" viewBox="0 0 18 12"><path d="M6 1 1 6l5 5M1 6h16"/></svg><span>${esc(t('editInputs'))}</span></button><span>${esc(t('estimate'))}</span><strong>${money(total, calc.currency)}</strong><small>${esc(activePeriod === 'monthly' ? t('monthly') : t('annual'))}</small></div>${filtersMarkup}</div><div class="tax-result-stats"><article><span>${esc(t('gross'))}</span><strong>${money(calculation.gross_annual_salary, calculation.base_currency)}</strong></article><article><span>${esc(t('takeHome'))}</span><strong>${takeHome == null ? '—' : money(takeHome, calc.currency)}</strong></article></div>${(calculation.warnings || []).map((warning: string) => `<p class="tax-result-warning">${esc(warning)}</p>`).join('')}<h3>${esc(t('breakdown'))}</h3><div class="tax-table-wrap"><table class="tax-eor-table"><tbody>${costRows(costs, calc.currency)}</tbody></table></div><p class="tax-disclaimer">${esc(t('estimatedNote'))}</p><div class="tax-result-ctas"><a class="garna-button garna-button-secondary" href="https://app.garna.io/${esc(locale)}/auth/sign-up" data-garna-signup><span class="garna-button-inner">${esc(t('signUp'))}</span></a><button type="button" class="garna-button garna-button-primary" data-book-demo><span class="garna-button-inner">${esc(t('bookDemo'))}</span></button></div>`;
		const resultCurrencySelect = results.querySelector<HTMLSelectElement>('.tax-result-currency-select');
		if (resultCurrencySelect) { enhanceTaxSelect(resultCurrencySelect); resultCurrencySelect.addEventListener('change', () => { activeCurrency = resultCurrencySelect.value; renderResult(); }); }
		results.hidden = false; setState('results');
	};
	countrySelect?.addEventListener('change', () => { clearStatus(); void selectCountry(countrySelect.value); }); currencySelect?.addEventListener('change', () => { updateCurrencyLabel(); clearStatus(); });
	salaryDisplay?.addEventListener('input', () => { if (!salaryDisplay || !salaryValue) return; clearStatus(); salaryDisplay.value = formatAmount(salaryDisplay.value); salaryValue.value = salaryDisplay.value.replace(/,/g, ''); });
	form?.querySelectorAll<HTMLInputElement>('[name="mode"]').forEach((input) => input.addEventListener('change', clearStatus));
	form?.querySelectorAll<HTMLInputElement>('[name="benefit-level"]').forEach((input) => input.addEventListener('change', () => { clearStatus(); renderBenefits(); })); benefitsRoot?.addEventListener('change', (event) => { clearStatus(); const select = (event.target as Element).closest<HTMLSelectElement>('[data-benefit-provider]'); if (select) renderBenefitDetail(select); });
	results?.addEventListener('click', (event) => { const target = event.target as Element, periodButton = target.closest<HTMLButtonElement>('[data-result-period]'); if (periodButton) { activePeriod = periodButton.dataset.resultPeriod === 'annual' ? 'annual' : 'monthly'; renderResult(); } else if (target.closest('[data-edit-calculator]')) setState('idle'); else if (target.closest('[data-book-demo]')) (window as any).GarnaWidget?.open({ trackingCta: 'employee_cost_calculator_result_demo' }); });
	form?.addEventListener('submit', async (event) => { event.preventDefault(); if (!form.reportValidity() || !countrySelect?.value || !salaryValue?.value) return; if (!countryDetails) { if (status) status.textContent = t('configError'); return; } setState('loading'); if (status) status.textContent = ''; try { calculation = await api('/api/eor/employment-cost', { method: 'POST', body: JSON.stringify({ country_code: countrySelect.value, state: stateSelect?.value || null, mode: form.querySelector<HTMLInputElement>('[name="mode"]:checked')?.value || 'gross', currency: currencySelect?.value || countryDetails.currency, salary: salaryValue.value, benefits: selectedBenefits() }) }); activeCurrency = calculation.input_currency || currencySelect?.value || calculation.base_currency; activePeriod = 'monthly'; renderResult(); } catch (error) { setState('idle'); if (status) status.textContent = error instanceof Error ? error.message : t('calcError'); } });
	const load = async () => {
		try {
			countries = await api('/api/eor/countries');
			countrySelect?.replaceChildren(Object.assign(document.createElement('option'), { value: '', textContent: t('selectCountry') }), ...countries.map((country) => Object.assign(document.createElement('option'), { value: country.code, textContent: countryLabel(country) })));
			updateCurrencyOptions();
			const params = new URLSearchParams(window.location.search), requestedCountry = params.get('country')?.toUpperCase();
			if (requestedCountry && countrySelect && countries.some((country) => country.code === requestedCountry)) {
				countrySelect.value = requestedCountry;
				syncTaxSelect(countrySelect);
				await selectCountry(requestedCountry);
				const requestedState = params.get('state');
				if (requestedState && stateSelect) {
					const stateOption = [...stateSelect.options].find((option) => option.value === requestedState || option.textContent?.trim() === requestedState);
					if (stateOption) stateSelect.value = stateOption.value;
					syncTaxSelect(stateSelect);
				}
				const requestedCurrency = params.get('currency');
				if (requestedCurrency && currencySelect && [...currencySelect.options].some((option) => option.value === requestedCurrency)) {
					currencySelect.value = requestedCurrency;
					syncTaxSelect(currencySelect);
				}
				const salary = params.get('salary');
				if (salary && salaryDisplay && salaryValue) { salaryDisplay.value = formatAmount(salary); salaryValue.value = salary.replace(/,/g, ''); }
				updateCurrencyLabel();
				if (params.get('calculate') === '1' && salary) form?.requestSubmit();
				return;
			}
		} catch (error) {
			countrySelect?.replaceChildren(Object.assign(document.createElement('option'), { value: '', textContent: t('configError') }));
			if (status) status.textContent = error instanceof Error ? error.message : t('configError');
		}
	};
	document.addEventListener('click', (event) => { const target = event.target; if (!(target instanceof Node)) return; selectWidgets.forEach((widget) => { if (!widget.root.contains(target)) closeTaxSelect(widget); }); });
	document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeTaxSelects(); });
	enhanceTaxSelects();
	void load();
</script>
