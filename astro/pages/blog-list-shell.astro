---
import BaseLayout from '../layouts/BaseLayout.astro';
import GarnaBookingWidget from '../components/ui/GarnaBookingWidget.astro';
import TrustedDynamicHead from '../components/sections/blog/TrustedDynamicHead.astro';
import { pageShells } from '../content/page-shells';
---

<BaseLayout shell={pageShells.blog}>
	<TrustedDynamicHead slot="head" html="%%BLOG_DYNAMIC_HEAD%%" />
	%%BLOG_ENGINE_BODY%%
	<Fragment slot="widgets">
		<GarnaBookingWidget
			trackingSource="blog"
			trackingPage="blog"
			titleFallback="Start your journey with Garna"
			subtitleFallback="Fill in your details to book a demo"
		/>
	</Fragment>
</BaseLayout>
