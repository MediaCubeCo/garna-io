---
import FAQSection from '../components/sections/FAQSection.astro';
import FinalCTASection from '../components/sections/FinalCTASection.astro';
import GarnaBookingWidget from '../components/ui/GarnaBookingWidget.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import PayrollSolutionInteractions from '../components/sections/payroll/PayrollSolutionInteractions.astro';
import ContractorPaymentsSection from '../components/sections/payroll/home/ContractorPaymentsCarouselSection.astro';
import DeferredContractorPaymentsSection from '../components/sections/payroll/home/DeferredPaymentsStackSection.astro';
import EffectivePayrollSection from '../components/sections/payroll/home/EffectivePayrollSection.astro';
import EmbeddedPayrollInfrastructureSection from '../components/sections/payroll/home/EmbeddedPayrollInfrastructureTabs.astro';
import HireEmployeesWorldwideSection from '../components/sections/payroll/home/HireEmployeesWorldwideSection.astro';
import HomeWorkflowsIntroSection from '../components/sections/payroll/home/HomeWorkflowsIntroSection.astro';
import ManageGlobalPayrollSection from '../components/sections/payroll/home/ManageGlobalPayrollSection.astro';
import SpendbaseQuoteSection from '../components/sections/payroll/home/SpendbaseQuoteSection.astro';
import TrustedByBuildersSection from '../components/sections/payroll/home/TrustedByBuildersSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageFinalCtas } from '../content/page-final-ctas';
import { pageHeroes } from '../content/page-heroes';
import { pageShells } from '../content/page-shells';
import type { FAQItem } from '../types/faq-section';

const homeFaqItems = [
	{
		question: 'What services does Garna provide?',
		answer:
			'Global payroll, Employer of Record, Contractor of Record, business banking, and international payments, all in one platform. You can hire, pay, and manage your whole team, employees, and contractors, without switching between tools.',
		questionTranslateKey: 'faq.items.q1.question',
		answerTranslateKey: 'faq.items.q1.answer',
	},
	{
		question: 'What is Employer of Record (EOR)?',
		answer:
			'An EOR legally employs your team in a country where you have no entity. Garna becomes that legal employer; you manage the day-to-day work.',
		questionTranslateKey: 'faq.items.q2.question',
		answerTranslateKey: 'faq.items.q2.answer',
	},
	{
		question: 'What is a Contractor of Record?',
		answer:
			"Garna manages the contract, compliance, and payments for your freelancers, so you're protected from misclassification risk without having to become their legal employer.",
		questionTranslateKey: 'faq.items.q3.question',
		answerTranslateKey: 'faq.items.q3.answer',
	},
	{
		question: 'What’s the difference between hiring through an EOR and hiring a contractor?',
		answer:
			'An EOR is designed for full-time employees who need local employment contracts, benefits, and payroll compliance. Contractors work independently and are typically hired for specific projects or services without an employment relationship.',
		questionTranslateKey: 'faq.items.q4.question',
		answerTranslateKey: 'faq.items.q4.answer',
	},
	{
		question: 'Can I hire international talent without an EOR?',
		answer:
			"Yes, by opening your own legal entity. It works, but incorporation, local payroll, and ongoing compliance make it slow and expensive at a small headcount. Check at what team size it's cheaper to set up your own company instead of using an EOR.",
		questionTranslateKey: 'faq.items.q5.question',
		answerTranslateKey: 'faq.items.q5.answer',
	},
	{
		question: 'Why should I choose Garna over other providers?',
		answer:
			'1. All-in-one service in one place: hire employees via EOR, work with contractors of any type (individuals, sole proprietors, or legal entities), and run your everyday banking¹ from a single platform.\n\n2. Transparent pricing without hidden fees.\n\n3. Truly global payouts: pay to 150+ countries in 80+ local currencies using bank transfers, cards, PayPal, local e-wallets, or crypto.\n\n4. Business banking included: multi-currency IBANs in your company name and transfers to 150+ destinations, provided by a separate licensed entity.\n\n5. Reliable payment infrastructure: one of the largest payment networks in the industry, with 20+ banking partners and payment systems.\n\n6. Virtual cards: issue a card in the app, add it to Apple Pay or Google Pay, and pay directly from your Garna balance².\n\n7. Human support with an average reply time of 67 seconds.\n\n¹ Business banking services are provided through a separate licensed payment entity/provider.\n² Card issuance and card payment services are provided through a licensed third-party payment provider and are subject to KYC, eligibility, and applicable terms.',
		questionTranslateKey: 'faq.items.q6.question',
		answerTranslateKey: 'faq.items.q6.answer',
	},
	{
		question: 'How long does it take to onboard an employee?',
		answer:
			'In most countries, we can hire a new employee in no more than one business day. Once we receive the confirmed offer details and the employee completes the required onboarding steps, including uploading documents and signing the contract, we ensure a smooth and fast start while supporting both you and the new hire.',
		questionTranslateKey: 'faq.items.q7.question',
		answerTranslateKey: 'faq.items.q7.answer',
	},
	{
		question: 'How long does it take to start using Garna Contractor of Record?',
		answer:
			'In most cases, you can have your first contractor onboarded in less than 20 minutes. Once you create a business account and pass verification, you can start inviting contractors. Garna also offers real-time payment options, so contractors can receive their remuneration the same day.',
		questionTranslateKey: 'faq.items.q8.question',
		answerTranslateKey: 'faq.items.q8.answer',
	},
	{
		question: 'What payment methods does Garna support?',
		answer:
			'We support bank transfers (SWIFT, SEPA, and bank transfers in local currencies), card payments in local currency, PayPal, Payoneer, other e-wallets, and cryptocurrency payments¹. With Garna, you can issue a digital card in the app, add it to Apple Pay or Google Pay, and pay directly from your Garna balance².\n\n¹ Cryptocurrency payment services are provided through a licensed third-party provider and are subject to availability, eligibility, and applicable terms.\n² Card issuance and card payment services are provided through a licensed third-party payment provider and are subject to KYC, eligibility, and applicable terms.',
		questionTranslateKey: 'faq.items.q9.question',
		answerTranslateKey: 'faq.items.q9.answer',
	},
	{
		question: 'Can I use my Garna business account as a daily business account?',
		answer:
			'Yes, it works as a regular business account for everyday banking, not just for payroll and contractor payments. With a Garna Business Account, you can get multi-currency IBANs in your company name, receive payments, and send transfers to 150+ destinations¹.\n\n¹ Business banking services are provided through a separate licensed payment entity/provider.',
		questionTranslateKey: 'faq.items.q10.question',
		answerTranslateKey: 'faq.items.q10.answer',
	},
	{
		question: 'What benefits does a business get access to when using Garna?',
		answer:
			'Beyond contractor management and payroll, you can access business benefits and receive discounts for Slack, Google Workspace, AWS, and accounts with over 100 other service providers at no extra cost.',
		questionTranslateKey: 'faq.items.q11.question',
		answerTranslateKey: 'faq.items.q11.answer',
	},
] satisfies FAQItem[];

---

<BaseLayout shell={pageShells.home} showRainbow={false}>
	<div class="home-hero-proof-stage" data-home-hero-proof-stage>
		<HeroSection {...pageHeroes.home}>
			<div slot="background" class="home-hero-cover" aria-hidden="true">
				<div class="home-hero-cover__media">
					<img data-home-hero-image src="/pages/payroll-solution-new/assets/home-hero-profile-clouds-v2.jpg" alt="" />
				</div>
				<div class="home-hero-focus-frame" data-home-hero-frame>
					<div class="home-hero-focus-frame__actions" data-home-hero-actions>
						<span data-translate="hero.visual.payroll">Payroll</span>
						<span data-translate="hero.visual.globalPayouts">Global payouts</span>
						<span>
							<svg viewBox="0 0 13 21" aria-hidden="true">
								<path d="M11.4746 14.7227C11.4275 15.5537 11.2163 16.3675 10.8525 17.1162C10.0307 18.7581 8.70591 19.7429 6.90425 20.0733C5.69763 20.2945 4.51044 20.1991 3.37495 19.7168C1.85099 19.0695 0.86664 17.9207 0.339801 16.3662C0.139741 15.7559 0.0279696 15.1196 0.00874611 14.4776C0.00684991 14.4314 0.0087461 14.385 0.00874611 14.3321H3.00777C3.0243 14.5458 3.03371 14.7549 3.05757 14.9619C3.10582 15.4803 3.25312 15.9843 3.49116 16.4473C3.95449 17.3081 4.67246 17.7533 5.65425 17.7686C6.07065 17.775 6.47795 17.734 6.86226 17.5596C7.41667 17.308 7.79767 16.8839 8.05952 16.3447C8.29209 15.8435 8.42793 15.3026 8.46089 14.751C8.47202 14.613 8.47777 14.4745 8.48628 14.3311H11.4932C11.4872 14.4642 11.4839 14.5936 11.4746 14.7227ZM11.5449 1.16602C11.7043 1.3011 11.8639 1.43594 12.0322 1.57813L10.2383 3.70215C10.2425 3.713 10.2478 3.72352 10.2539 3.7334C10.8744 4.54768 11.273 5.50908 11.4111 6.52344C11.5791 7.65883 11.5135 8.78028 11.1269 9.86524C10.4697 11.71 9.20303 12.9244 7.29195 13.3994C5.74263 13.7845 4.2315 13.6402 2.81929 12.8555C1.5815 12.1676 0.782316 11.1098 0.337847 9.77735C0.059096 8.91898 -0.0490815 8.01407 0.0204649 7.11426C0.0817073 6.18439 0.306447 5.29789 0.758746 4.47949C1.56472 3.02129 2.79412 2.12177 4.42085 1.78028C5.63517 1.51384 6.90175 1.61637 8.05757 2.07422C8.07377 2.08059 8.09019 2.0874 8.1064 2.09375C8.17573 2.12094 8.25148 2.17872 8.31245 2.16602C8.36926 2.15407 8.41133 2.06798 8.45796 2.0127C9.00725 1.3629 9.55666 0.712741 10.1055 0.0625C10.1221 0.0427899 10.137 0.020795 10.1523 0H10.1689C10.6274 0.388706 11.0864 0.777334 11.5449 1.16602ZM5.51167 4.0586C5.19448 4.069 4.88273 4.14498 4.59566 4.28028C4.00652 4.55998 3.62387 5.03063 3.37202 5.61719C3.09821 6.25495 3.015 6.92884 3.02144 7.61621C3.02143 7.73798 3.01589 7.86003 3.02241 7.98145C3.0535 8.55888 3.15117 9.12344 3.38863 9.65528C3.65578 10.2535 4.05942 10.7237 4.67378 10.9893C5.06109 11.1566 5.46927 11.1886 5.88472 11.1787C6.77375 11.1576 7.45241 10.7698 7.91988 10.0147C8.12885 9.66554 8.27656 9.28275 8.3564 8.88379C8.49588 8.21172 8.52413 7.52099 8.43941 6.83985C8.39161 6.35369 8.25726 5.8794 8.04292 5.44043C7.74657 4.85268 7.31184 4.41419 6.68062 4.18946C6.30092 4.05435 5.90773 4.04298 5.51167 4.0586Z" />
							</svg>
						</span>
					</div>
				</div>
			</div>
		</HeroSection>
		<div class="home-workflows-scroll" data-home-workflows-scroll>
			<HomeWorkflowsIntroSection />
		</div>
		<div class="home-hero-proof-transition" data-home-proof-transition aria-hidden="true">
			<div class="home-transition-back home-transition-back--hire">
				<img src="/pages/payroll-solution-new/assets/home-workflows-hire-upscaled.jpg" alt="" />
			</div>
			<div class="home-transition-back home-transition-back--contractors">
				<img src="/pages/payroll-solution-new/assets/home-proof-mountain-man-v1.png" alt="" />
			</div>
			<div class="home-transition-front">
			<img src="/pages/payroll-solution-new/assets/home-hero-profile-clouds-v2.jpg" alt="" data-home-transition-image />
			</div>
		</div>
	</div>
	<ManageGlobalPayrollSection />
	<ContractorPaymentsSection />
	<HireEmployeesWorldwideSection />
	<EffectivePayrollSection />
	<SpendbaseQuoteSection />
	<DeferredContractorPaymentsSection />
	<EmbeddedPayrollInfrastructureSection />
	<TrustedByBuildersSection />
	<FAQSection
		title={{ text: 'FAQ on Payroll Solutions', translateKey: 'faq.title' }}
		items={homeFaqItems}
		variant="eor"
		class="home-payroll-faq pt-16 pb-16 lg:pt-32 lg:pb-32"
		containerClass="garna-container home-payroll-faq-container"
	/>
	<FinalCTASection {...pageFinalCtas.home} />
	<script is:inline>
		document.addEventListener('click', (event) => {
			const link = event.target instanceof Element ? event.target.closest('a') : null;
			if (!link || link.getAttribute('href') !== '#') return;
			if (!link.textContent || !link.textContent.toLowerCase().includes('book a demo')) return;

			event.preventDefault();
			if (window.GarnaWidget) {
				window.GarnaWidget.open({ trackingCta: 'payroll_solution_new_demo' });
			}
		});
	</script>
	<script is:inline>
		(() => {
			const clamp = (value, min = 0, max = 1) => Math.min(max, Math.max(min, value));
			const mix = (from, to, progress) => from + (to - from) * progress;
			const smoothstep = (start, end, value) => {
				const t = clamp((value - start) / (end - start));
				return t * t * (3 - 2 * t);
			};
			const smootherstep = (start, end, value) => {
				const t = clamp((value - start) / (end - start));
				return t * t * t * (t * (t * 6 - 15) + 10);
			};
			const getPositionRatio = (token, axis) => {
				if (!token) return 0.5;
				if (token.endsWith('%')) return Number.parseFloat(token) / 100;
				if (token === 'left' || token === 'top') return 0;
				if (token === 'right' || token === 'bottom') return 1;
				if (token === 'center') return 0.5;
				return axis === 'y' && token === 'bottom' ? 1 : 0.5;
			};
			const getObjectPosition = (style) => {
				const tokens = style.objectPosition.trim().split(/\s+/);
				if (tokens.length === 1) return { x: getPositionRatio(tokens[0], 'x'), y: 0.5 };
				return { x: getPositionRatio(tokens[0], 'x'), y: getPositionRatio(tokens[1], 'y') };
			};
			const getScale = (style) => {
				const matrix = new DOMMatrixReadOnly(style.transform === 'none' ? undefined : style.transform);
				return Math.hypot(matrix.a, matrix.b) || 1;
			};
			const getPaintedImageRect = (containerRect, image) => {
				const style = getComputedStyle(image);
				const naturalRatio = image.naturalWidth && image.naturalHeight ? image.naturalWidth / image.naturalHeight : 1;
				const containerRatio = containerRect.width / containerRect.height;
				const base = containerRatio > naturalRatio
					? { width: containerRect.width, height: containerRect.width / naturalRatio }
					: { width: containerRect.height * naturalRatio, height: containerRect.height };
				const position = getObjectPosition(style);
				const scale = getScale(style);
				const [originX = '0', originY = '0'] = style.transformOrigin.split(/\s+/);
				const origin = {
					x: containerRect.x + Number.parseFloat(originX),
					y: containerRect.y + Number.parseFloat(originY),
				};
				const baseRect = {
					x: containerRect.x + (containerRect.width - base.width) * position.x,
					y: containerRect.y + (containerRect.height - base.height) * position.y,
					width: base.width,
					height: base.height,
				};

				return {
					x: origin.x + (baseRect.x - origin.x) * scale,
					y: origin.y + (baseRect.y - origin.y) * scale,
					width: baseRect.width * scale,
					height: baseRect.height * scale,
				};
			};
			const initHomeHeroProofTransition = () => {
				const stage = document.querySelector('[data-home-hero-proof-stage]');
				if (!(stage instanceof HTMLElement) || stage.dataset.transitionReady === 'true') return;

				const heroFrame = stage.querySelector('[data-home-hero-frame]');
				const heroImage = stage.querySelector('[data-home-hero-image]');
				const heroActions = stage.querySelector('[data-home-hero-actions]');
				const heroSection = heroFrame?.closest('[data-section-kind="hero"]');
				const heroCta = heroSection?.querySelector('.garna-button')?.parentElement;
				const siteHeader = document.querySelector('.garna-header');
				const proofSection = stage.querySelector('.home-proof-section');
				const proofScroll = stage.querySelector('[data-home-workflows-scroll]');
				const proofContent = proofSection?.querySelector('.home-workflows-intro__container');
				const targetCard = stage.querySelector('[data-home-proof-card="featured"]');
				const targetImage = stage.querySelector('[data-home-proof-image="featured"]');
				const overlay = stage.querySelector('[data-home-proof-transition]');
				const overlayImage = stage.querySelector('[data-home-transition-image]');
				if (
					!(heroFrame instanceof HTMLElement) ||
					!(heroImage instanceof HTMLImageElement) ||
					!(heroActions instanceof HTMLElement) ||
					!(proofSection instanceof HTMLElement) ||
					!(targetCard instanceof HTMLElement) ||
					!(targetImage instanceof HTMLImageElement) ||
					!(overlay instanceof HTMLElement) ||
					!(overlayImage instanceof HTMLImageElement)
				) return;

				stage.dataset.transitionReady = 'true';
				const transitionEnabled = true;
				const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
				const desktop = window.matchMedia('(min-width: 841px)');
				let frame = 0;
				let mobileFrameViewportKey = '';
				const deckCards = Array.from(stage.querySelectorAll('[data-workflow-card]'));
				const deckHeadings = Array.from(stage.querySelectorAll('[data-workflow-heading]'));
				const deckIndicators = Array.from(stage.querySelectorAll('[data-workflow-progress]'));
				const stack = targetCard.parentElement;
				stack.querySelector('.home-workflows-mobile-rail')?.remove();
				const mobileRail = document.createElement('div');
				mobileRail.className = 'home-workflows-mobile-rail';
				const mobileCards = [];
				// Copies on both ends keep the visible rail continuous at states one and three.
				for (let sequence = 0; sequence < 9; sequence++) {
					const card = deckCards[sequence % 3].cloneNode(true);
					card.removeAttribute('data-workflow-card');
					card.removeAttribute('data-home-proof-card');
					card.querySelector('[data-home-proof-image]')?.removeAttribute('data-home-proof-image');
					card.classList.remove('is-active');
					card.classList.add('home-workflows-mobile-card');
					card.removeAttribute('style');
					mobileRail.append(card);
					mobileCards.push(card);
				}
				stack.append(mobileRail);
				// Preserve both wider experiments for comparison.
				const deckVariant = 'quiet-stack'; // Alternatives: 'three-card-selection', 'two-sided-swap'
				const renderTwoSidedDeck = (progress) => {
					let current = 0;
					let turn = 0;
					if (progress >= 0.60) { current = 1; turn = clamp((progress - 0.60) / 0.27); }
					else if (progress >= 0.15) { turn = clamp((progress - 0.15) / 0.27); }
					const next = current + 1;
					const moving = turn > 0 && turn < 1;
					const active = turn >= 0.5 ? next : current;
					const departure = 1 - smoothstep(0, 0.20, turn);
					const arrival = smoothstep(0.78, 1, turn);
					const excursion = turn < 0.5 ? smootherstep(0.12, 0.5, turn) : 1 - smootherstep(0.5, 0.92, turn);
					// Fan both cards out symmetrically, leaving room for their rotated corners.
					const cardWidth = targetCard.offsetWidth;
					const sideTravel = Math.max(0, Math.min(cardWidth * 0.72, (proofSection.clientWidth - cardWidth) / 2 - 48));
					deckHeadings.forEach((heading, index) => {
						const opacity = index === current ? departure : index === next ? arrival : 0;
						heading.style.opacity = String(opacity);
						heading.style.visibility = opacity > 0 ? 'visible' : 'hidden';
						heading.style.transform = `translateY(${(1 - opacity) * 10}px)`;
						heading.setAttribute('aria-hidden', String(index !== active));
					});
					deckCards.forEach((card, index) => {
						const visible = moving ? index === current || index === next : index === (turn === 1 ? next : current);
						card.style.opacity = visible ? '1' : '0';
						card.style.visibility = visible ? 'visible' : 'hidden';
						card.style.zIndex = String(index === current ? (turn < 0.5 ? 3 : 1) : 2);
						card.style.transform = index === current
							? `translateX(${-sideTravel * excursion}px) translateY(${-10 * excursion}px) rotate(${-8 * excursion}deg) scale(${1 - 0.04 * excursion})`
							: index === next && moving
								? `translateX(${sideTravel * excursion}px) translateY(${-10 * excursion}px) rotate(${8 * excursion}deg) scale(${mix(0.94, 1, smoothstep(0.5, 0.92, turn))})`
								: 'none';
						card.setAttribute('aria-hidden', String(index !== active));
						const notice = card.querySelector('.home-workflows-stack__status');
						if (notice instanceof HTMLElement) {
							const opacity = index === current ? departure : index === next ? arrival : 0;
							notice.style.opacity = `calc(${opacity} * var(--home-proof-featured-notice-opacity, 1))`;
							notice.style.transform = `translateY(${(1 - opacity) * 8}px)`;
							notice.style.transition = 'none';
						}
					});
				};

				const renderThreeCardDeck = (progress) => {
					const current = progress >= 0.60 ? 1 : 0;
					const next = current + 1;
					const turn = clamp((progress - (current === 0 ? 0.15 : 0.60)) / 0.27);
					const reveal = smootherstep(0.08, 0.32, turn);
					const selection = smootherstep(0.38, 0.70, turn);
					const collapse = smootherstep(0.74, 0.96, turn);
					const departure = 1 - smoothstep(0, 0.18, turn);
					const arrival = smoothstep(0.86, 1, turn);
					const active = selection >= 0.5 ? next : current;
					const width = targetCard.offsetWidth;
					const travel = Math.max(0, Math.min(width * 1.03, (proofSection.clientWidth - width * 0.88) / 2 - 36));
					// Pay -> contractors: choose left. Contractors -> hire: choose right.
					const before = current === 0 ? [0, -1, 1] : [-1, 0, 1];
					const after = current === 0 ? [1, 0, -1] : [1, -1, 0];
					deckHeadings.forEach((heading, index) => {
						const opacity = index === current ? departure : index === next ? arrival : 0;
						heading.style.opacity = String(opacity);
						heading.style.visibility = opacity > 0 ? 'visible' : 'hidden';
						heading.style.transform = `translateY(${(1 - opacity) * 10}px)`;
						heading.setAttribute('aria-hidden', String(index !== active));
					});
					deckCards.forEach((card, index) => {
						const position = mix(before[index], after[index], selection);
						const spread = reveal * (1 - collapse);
						const startScale = index === current ? 1 : mix(0.96, 0.88, reveal);
						const selectedScale = index === next ? 1 : 0.88;
						const scale = mix(mix(startScale, selectedScale, selection), index === next ? 1 : 0.96, collapse);
						const arc = Math.sin(selection * Math.PI) * (index === next ? -38 : 20);
						const visible = turn > 0 && turn < 1 ? true : index === (turn === 1 ? next : current);
						card.style.opacity = visible ? '1' : '0';
						card.style.visibility = visible ? 'visible' : 'hidden';
						card.style.zIndex = String(index === next && selection > 0 ? 4 : index === current ? 3 : 1);
						card.style.transform = `translateX(${position * travel * spread}px) translateY(${arc}px) scale(${scale})`;
						card.setAttribute('aria-hidden', String(index !== active));
						const notice = card.querySelector('.home-workflows-stack__status');
						if (notice instanceof HTMLElement) {
							const opacity = index === current ? departure : index === next ? arrival : 0;
							notice.style.opacity = `calc(${opacity} * var(--home-proof-featured-notice-opacity, 1))`;
							notice.style.transform = `translateY(${(1 - opacity) * 8}px)`;
							notice.style.transition = 'none';
						}
					});
				};
				let deckPosition = 0;
				let deckDestination = 0;
				let deckFrom = 0;
				let deckStartedAt = 0;
				const renderQuietStack = (progress, landed = true) => {
					const now = performance.now();
					const requested = Math.min(2, Math.floor(progress * 3));
					if (!desktop.matches) {
						deckPosition = deckDestination = deckFrom = requested;
						// Use painted widths: inactive cards are scaled to 94%, so their
						// layout slots must shrink too to preserve equal visible gaps.
						const referenceRail = document.querySelector('[data-scroll-visual-carousel-id="home-contractor-payments-carousel"] .contractor-carousel__rail');
						const gap = referenceRail instanceof HTMLElement ? Number.parseFloat(getComputedStyle(referenceRail).columnGap) : (window.innerWidth <= 767 ? 12.8 : 18.4);
						const cardWidth = stack.getBoundingClientRect().width;
						const step = cardWidth * .94 + gap;
						mobileRail.style.transform = `translateX(${-step * (requested + 3)}px)`;
						mobileCards.forEach((card, index) => {
							const selected = index === requested + 3;
							card.style.left = `${index * step + (index > requested + 3 ? cardWidth * .06 : 0)}px`;
							card.classList.toggle('is-mobile-active', selected);
							card.setAttribute('aria-hidden', String(!selected));
						});
						deckHeadings.forEach((heading, index) => {
							heading.style.display = index === requested ? 'block' : 'none';
							heading.style.opacity = '1';
							heading.style.visibility = 'visible';
							heading.style.transform = 'none';
							heading.setAttribute('aria-hidden', String(index !== requested));
						});
						deckIndicators.forEach((indicator, index) => {
							indicator.classList.toggle('is-active', index === requested);
							indicator.style.setProperty('--step-fill', String(clamp(progress * 3 - index)));
						});
						return;
					}
					const immediate = !landed || reduceMotion.matches;
					if (immediate) {
						deckPosition = deckDestination = deckFrom = landed ? requested : 0;
					} else {
						deckPosition = mix(deckFrom, deckDestination, smootherstep(0, 620, now - deckStartedAt));
						if (requested !== deckDestination) {
							deckFrom = deckPosition;
							deckDestination = requested;
							deckStartedAt = now;
						}
						if (now - deckStartedAt < 620 && deckFrom !== deckDestination) schedule();
					}
					const current = Math.min(1, Math.floor(deckPosition));
					const next = current + 1;
					const turn = clamp(deckPosition - current);
					const movement = turn;
					const active = movement >= 1 / 3 ? next : current;
					deckIndicators.forEach((indicator, index) => {
						indicator.classList.toggle('is-active', index === active);
						indicator.style.setProperty('--step-fill', String(clamp(progress * 3 - index)));
					});
					const departure = 1 - smoothstep(0.08, 0.48, turn);
					const arrival = smoothstep(0.52, 0.94, turn);
					deckHeadings.forEach((heading, index) => {
						heading.style.display = index === active ? 'block' : 'none';
						heading.style.opacity = '1';
						heading.style.visibility = index === active ? 'visible' : 'hidden';
						heading.style.transform = 'none';
						heading.setAttribute('aria-hidden', String(index !== active));
					});
					deckCards.forEach((card, index) => {
						// Same cyclic depth order as CreatorPayoutProcessSection, scrubbed by scroll.
						const fromDepth = (index - current + deckCards.length) % deckCards.length;
						const toDepth = (index - next + deckCards.length) % deckCards.length;
						// All three move together. Layers swap at matching depths (2t = 1-t),
						// so a smaller incoming image never covers the larger outgoing one.
						const depth = mix(fromDepth, toDepth, movement);
						const visible = index === current || landed;
						card.style.visibility = visible ? 'visible' : 'hidden';
						card.style.opacity = '1';
						card.style.zIndex = String(5 - (movement >= 1 / 3 ? toDepth : fromDepth));
						// Match the travelling stack exactly at the landing handoff.
						card.style.transformOrigin = 'center top';
						card.style.transform = `translateY(${-8 * depth}px) scale(${1 - 0.03 * depth})`;
						if (!desktop.matches) {
							card.style.transformOrigin = 'center center';
							card.style.transform = `translateX(${(index - deckPosition) * (card.offsetWidth + 16)}px) scale(${1 - 0.04 * Math.min(1, Math.abs(index - deckPosition))})`;
						}
						card.setAttribute('aria-hidden', String(index !== active));
						const notice = card.querySelector('.home-workflows-stack__status');
						if (notice instanceof HTMLElement) {
							notice.style.opacity = 'var(--home-proof-featured-notice-opacity, 1)';
							notice.style.transform = 'none';
							notice.style.transition = '';
						}
					});
				};
				const renderDeck = deckVariant === 'quiet-stack' ? renderQuietStack
					: deckVariant === 'three-card-selection' ? renderThreeCardDeck : renderTwoSidedDeck;

				const setOverlay = (rect, imageRect, opacity, borderOpacity, borderWidth, radius) => {
					overlay.style.setProperty('--home-transition-x', `${rect.x}px`);
					overlay.style.setProperty('--home-transition-y', `${rect.y}px`);
					overlay.style.setProperty('--home-transition-w', `${rect.width}px`);
					overlay.style.setProperty('--home-transition-h', `${rect.height}px`);
					overlay.style.setProperty('--home-transition-radius', `${radius}px`);
					overlay.style.setProperty('--home-transition-opacity-duration', '0ms');
					overlay.style.setProperty('--home-transition-opacity', String(opacity));
					overlay.style.setProperty('--home-transition-border-opacity', String(borderOpacity));
					overlay.style.setProperty('--home-transition-border-width', `${borderWidth}px`);
					overlay.style.setProperty('--home-transition-img-x', `${imageRect.x}px`);
					overlay.style.setProperty('--home-transition-img-y', `${imageRect.y}px`);
					overlay.style.setProperty('--home-transition-img-w', `${imageRect.width}px`);
					overlay.style.setProperty('--home-transition-img-h', `${imageRect.height}px`);
				};
				const getViewportCenter = () => {
					const headerHeight = siteHeader instanceof HTMLElement ? siteHeader.getBoundingClientRect().height : 0;
					return window.innerHeight / 2 + headerHeight / 2;
				};
				const updateMobileHeroFrame = () => {
					if (desktop.matches) {
						mobileFrameViewportKey = '';
						stage.style.removeProperty('--home-hero-mobile-frame-width');
						stage.style.removeProperty('--home-hero-mobile-frame-height');
						stage.style.removeProperty('--home-hero-mobile-frame-bottom');
						stage.style.removeProperty('--home-hero-actions-height-scale');
						return;
					}

					const viewportKey = `${window.innerWidth}x${window.innerHeight}`;
					if (viewportKey === mobileFrameViewportKey) return;
					mobileFrameViewportKey = viewportKey;

					const ctaRect = heroCta instanceof HTMLElement ? heroCta.getBoundingClientRect() : null;
					const heroRect = heroSection instanceof HTMLElement ? heroSection.getBoundingClientRect() : null;
					const buttonBottom = ctaRect && heroRect ? ctaRect.bottom - heroRect.top : window.innerHeight * 0.38;
					const bottomGap = clamp(window.innerHeight * 0.022, 12, 18);
					const buttonGap = clamp(window.innerHeight * 0.03, 18, 28);
					const maxFrameHeight = Math.max(112, window.innerHeight - buttonBottom - buttonGap - bottomGap);
					const widthFromViewport = Math.min(window.innerWidth * 0.66, 320);
					const frameWidth = Math.max(112, widthFromViewport);
					const frameHeight = Math.max(112, Math.min(frameWidth / 0.66, maxFrameHeight));
					const naturalFrameHeight = frameWidth / 0.66;
					const actionsHeightScale = clamp(frameHeight / naturalFrameHeight, 0.82, 1);

					stage.style.setProperty('--home-hero-mobile-frame-width', `${frameWidth}px`);
					stage.style.setProperty('--home-hero-mobile-frame-height', `${frameHeight}px`);
					stage.style.setProperty('--home-hero-mobile-frame-bottom', `${bottomGap}px`);
					stage.style.setProperty('--home-hero-actions-height-scale', String(actionsHeightScale));
				};
				const fitMobileDeck = (progress) => {
					if (desktop.matches) return;
					const headerHeight = siteHeader instanceof HTMLElement ? siteHeader.getBoundingClientRect().height : 0;
					const grid = proofSection.querySelector('.home-workflows-intro__split');
					const copy = grid?.firstElementChild;
					const indicators = proofSection.querySelector('.home-workflows-progress');
					if (!(grid instanceof HTMLElement) || !(copy instanceof HTMLElement) || !(indicators instanceof HTMLElement)) return;
					const room = window.innerHeight - headerHeight - 32 - copy.getBoundingClientRect().height
						- Number.parseFloat(getComputedStyle(grid).rowGap) - indicators.getBoundingClientRect().height - 16;
					const preferred = window.innerWidth <= 767 ? Math.min(window.innerWidth * .62, window.innerHeight * .30, 328) : Math.min(window.innerWidth * .36, window.innerHeight * .35, 320);
					const width = Math.max(1, Math.min(preferred, room * .78));
					const value = `${width.toFixed(2)}px`;
					if (stage.style.getPropertyValue('--home-workflows-mobile-card-width') !== value) {
						stage.style.setProperty('--home-workflows-mobile-card-width', value);
						renderQuietStack(progress);
						schedule();
					}
				};

				const render = () => {
					frame = 0;
					const pinEnabled = transitionEnabled;
					stage.classList.toggle('home-workflows-pinned', pinEnabled);
					stage.style.setProperty('--home-workflows-header-height', `${siteHeader instanceof HTMLElement ? siteHeader.getBoundingClientRect().height : 0}px`);
					// Match scroll pixels per indicator to the Contractor carousel at this viewport.
					const reference = document.querySelector('[data-scroll-visual-carousel-id="home-contractor-payments-carousel"]');
					if (reference instanceof HTMLElement && proofScroll instanceof HTMLElement && reference.parentElement) {
						const headerHeight = siteHeader instanceof HTMLElement ? siteHeader.getBoundingClientRect().height : 0;
						const referenceHeight = reference.getBoundingClientRect().height;
						const stickyTop = Math.max(headerHeight, headerHeight + (window.innerHeight - headerHeight - referenceHeight) / 2);
						const referenceDistance = Math.max(1, reference.parentElement.getBoundingClientRect().height - stickyTop - reference.offsetHeight);
						const referenceSteps = Math.max(1, reference.querySelectorAll('[data-carousel-dot]').length);
						proofScroll.style.height = `${proofSection.offsetHeight + referenceDistance * deckCards.length / referenceSteps}px`;
					}

					if (!transitionEnabled || reduceMotion.matches) {
						const headerHeight = siteHeader instanceof HTMLElement ? siteHeader.getBoundingClientRect().height : 0;
						const stickyTop = 0;
						const scrollRect = proofScroll.getBoundingClientRect();
						const scrollDistance = Math.max(1, proofScroll.offsetHeight - proofSection.offsetHeight - stickyTop);
						const mobileProgress = clamp((stickyTop - scrollRect.top) / scrollDistance);
						renderDeck(mobileProgress, true);
						fitMobileDeck(mobileProgress);
						updateMobileHeroFrame();
						stage.style.setProperty('--home-hero-actions-opacity', '1');
						stage.style.setProperty('--home-hero-frame-opacity', '1');
						stage.style.setProperty('--home-hero-backdrop-progress', '0');
						stage.style.setProperty('--home-proof-featured-image-opacity', '1');
						stage.style.setProperty('--home-proof-featured-card-opacity', '1');
						stage.style.setProperty('--home-proof-featured-notice-opacity', '1');
						stage.style.setProperty('--home-proof-header-opacity', '1');
						overlay.style.setProperty('--home-transition-opacity', '0');
						return;
					}
					updateMobileHeroFrame();

					if (!desktop.matches) {
						const stageRect = stage.getBoundingClientRect();
						const stageTop = window.scrollY + stageRect.top;
						const transitionEndScroll = window.scrollY + proofScroll.getBoundingClientRect().top;
						const distance = Math.max(1, transitionEndScroll - stageTop);
						const progress = clamp(-stageRect.top / distance);
						const transitionStarted = progress > .002;
						const transitionComplete = progress >= 1;
						const holdDistance = Math.max(1, proofScroll.offsetHeight - proofSection.offsetHeight);
						const deckProgress = clamp((window.scrollY - transitionEndScroll) / holdDistance);
						fitMobileDeck(deckProgress);
						renderDeck(deckProgress, transitionComplete);

						const landingCard = mobileCards[3];
						const landingImage = landingCard?.querySelector('img');
						if (!(landingCard instanceof HTMLElement) || !(landingImage instanceof HTMLImageElement)) return;
						const measuredTarget = landingCard.getBoundingClientRect();
						const heroRect = heroFrame.getBoundingClientRect();
						const heroCoverRect = heroImage.parentElement?.getBoundingClientRect() ?? heroImage.getBoundingClientRect();
						const sourceScrollOffset = window.scrollY - stageTop;
						const sourceRect = {
							x: heroRect.x,
							y: heroRect.y + sourceScrollOffset,
							width: heroRect.width,
							height: heroRect.height,
						};
						const sourceCoverRect = {
							x: heroCoverRect.x,
							y: heroCoverRect.y + sourceScrollOffset,
							width: heroCoverRect.width,
							height: heroCoverRect.height,
						};
						const targetRect = {
							x: measuredTarget.x,
							y: measuredTarget.y + window.scrollY - transitionEndScroll,
							width: measuredTarget.width,
							height: measuredTarget.height,
						};
						const heroImgRect = getPaintedImageRect(sourceCoverRect, heroImage);
						const targetImgRect = getPaintedImageRect(targetRect, landingImage);
						const sizeProgress = clamp(progress / .94);
						const rect = {
							x: mix(sourceRect.x, targetRect.x, progress),
							y: mix(sourceRect.y, targetRect.y, progress),
							width: mix(sourceRect.width, targetRect.width, sizeProgress),
							height: mix(sourceRect.height, targetRect.height, sizeProgress),
						};
						const imageRect = {
							x: mix(heroImgRect.x - sourceRect.x, targetImgRect.x - targetRect.x, sizeProgress),
							y: mix(heroImgRect.y - sourceRect.y, targetImgRect.y - targetRect.y, sizeProgress),
							width: mix(heroImgRect.width, targetImgRect.width, sizeProgress),
							height: mix(heroImgRect.height, targetImgRect.height, sizeProgress),
						};
						const heroStyle = getComputedStyle(heroFrame);
						const targetStyle = getComputedStyle(landingCard);
						const heroRadius = Number.parseFloat(heroStyle.borderTopLeftRadius) || 24;
						const targetRadius = Number.parseFloat(targetStyle.borderTopLeftRadius) || 20;
						const heroBorderWidth = Number.parseFloat(heroStyle.borderTopWidth) || 1;
						const overlayOpacity = transitionStarted && !transitionComplete ? 1 : 0;
						setOverlay(rect, imageRect, overlayOpacity, mix(.54, 0, sizeProgress), mix(heroBorderWidth, 0, sizeProgress), mix(heroRadius, targetRadius, sizeProgress));
						overlay.style.setProperty('--home-transition-stack-reveal', '0');
						landingCard.style.opacity = '';
						landingCard.style.visibility = transitionStarted && !transitionComplete ? 'hidden' : '';
						stage.style.setProperty('--home-hero-frame-opacity', String(transitionStarted ? 0 : 1));
						stage.style.setProperty('--home-hero-actions-opacity', String(1 - smoothstep(.035, .18, progress)));
						stage.style.setProperty('--home-hero-backdrop-progress', String(smoothstep(.05, .46, progress)));
						stage.style.setProperty('--home-proof-header-opacity', String(smootherstep(.58, .9, progress)));
						stage.style.setProperty('--home-proof-featured-image-opacity', '1');
						stage.style.setProperty('--home-proof-featured-card-opacity', '1');
						stage.style.setProperty('--home-proof-featured-notice-opacity', '1');
						return;
					}

					// Measure the resting card, not its previous deck-turn transform.
					targetCard.style.transform = 'none';
					const stageRect = stage.getBoundingClientRect();
					const stageTop = window.scrollY + stageRect.top;
					const targetRect = targetCard.getBoundingClientRect();
					// The runway stays in document flow while its section is sticky.
					// Arrive exactly as the full-height section locks to the viewport.
					const proofRect = (proofContent ?? proofSection).getBoundingClientRect();
					const proofTop = window.scrollY + proofRect.top;
					const arrivalLead = Math.min(64, window.innerHeight * 0.07);
					const transitionEndScroll = Math.max(0, proofScroll instanceof HTMLElement
						? window.scrollY + proofScroll.getBoundingClientRect().top
						: proofTop + proofRect.height / 2 - getViewportCenter() - arrivalLead);
					const holdDistance = proofScroll instanceof HTMLElement ? Math.max(1, proofScroll.offsetHeight - proofSection.offsetHeight) : 1;
					const deckProgress = clamp((window.scrollY - transitionEndScroll) / holdDistance);
					stage.style.setProperty('--home-workflows-progress', String(deckProgress));
					const distance = Math.max(1, transitionEndScroll - stageTop);
					const startOffset = 0;
					const progress = clamp((-stageRect.top - startOffset) / Math.max(1, distance - startOffset));
					const positionProgress = progress;
					const sizeProgress = clamp(progress / 0.94);

					const heroRect = heroFrame.getBoundingClientRect();
					const heroCoverRect = heroImage.parentElement?.getBoundingClientRect() ?? heroImage.getBoundingClientRect();
					const heroImgRect = getPaintedImageRect(heroCoverRect, heroImage);
					// Match the image's inner box, including its CSS zoom, for a seamless handoff.
					const targetImgRect = getPaintedImageRect({
						x: targetRect.x + targetCard.clientLeft,
						y: targetRect.y + targetCard.clientTop,
						width: targetImage.clientWidth,
						height: targetImage.clientHeight,
					}, targetImage);
					const heroStyle = getComputedStyle(heroFrame);
					const targetStyle = getComputedStyle(targetCard);
					const heroRadius = Number.parseFloat(heroStyle.borderTopLeftRadius) || 24;
					const targetRadius = Number.parseFloat(targetStyle.borderTopLeftRadius) || 22;
					const heroBorderWidth = Number.parseFloat(heroStyle.borderTopWidth) || 1;
					const targetBorderWidth = Number.parseFloat(targetStyle.borderTopWidth) || 0;

					const rect = {
						x: mix(heroRect.x, targetRect.x, positionProgress),
						y: mix(heroRect.y, targetRect.y, positionProgress),
						width: mix(heroRect.width, targetRect.width, sizeProgress),
						height: mix(heroRect.height, targetRect.height, sizeProgress),
					};
					const imageRect = {
						x: mix(heroImgRect.x - heroRect.x, targetImgRect.x - targetRect.x, sizeProgress),
						y: mix(heroImgRect.y - heroRect.y, targetImgRect.y - targetRect.y, sizeProgress),
						width: mix(heroImgRect.width, targetImgRect.width, sizeProgress),
						height: mix(heroImgRect.height, targetImgRect.height, sizeProgress),
					};
					const imageBottomGap = rect.height - (imageRect.y + imageRect.height);
					if (imageBottomGap > 0) imageRect.y += imageBottomGap;
					const transitionStarted = progress > 0.002;
					const transitionComplete = progress >= 1;
					const overlayOpacity = transitionStarted && !transitionComplete ? 1 : 0;
					// Reveal on departure and retain the stack through landing.
					const endpointGap = Math.min(0.02, 3 / distance);
					const stackReveal = smootherstep(endpointGap, endpointGap + 0.12, progress);
					overlay.style.setProperty('--home-transition-stack-reveal', String(stackReveal));
					const borderProgress = sizeProgress;
					const borderOpacity = mix(0.54, 0, borderProgress);
					const borderWidth = mix(heroBorderWidth, targetBorderWidth, borderProgress);
					const heroFrameOpacity = transitionStarted ? 0 : 1;
					const actionsOpacity = 1 - smoothstep(0.035, 0.18, progress);
					const heroBackdropProgress = smoothstep(0.05, 0.46, progress);
					const proofImageOpacity = transitionComplete ? 1 : 0;
					const proofCardOpacity = transitionComplete ? 1 : 0;
					const proofNoticeOpacity = transitionComplete ? 1 : 0;
					const proofHeaderOpacity = smootherstep(0.58, 0.9, progress);

					setOverlay(rect, imageRect, overlayOpacity, borderOpacity, borderWidth, mix(heroRadius, targetRadius, sizeProgress));
					stage.style.setProperty('--home-hero-frame-opacity', String(heroFrameOpacity));
					stage.style.setProperty('--home-hero-actions-opacity', String(actionsOpacity));
					stage.style.setProperty('--home-hero-backdrop-progress', String(heroBackdropProgress));
					stage.style.setProperty('--home-proof-featured-image-opacity', String(proofImageOpacity));
					stage.style.setProperty('--home-proof-featured-card-opacity', String(proofCardOpacity));
					stage.style.setProperty('--home-proof-featured-notice-opacity', String(proofNoticeOpacity));
					stage.style.setProperty('--home-proof-header-opacity', String(proofHeaderOpacity));
					renderDeck(deckProgress, transitionComplete);
				};

				const schedule = () => {
					if (!frame) frame = window.requestAnimationFrame(render);
				};

				if (transitionEnabled) window.addEventListener('scroll', schedule, { passive: true });
				window.addEventListener('resize', schedule, { passive: true });
				reduceMotion.addEventListener?.('change', schedule);
				desktop.addEventListener?.('change', schedule);
				heroImage.addEventListener('load', schedule, { once: true });
				targetImage.addEventListener('load', schedule, { once: true });
				render();
			};

			initHomeHeroProofTransition();
			window.addEventListener('garna:page-content-updated', initHomeHeroProofTransition);
		})();
	</script>
	<Fragment slot="widgets">
		<PayrollSolutionInteractions />
		<GarnaBookingWidget
			trackingSource="home"
			trackingPage="home"
			titleFallback="Start your journey with Garna"
			subtitleFallback="Fill in your details to book a demo"
		/>
	</Fragment>
</BaseLayout>

<style is:global>
	astro-dev-toolbar {
		display: none !important;
	}

	.home-hero-proof-stage {
		position: relative;
		--home-hero-actions-opacity: 1;
		--home-hero-frame-opacity: 1;
		--home-hero-backdrop-progress: 0;
		--home-proof-featured-image-opacity: 1;
		--home-proof-featured-card-opacity: 1;
		--home-proof-featured-notice-opacity: 1;
		--home-proof-header-opacity: 1;
	}

	/* Reading holds surround both scroll-driven deck turns. */
	.home-workflows-pinned .home-workflows-scroll {
		height: 400svh;
	}

	.home-workflows-pinned .home-workflows-scroll > .home-workflows-intro {
		position: sticky;
		top: 0;
		height: 100svh;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		padding-block: var(--home-workflows-header-height, 64px) 0;
	}
	@media (max-width: 840px) {
		.home-workflows-pinned .home-workflows-scroll > .home-workflows-intro {
			top: 0;
			height: 100svh;
			padding-block: calc(var(--home-workflows-header-height, 64px) + 16px) 16px;
		}
	}

	.home-hero-proof-transition {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 6;
		width: var(--home-transition-w, 0);
		height: var(--home-transition-h, 0);
		overflow: visible;
		border: 0;
		border-radius: var(--home-transition-radius, 24px);
		opacity: var(--home-transition-opacity, 0);
		transform: translate3d(var(--home-transition-x, 0), var(--home-transition-y, 0), 0);
		transition: opacity var(--home-transition-opacity-duration, 0ms) cubic-bezier(0.16, 1, 0.3, 1);
		pointer-events: none;
		backface-visibility: hidden;
		contain: layout style;
		will-change: transform, width, height, opacity;
	}

	.home-transition-front {
		position: absolute;
		inset: 0;
		z-index: 2;
		overflow: hidden;
		border-radius: inherit;
	}

	.home-transition-back {
		position: absolute;
		inset: 0;
		overflow: hidden;
		border: 0;
		border-radius: inherit;
		transform-origin: center top;
		opacity: 1;
		transform: translateY(calc(-8px * var(--stack-depth) * var(--home-transition-stack-reveal, 0))) scale(calc(1 - 0.03 * var(--stack-depth) * var(--home-transition-stack-reveal, 0)));
	}

	.home-transition-back--hire {
		z-index: 0;
		--stack-depth: 2;
	}

	.home-transition-back--contractors {
		z-index: 1;
		--stack-depth: 1;
	}

	.home-transition-back img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.home-transition-back--hire img { object-position: 5% center; }
	.home-transition-back--contractors img {
		object-position: center 64%;
		transform: scale(1.36);
		transform-origin: center center;
	}

	.home-transition-front::after {
		position: absolute;
		inset: 0;
		z-index: 1;
		box-sizing: border-box;
		content: "";
		border: var(--home-transition-border-width, 1px) solid rgba(255, 255, 255, var(--home-transition-border-opacity, 0.54));
		border-radius: inherit;
		pointer-events: none;
	}

	.home-transition-front img {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 0;
		width: var(--home-transition-img-w, 100vw);
		max-width: none;
		height: var(--home-transition-img-h, 100vh);
		max-height: none;
		transform: translate3d(var(--home-transition-img-x, 0), var(--home-transition-img-y, 0), 0);
