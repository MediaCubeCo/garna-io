						const scrollRect = proofScroll.getBoundingClientRect();
						const scrollDistance = Math.max(1, proofScroll.offsetHeight - proofSection.offsetHeight - stickyTop);
						const mobileProgress = clamp((stickyTop - scrollRect.top) / scrollDistance);
						renderDeck(mobileProgress, true);
						fitMobileDeck(mobileProgress);
					updateMobileHeroFrame();
					stage.style.setProperty('--home-hero-actions-opacity', '1');
					const reducedHeroProgress = clamp(-stage.getBoundingClientRect().top / Math.max(1, window.innerHeight * .12));
					stage.style.setProperty('--home-hero-stats-opacity', String(1 - reducedHeroProgress));
					stage.style.setProperty('--home-hero-frame-opacity', '1');
						stage.style.setProperty('--home-hero-backdrop-progress', '0');
						stage.style.setProperty('--home-proof-featured-image-opacity', '1');
						stage.style.setProperty('--home-proof-featured-card-opacity', '1');
						stage.style.setProperty('--home-proof-featured-notice-opacity', '1');
						stage.style.setProperty('--home-proof-header-opacity', '1');
						overlay.style.setProperty('--home-transition-opacity', '0');
						stage.style.setProperty('--home-hero-media-opacity', '1');
						return;
					}
					updateMobileHeroFrame();

					if (!desktop.matches) {
						if (flightMode !== 'attached' || plate.classList.contains('is-detached')) stopFlight();
						stage.classList.remove('is-plate-owner');
						const stageRect = stage.getBoundingClientRect();
						const stageTop = window.scrollY + stageRect.top;
						const transitionEndScroll = window.scrollY + proofScroll.getBoundingClientRect().top;
						const distance = Math.max(1, transitionEndScroll - stageTop);
						const progress = clamp(-stageRect.top / distance);
						const transitionStarted = progress > .002;
						const transitionComplete = progress >= 1;
						const holdDistance = Math.max(1, proofScroll.offsetHeight - proofSection.offsetHeight);
						const deckProgress = clamp((window.scrollY - transitionEndScroll) / holdDistance);
						fitMobileDeck(deckProgress);
						renderDeck(deckProgress, transitionComplete);

						const landingCard = mobileCards[3];
						const landingImage = landingCard?.querySelector('img');
						if (!(landingCard instanceof HTMLElement) || !(landingImage instanceof HTMLImageElement)) return;
						const measuredTarget = landingCard.getBoundingClientRect();
						const heroRect = heroFrame.getBoundingClientRect();
						const heroCoverRect = heroSlot.getBoundingClientRect();
						const sourceScrollOffset = window.scrollY - stageTop;
						const sourceRect = {
							x: heroRect.x,
							y: heroRect.y + sourceScrollOffset,
							width: heroRect.width,
							height: heroRect.height,
						};
						const sourceCoverRect = {
							x: heroCoverRect.x,
							y: heroCoverRect.y + sourceScrollOffset,
							width: heroCoverRect.width,
							height: heroCoverRect.height,
						};
						const targetRect = {
							x: measuredTarget.x,
							y: measuredTarget.y + window.scrollY - transitionEndScroll,
							width: measuredTarget.width,
							height: measuredTarget.height,
						};
						const heroImgRect = getPaintedImageRect(sourceCoverRect, heroImage);
						const targetImgRect = getPaintedImageRect(targetRect, landingImage);
						const sizeProgress = clamp(progress / .94);
						const rect = {
							x: mix(sourceRect.x, targetRect.x, progress),
							y: mix(sourceRect.y, targetRect.y, progress),
							width: mix(sourceRect.width, targetRect.width, sizeProgress),
							height: mix(sourceRect.height, targetRect.height, sizeProgress),
						};
						const imageRect = {
							x: mix(heroImgRect.x - sourceRect.x, targetImgRect.x - targetRect.x, sizeProgress),
							y: mix(heroImgRect.y - sourceRect.y, targetImgRect.y - targetRect.y, sizeProgress),
							width: mix(heroImgRect.width, targetImgRect.width, sizeProgress),
							height: mix(heroImgRect.height, targetImgRect.height, sizeProgress),
						};
						const heroStyle = getComputedStyle(heroFrame);
						const targetStyle = getComputedStyle(landingCard);
						const heroRadius = Number.parseFloat(heroStyle.borderTopLeftRadius) || 24;
						const targetRadius = Number.parseFloat(targetStyle.borderTopLeftRadius) || 20;
						const heroBorderWidth = Number.parseFloat(heroStyle.borderTopWidth) || 1;
						const overlayOpacity = transitionStarted && !transitionComplete ? 1 : 0;
						setOverlay(rect, imageRect, overlayOpacity, 0, mix(heroBorderWidth, 0, sizeProgress), mix(heroRadius, targetRadius, sizeProgress));
						overlay.style.setProperty('--home-transition-stack-reveal', '0');
						landingCard.style.opacity = '';
						landingCard.style.visibility = transitionStarted && !transitionComplete ? 'hidden' : '';
						stage.style.setProperty('--home-hero-frame-opacity', String(transitionStarted ? 0 : 1));
						stage.style.setProperty('--home-hero-actions-opacity', String(1 - smoothstep(.035, .18, progress)));
						stage.style.setProperty('--home-hero-stats-opacity', String(1 - smoothstep(.008, .09, progress)));
						stage.style.setProperty('--home-hero-backdrop-progress', String(smoothstep(.05, heroShrinkEnd, progress)));
						stage.style.setProperty('--home-hero-radius-progress', String(smoothstep(.005, .1, progress)));
						stage.style.setProperty('--home-proof-header-opacity', String(smootherstep(.58, .9, progress)));
						stage.style.setProperty('--home-proof-featured-image-opacity', '1');
						stage.style.setProperty('--home-proof-featured-card-opacity', '1');
						stage.style.setProperty('--home-proof-featured-notice-opacity', '1');
						return;
					}

					const stageRect = stage.getBoundingClientRect();
					const stageTop = window.scrollY + stageRect.top;
					// The runway stays in document flow while its section is sticky.
					// Arrive exactly as the full-height section locks to the viewport.
					const proofRect = (proofContent ?? proofSection).getBoundingClientRect();
					const proofTop = window.scrollY + proofRect.top;
					const arrivalLead = Math.min(64, window.innerHeight * 0.07);
					const transitionEndScroll = Math.max(0, proofScroll instanceof HTMLElement
						? window.scrollY + proofScroll.getBoundingClientRect().top
						: proofTop + proofRect.height / 2 - getViewportCenter() - arrivalLead);
					const holdDistance = proofScroll instanceof HTMLElement ? Math.max(1, proofScroll.offsetHeight - proofSection.offsetHeight) : 1;
					const deckProgress = clamp((window.scrollY - transitionEndScroll) / holdDistance);
					stage.style.setProperty('--home-workflows-progress', String(deckProgress));
					const distance = Math.max(1, transitionEndScroll - stageTop);
					const startOffset = 0;
					const progress = clamp((-stageRect.top - startOffset) / Math.max(1, distance - startOffset));
					latestDeckProgress = deckProgress;
					latestProgress = progress;
					const headerHeight = siteHeader instanceof HTMLElement ? siteHeader.getBoundingClientRect().height : 0;
					const mediaNow = measureMediaRect();
					const heroBackdropProgress = smoothstep(0.05, heroShrinkEnd, progress);
					const plateNearTop = mediaNow.width > 2
						&& mediaNow.top <= headerHeight + 20
						&& mediaNow.bottom <= headerHeight + window.innerHeight * 0.3
						&& mediaNow.bottom > headerHeight;
					stage.classList.add('is-plate-owner');
					const backDown = flightMode === 'attached' && homeProgress >= 0 && progress > homeProgress + 0.12;
					if (flightMode === 'attached' && homeProgress >= 0 && (progress < 0.4 || backDown)) homeProgress = -1;
					if (!flightBooted) {
						flightBooted = true;
						if (plateNearTop || progress >= 0.72) {
							flightT = 1;
							flightTarget = 1;
							flightMode = 'locked';
							returnArmed = true;
							stackReveal = 1;
							const index = indicatorIndexFor(deckProgress);
							deckShown = index;
							deckTarget = index;
						}
					} else if (departReady && flightMode === 'locked') {
						departReady = false;
						homing = false;
						if (progress >= 0.86) playArrival();
						else {
							flightTarget = 0;
							flightT = 1;
							springFlight(0);
						}
					} else if (flightMode === 'locked' && cardTopRemaining() > 0.1) {
						returnArmed = true;
					} else if (flightMode === 'locked' && returnArmed && cardTopRemaining() <= 0.1) {
						returnArmed = false;
						homing = false;
						departReady = false;
						resetDeck();
						flightTarget = 0;
						flightT = 1;
						springFlight(0);
					} else if (flightMode === 'flying' && flightTarget === 0 && cardTopRemaining() >= 0.2) {
						flightTarget = 1;
						springFlight(1);
					} else if (flightMode === 'attached' && homeProgress < 0 && heroBackdropProgress >= 0.62 && (plateNearTop || progress >= 0.86) && flightTarget !== 1) {
						flightTarget = 1;
						flightT = 0;
						springFlight(1);
					}

					const settled = flightMode === 'locked';
					const heroFrameOpacity = flightMode === 'attached' ? 1 - smoothstep(0.08, 0.28, progress) : 0;
					const actionsOpacity = 1 - smoothstep(0.035, 0.18, progress);
					syncCopyReveal();
					overlay.style.setProperty('--home-transition-opacity', '0');
					overlay.style.setProperty('--home-transition-stack-reveal', '0');
					overlay.style.setProperty('--home-transition-stack-fan', '0px');
					stage.style.setProperty('--home-hero-media-opacity', '1');
					if (settled) holdPlate();
					else if (flightMode === 'attached') releasePlate();
					stage.style.setProperty('--home-hero-frame-opacity', String(heroFrameOpacity));
					stage.style.setProperty('--home-hero-actions-opacity', String(actionsOpacity));
					stage.style.setProperty('--home-hero-stats-opacity', String(1 - smoothstep(.008, .09, progress)));
					stage.style.setProperty('--home-hero-backdrop-progress', String(heroBackdropProgress));
					stage.style.setProperty('--home-hero-radius-progress', String(smoothstep(.005, .1, progress)));
					stage.style.setProperty('--home-proof-featured-image-opacity', '0');
					stage.style.setProperty('--home-proof-featured-card-opacity', '0');
					stage.style.setProperty('--home-proof-featured-notice-opacity', settled && stackReveal > 0.98 ? '1' : '0');
					if (settled) {
						const indicatorIndex = indicatorIndexFor(deckProgress);
						if (indicatorIndex !== deckTarget) playDeck(indicatorIndex);
					} else if (flightMode === 'attached' && (deckTarget !== 0 || deckShown !== 0)) resetDeck();
					renderDeck(deckProgress, settled);
					if (plate.classList.contains('is-detached') && !(flightMode === 'flying' && flightTarget === 1)) {
						if (flightTarget === 0 && stackReveal < 0.03) collapseLayers();
						else syncLayersToDeck();
					}
				};

				const schedule = () => {
					if (!frame) frame = window.requestAnimationFrame(render);
				};

				if (transitionEnabled) window.addEventListener('scroll', schedule, { passive: true });
				window.addEventListener('resize', schedule, { passive: true });
				reduceMotion.addEventListener?.('change', schedule);
				desktop.addEventListener?.('change', schedule);
				heroImage.addEventListener('load', schedule, { once: true });
				targetImage.addEventListener('load', schedule, { once: true });
				document.fonts?.ready.then(() => {
					mobileFrameViewportKey = '';
					frameClearanceViewportKey = '';
					heroTopClearanceViewportKey = '';
					schedule();
				});
				render();
			};

			initHomeHeroProofTransition();
			window.addEventListener('garna:page-content-updated', initHomeHeroProofTransition);
		})();
	</script>
	<Fragment slot="widgets">
		<PayrollSolutionInteractions />
		<GarnaBookingWidget
			trackingSource="home"
			trackingPage="home"
			titleFallback="Start your journey with Garna"
			subtitleFallback="Fill in your details to book a demo"
		/>
	</Fragment>
</BaseLayout>

