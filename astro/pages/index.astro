---
import FAQSection from '../components/sections/FAQSection.astro';
import FinalCTASection from '../components/sections/FinalCTASection.astro';
import GarnaBookingWidget from '../components/ui/GarnaBookingWidget.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import PayrollSolutionInteractions from '../components/sections/payroll/PayrollSolutionInteractions.astro';
import ContractorPaymentsSection from '../components/sections/payroll/home/ContractorPaymentsCarouselSection.astro';
import DeferredContractorPaymentsSection from '../components/sections/payroll/home/DeferredPaymentsStackSection.astro';
import EffectivePayrollSection from '../components/sections/payroll/home/EffectivePayrollSection.astro';
import EmbeddedPayrollInfrastructureSection from '../components/sections/payroll/home/EmbeddedPayrollInfrastructureTabs.astro';
import HireEmployeesWorldwideSection from '../components/sections/payroll/home/HireEmployeesWorldwideSection.astro';
import HomeWorkflowsIntroSection from '../components/sections/payroll/home/HomeWorkflowsIntroSection.astro';
import ManageGlobalPayrollSection from '../components/sections/payroll/home/ManageGlobalPayrollSection.astro';
import SpendbaseQuoteSection from '../components/sections/payroll/home/SpendbaseQuoteSection.astro';
import TrustedByBuildersSection from '../components/sections/payroll/home/TrustedByBuildersSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageFinalCtas } from '../content/page-final-ctas';
import { pageHeroes } from '../content/page-heroes';
import { pageShells } from '../content/page-shells';
import type { FAQItem } from '../types/faq-section';

interface Props {
	defaultTheme?: 'dark' | 'light';
	mainClass?: string;
}

const {
	defaultTheme = 'dark',
	mainClass = '',
} = Astro.props;

const homeFaqItems = [
	{
		question: 'What services does Garna provide?',
		answer:
			'Global payroll, Employer of Record, Contractor of Record, business banking, and international payments, all in one platform. You can hire, pay, and manage your whole team, employees, and contractors, without switching between tools.',
		questionTranslateKey: 'faq.items.q1.question',
		answerTranslateKey: 'faq.items.q1.answer',
	},
	{
		question: 'What is Employer of Record (EOR)?',
		answer:
			'An EOR legally employs your team in a country where you have no entity. Garna becomes that legal employer; you manage the day-to-day work.',
		questionTranslateKey: 'faq.items.q2.question',
		answerTranslateKey: 'faq.items.q2.answer',
	},
	{
		question: 'What is a Contractor of Record?',
		answer:
			"Garna manages the contract, compliance, and payments for your freelancers, so you're protected from misclassification risk without having to become their legal employer.",
		questionTranslateKey: 'faq.items.q3.question',
		answerTranslateKey: 'faq.items.q3.answer',
	},
	{
		question: 'What’s the difference between hiring through an EOR and hiring a contractor?',
		answer:
			'An EOR is designed for full-time employees who need local employment contracts, benefits, and payroll compliance. Contractors work independently and are typically hired for specific projects or services without an employment relationship.',
		questionTranslateKey: 'faq.items.q4.question',
		answerTranslateKey: 'faq.items.q4.answer',
	},
	{
		question: 'Can I hire international talent without an EOR?',
		answer:
			"Yes, by opening your own legal entity. It works, but incorporation, local payroll, and ongoing compliance make it slow and expensive at a small headcount. Check at what team size it's cheaper to set up your own company instead of using an EOR.",
		questionTranslateKey: 'faq.items.q5.question',
		answerTranslateKey: 'faq.items.q5.answer',
	},
	{
		question: 'Why should I choose Garna over other providers?',
		answer:
			'1. All-in-one service in one place: hire employees via EOR, work with contractors of any type (individuals, sole proprietors, or legal entities), and run your everyday banking¹ from a single platform.\n\n2. Transparent pricing without hidden fees.\n\n3. Truly global payouts: pay to 150+ countries in 80+ local currencies using bank transfers, cards, PayPal, local e-wallets, or crypto.\n\n4. Business banking included: multi-currency IBANs in your company name and transfers to 150+ destinations, provided by a separate licensed entity.\n\n5. Reliable payment infrastructure: one of the largest payment networks in the industry, with 20+ banking partners and payment systems.\n\n6. Virtual cards: issue a card in the app, add it to Apple Pay or Google Pay, and pay directly from your Garna balance².\n\n7. Responsive human support whenever you need help.\n\n¹ Business banking services are provided through a separate licensed payment entity/provider.\n² Card issuance and card payment services are provided through a licensed third-party payment provider and are subject to KYC, eligibility, and applicable terms.',
		questionTranslateKey: 'faq.items.q6.question',
		answerTranslateKey: 'faq.items.q6.answer',
	},
	{
		question: 'How long does it take to onboard an employee?',
		answer:
			'In most countries, we can hire a new employee in no more than one business day. Once we receive the confirmed offer details and the employee completes the required onboarding steps, including uploading documents and signing the contract, we ensure a smooth and fast start while supporting both you and the new hire.',
		questionTranslateKey: 'faq.items.q7.question',
		answerTranslateKey: 'faq.items.q7.answer',
	},
	{
		question: 'How long does it take to start using Garna Contractor of Record?',
		answer:
			'In most cases, you can have your first contractor onboarded in less than 20 minutes. Once you create a business account and pass verification, you can start inviting contractors. Garna also offers real-time payment options, so contractors can receive their remuneration the same day.',
		questionTranslateKey: 'faq.items.q8.question',
		answerTranslateKey: 'faq.items.q8.answer',
	},
	{
		question: 'What payment methods does Garna support?',
		answer:
			'We support bank transfers (SWIFT, SEPA, and bank transfers in local currencies), card payments in local currency, PayPal, Payoneer, other e-wallets, and cryptocurrency payments¹. With Garna, you can issue a digital card in the app, add it to Apple Pay or Google Pay, and pay directly from your Garna balance².\n\n¹ Cryptocurrency payment services are provided through a licensed third-party provider and are subject to availability, eligibility, and applicable terms.\n² Card issuance and card payment services are provided through a licensed third-party payment provider and are subject to KYC, eligibility, and applicable terms.',
		questionTranslateKey: 'faq.items.q9.question',
		answerTranslateKey: 'faq.items.q9.answer',
	},
	{
		question: 'Can I use my Garna business account as a daily business account?',
		answer:
			'Yes, it works as a regular business account for everyday banking, not just for payroll and contractor payments. With a Garna Business Account, you can get multi-currency IBANs in your company name, receive payments, and send transfers to 150+ destinations¹.\n\n¹ Business banking services are provided through a separate licensed payment entity/provider.',
		questionTranslateKey: 'faq.items.q10.question',
		answerTranslateKey: 'faq.items.q10.answer',
	},
	{
		question: 'What benefits does a business get access to when using Garna?',
		answer:
			'Beyond contractor management and payroll, you can access business benefits and receive discounts for Slack, Google Workspace, AWS, and accounts with over 100 other service providers at no extra cost.',
		questionTranslateKey: 'faq.items.q11.question',
		answerTranslateKey: 'faq.items.q11.answer',
	},
] satisfies FAQItem[];

---

<BaseLayout shell={pageShells.home} showRainbow={false} defaultTheme={defaultTheme} mainClass={mainClass}>
	<div class="home-hero-proof-stage" data-home-hero-proof-stage>
		<HeroSection {...pageHeroes.home}>
			<div slot="before-title" class="home-hero-proof-rotator" aria-label="Garna in numbers" data-translate-aria-label="hero.stats.ariaLabel">
				<div class="home-hero-proof-rotator__track">
					<span class="home-hero-proof-rotator__item">
						<strong>400+</strong>
						<span data-translate="hero.stats.businesses">businesses trust Garna</span>
					</span>
					<span class="home-hero-proof-rotator__item">
						<strong>$110M+</strong>
						<span data-translate="hero.stats.paid">paid to specialists</span>
					</span>
					<span class="home-hero-proof-rotator__item">
						<strong>38K+</strong>
						<span data-translate="hero.stats.professionals">professionals use Garna</span>
					</span>
				</div>
			</div>
			<div slot="background" class="home-hero-cover">
				<div class="home-hero-cover__slot" data-home-hero-slot aria-hidden="true"></div>
				<div class="home-hero-cover__media" data-home-hero-plate aria-hidden="true">
					<div class="home-hero-plate__layer home-hero-plate__layer--hire" data-plate-layer="hire" data-plate-depth="2">
						<img src="/pages/payroll-solution-new/assets/home-workflows-hire-upscaled.jpg" alt="" />
					</div>
					<div class="home-hero-plate__layer home-hero-plate__layer--contractors" data-plate-layer="contractors" data-plate-depth="1">
						<img src="/pages/payroll-solution-new/assets/home-proof-mountain-man-v1.png" alt="" />
					</div>
					<div class="home-hero-plate__layer home-hero-plate__layer--photo" data-plate-layer="pay" data-plate-depth="0">
						<img data-home-hero-image src="/pages/payroll-solution-new/assets/home-hero-editorial-preview-3-optimized.webp" alt="" />
					</div>
				</div>
				<div class="home-hero-focus-frame" data-home-hero-frame aria-hidden="true"></div>
			</div>
		</HeroSection>
		<div class="home-workflows-scroll" data-home-workflows-scroll>
			<HomeWorkflowsIntroSection />
		</div>
		<div class="home-hero-proof-transition" data-home-proof-transition aria-hidden="true">
			<div class="home-transition-back home-transition-back--hire">
				<img src="/pages/payroll-solution-new/assets/home-workflows-hire-upscaled.jpg" alt="" />
			</div>
			<div class="home-transition-back home-transition-back--contractors">
				<img src="/pages/payroll-solution-new/assets/home-proof-mountain-man-v1.png" alt="" />
			</div>
			<div class="home-transition-front">
				<img src="/pages/payroll-solution-new/assets/home-hero-editorial-preview-3-optimized.webp" alt="" data-home-transition-image />
			</div>
		</div>
	</div>
	<ManageGlobalPayrollSection />
	<ContractorPaymentsSection />
	<HireEmployeesWorldwideSection cardInteractive={defaultTheme !== 'light'} />
	<EffectivePayrollSection />
	<SpendbaseQuoteSection />
	<DeferredContractorPaymentsSection />
	<EmbeddedPayrollInfrastructureSection />
	<TrustedByBuildersSection />
	<FAQSection
		title={{ text: 'FAQ on Payroll Solutions', translateKey: 'faq.title' }}
		items={homeFaqItems}
		variant="eor"
		class="home-payroll-faq pt-16 pb-16 lg:pt-32 lg:pb-32"
		containerClass="garna-container home-payroll-faq-container"
	/>
	<FinalCTASection {...pageFinalCtas.home} />
	<script is:inline>
		document.addEventListener('click', (event) => {
			const link = event.target instanceof Element ? event.target.closest('a') : null;
			if (!link || link.getAttribute('href') !== '#') return;
			if (!link.textContent || !link.textContent.toLowerCase().includes('book a demo')) return;

			event.preventDefault();
			if (window.GarnaWidget) {
				window.GarnaWidget.open({ trackingCta: 'payroll_solution_new_demo' });
			}
		});
	</script>
	<script>
		import { animate, spring } from 'motion';

		(() => {
			const clamp = (value, min = 0, max = 1) => Math.min(max, Math.max(min, value));
			const mix = (from, to, progress) => from + (to - from) * progress;
			const smoothstep = (start, end, value) => {
				const t = clamp((value - start) / (end - start));
				return t * t * (3 - 2 * t);
			};
			const smootherstep = (start, end, value) => {
				const t = clamp((value - start) / (end - start));
				return t * t * t * (t * (t * 6 - 15) + 10);
			};
			const getPositionRatio = (token, axis) => {
				if (!token) return 0.5;
				if (token.endsWith('%')) return Number.parseFloat(token) / 100;
				if (token === 'left' || token === 'top') return 0;
				if (token === 'right' || token === 'bottom') return 1;
				if (token === 'center') return 0.5;
				return axis === 'y' && token === 'bottom' ? 1 : 0.5;
			};
			const getObjectPosition = (style) => {
				const tokens = style.objectPosition.trim().split(/\s+/);
				if (tokens.length === 1) return { x: getPositionRatio(tokens[0], 'x'), y: 0.5 };
				return { x: getPositionRatio(tokens[0], 'x'), y: getPositionRatio(tokens[1], 'y') };
			};
			const getScale = (style) => {
				const matrix = new DOMMatrixReadOnly(style.transform === 'none' ? undefined : style.transform);
				return Math.hypot(matrix.a, matrix.b) || 1;
			};
			const getPaintedImageRect = (containerRect, image) => {
				const style = getComputedStyle(image);
				const naturalRatio = image.naturalWidth && image.naturalHeight ? image.naturalWidth / image.naturalHeight : 1;
				const containerRatio = containerRect.width / containerRect.height;
				const base = containerRatio > naturalRatio
					? { width: containerRect.width, height: containerRect.width / naturalRatio }
					: { width: containerRect.height * naturalRatio, height: containerRect.height };
				const position = getObjectPosition(style);
				const scale = getScale(style);
				const [originX = '0', originY = '0'] = style.transformOrigin.split(/\s+/);
				const origin = {
					x: containerRect.x + Number.parseFloat(originX),
					y: containerRect.y + Number.parseFloat(originY),
				};
				const baseRect = {
					x: containerRect.x + (containerRect.width - base.width) * position.x,
					y: containerRect.y + (containerRect.height - base.height) * position.y,
					width: base.width,
					height: base.height,
				};

				return {
					x: origin.x + (baseRect.x - origin.x) * scale,
					y: origin.y + (baseRect.y - origin.y) * scale,
					width: baseRect.width * scale,
					height: baseRect.height * scale,
				};
			};
			const initHomeHeroProofTransition = () => {
				const stage = document.querySelector('[data-home-hero-proof-stage]');
				if (!(stage instanceof HTMLElement) || stage.dataset.transitionReady === 'true') return;

				const heroFrame = stage.querySelector('[data-home-hero-frame]');
				const heroImage = stage.querySelector('[data-home-hero-image]');
				const plate = stage.querySelector('[data-home-hero-plate]');
				const heroSlot = stage.querySelector('[data-home-hero-slot]');
				const heroCover = plate?.parentElement ?? null;
				const heroSection = heroFrame?.closest('[data-section-kind="hero"]');
				const heroButton = heroSection?.querySelector('.garna-button');
				const heroCta = heroSection?.querySelector('.garna-button')?.parentElement;
				const heroStats = heroSection?.querySelector('.home-hero-proof-rotator');
				const siteHeader = document.querySelector('.garna-header');
				const proofSection = stage.querySelector('.home-proof-section');
				const proofScroll = stage.querySelector('[data-home-workflows-scroll]');
				const proofContent = proofSection?.querySelector('.home-workflows-intro__container');
				const targetCard = stage.querySelector('[data-home-proof-card="featured"]');
				const targetImage = stage.querySelector('[data-home-proof-image="featured"]');
				const overlay = stage.querySelector('[data-home-proof-transition]');
				const overlayImage = stage.querySelector('[data-home-transition-image]');
				if (
					!(heroFrame instanceof HTMLElement) ||
					!(heroImage instanceof HTMLImageElement) ||
					!(plate instanceof HTMLElement) ||
					!(heroSlot instanceof HTMLElement) ||
					!(proofSection instanceof HTMLElement) ||
					!(targetCard instanceof HTMLElement) ||
					!(targetImage instanceof HTMLImageElement) ||
					!(overlay instanceof HTMLElement) ||
					!(overlayImage instanceof HTMLImageElement)
				) return;

				stage.dataset.transitionReady = 'true';
				const transitionEnabled = true;
				const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
				const desktop = window.matchMedia('(min-width: 841px)');
				let frame = 0;
				let mobileFrameViewportKey = '';
				let frameClearanceViewportKey = '';
				let heroTopClearanceViewportKey = '';
				const deckCards = Array.from(stage.querySelectorAll('[data-workflow-card]'));
				const deckHeadings = Array.from(stage.querySelectorAll('[data-workflow-heading]'));
				const deckIndicators = Array.from(stage.querySelectorAll('[data-workflow-progress]'));
				const stack = targetCard.parentElement;
				stack.querySelector('.home-workflows-mobile-rail')?.remove();
				const mobileRail = document.createElement('div');
				mobileRail.className = 'home-workflows-mobile-rail';
				const mobileCards = [];
				// Copies on both ends keep the visible rail continuous at states one and three.
				for (let sequence = 0; sequence < 9; sequence++) {
					const card = deckCards[sequence % 3].cloneNode(true);
					card.removeAttribute('data-workflow-card');
					card.removeAttribute('data-home-proof-card');
					card.querySelector('[data-home-proof-image]')?.removeAttribute('data-home-proof-image');
					card.classList.remove('is-active');
					card.classList.add('home-workflows-mobile-card');
					card.removeAttribute('style');
					mobileRail.append(card);
					mobileCards.push(card);
				}
				stack.append(mobileRail);
				// Preserve both wider experiments for comparison.
				const deckVariant = 'quiet-stack'; // Alternatives: 'three-card-selection', 'two-sided-swap'
				const renderTwoSidedDeck = (progress) => {
					let current = 0;
					let turn = 0;
					if (progress >= 0.60) { current = 1; turn = clamp((progress - 0.60) / 0.27); }
					else if (progress >= 0.15) { turn = clamp((progress - 0.15) / 0.27); }
					const next = current + 1;
					const moving = turn > 0 && turn < 1;
					const active = turn >= 0.5 ? next : current;
					const departure = 1 - smoothstep(0, 0.20, turn);
					const arrival = smoothstep(0.78, 1, turn);
					const excursion = turn < 0.5 ? smootherstep(0.12, 0.5, turn) : 1 - smootherstep(0.5, 0.92, turn);
					// Fan both cards out symmetrically, leaving room for their rotated corners.
					const cardWidth = targetCard.offsetWidth;
					const sideTravel = Math.max(0, Math.min(cardWidth * 0.72, (proofSection.clientWidth - cardWidth) / 2 - 48));
					deckHeadings.forEach((heading, index) => {
						const opacity = index === current ? departure : index === next ? arrival : 0;
						heading.style.opacity = String(opacity);
						heading.style.visibility = opacity > 0 ? 'visible' : 'hidden';
						heading.style.transform = `translateY(${(1 - opacity) * 10}px)`;
						heading.setAttribute('aria-hidden', String(index !== active));
					});
					deckCards.forEach((card, index) => {
						const visible = moving ? index === current || index === next : index === (turn === 1 ? next : current);
						card.style.opacity = visible ? '1' : '0';
						card.style.visibility = visible ? 'visible' : 'hidden';
						card.style.zIndex = String(index === current ? (turn < 0.5 ? 3 : 1) : 2);
						card.style.transform = index === current
							? `translateX(${-sideTravel * excursion}px) translateY(${-10 * excursion}px) rotate(${-8 * excursion}deg) scale(${1 - 0.04 * excursion})`
							: index === next && moving
								? `translateX(${sideTravel * excursion}px) translateY(${-10 * excursion}px) rotate(${8 * excursion}deg) scale(${mix(0.94, 1, smoothstep(0.5, 0.92, turn))})`
								: 'none';
						card.setAttribute('aria-hidden', String(index !== active));
						const notice = card.querySelector('.home-workflows-stack__status');
						if (notice instanceof HTMLElement) {
							const opacity = index === current ? departure : index === next ? arrival : 0;
							notice.style.opacity = `calc(${opacity} * var(--home-proof-featured-notice-opacity, 1))`;
							notice.style.transform = `translateY(${(1 - opacity) * 8}px)`;
							notice.style.transition = 'none';
						}
					});
				};

				const renderThreeCardDeck = (progress) => {
					const current = progress >= 0.60 ? 1 : 0;
					const next = current + 1;
					const turn = clamp((progress - (current === 0 ? 0.15 : 0.60)) / 0.27);
					const reveal = smootherstep(0.08, 0.32, turn);
					const selection = smootherstep(0.38, 0.70, turn);
					const collapse = smootherstep(0.74, 0.96, turn);
					const departure = 1 - smoothstep(0, 0.18, turn);
					const arrival = smoothstep(0.86, 1, turn);
					const active = selection >= 0.5 ? next : current;
					const width = targetCard.offsetWidth;
					const travel = Math.max(0, Math.min(width * 1.03, (proofSection.clientWidth - width * 0.88) / 2 - 36));
					// Pay -> contractors: choose left. Contractors -> hire: choose right.
					const before = current === 0 ? [0, -1, 1] : [-1, 0, 1];
					const after = current === 0 ? [1, 0, -1] : [1, -1, 0];
					deckHeadings.forEach((heading, index) => {
						const opacity = index === current ? departure : index === next ? arrival : 0;
						heading.style.opacity = String(opacity);
						heading.style.visibility = opacity > 0 ? 'visible' : 'hidden';
						heading.style.transform = `translateY(${(1 - opacity) * 10}px)`;
						heading.setAttribute('aria-hidden', String(index !== active));
					});
					deckCards.forEach((card, index) => {
						const position = mix(before[index], after[index], selection);
						const spread = reveal * (1 - collapse);
						const startScale = index === current ? 1 : mix(0.96, 0.88, reveal);
						const selectedScale = index === next ? 1 : 0.88;
						const scale = mix(mix(startScale, selectedScale, selection), index === next ? 1 : 0.96, collapse);
						const arc = Math.sin(selection * Math.PI) * (index === next ? -38 : 20);
						const visible = turn > 0 && turn < 1 ? true : index === (turn === 1 ? next : current);
						card.style.opacity = visible ? '1' : '0';
						card.style.visibility = visible ? 'visible' : 'hidden';
						card.style.zIndex = String(index === next && selection > 0 ? 4 : index === current ? 3 : 1);
						card.style.transform = `translateX(${position * travel * spread}px) translateY(${arc}px) scale(${scale})`;
						card.setAttribute('aria-hidden', String(index !== active));
						const notice = card.querySelector('.home-workflows-stack__status');
						if (notice instanceof HTMLElement) {
							const opacity = index === current ? departure : index === next ? arrival : 0;
							notice.style.opacity = `calc(${opacity} * var(--home-proof-featured-notice-opacity, 1))`;
							notice.style.transform = `translateY(${(1 - opacity) * 8}px)`;
							notice.style.transition = 'none';
						}
					});
				};
				let deckPosition = 0;
				// The dot switches when its fill reaches the end of that segment.
				// The card animation starts from this same index.
				const indicatorIndexFor = (progress) => {
					const mark = Math.max(0, progress * 3);
					if (mark < 1) return 0;
					if (mark < 2) return 1;
					return 2;
				};
				const compactStack = stage.closest('.light-home-draft') !== null;
				const firstStackStep = compactStack ? 16 : 28;
				const nextStackStep = compactStack ? 14 : 24;
				const stackY = (depth) => depth <= 1
					? -firstStackStep * depth
					: -firstStackStep - nextStackStep * (depth - 1);
				const renderQuietStack = (progress, landed = true) => {
					const requested = Math.min(2, Math.floor(progress * 3));
					if (!desktop.matches) {
						deckPosition = requested;
						// Use painted widths: inactive cards are scaled to 94%, so their
						// layout slots must shrink too to preserve equal visible gaps.
						const referenceRail = document.querySelector('[data-scroll-visual-carousel-id="home-contractor-payments-carousel"] .contractor-carousel__rail');
						const gap = referenceRail instanceof HTMLElement ? Number.parseFloat(getComputedStyle(referenceRail).columnGap) : (window.innerWidth <= 767 ? 12.8 : 18.4);
						const cardWidth = stack.getBoundingClientRect().width;
						const step = cardWidth * .94 + gap;
						mobileRail.style.transform = `translateX(${-step * (requested + 3)}px)`;
						mobileCards.forEach((card, index) => {
							const selected = index === requested + 3;
							card.style.left = `${index * step + (index > requested + 3 ? cardWidth * .06 : 0)}px`;
							card.classList.toggle('is-mobile-active', selected);
							card.setAttribute('aria-hidden', String(!selected));
						});
						deckHeadings.forEach((heading, index) => {
							heading.style.display = index === requested ? 'block' : 'none';
							heading.style.opacity = '1';
							heading.style.visibility = 'visible';
							heading.style.transform = 'none';
							heading.setAttribute('aria-hidden', String(index !== requested));
						});
						deckIndicators.forEach((indicator, index) => {
							indicator.classList.toggle('is-active', index === requested);
							indicator.style.setProperty('--step-fill', String(clamp(progress * 3 - index)));
						});
						return;
					}
					// 0 = only the people card. 1 = the next card has landed on top.
