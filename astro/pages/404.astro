---
import BaseLayout from '../layouts/BaseLayout.astro';
import NotFoundSection from '../components/sections/system/NotFoundSection.astro';
import type { PageShellConfig } from '../types/page-shell';

const shell: PageShellConfig = {
	title: '404 - Target Missing - Garna',
	description: 'Page not found',
	bodyClass: 'overflow-x-hidden bg-garna-page text-white selection:bg-[#5EA500] selection:text-black',
	iconLibrary: 'iconify',
};
---

<BaseLayout shell={shell} showHeader={false} showFooter={false}>
	<NotFoundSection />
</BaseLayout>
