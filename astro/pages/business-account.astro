---
import FAQSection from '../components/sections/FAQSection.astro';
import FinalCTASection from '../components/sections/FinalCTASection.astro';
import GarnaBookingWidget from '../components/ui/GarnaBookingWidget.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageFinalCtas } from '../content/page-final-ctas';
import { pageShells } from '../content/page-shells';
import type { FAQItem } from '../types/faq-section';
import BusinessAccountHeroSection from '../components/sections/payroll/BusinessAccountHeroSection.astro';
import BusinessAccountFinancialAdminCarouselSection from '../components/sections/payroll/BusinessAccountFinancialAdminCarouselSection.astro';
import BusinessAccountProofStatsCardsSection from '../components/sections/payroll/BusinessAccountProofStatsCardsSection.astro';
import BusinessAccountBenefitsSection from '../components/sections/payroll/BusinessAccountBenefitsSection.astro';
import BusinessAccountCostEstimatorSection from '../components/sections/payroll/BusinessAccountCostEstimatorSection.astro';
import BusinessAccountSecuritySection from '../components/sections/payroll/BusinessAccountSecuritySection.astro';
import BusinessAccountMoreThanAccountSection from '../components/sections/payroll/BusinessAccountMoreThanAccountSection.astro';
import BusinessAccountSectionStyles from '../components/sections/payroll/BusinessAccountSectionStyles.astro';
import BusinessAccountInteractions from '../components/sections/payroll/BusinessAccountInteractions.astro';

const businessAccountApiPaymentCards = [
	{
		value: '',
		label: '',
		image: '/images/business-account/api-payments-integration-upscaled.jpg',
		alt: 'A woman using her phone in a bright cafe',
		imagePosition: 'center center',
		notice: {
			icon: 'contract' as const,
			label: 'API payment',
			labelKey: 'apiPayments.cards.integration.label',
			timestamp: 'Processed',
			timestampKey: 'apiPayments.cards.integration.time',
			title: 'Payment created',
			titleKey: 'apiPayments.cards.integration.completed',
			meta: 'Created via API and confirmed automatically',
			metaKey: 'apiPayments.cards.integration.detail',
			amount: '$12,680',
			tone: 'bank' as const,
		},
	},
];

const businessAccountFaqItems = [
	{
		question: 'Who can open a Garna business account?',
		answer:
			'Garna works with businesses across a wide range of industries and jurisdictions. Every applicant goes through our onboarding and compliance review.',
		questionTranslateKey: 'faq.items.q1.question',
		answerTranslateKey: 'faq.items.q1.answer',
	},
	{
		question: 'What documents do I need to open a Garna business account?',
		answer:
			"To open a business account with Garna, you'll need to complete a short KYB (Know Your Business) application and submit a set of supporting documents. The exact requirements depend on your company's structure and jurisdiction, and our team reviews each application individually — we'll let you know exactly what's needed to get you fully verified and ready to go.",
		questionTranslateKey: 'faq.items.q2.question',
		answerTranslateKey: 'faq.items.q2.answer',
	},
	{
		question: 'How do you keep funds secure?',
		answer:
			'Garna uses bank-level encryption and follows GDPR requirements and industry-standard data security practices to help protect your funds and data.',
		questionTranslateKey: 'faq.items.q3.question',
		answerTranslateKey: 'faq.items.q3.answer',
	},
	{
		question: 'Can I receive payments in multiple currencies?',
		answer:
			'We support more than 80 national currencies, including USD, EUR, and a wide range of local options.',
		questionTranslateKey: 'faq.items.q4.question',
		answerTranslateKey: 'faq.items.q4.answer',
	},
	{
		question: 'Can I send international payments from my Garna account?',
		answer:
			'We support bank transfers (SWIFT, SEPA, and local-currency bank transfers), card payments in local currency, PayPal, and crypto payments (USDT/USDC).',
		questionTranslateKey: 'faq.items.q5.question',
		answerTranslateKey: 'faq.items.q5.answer',
	},
	{
		question: 'Can I pay employees and contractors through Garna?',
		answer:
			'Yes. Through Garna, you can pay employees, contractors, and freelancers using the payment method that works best for them.',
		questionTranslateKey: 'faq.items.q6.question',
		answerTranslateKey: 'faq.items.q6.answer',
	},
	{
		question: 'What is the average payment processing time?',
		answer:
			'Processing typically ranges from instant to three business days, depending on the payment method. Most crypto payments are instant, e-wallet payments take up to one day, and bank transfers take up to three business days.',
		questionTranslateKey: 'faq.items.q7.question',
		answerTranslateKey: 'faq.items.q7.answer',
	},
	{
		question: 'Can I access my money at any time?',
		answer: 'Yes. Your balance is available whenever you need it for payroll, payments, or transfers.',
		questionTranslateKey: 'faq.items.q8.question',
		answerTranslateKey: 'faq.items.q8.answer',
	},
] satisfies FAQItem[];
---

<BaseLayout shell={pageShells.businessAccount}>
	<BusinessAccountHeroSection />
	<BusinessAccountFinancialAdminCarouselSection />
	<BusinessAccountCostEstimatorSection />
	<BusinessAccountBenefitsSection />
	<BusinessAccountSecuritySection />
	<BusinessAccountSectionStyles />
	<BusinessAccountProofStatsCardsSection
		title={{ text: 'Connect Global Payments to Your Platform', translateKey: 'apiPayments.title' }}
		description={{
			text: 'Integrate Garna Business Account into your own platform and manage payments seamlessly under the hood',
			translateKey: 'apiPayments.description',
		}}
		action={{
			label: { text: 'Learn more', translateKey: 'apiPayments.button' },
			href: '/white-label',
			variant: 'primary',
			icon: 'none',
		}}
		stats={businessAccountApiPaymentCards}
	/>
	<BusinessAccountMoreThanAccountSection />
	<FAQSection
		title={{ text: 'FAQ on Business Account', translateKey: 'faq.title' }}
		items={businessAccountFaqItems}
		variant="eor"
		class="py-16 lg:py-32"
		containerClass="garna-container"
	/>
	<FinalCTASection {...pageFinalCtas.businessAccount} />
	<Fragment slot="widgets">
		<BusinessAccountInteractions />
		<GarnaBookingWidget
			trackingSource="business-account"
			trackingPage="business-account"
			titleFallback="Book a Business Account demo"
			subtitleFallback="Get all your questions answered by our experts"
		/>
	</Fragment>
</BaseLayout>
