---
import BaseLayout from '../layouts/BaseLayout.astro';
import GarnaBookingWidget from '../components/ui/GarnaBookingWidget.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import { pageShells } from '../content/page-shells';
import BlogLeadSections from '../components/sections/blog/BlogLeadSections.astro';
import BlogGridSections from '../components/sections/blog/BlogGridSections.astro';
import BlogInteractions from '../components/sections/blog/BlogInteractions.astro';

const blogHero = {
	class: 'flex flex-col w-full pt-24 md:pt-32 pb-16 md:pb-24 relative justify-center',
	containerClass:
		'flex flex-col md:pl-6 md:pr-6 md:pt-8 w-full max-w-7xl z-10 mr-auto ml-auto pt-12 pr-6 pl-6 relative items-center',
	contentClass: 'flex flex-col text-center max-w-5xl z-10 mb-12 relative items-center',
	titleClass:
		'leading-none md:text-7xl lg:text-[88px] text-6xl text-white tracking-tight font-manrope mb-6',
	descriptionClass:
		'text-xl tracking-tight text-center max-w-5xl mr-auto ml-auto',
	title: [{ text: 'Garna Insights Hub', translateKey: 'blog.hero.title' }],
	description:
		'Dive into the world of expert insights on global hiring, payroll, and workforce management and stay one step ahead. Check out our practical guides, industry trends, and international employment updates',
	descriptionTranslateKey: 'blog.hero.description',
	tone: 'neutral',
};

const demoOnclick =
	"event.preventDefault(); if (window.GarnaWidget) window.GarnaWidget.open({ trackingCta: 'blog_demo' });";
---

<BaseLayout shell={pageShells.blog}>
	<HeroSection {...blogHero}>
		<div class="w-full relative z-10 flex justify-center">
			<div class="flex flex-wrap md:flex-nowrap justify-center overflow-x-hidden md:overflow-x-auto no-scrollbar snap-x max-w-full pr-4 pl-4 gap-x-2 gap-y-2 items-center">
				<button class="flex-shrink-0 bg-[#5ea500] text-white px-5 py-2 rounded-full text-sm hover:bg-[#4a8300] transition-colors snap-start">
					<span data-translate="blog.categories.all">All categories</span>
				</button>
				<button class="flex-shrink-0 px-5 py-2 rounded-full text-sm hover:bg-[#5ea500]/10 hover:text-[#5ea500] transition-colors snap-start border border-transparent hover:border-[#5ea500]/20"><span data-translate="blog.categories.payroll">Payroll</span></button>
				<button class="flex-shrink-0 px-5 py-2 rounded-full text-sm hover:bg-[#5ea500]/10 hover:text-[#5ea500] transition-colors snap-start border border-transparent hover:border-[#5ea500]/20"><span data-translate="blog.categories.hr">HR</span></button>
				<button class="flex-shrink-0 px-5 py-2 rounded-full text-sm hover:bg-[#5ea500]/10 hover:text-[#5ea500] transition-colors snap-start border border-transparent hover:border-[#5ea500]/20"><span data-translate="blog.categories.businessFinance">Business finance</span></button>
				<button class="flex-shrink-0 px-5 py-2 rounded-full text-sm hover:bg-[#5ea500]/10 hover:text-[#5ea500] transition-colors snap-start border border-transparent hover:border-[#5ea500]/20"><span data-translate="blog.categories.tools">Tools</span></button>
			</div>
		</div>
	</HeroSection>
	<BlogLeadSections />
	<section class="overflow-hidden lg:pt-8 lg:pb-8 pt-8 pb-8 relative">
		<div class="font-manrope max-w-7xl mx-auto pr-6 pl-6">
			<a
				href="#"
				onclick={demoOnclick}
				class="flex flex-col sm:flex-row gap-4 sm:gap-6 items-center justify-between rounded-3xl border border-white/10 bg-[#0a0a0a]/55 px-6 py-5 shadow-[0_20px_60px_rgba(0,0,0,0.22)] transition-colors hover:border-[#5ea500]/30 outline-none"
			>
				<h2 class="md:text-3xl text-2xl leading-tight font-thin text-white tracking-tight" data-translate="blog.cta.title">Your Global Growth Starts Here</h2>
				<span class="inline-flex min-h-12 shrink-0 items-center justify-center rounded-xl bg-[#5ea500] px-7 text-base font-normal text-white shadow-[0_0_24px_rgba(94,165,0,0.32)] transition-transform duration-300 hover:scale-[1.03] hover:bg-[#69b800]">
					<span data-translate="blog.cta.button">Book a Demo</span>
				</span>
			</a>
		</div>
	</section>
	<BlogGridSections />
	<Fragment slot="widgets">
		<BlogInteractions />
		<GarnaBookingWidget
			trackingSource="blog"
			trackingPage="blog"
			titleFallback="Start your journey with Garna"
			subtitleFallback="Fill in your details to book a demo"
		/>
	</Fragment>
</BaseLayout>
