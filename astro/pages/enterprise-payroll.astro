---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import FAQSection from '../components/sections/FAQSection.astro';
import FinalCTASection from '../components/sections/FinalCTASection.astro';
import GarnaBookingWidget from '../components/ui/GarnaBookingWidget.astro';
import EnterprisePayrollHeroVisual from '../components/visuals/EnterprisePayrollHeroVisual.astro';
import EnterpriseControlSection from '../components/sections/payroll/EnterpriseControlSection.astro';
import EnterprisePlatformSection from '../components/sections/payroll/EnterprisePlatformSection.astro';
import BusinessSolutionsSection from '../components/sections/payroll/BusinessSolutionsSection.astro';
import EnterprisePayrollStepsSection from '../components/sections/payroll/EnterprisePayrollStepsSection.astro';
import EnterpriseOperationsSection from '../components/sections/payroll/EnterpriseOperationsSection.astro';
import GarnaDifferentiatorsSection from '../components/sections/payroll/GarnaDifferentiatorsSection.astro';
import EnterpriseTestimonialsSection from '../components/sections/payroll/EnterpriseTestimonialsSection.astro';
import EnterprisePayrollSectionStyles from '../components/sections/payroll/EnterprisePayrollSectionStyles.astro';
import EnterprisePayrollInteractions from '../components/sections/payroll/EnterprisePayrollInteractions.astro';
import PayrollLandingEnhancements from '../components/sections/payroll/PayrollLandingEnhancements.astro';
import { enterprisePayrollFaqItems } from '../content/payroll-landing-faqs';
import { pageFinalCtas } from '../content/page-final-ctas';
import { pageHeroes } from '../content/page-heroes';
import { pageShells } from '../content/page-shells';
---

<BaseLayout shell={pageShells.enterprisePayroll}>
	<HeroSection {...pageHeroes.enterprisePayroll}>
		<EnterprisePayrollHeroVisual />
	</HeroSection>
	<EnterpriseControlSection />
	<EnterprisePlatformSection />
	<BusinessSolutionsSection audience="enterprise" />
	<EnterprisePayrollStepsSection />
	<EnterpriseOperationsSection />
	<GarnaDifferentiatorsSection />
	<EnterpriseTestimonialsSection />
	<EnterprisePayrollSectionStyles />
	<FAQSection
		title={{ text: 'Payroll FAQs for Global Businesses', translateKey: 'enterprisePayrollFaq.title' }}
		subtitle={{ text: "Got Questions? We've Got Answers", translateKey: 'faqHome.subtitle' }}
		items={enterprisePayrollFaqItems}
		class="pt-16 pb-16 lg:pt-32 lg:pb-32"
		containerClass="garna-container"
	/>
	<FinalCTASection {...pageFinalCtas.enterprisePayroll} />
	<PayrollLandingEnhancements />
	<Fragment slot="widgets">
		<EnterprisePayrollInteractions />
		<GarnaBookingWidget
			trackingSource="contractor-of-record"
			trackingPage="contractor-of-record"
			titleFallback="Start your journey with Garna"
			subtitleFallback="Fill in your details to book a demo"
		/>
	</Fragment>
</BaseLayout>
