---
import Button from '../components/ui/Button.astro';

const hero = {
	image: '/pages/payroll-solution-new/assets/ads-landing-hero-invoicing-woman-upscaled.jpg',
	objectPosition: 'center 30%',
	narrowObjectPosition: 'center 24%',
	title: 'Invoice Clients Globally Without a Company',
	titleKey: 'hero.title',
	description: 'Invoice business clients worldwide and receive international payments with Garna in one clear workflow',
	descriptionKey: 'hero.description',
};

---

<section class="eor-hero" data-section-kind="hero">
	<div class="eor-hero__grid mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-2 lg:items-center lg:gap-20">
		<div class="eor-hero__copy">
			<div class="eor-hero__text">
				<h1 class="garna-hero-title-gradient" data-translate={hero.titleKey}>{hero.title}</h1>
				<p data-garna-subtitle data-translate={hero.descriptionKey}>
					{hero.description}
				</p>
			</div>
			<Button
				href="https://app.garna.io/en/auth/sign-up"
				variant="primary"
				size="hero"
				effect="rotating-flare"
				icon="arrow-up-right"
				class="eor-hero__cta w-fit"
				data-garna-signup
			>
				<span data-translate="hero.cta">Create account</span>
			</Button>

			<div class="eor-hero__note">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M13.4 2.5 5.8 13h5.4l-.7 8.5L18.2 11h-5.4l.6-8.5Z"></path>
				</svg>
				<p data-translate="hero.note">Built for freelancers with global clients</p>
			</div>
		</div>

		<div class="eor-hero__visual" aria-label="Global invoicing payment preview" data-translate-aria-label="hero.visualAriaLabel">
			<div class="eor-hero__media">
				<img
					class="eor-hero__image"
					src={hero.image}
					alt=""
					loading="eager"
					style={`--eor-hero-object-position: ${hero.objectPosition}; --eor-hero-narrow-object-position: ${hero.narrowObjectPosition};`}
				/>
			</div>
			<div class="eor-hero__notifications" aria-hidden="true">
				<div class="hero-finance-card hero-finance-card--income">
					<small data-translate="hero.cards.monthlyIncome">Monthly Income</small>
					<strong>$4,300</strong>
					<span data-translate="hero.cards.monthlyGrowth">↑ 18% this month</span>
					<div class="hero-income-chart">
						<i style="--bar-height: 31%"></i>
						<i style="--bar-height: 48%"></i>
						<i style="--bar-height: 42%"></i>
						<i style="--bar-height: 58%"></i>
						<i style="--bar-height: 72%"></i>
						<i style="--bar-height: 94%"></i>
					</div>
					<div class="hero-income-months" aria-hidden="true"><span>Jan</span><span>Feb</span><span>Mar</span><span>Apr</span><span>May</span><span>Jun</span></div>
				</div>

				<div class="hero-finance-card hero-finance-card--balance">
					<div class="hero-balance-head">
						<strong data-translate="hero.cards.balance">Balance</strong>
						<span>+</span>
					</div>
					<div class="hero-balance-accounts">
						<div><small>USD</small><strong>$7,500.00</strong></div>
						<div><small>EUR</small><strong>€5,690.00</strong></div>
					</div>
					<div class="hero-balance-action" data-translate="hero.cards.withdraw">Withdraw</div>
				</div>
			</div>
		</div>
	</div>

</section>

<style>
	.eor-hero {
		position: relative;
		overflow: visible;
		background: transparent;
		padding: clamp(8.5rem, 13vw, 12rem) 0 clamp(4.5rem, 8vw, 7rem);
		color: #ffffff;
	}

	.eor-hero__copy,
	.eor-hero__visual {
		position: relative;
		z-index: 1;
	}

	.eor-hero__copy {
		display: flex;
		width: 100%;
		flex-direction: column;
		align-items: flex-start;
		text-align: left;
	}

	.eor-hero__text {
		width: 100%;
	}

	.eor-hero__copy h1 {
		overflow: hidden;
		margin: 0;
		padding-bottom: 0.16em;
		font-family: Manrope, sans-serif;
		font-size: 2.75rem;
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: 0;
	}

	@media (min-width: 768px) {
		.eor-hero__copy h1 {
			font-size: 3rem;
		}
	}

	@media (min-width: 1024px) {
		.eor-hero__copy {
			min-height: clamp(29rem, 44vw, 40rem);
		}

		.eor-hero__copy h1 {
			font-size: clamp(54px, calc(14px + 3.90625vw), 64px);
		}

		.eor-hero__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: clamp(2.5rem, 6.25vw, 5rem);
		}
	}

	@media (min-width: 1280px) {
		.eor-hero__copy h1 {
			font-size: 64px;
		}

		:global(html[lang='ru']) .eor-hero__copy h1 {
			font-size: 64px;
		}
	}

	.eor-hero__copy h1 {
		white-space: pre-line;
	}

	.eor-hero__copy p {
		max-width: 36rem;
		overflow: hidden;
		margin: 1.25rem 0 0;
		color: rgb(255 255 255 / 0.62);
		font-family: Manrope, sans-serif;
		font-size: 1.125rem;
		font-weight: 500;
		line-height: 1.58;
	}

	@media (min-width: 768px) {
		.eor-hero__copy p {
			font-size: 1.25rem;
		}
	}

	:global(.eor-hero__cta) {
		margin-top: 2.5rem;
	}

	@media (min-width: 846px) {
		:global(.eor-hero__cta) {
			margin-bottom: 2rem;
		}
	}

	.eor-hero__note {
		display: flex;
		width: 100%;
		align-items: center;
		gap: clamp(0.4rem, 1.2vw, 0.8rem);
		margin-top: auto;
		padding-top: 1.3rem;
		border-top: 1px solid rgb(255 255 255 / 0.16);
	}

	.eor-hero__note svg {
		width: 1.45rem;
		height: 1.45rem;
		flex: 0 0 auto;
		fill: none;
		stroke: #c7ff00;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.7;
	}

	.eor-hero__note p {
		max-width: none;
		margin: 0;
		color: rgb(255 255 255 / 0.82);
		font-size: 0.92rem;
		font-weight: 600;
		line-height: 1.4;
		white-space: nowrap;
	}

	.eor-hero__visual {
		width: 100%;
		min-height: clamp(29rem, 44vw, 40rem);
		border-radius: 24px;
		box-shadow: 0 34px 90px -55px rgb(0 0 0 / 0.86);
		container-type: inline-size;
		overflow: visible;
	}

	.eor-hero__media {
		position: absolute;
		inset: 0;
		overflow: hidden;
		border-radius: inherit;
		background: #1a1a1a;
		isolation: isolate;
	}

	.eor-hero__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--eor-hero-object-position, center center);
	}

	.eor-hero__media::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		border-radius: inherit;
		background:
			linear-gradient(90deg, rgb(16 16 16 / 0.06), transparent 45%),
			linear-gradient(0deg, rgb(16 16 16 / 0.18), transparent 46%);
		pointer-events: none;
	}

	.eor-hero__notifications {
		--eor-notifications-scale: 1;
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
	}

	@media (min-width: 1024px) and (max-width: 1099.98px) {
		.eor-hero__notifications {
			--eor-notifications-scale: 0.84;
		}
	}

	@media (min-width: 846px) and (max-width: 1023.98px) {
		.eor-hero__grid {
			--eor-hero-tablet-column-height: clamp(25rem, 46vw, 29rem);
			grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.82fr);
			align-items: center;
			gap: clamp(1.75rem, 3vw, 2.25rem);
		}

		.eor-hero__copy h1 {
			font-size: 3rem;
		}

		.eor-hero__copy p {
			margin-top: 0.75rem;
		}

		:global(.eor-hero__cta) {
			margin-top: 1.75rem;
		}

		.eor-hero__copy {
			align-self: stretch;
			min-height: var(--eor-hero-tablet-column-height);
		}

		.eor-hero__note {
			margin-top: auto;
		}

		.eor-hero__visual {
			width: 92%;
			min-height: var(--eor-hero-tablet-column-height);
			margin-left: auto;
		}

		.eor-hero__notifications {
			--eor-notifications-scale: 0.66;
		}

	}

	@media (min-width: 1100px) and (max-width: 1199.98px) {
		.eor-hero__notifications {
			--eor-notifications-scale: 0.9;
		}
	}

	@media (min-width: 1200px) and (max-width: 1279.98px) {
		.eor-hero__notifications {
			--eor-notifications-scale: 0.96;
		}
	}

	.eor-hero-notification {
		--eor-notification-delay: 0s;
		position: absolute;
		width: 15rem;
		overflow: visible;
		padding: 0.72rem;
		border: 1px solid rgb(255 255 255 / 0.1);
		border-radius: 14px;
		background: rgb(7 8 10 / 0.82);
		box-shadow: 0 0.65rem 1.8rem rgb(0 0 0 / 0.26);
		color: #ffffff;
		font-family: Manrope, sans-serif;
		backdrop-filter: blur(12px);
		opacity: 1;
		transform: scale(var(--eor-notifications-scale));
		animation: none;
	}

	.eor-hero-notification--hire {
		display: flex;
		width: 10rem;
		min-height: 11.25rem;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.72rem;
		padding: 1rem 0.85rem 0.9rem;
		text-align: center;
	}

	.eor-hero-notification--top-right {
		--eor-notification-delay: 0s;
		top: 1.35rem;
		right: -2.7rem;
		z-index: 1;
		transform-origin: top right;
	}

	.eor-hero-notification--bottom-right {
		--eor-notification-delay: 4.6s;
		right: -1.85rem;
		bottom: 1rem;
		z-index: 3;
		transform-origin: bottom right;
	}

	.eor-hero-notification--bottom-left {
		--eor-notification-delay: 2.3s;
		bottom: 0.8rem;
		left: -4.5rem;
		transform-origin: bottom left;
	}

	:global(html[lang='ru']) .eor-hero-notification--bottom-right {
		width: 12rem;
	}

	@media (min-width: 846px) and (max-width: 1023.98px) {
		.eor-hero-notification--top-right {
			right: -1.35rem;
		}
	}

	@keyframes eor-notification-pulse {
		0%,
		6% {
			opacity: 0;
		}

		12% {
			opacity: 1;
		}

		22%,
		40% {
			opacity: 1;
		}

		46%,
		100% {
			opacity: 0;
		}
	}

	.eor-hero-notification__avatar-wrap {
		position: relative;
		display: grid;
		width: 5rem;
		height: 5rem;
		flex: 0 0 auto;
		place-items: center;
		border: 1px solid rgb(203 243 0 / 0.28);
		border-radius: 50%;
		background: rgb(203 243 0 / 0.1);
		color: #cbf300;
	}

	.eor-hero-notification__avatar-wrap svg {
		width: 2.35rem;
		height: 2.35rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.55;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.eor-hero-notification__avatar {
		display: block;
		width: 100%;
		height: 100%;
		border: 1px solid rgb(255 255 255 / 0.18);
		border-radius: 50%;
		object-fit: cover;
	}

	.eor-hero-notification__flag {
		position: absolute;
		right: -0.28rem;
		bottom: -0.18rem;
		display: grid;
		width: 1.58rem;
		height: 1.58rem;
		place-items: center;
		border: 2px solid #101010;
		border-radius: 50%;
		background: #ffffff;
		font-size: 0.75rem;
		line-height: 1;
	}

	.eor-hero-notification__flag img,
	.eor-hero-notification__payment-flag img {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: inherit;
		object-fit: cover;
	}

	.eor-hero-notification__copy {
		display: grid;
		min-width: 0;
		gap: 0.22rem;
		justify-items: center;
	}

	.eor-hero-notification__copy strong {
		color: #ffffff;
		font-size: 1.08rem;
		font-weight: 650;
		line-height: 1.15;
	}

	.eor-hero-notification__copy small {
		color: rgb(255 255 255 / 0.58);
		font-size: 0.7rem;
		font-weight: 500;
		line-height: 1.15;
	}

	.eor-hero-notification__status {
		color: #cbf300 !important;
		font-size: 0.62rem !important;
		font-weight: 700 !important;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.eor-hero-notification--payments {
		width: 18rem;
		padding: 0.82rem 0.9rem;
	}

	.eor-hero-notification__payment-row {
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr);
		align-items: center;
		gap: 0.72rem;
		padding: 0.62rem 0;
	}

	.eor-hero-notification__payment-row + .eor-hero-notification__payment-row {
		border-top: 1px solid rgb(255 255 255 / 0.1);
	}

	.eor-hero-notification__payment-flag {
		display: grid;
		width: 2.5rem;
		height: 2.5rem;
		place-items: center;
		border-radius: 50%;
		border: 1px solid rgb(255 255 255 / 0.14);
		background: rgb(255 255 255 / 0.09);
		overflow: hidden;
	}

	.eor-hero-notification__payment-copy {
		display: grid;
		min-width: 0;
		gap: 0.16rem;
	}

	.eor-hero-notification__payment-copy small {
		color: rgb(255 255 255 / 0.58);
		font-size: 0.76rem;
		line-height: 1.1;
	}

	.eor-hero-notification__payment-copy strong {
		font-size: 1.02rem;
		font-weight: 650;
		line-height: 1.1;
	}

	@media (max-width: 845.98px) {
		.eor-hero__grid {
			gap: clamp(3rem, 7vw, 4rem);
		}

		.eor-hero__copy {
			max-width: 47rem;
			margin-inline: auto;
			align-items: center;
			text-align: center;
		}

		.eor-hero__copy h1 {
			min-height: 0;
			max-width: none;
			white-space: normal;
			overflow-wrap: normal;
			word-break: normal;
			text-wrap: wrap;
		}

		.eor-hero__copy p {
			min-height: 0;
			margin-inline: auto;
		}

		.eor-hero__note {
			width: 100%;
			justify-content: center;
			margin-top: clamp(3.5rem, 7vw, 4rem);
			text-align: center;
		}

		.eor-hero__note p {
			margin: 0;
		}

		:global(.eor-hero__cta) {
			margin-top: clamp(1.75rem, 4vw, 2.25rem);
		}

		.eor-hero__visual {
			max-width: none;
			width: min(100%, 32rem);
			margin: 0 auto;
			min-height: 0;
			aspect-ratio: 7 / 8;
		}

		.eor-hero__image {
			object-position: var(--eor-hero-narrow-object-position, var(--eor-hero-object-position, center center));
		}
	}

	@media (max-width: 640px) {
		.eor-hero {
			padding-top: 7rem;
		}

		.eor-hero__visual {
			min-height: 0;
			border-radius: 18px;
		}

		.eor-hero-notification {
			width: 12rem;
			padding: 0.55rem;
		}

		.eor-hero-notification--hire {
			width: 8.75rem;
			min-height: 9.3rem;
			gap: 0.55rem;
			padding: 0.75rem 0.6rem 0.7rem;
		}

		:global(html[lang='ru']) .eor-hero-notification--bottom-right {
			width: 10.75rem;
		}

		.eor-hero-notification__avatar-wrap {
			width: 4.05rem;
			height: 4.05rem;
		}

		.eor-hero-notification__copy strong {
			font-size: 0.88rem;
		}

		.eor-hero-notification__copy small {
			font-size: 0.62rem;
		}

		.eor-hero-notification__status {
			font-size: 0.56rem !important;
		}

		.eor-hero-notification--payments {
			width: 12.75rem;
			padding: 0.6rem 0.66rem 0.64rem;
		}

		.eor-hero-notification__payment-row {
			grid-template-columns: 2rem minmax(0, 1fr);
			gap: 0.55rem;
			padding: 0.44rem 0;
		}

		.eor-hero-notification__payment-flag {
			width: 2rem;
			height: 2rem;
		}

		.eor-hero-notification__payment-copy small {
			font-size: 0.62rem;
		}

		.eor-hero-notification__payment-copy strong {
			font-size: 0.78rem;
		}

		.eor-hero-notification--top-right {
			top: 0.95rem;
			right: -0.85rem;
		}

		.eor-hero-notification--bottom-right {
			right: -0.75rem;
			bottom: 0.55rem;
		}

		.eor-hero-notification--bottom-left {
			bottom: 2rem;
			left: -0.55rem;
		}

	}

	@media (max-width: 559px) {
		@container (max-width: 420px) {
			.eor-hero__notifications {
				--eor-notifications-scale: 0.82;
			}
		}

		.eor-hero__note svg {
			width: clamp(1.1rem, 4.5vw, 1.45rem);
			height: clamp(1.1rem, 4.5vw, 1.45rem);
		}

		.eor-hero__note p {
			font-size: clamp(0.82rem, 3.4vw, 0.92rem);
		}

		@container (max-width: 360px) {
			.eor-hero__notifications {
				--eor-notifications-scale: 0.78;
			}
		}

		@container (max-width: 300px) {
			.eor-hero__notifications {
				--eor-notifications-scale: 0.64;
			}
		}
	}

	@media (max-width: 767px) {
		.eor-hero__visual {
			width: min(100%, 28rem);
			height: auto;
			aspect-ratio: 56 / 73;
		}
	}

	@media (min-width: 560px) and (max-width: 767px) {
		.eor-hero-notification--top-right,
		.eor-hero-notification--bottom-right {
			right: -1.75rem;
		}

		.eor-hero-notification--bottom-left {
			left: -2.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.eor-hero-notification {
			animation: none;
			opacity: 1;
			transform: scale(var(--eor-notifications-scale));
		}
	}

	.hero-finance-card {
		position: absolute;
		box-sizing: border-box;
		border: 1px solid rgb(255 255 255 / 0.13);
		border-radius: 16px;
		background: rgb(8 9 11 / 0.9);
		box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 0.34);
		color: #fff;
		font-family: Manrope, sans-serif;
		backdrop-filter: blur(14px);
		opacity: 1;
		transform: scale(var(--eor-notifications-scale)) scale(0.92);
		animation: none;
		transition: none;
	}

	.hero-finance-card--income {
		top: 2.2rem;
		right: clamp(-3.5rem, calc(5rem - 7.5vw), -1rem);
		width: 13.5rem;
		padding: 1.05rem 1.1rem 0.8rem;
		transform: scale(var(--eor-notifications-scale)) scale(0.84);
		transform-origin: top right;
	}

	.hero-finance-card--income > small {
		display: block;
		color: rgb(255 255 255 / 0.58);
		font-size: 0.68rem;
	}

	.hero-finance-card--income > strong {
		display: block;
		margin-top: 0.18rem;
		font-size: 2rem;
		font-weight: 500;
		letter-spacing: -0.05em;
		line-height: 1.05;
	}

	.hero-finance-card--income > span {
		display: block;
		margin-top: 0.25rem;
		color: #cbf300;
		font-size: 0.64rem;
		font-weight: 650;
	}

	.hero-income-chart {
		display: grid;
		height: 3.1rem;
		grid-template-columns: repeat(6, 1fr);
		align-items: end;
		gap: 0.28rem;
		margin-top: 0.62rem;
		border-bottom: 1px solid rgb(255 255 255 / 0.14);
	}

	.hero-income-chart i {
		display: block;
		height: var(--bar-height);
		border-radius: 3px 3px 0 0;
		background: linear-gradient(180deg, #d8ff43, #92b600);
	}

	.hero-income-months {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 0.28rem;
		padding-top: 0.26rem;
		color: rgb(255 255 255 / 0.38);
		font-size: 0.43rem;
		text-align: center;
	}

	.hero-finance-card--balance {
		left: -3rem;
		bottom: 1.2rem;
		width: 18.25rem;
		padding: 1rem;
		transform: scale(var(--eor-notifications-scale)) scale(0.88);
		transform-origin: bottom left;
	}

	.hero-balance-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.hero-balance-head strong {
		font-size: 1.28rem;
		font-weight: 600;
	}

