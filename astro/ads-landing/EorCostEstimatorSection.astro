---
import Section from '../components/layout/Section.astro';
import SectionHeader from '../components/layout/SectionHeader.astro';
import Button from '../components/ui/Button.astro';
---

<Section id="payout-calculator" contained={false} spacing="none" class="eor-estimator-section py-20 lg:py-36">
	<div class="eor-estimator-container mx-auto max-w-7xl px-6">
		<div class="eor-estimator-shell">
			<div class="eor-estimator-content">
				<SectionHeader
					align="left"
					class="eor-estimator-copy"
					title={{ text: 'Always Know What You’ll Get', translateKey: 'costEstimator.title' }}
				/>

				<ul class="eor-estimator-details">
					<li><span aria-hidden="true">✓</span><p data-translate="costEstimator.details.paymentFee">Garna charges 5% when your client pays by bank transfer and 8% when they pay by card</p></li>
					<li><span aria-hidden="true">✓</span><p data-translate="costEstimator.details.feePayer">Choose who pays the fee — you or your client</p></li>
					<li><span aria-hidden="true">✓</span><p data-translate="costEstimator.details.withdrawalMethods">Withdraw in USD, EUR, local currency, or crypto</p></li>
					<li><span aria-hidden="true">✓</span><p data-translate="costEstimator.details.withdrawalFee">Withdrawals are always free — 0% fee</p></li>
				</ul>

				<Button
					href="https://app.garna.io/en/auth/sign-up"
					size="header"
					variant="primary"
					effect="none"
					icon="none"
					data-garna-signup
				>
					<span data-translate="costEstimator.button">Create account</span>
				</Button>
			</div>

			<form class="eor-estimator-card" action="#" onsubmit="event.preventDefault();" data-payout-calculator>
				<div class="eor-estimator-card__header">
					<h3 data-translate="costEstimator.form.title">Payout Calculator</h3>
					<div class="eor-estimator-segments eor-estimator-segments--currency" role="radiogroup" aria-label="Currency" data-translate-aria-label="costEstimator.form.currency">
						<label><input type="radio" name="payout-currency" value="EUR" /><span>€ EUR</span></label>
						<label><input type="radio" name="payout-currency" value="USD" checked /><span>$ USD</span></label>
					</div>
				</div>

				<div class="eor-estimator-group">
					<p id="payout-fee-payer-label" data-translate="costEstimator.form.feePaidBy">Fee paid by</p>
					<div class="eor-estimator-segments" role="radiogroup" aria-labelledby="payout-fee-payer-label">
						<label><input type="radio" name="payout-fee-payer" value="freelancer" /><span data-translate="costEstimator.form.freelancer">Freelancer</span></label>
						<label><input type="radio" name="payout-fee-payer" value="client" checked /><span data-translate="costEstimator.form.client">Client</span></label>
					</div>
				</div>

				<div class="eor-estimator-group">
					<p id="payout-method-label" data-translate="costEstimator.form.paymentMethod">How your client pays</p>
					<div class="eor-estimator-segments" role="radiogroup" aria-labelledby="payout-method-label">
						<label><input type="radio" name="payout-method" value="bank" checked /><span data-translate="costEstimator.form.bank">Bank transfer</span></label>
						<label><input type="radio" name="payout-method" value="card" /><span data-translate="costEstimator.form.card">Card</span></label>
					</div>
				</div>

				<label class="eor-estimator-amount-field">
					<span data-translate="costEstimator.form.amount">Amount you’re charging</span>
					<div class="eor-estimator-amount">
						<b data-payout-symbol>$</b>
						<input type="number" min="0" step="0.01" inputmode="decimal" value="1000" aria-label="Amount you’re charging" data-translate-aria-label="costEstimator.form.amount" data-payout-amount />
					</div>
				</label>

				<div class="eor-estimator-results" aria-live="polite">
					<div><span data-translate="costEstimator.form.youReceive">You receive</span><strong data-payout-receive>$1,000</strong></div>
					<div><span data-translate="costEstimator.form.clientPays">Client pays</span><strong data-payout-client>$1,050</strong></div>
				</div>

				<p class="eor-estimator-note" data-translate="costEstimator.form.note">Garna fee: 5% by bank transfer or 8% by card. Withdrawal fee: 0%.</p>
			</form>
		</div>
	</div>
</Section>

<style>
	:global(.eor-estimator-section) {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		background: #101010;
	}

	:global(.eor-estimator-section)::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -2;
		background: url("/pages/payroll-solution-new/assets/eor-cost-estimator-business-desk-v9.png") center center / cover no-repeat;
	}

	:global(.eor-estimator-section)::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: rgb(0 0 0 / 0.55);
	}

	.eor-estimator-container { position: relative; }

	.eor-estimator-shell {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(27rem, 0.95fr);
		gap: clamp(3rem, 6vw, 6rem);
		align-items: center;
	}

	.eor-estimator-content { max-width: 39rem; }

	:global(.eor-estimator-copy) { max-width: 34rem; }

	.eor-estimator-details {
		--detail-font-size: clamp(1.125rem, 1.6vw, 1.25rem);
		--detail-line-height: clamp(1.828125rem, 2.6vw, 2.03125rem);
		display: grid;
		gap: 0;
		margin: 1.75rem 0 2rem;
		padding: 0;
		list-style: none;
	}

	.eor-estimator-details li {
		display: grid;
		grid-template-columns: 1.45rem 1fr;
		gap: 0.75rem;
		align-items: start;
		padding: 0.85rem 0;
	}

	.eor-estimator-details span {
		display: inline-flex;
		width: 1.25rem;
		height: 1.25rem;
		margin-top: calc((var(--detail-line-height) - 1.25rem) / 2);
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		background: #cbf300;
		color: #080808;
		font: 800 0.72rem/1 Manrope, sans-serif;
	}

	.eor-estimator-details p {
		color: rgb(255 255 255 / 0.8);
		font-family: Manrope, sans-serif;
		font-size: var(--detail-font-size);
		font-weight: 400;
		line-height: var(--detail-line-height);
	}

	.eor-estimator-card {
		position: relative;
		display: grid;
		gap: 1.2rem;
		width: 100%;
		max-width: 36rem;
		justify-self: end;
		border: 1px solid rgb(255 255 255 / 0.1);
		border-radius: 18px;
		background: rgb(26 26 26 / 0.9);
		backdrop-filter: blur(18px);
		padding: clamp(1.15rem, 2vw, 1.55rem);
		box-shadow: 0 28px 70px -58px rgb(0 0 0 / 0.9);
		color: #fff;
		text-align: left;
	}

	.eor-estimator-card__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.eor-estimator-card h3 {
		color: #fff;
		font-family: Manrope, sans-serif;
		font-size: clamp(1.35rem, 1.8vw, 1.75rem);
		font-weight: 500;
		line-height: 1.1;
		letter-spacing: 0;
		text-align: left;
	}

	.eor-estimator-group {
		display: grid;
		gap: 0.7rem;
		min-width: 0;
		margin: 0;
	}

	.eor-estimator-group > p,
	.eor-estimator-amount-field > span {
		width: 100%;
		color: #fff;
		font-family: Manrope, sans-serif;
		font-size: 0.82rem;
		font-weight: 600;
		line-height: 1.2;
		text-align: left;
	}

	.eor-estimator-segments {
		position: relative;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		isolation: isolate;
		overflow: hidden;
		border: 1px solid rgb(255 255 255 / 0.1);
		border-radius: 10px;
		background: #101010;
	}

	.eor-estimator-segments::before {
		content: "";
		position: absolute;
		z-index: -1;
		inset: 0 auto 0 0;
		width: 50%;
		border-radius: 9px;
		background: #cbf300;
		transition: transform 180ms ease;
	}

	.eor-estimator-segments:has(label:nth-child(2) input:checked)::before {
		transform: translateX(100%);
	}

	.eor-estimator-segments label {
		position: relative;
		min-width: 0;
		cursor: pointer;
	}

	.eor-estimator-segments input {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
	}

	.eor-estimator-segments span,
	.eor-estimator-amount {
		display: flex;
		width: 100%;
		min-height: 2.75rem;
		align-items: center;
		border: 0;
		background: transparent;
		color: rgb(255 255 255 / 0.64);
		font-family: Manrope, sans-serif;
		font-size: 0.95rem;
		font-weight: 600;
		transition: color 160ms ease;
	}

	.eor-estimator-segments span {
		justify-content: center;
		padding: 0.5rem 0.85rem;
		text-align: center;
	}

	.eor-estimator-segments input:checked + span {
		color: #080808;
	}

	.eor-estimator-segments input:focus-visible + span {
		outline: 2px solid #cbf300;
		outline-offset: -3px;
	}

	.eor-estimator-segments--currency {
		flex: 0 0 auto;
		width: 9.25rem;
		border-radius: 9px;
	}

	.eor-estimator-segments--currency span {
		min-height: 2.25rem;
		padding: 0.35rem 0.6rem;
		font-size: 0.78rem;
	}

	.eor-estimator-segments--currency::before {
		inset: 0 auto 0 0;
		width: 50%;
		border-radius: 8px;
	}

	.eor-estimator-amount-field { display: grid; gap: 0.7rem; }

	.eor-estimator-amount {
		min-height: calc(2.75rem + 2px);
		border: 1px solid rgb(255 255 255 / 0.1);
		border-radius: 10px;
		background: #101010;
		gap: 0.75rem;
		padding: 0 1rem;
	}

	.eor-estimator-amount:focus-within {
		border-color: rgb(203 243 0 / 0.68);
		box-shadow: 0 0 0 1px rgb(203 243 0 / 0.14);
	}

	.eor-estimator-amount b {
		color: #cbf300;
		font-size: 1.05rem;
		font-weight: 600;
	}

	.eor-estimator-amount input {
		width: 100%;
		border: 0;
		outline: 0;
		background: transparent;
		color: #fff;
		font: 600 1rem/1 Manrope, sans-serif;
	}

	.eor-estimator-amount input::-webkit-inner-spin-button { appearance: none; }

	.eor-estimator-results {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.eor-estimator-results > div {
		display: grid;
		gap: 0.45rem;
		border: 1px solid rgb(255 255 255 / 0.08);
		border-radius: 10px;
		background: #101010;
		padding: 0.95rem 0.9rem;
	}

	.eor-estimator-results span {
		color: rgb(255 255 255 / 0.52);
		font: 500 0.78rem/1.2 Manrope, sans-serif;
	}

	.eor-estimator-results strong {
		min-width: 0;
		overflow: hidden;
		color: #fff;
		font: 500 clamp(1.3rem, 2.4vw, 1.75rem)/1 Manrope, sans-serif;
		letter-spacing: -0.03em;
		text-overflow: ellipsis;
	}

	.eor-estimator-results > div:first-child strong { color: #cbf300; }

	.eor-estimator-note {
		color: rgb(255 255 255 / 0.45);
		font: 400 0.75rem/1.5 Manrope, sans-serif;
	}

	@media (max-width: 560px) {
		.eor-estimator-card { gap: 1rem; }
		.eor-estimator-card__header { align-items: flex-start; }
		.eor-estimator-segments span { min-height: 2.65rem; padding-inline: 0.45rem; font-size: 0.8rem; }
		.eor-estimator-segments--currency { width: 8.4rem; }
		.eor-estimator-segments--currency span { min-height: 2.15rem; font-size: 0.72rem; }
		.eor-estimator-results { grid-template-columns: 1fr; }
	}

	@media (max-width: 900px) {
		.eor-estimator-shell {
			grid-template-columns: 1fr;
			gap: 2.75rem;
		}

		.eor-estimator-content,
		:global(.eor-estimator-copy) {
			max-width: 44rem;
		}

		.eor-estimator-card {
			justify-self: center;
		}
	}
</style>

<script>
	const initializePayoutCalculators = () => {
		for (const form of document.querySelectorAll('[data-payout-calculator]')) {
			if (!(form instanceof HTMLFormElement) || form.dataset.ready === 'true') continue;
			form.dataset.ready = 'true';

			const amountInput = form.querySelector('[data-payout-amount]');
			const receiveOutput = form.querySelector('[data-payout-receive]');
			const clientOutput = form.querySelector('[data-payout-client]');
			const symbolOutput = form.querySelector('[data-payout-symbol]');

			const calculate = () => {
				if (!(amountInput instanceof HTMLInputElement)) return;
				const currency = form.querySelector('input[name="payout-currency"]:checked')?.getAttribute('value') || 'USD';
				const feePayer = form.querySelector('input[name="payout-fee-payer"]:checked')?.getAttribute('value') || 'client';
				const method = form.querySelector('input[name="payout-method"]:checked')?.getAttribute('value') || 'bank';
				const amount = Math.max(0, Number.parseFloat(amountInput.value) || 0);
				const feeRate = method === 'card' ? 0.08 : 0.05;
				const received = feePayer === 'freelancer' ? amount * (1 - feeRate) : amount;
				const clientPays = feePayer === 'client' ? amount * (1 + feeRate) : amount;
				const locale = document.documentElement.lang || 'en';
				const formatter = new Intl.NumberFormat(locale, { style: 'currency', currency, minimumFractionDigits: 0, maximumFractionDigits: 2 });

				if (receiveOutput instanceof HTMLElement) receiveOutput.textContent = formatter.format(received);
				if (clientOutput instanceof HTMLElement) clientOutput.textContent = formatter.format(clientPays);
				if (symbolOutput instanceof HTMLElement) symbolOutput.textContent = currency === 'EUR' ? '€' : '$';
			};

			form.addEventListener('input', calculate);
			form.addEventListener('change', calculate);
			calculate();
		}
	};

	initializePayoutCalculators();
	document.addEventListener('astro:page-load', initializePayoutCalculators);
</script>
