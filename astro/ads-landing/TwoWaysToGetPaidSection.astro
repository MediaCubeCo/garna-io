---
import TabbedImageFeatureSection from '../components/sections/TabbedImageFeatureSection.astro';

const panels = [
	{
		key: 'invoice',
		tab: { text: 'Invoice', translateKey: 'twoWays.tabs.invoice' },
		image: '/images/ads-invoice-home-freelancer-upscaled-v3.jpg',
		imagePosition: 'center top',
		imagePositionMobile: '72% top',
		tag: { text: 'For completed work', translateKey: 'twoWays.panels.invoice.tag' },
		title: { text: 'Send a professional client invoice', translateKey: 'twoWays.panels.invoice.title' },
		description: {
			text: 'Create an invoice in Garna and send it to your client. They follow clear payment instructions, while you keep the invoice and payment details together',
			translateKey: 'twoWays.panels.invoice.description',
		},
		cta: { text: 'Create invoice', translateKey: 'twoWays.panels.invoice.cta', href: 'https://app.garna.io/en/auth/sign-up' },
	},
	{
		key: 'transfer',
		tab: { text: 'Direct Transfer', translateKey: 'twoWays.tabs.transfer' },
		image: '/images/ads-direct-transfer-home-upscaled.jpg',
		copyWidthTablet: '500px',
		imagePosition: 'center 48%',
		imagePositionMobile: '62% 48%',
		tag: { text: 'For agreed client payments', translateKey: 'twoWays.panels.transfer.tag' },
		title: { text: 'Receive a direct business payment', translateKey: 'twoWays.panels.transfer.title' },
		description: {
			text: 'Share the Garna payment details for the agreed amount and currency. Once the client pays, the funds are credited to your Garna balance',
			translateKey: 'twoWays.panels.transfer.description',
		},
		cta: { text: 'Create account', translateKey: 'twoWays.panels.transfer.cta', href: 'https://app.garna.io/en/auth/sign-up' },
	},
];
---

<TabbedImageFeatureSection
	id="two-ways-to-get-paid"
	title={{ text: 'Two Ways to Get Paid', translateKey: 'twoWays.title' }}
	description={{ text: 'Choose the right payment flow for each client and project', translateKey: 'twoWays.description' }}
	panels={panels}
	tabsAriaLabel={{ text: 'Ways to get paid with Garna', translateKey: 'twoWays.tabs.ariaLabel' }}
/>

<style is:global>
	@media (min-width: 801px) {
		#two-ways-to-get-paid-panel-invoice .tabbed-image-feature__image {
			transform: translateX(3.6%) scale(1.08);
			transform-origin: center top;
		}
	}
</style>
