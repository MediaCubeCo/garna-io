---
import Section from '../components/layout/Section.astro';
import Card from '../components/ui/Card.astro';

const problems = [
	{
		problem: "My client is ready to pay, but doesn't know how to send money to my country",
		problemKey: 'problems.items.paymentRoute.problem',
		solution: 'The client pays through Garna, then the funds appear in your Garna balance',
		solutionKey: 'problems.items.paymentRoute.solution',
		avatar: '/pages/payroll-solution-new/assets/contractor-avatar-sarah-v1.webp',
	},
	{
		problem: "My client can only pay a legal entity, but I'm an individual",
		problemKey: 'problems.items.legalEntity.problem',
		solution: 'Invoice business clients through Garna without opening your own company',
		solutionKey: 'problems.items.legalEntity.solution',
		avatar: '/pages/payroll-solution-new/assets/contractor-avatar-maya-v2.webp',
	},
	{
		problem: 'My client and I need an official invoice and payment documents',
		problemKey: 'problems.items.documents.problem',
		solution: 'Create the invoice in Garna and keep the payment documents in one place',
		solutionKey: 'problems.items.documents.solution',
		avatar: '/pages/payroll-solution-new/assets/contractor-avatar-alex-v2.webp',
	},
	{
		problem: 'I work with several international clients and need one clear workflow',
		problemKey: 'problems.items.workflow.problem',
		solution: 'Manage invoices, incoming payments, and withdrawals from one Garna account',
		solutionKey: 'problems.items.workflow.solution',
		avatar: '/pages/payroll-solution-new/assets/eor-hero-avatar-samantha-v3.png',
	},
	{
		problem: "I'm losing money to unclear fees and unexpected charges",
		problemKey: 'problems.items.fees.problem',
		solution: 'See payment details and fees before you confirm each transaction',
		solutionKey: 'problems.items.fees.solution',
		avatar: '/images/creator-avatar-headphones.jpg',
	},
] as const;
---

<Section
	id="problems-we-solve"
	spacing="spacious"
	title={{ text: 'Problems We Solve', translateKey: 'problems.title' }}
	headerClass="mb-14 max-w-4xl lg:mb-16"
>
	<div class="problems-grid">
		{problems.map((item, index) => (
			<Card class={`problem-chat-card p-6 ${index === 3 ? 'problem-chat-card--bottom-left' : index === 4 ? 'problem-chat-card--bottom-right' : ''}`}>
				<div class="problem-chat problem-chat--customer">
					<span class="problem-avatar" aria-hidden="true">
						<img src={item.avatar} alt="" loading="lazy" />
					</span>
					<p data-translate={item.problemKey}>{item.problem}</p>
				</div>

				<div class="problem-chat problem-chat--garna">
					<p data-translate={item.solutionKey}>{item.solution}</p>
					<span class="problem-garna-mark" aria-hidden="true">
						<img src="/images/garna-g-mark-dark.svg" alt="" />
					</span>
				</div>
			</Card>
		))}
	</div>
</Section>

<style>
	:global(.problems-grid) {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: 18px;
	}

	:global(.problem-chat-card) {
		position: relative;
		display: flex;
		min-height: 312px;
		grid-column: span 2;
		flex-direction: column;
		justify-content: center;
		gap: 26px;
	}

	:global(.problem-chat-card--bottom-left) {
		grid-column: 2 / span 2;
	}

	:global(.problem-chat-card--bottom-right) {
		grid-column: 4 / span 2;
	}

	.problem-chat {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: flex-end;
		gap: 11px;
	}

	.problem-chat p {
		margin: 0;
		padding: 15px 17px;
		border-radius: 16px;
		font: 500 14px / 1.48 Manrope, sans-serif;
	}

	.problem-chat--customer p {
		border-bottom-left-radius: 5px;
		background: rgba(255, 255, 255, 0.075);
		color: #f4f4f5;
	}

	.problem-chat--garna {
		justify-content: flex-end;
	}

	.problem-chat--garna p {
		border: 1px solid rgba(203, 243, 0, 0.16);
		border-bottom-right-radius: 5px;
		background: rgba(203, 243, 0, 0.075);
		color: #e4e4e7;
	}

	.problem-avatar,
	.problem-garna-mark {
		display: grid;
		width: 42px;
		height: 42px;
		flex: 0 0 42px;
		place-items: center;
		border-radius: 50%;
	}

	.problem-avatar {
		border: 1px solid rgba(255, 255, 255, 0.09);
		background: #202020;
		overflow: hidden;
	}

	.problem-avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.problem-garna-mark {
		background: #cbf300;
	}

	.problem-garna-mark img {
		width: 13px;
		height: 21px;
	}

	@media (max-width: 1023px) {
		:global(.problems-grid) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		:global(.problem-chat-card),
		:global(.problem-chat-card--bottom-left),
		:global(.problem-chat-card--bottom-right) {
			grid-column: auto;
		}

		:global(.problem-chat-card--bottom-right) {
			width: calc(50% - 9px);
			grid-column: 1 / -1;
			justify-self: center;
		}
	}

	@media (max-width: 640px) {
		:global(.problems-grid) {
			grid-template-columns: 1fr;
		}

		:global(.problem-chat-card),
		:global(.problem-chat-card--bottom-right) {
			width: auto;
			min-height: 280px;
			grid-column: auto;
		}

		.problem-chat p {
			font-size: 13px;
		}
	}
</style>
