---
import Section from '../components/layout/Section.astro';
import Button from '../components/ui/Button.astro';

const problems = [
	{ title: 'Getting Paid Across Borders', titleKey: 'problems.items.paymentRoute.title', problem: "My client is ready to pay, but doesn't know how to send money to my country", problemKey: 'problems.items.paymentRoute.problem', solution: 'The client pays through Garna, then the funds appear in your Garna balance', solutionKey: 'problems.items.paymentRoute.solution', avatar: '/pages/payroll-solution-new/assets/contractor-avatar-sarah-v1.webp' },
	{ title: 'No Legal Entity Required', titleKey: 'problems.items.legalEntity.title', problem: "My client can only pay a legal entity, but I'm an individual", problemKey: 'problems.items.legalEntity.problem', solution: 'Invoice business clients through Garna without opening your own company', solutionKey: 'problems.items.legalEntity.solution', avatar: '/pages/payroll-solution-new/assets/contractor-avatar-maya-v2.webp' },
	{ title: 'Business-Ready Documents', titleKey: 'problems.items.documents.title', problem: 'My client and I need an official invoice and payment documents', problemKey: 'problems.items.documents.problem', solution: 'Create the invoice in Garna and keep the payment documents in one place', solutionKey: 'problems.items.documents.solution', avatar: '/pages/payroll-solution-new/assets/contractor-avatar-alex-v2.webp' },
	{ title: 'Managing Multiple Clients', titleKey: 'problems.items.workflow.title', problem: 'I work with several international clients and need one clear workflow', problemKey: 'problems.items.workflow.problem', solution: 'Manage invoices, incoming payments, and withdrawals from one Garna account', solutionKey: 'problems.items.workflow.solution', avatar: '/pages/payroll-solution-new/assets/eor-hero-avatar-samantha-v3.png' },
	{ title: 'Clear Fees Upfront, No Surprises', titleKey: 'problems.items.fees.title', problem: "I'm losing money to unclear fees and unexpected charges", problemKey: 'problems.items.fees.problem', solution: 'See payment details and fees before you confirm each transaction', solutionKey: 'problems.items.fees.solution', avatar: '/images/creator-avatar-headphones.jpg' },
] as const;

const carouselSlides = [
	{ ...problems[problems.length - 1], index: problems.length - 1 },
	...problems.map((problem, index) => ({ ...problem, index })),
];
---

<Section id="problems-we-solve" spacing="default" contentClass="problems-carousel-content">
	<div class="problems-carousel" data-problems-carousel>
		<div class="problems-carousel__copy">
			<h2 data-translate="problems.title">Problems We Solve</h2>
			<p data-garna-subtitle data-translate="problems.description">Five common barriers between independent professionals and international client payments&nbsp;— solved in one Garna workflow</p>
			<Button href="https://app.garna.io/en/auth/sign-up" size="header" variant="primary" effect="none" icon="none" data-garna-signup>
				<span data-translate="problems.button">Create account</span>
			</Button>
		</div>

		<div class="problems-carousel__viewport">
			<div class="problems-carousel__rail" data-problems-rail>
				{carouselSlides.map((item, sequenceIndex) => (
					<button type="button" class:list={['problem-carousel-card', 'garna-glass-card', sequenceIndex === 1 && 'is-active']} data-problem-slide data-card-glow="true" data-index={item.index} data-sequence={sequenceIndex} aria-label={item.title} data-translate-aria-label={item.titleKey}>
						<span class="problem-carousel-card__header">
							<small>{String(item.index + 1).padStart(2, '0')}</small>
							<strong data-translate={item.titleKey}>{item.title}</strong>
						</span>
						<span class="problem-carousel-card__conversation">
							<span class="problem-chat problem-chat--customer">
								<span class="problem-avatar" aria-hidden="true"><img src={item.avatar} alt="" loading="lazy" /></span>
								<span data-translate={item.problemKey}>{item.problem}</span>
							</span>
							<span class="problem-chat problem-chat--garna">
								<span data-translate={item.solutionKey}>{item.solution}</span>
								<span class="problem-garna-mark" aria-hidden="true"><img src="/images/garna-g-mark-dark.svg" alt="" /></span>
							</span>
						</span>
					</button>
				))}
			</div>
			<div class="problems-carousel__controls">
				{problems.map((item, index) => (
					<button type="button" class:list={index === 0 && 'is-active'} data-problem-dot data-index={index} aria-label={item.title} data-translate-aria-label={item.titleKey} aria-current={index === 0 ? 'true' : undefined}></button>
				))}
			</div>
		</div>
	</div>
</Section>

<script define:vars={{ problemCount: problems.length }}>
	for (const carousel of document.querySelectorAll('[data-problems-carousel]')) {
		if (!(carousel instanceof HTMLElement) || carousel.dataset.ready === 'true') continue;
		carousel.dataset.ready = 'true';
		const rail = carousel.querySelector('[data-problems-rail]');
		const viewport = carousel.querySelector('.problems-carousel__viewport');
		const slides = [...carousel.querySelectorAll('[data-problem-slide]')];
		const realSlides = slides.slice(1, problemCount + 1);
		const dots = [...carousel.querySelectorAll('[data-problem-dot]')];
		const scrollArea = carousel.parentElement;
		const siteHeader = document.querySelector('.garna-header');
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const compactLayout = window.matchMedia('(max-width: 1079.98px)');
		const verticalLayout = window.matchMedia('(max-width: 699.98px)');
		let activeIndex = 0;
		let freeScroll = false;
		let sizeDirty = true;
		let measuredWidth = 0;
		let frame = 0;
		let dragPointerId = -1;
		let dragStartX = 0;
		let dragStartScrollLeft = 0;
		let didDrag = false;
		let suppressClick = false;

		const getStickyTop = () => {
			const headerHeight = siteHeader instanceof HTMLElement ? siteHeader.getBoundingClientRect().height : 0;
			const availableHeight = window.innerHeight - headerHeight;
			return headerHeight + ((availableHeight - carousel.getBoundingClientRect().height) / 2);
		};
		const syncCardHeight = () => {
			if (!compactLayout.matches) {
				carousel.style.removeProperty('--problem-card-height');
				slides.forEach((slide) => {
					if (slide instanceof HTMLElement) slide.style.setProperty('--problem-card-unit', `${slide.offsetWidth / 100}px`);
				});
				return;
			}
			if (viewport instanceof HTMLElement) viewport.style.removeProperty('zoom');
			let requiredHeight = 0;
			realSlides.forEach((slide) => {
				if (!(slide instanceof HTMLElement)) return;
				const header = slide.querySelector('.problem-carousel-card__header');
				const conversation = slide.querySelector('.problem-carousel-card__conversation');
				if (!(header instanceof HTMLElement) || !(conversation instanceof HTMLElement)) return;
				const style = getComputedStyle(slide);
				const naturalHeight = header.scrollHeight
					+ conversation.scrollHeight
					+ (Number.parseFloat(style.rowGap) || 0)
					+ (Number.parseFloat(style.paddingTop) || 0)
					+ (Number.parseFloat(style.paddingBottom) || 0)
					+ (Number.parseFloat(style.borderTopWidth) || 0)
					+ (Number.parseFloat(style.borderBottomWidth) || 0);
				requiredHeight = Math.max(requiredHeight, naturalHeight);
			});
			if (requiredHeight) carousel.style.setProperty('--problem-card-height', `${Math.ceil(requiredHeight + 1)}px`);
		};
		const syncStickyTop = () => carousel.style.setProperty('--problems-carousel-sticky-top', `${getStickyTop()}px`);
		const updateDots = (progress = 1) => {
			dots.forEach((dot, index) => {
				dot.classList.toggle('is-active', index === activeIndex);
				if (index === activeIndex) dot.setAttribute('aria-current', 'true'); else dot.removeAttribute('aria-current');
				if (dot instanceof HTMLElement) dot.style.setProperty('--problem-dot-progress', String(index === activeIndex ? progress : 0));
			});
		};
		const scrollNativeToIndex = (index, behavior = 'smooth') => {
			if (!(viewport instanceof HTMLElement)) return;
			const target = realSlides[index];
			if (!(target instanceof HTMLElement)) return;
			viewport.scrollTo({ left: target.offsetLeft, behavior });
		};
		const syncViewportScrollable = () => {
			if (!(viewport instanceof HTMLElement)) return;
			viewport.toggleAttribute('data-scrollable', freeScroll && viewport.scrollWidth > viewport.clientWidth + 1);
		};
		const syncLayoutMode = () => {
			const headerHeight = siteHeader instanceof HTMLElement ? siteHeader.getBoundingClientRect().height : 0;
			const copy = carousel.querySelector('.problems-carousel__copy');
			const rowGap = Number.parseFloat(getComputedStyle(carousel).rowGap) || 0;
			const copyHeight = copy instanceof HTMLElement ? copy.offsetHeight : 0;
			const viewportHeight = viewport instanceof HTMLElement ? viewport.offsetHeight : 0;
			const requiredHeight = verticalLayout.matches
				? copyHeight + viewportHeight + rowGap
				: Math.max(copyHeight, viewportHeight);
			const shouldFreeScroll = compactLayout.matches && requiredHeight > window.innerHeight - headerHeight;
			if (shouldFreeScroll === freeScroll) return;
			freeScroll = shouldFreeScroll;
			carousel.dataset.shortViewport = String(freeScroll);
			if (scrollArea instanceof HTMLElement) scrollArea.dataset.shortViewport = String(freeScroll);
			if (freeScroll) {
				slides.forEach((slide) => {
					if (slide instanceof HTMLElement) slide.style.marginRight = '0px';
				});
				requestAnimationFrame(() => {
					syncViewportScrollable();
					scrollNativeToIndex(activeIndex, 'auto');
				});
			} else if (viewport instanceof HTMLElement) {
				viewport.removeAttribute('data-scrollable');
				viewport.removeAttribute('data-dragging');
				dragPointerId = -1;
			}
		};
		const updateNativeContent = () => {
			if (!(viewport instanceof HTMLElement)) return;
			const viewportCenter = viewport.scrollLeft + viewport.clientWidth / 2;
			let nearestIndex = 0;
			let nearestDistance = Number.POSITIVE_INFINITY;
			realSlides.forEach((slide, index) => {
				if (!(slide instanceof HTMLElement)) return;
				const distance = Math.abs(slide.offsetLeft + slide.offsetWidth / 2 - viewportCenter);
				if (distance < nearestDistance) { nearestDistance = distance; nearestIndex = index; }
			});
			activeIndex = nearestIndex;
			realSlides.forEach((slide, index) => slide.classList.toggle('is-active', index === activeIndex));
			updateDots();
		};
		const updateContent = (nextIndex, progress = 1) => {
			activeIndex = (nextIndex + problemCount) % problemCount;
			const activeSlide = slides[activeIndex + 1];
			slides.forEach((slide) => {
				if (!(slide instanceof HTMLElement)) return;
				const isActive = Number(slide.dataset.sequence) === activeIndex + 1;
				slide.classList.toggle('is-active', isActive);
				const scaleCompensation = !isActive ? slide.offsetWidth * .06 : 0;
				slide.style.marginRight = `${-scaleCompensation}px`;
			});
			if (rail instanceof HTMLElement && activeSlide instanceof HTMLElement) rail.style.transform = `translateX(${-activeSlide.offsetLeft + 1}px)`;
			updateDots(progress);
		};
		const render = () => {
			frame = 0;
			if (sizeDirty) { syncCardHeight(); sizeDirty = false; }
			syncLayoutMode();
			if (freeScroll) { syncViewportScrollable(); updateNativeContent(); return; }
			syncStickyTop();
			if (!(scrollArea instanceof HTMLElement)) return;
			if (reduceMotion.matches) { updateContent(activeIndex); return; }
			const rect = scrollArea.getBoundingClientRect();
			const stickyTop = getStickyTop();
			const scrollable = Math.max(1, rect.height - stickyTop - carousel.offsetHeight);
			const progress = Math.min(1, Math.max(0, (stickyTop - rect.top) / scrollable));
			const progressStep = progress * problemCount;
			const nextIndex = progress >= 1 ? problemCount - 1 : Math.floor(progressStep);
			updateContent(nextIndex, progress >= 1 ? 1 : progressStep - nextIndex);
		};
		const schedule = () => { if (!frame) frame = requestAnimationFrame(render); };
		const scrollToIndex = (index) => {
			const nextIndex = Math.min(problemCount - 1, Math.max(0, index));
			if (freeScroll) { scrollNativeToIndex(nextIndex, reduceMotion.matches ? 'auto' : 'smooth'); return; }
			if (!(scrollArea instanceof HTMLElement)) return;
			const rect = scrollArea.getBoundingClientRect();
			const scrollable = Math.max(1, rect.height - getStickyTop() - carousel.offsetHeight);
			window.scrollTo({ top: window.scrollY + rect.top - getStickyTop() + scrollable * (nextIndex / problemCount), behavior: reduceMotion.matches ? 'auto' : 'smooth' });
		};
		const stopDragging = (event) => {
			if (!(viewport instanceof HTMLElement) || event.pointerId !== dragPointerId) return;
			if (didDrag) {
				suppressClick = true;
				setTimeout(() => { suppressClick = false; }, 0);
			}
			if (viewport.hasPointerCapture(event.pointerId)) viewport.releasePointerCapture(event.pointerId);
			dragPointerId = -1;
			didDrag = false;
			viewport.removeAttribute('data-dragging');
		};
		viewport?.addEventListener('pointerdown', (event) => {
			if (
				!(viewport instanceof HTMLElement) ||
				event.pointerType !== 'mouse' ||
				event.button !== 0 ||
				!freeScroll ||
				!viewport.hasAttribute('data-scrollable') ||
				!(event.target instanceof Element && event.target.closest('[data-problems-rail]'))
			) return;
			dragPointerId = event.pointerId;
			dragStartX = event.clientX;
			dragStartScrollLeft = viewport.scrollLeft;
			didDrag = false;
			viewport.setPointerCapture(event.pointerId);
			viewport.setAttribute('data-dragging', 'true');
		});
		viewport?.addEventListener('pointermove', (event) => {
			if (!(viewport instanceof HTMLElement) || event.pointerId !== dragPointerId) return;
			const distance = event.clientX - dragStartX;
			if (Math.abs(distance) > 3) didDrag = true;
			if (!didDrag) return;
			event.preventDefault();
			viewport.scrollLeft = dragStartScrollLeft - distance;
		});
		viewport?.addEventListener('pointerup', stopDragging);
		viewport?.addEventListener('pointercancel', stopDragging);
		viewport?.addEventListener('lostpointercapture', () => {
			dragPointerId = -1;
			didDrag = false;
			if (viewport instanceof HTMLElement) viewport.removeAttribute('data-dragging');
		});
		viewport?.addEventListener('click', (event) => {
			if (!suppressClick) return;
			event.preventDefault();
			event.stopPropagation();
		}, true);
		viewport?.addEventListener('dragstart', (event) => {
			if (freeScroll && event.target instanceof Element && event.target.closest('[data-problems-rail]')) event.preventDefault();
		});
		dots.forEach((dot) => dot.addEventListener('click', () => scrollToIndex(Number(dot.dataset.index || 0))));
		slides.forEach((slide) => slide.addEventListener('click', () => scrollToIndex(Number(slide.dataset.index || 0))));
		window.addEventListener('scroll', schedule, { passive: true });
		window.addEventListener('resize', () => { sizeDirty = true; schedule(); }, { passive: true });
		viewport?.addEventListener('scroll', schedule, { passive: true });
		reduceMotion.addEventListener?.('change', schedule);
		new MutationObserver(() => { sizeDirty = true; schedule(); }).observe(carousel, { subtree: true, childList: true, characterData: true });
		new ResizeObserver(() => {
			if (carousel.clientWidth === measuredWidth) return;
			measuredWidth = carousel.clientWidth;
			sizeDirty = true;
			schedule();
		}).observe(carousel);
		window.addEventListener('load', () => { sizeDirty = true; schedule(); }, { once: true });
		document.fonts?.ready.then(() => { sizeDirty = true; schedule(); });
		render();
		requestAnimationFrame(() => requestAnimationFrame(() => { sizeDirty = true; schedule(); }));
	}
</script>

<style>
	:global(.problems-carousel-content) { min-height: 300vh; }
	.problems-carousel { position: sticky; top: var(--problems-carousel-sticky-top, 5rem); display: grid; grid-template-columns: minmax(17rem, .82fr) minmax(0, 1.18fr); min-height: 34rem; align-items: center; gap: clamp(2.5rem, 6vw, 6.5rem); margin-right: calc(50% - 50vw); overflow: hidden; }
	.problems-carousel__copy { width: min(100%, 32rem); padding-left: clamp(0rem, 2vw, 1.5rem); text-align: left; }
	.problems-carousel__copy h2 { margin: 0; color: #fff; font: 400 3rem / 1.25 Manrope, sans-serif; text-wrap: balance; }
	.problems-carousel__copy p { max-width: 31rem; margin: 1.5rem 0 2.5rem; color: var(--garna-subtitle-color); font-size: 1.25rem; font-weight: var(--garna-subtitle-weight); line-height: 1.625; }
	.problems-carousel__viewport { width: 100%; overflow: hidden; padding-block: .65rem; }
	.problems-carousel__rail { display: flex; gap: 1.15rem; width: 100%; transition: transform 520ms cubic-bezier(.22, 1, .36, 1); will-change: transform; }
	.problem-carousel-card { --garna-card-glow-x: 50%; --garna-card-glow-y: 50%; --garna-card-glow-radius: 32rem; --problem-card-content-gap: 2.5rem; position: relative; isolation: isolate; display: flex; flex: 0 0 43%; height: var(--problem-card-height, 28rem); flex-direction: column; justify-content: space-between; gap: var(--problem-card-content-gap); overflow: hidden; border-radius: 1.75rem; padding: clamp(1.35rem, 2.4vw, 2rem); color: #fff; cursor: pointer; text-align: left; transform: scale(.94); transform-origin: center left; transition: transform 520ms cubic-bezier(.22, 1,.36, 1), border-color 220ms ease, box-shadow 220ms ease, opacity 220ms ease; }
	.problem-carousel-card::before { position: absolute; inset: 0; z-index: 0; border-radius: inherit; background: radial-gradient(circle var(--garna-card-glow-radius) at var(--garna-card-glow-x) var(--garna-card-glow-y), rgb(255 255 255 / .12) 0%, rgb(255 255 255 / .075) 18%, rgb(255 255 255 / .035) 40%, transparent 70%); content: ''; opacity: 0; pointer-events: none; transition: opacity 300ms ease; }
	.problem-carousel-card > * { position: relative; z-index: 1; }
	.problem-carousel-card:is(:hover, :focus-visible, [data-pointer-active='true']) { border-color: rgb(255 255 255 / .15); box-shadow: 0 18px 45px rgb(0 0 0 / .28); }
	.problem-carousel-card:is(:hover, :focus-visible, [data-pointer-active='true'])::before { opacity: 1; }
	.problem-carousel-card.is-active { transform: none; }
	.problem-carousel-card:not(.is-active) { opacity: .68; }
	.problem-carousel-card__header { display: flex; flex-direction: column; gap: .75rem; }
	.problem-carousel-card__header small { color: #cbf300; font: 700 .72rem / 1 Manrope, sans-serif; letter-spacing: .12em; }
	.problem-carousel-card__header strong { max-width: 15rem; font: 500 clamp(1.25rem, 1.75vw, 1.55rem) / 1.2 Manrope, sans-serif; letter-spacing: -.02em; }
	.problem-carousel-card[data-index='4'] .problem-carousel-card__header strong { max-width: 18rem; text-wrap: balance; }
	.problem-carousel-card__conversation { display: flex; flex-direction: column; gap: 1.35rem; }
	.problem-chat { display: flex; align-items: flex-end; gap: .7rem; }
	.problem-chat > span:not(.problem-avatar, .problem-garna-mark) { padding: .9rem 1rem; border-radius: 1rem; font: 500 .8rem / 1.48 Manrope, sans-serif; }
	.problem-chat--customer > span:last-child { border-bottom-left-radius: .3rem; background: rgb(255 255 255 / .075); color: #f4f4f5; }
	.problem-chat--garna { justify-content: flex-end; }
	.problem-chat--garna > span:first-child { border: 1px solid rgb(203 243 0 / .16); border-bottom-right-radius: .3rem; background: rgb(203 243 0 / .075); color: #e4e4e7; }
	.problem-avatar, .problem-garna-mark { display: grid; width: 2.5rem; height: 2.5rem; flex: 0 0 2.5rem; place-items: center; border-radius: 50%; }
	.problem-avatar { overflow: hidden; border: 1px solid rgb(255 255 255 / .09); background: #202020; }
	.problem-avatar img { width: 100%; height: 100%; object-fit: cover; }
	.problem-garna-mark { background: #cbf300; }
	.problem-garna-mark img { width: .8rem; height: 1.3rem; }
	.problems-carousel__controls { display: flex; width: 43%; justify-content: center; align-items: center; gap: .45rem; margin-top: 1.35rem; }
	.problems-carousel__controls button { position: relative; width: .58rem; height: .58rem; overflow: hidden; border: 0; border-radius: 999px; background: rgb(255 255 255 / .24); padding: 0; cursor: pointer; transition: width 220ms ease, background 220ms ease; }
	.problems-carousel__controls button.is-active { width: 3.4rem; background: rgb(203 243 0 / .18); box-shadow: inset 0 0 0 1px rgb(203 243 0 / .18); }
	.problems-carousel__controls button.is-active::after { position: absolute; inset: 0; border-radius: inherit; background: #cbf300; box-shadow: 0 0 14px rgb(203 243 0 / .52); content: ''; transform: scaleX(var(--problem-dot-progress, 1)); transform-origin: left center; }
	@media (min-width: 700px) and (max-width: 1079.98px) {
		.problems-carousel { grid-template-columns: minmax(15rem, .9fr) minmax(0, 1.1fr); gap: clamp(1.5rem, 3vw, 2.5rem); }
		.problems-carousel__copy { width: 100%; padding-left: 0; }
		.problem-carousel-card { --problem-card-content-gap: 2rem; flex-basis: min(72%, 20rem); }
		.problem-carousel-card__header,
		.problem-carousel-card__conversation { flex-shrink: 0; }
		.problem-carousel-card__conversation { margin-top: auto; }
		.problems-carousel__controls { width: min(72%, 20rem); }
	}
	@media (max-width: 699px) {
		.problems-carousel { grid-template-columns: 1fr; gap: 2.25rem; margin-right: 0; overflow: visible; }
		.problems-carousel__copy { width: 100%; padding-left: 0; }
		.problems-carousel__viewport { width: auto; margin-right: calc(50% - 50vw); }
		.problems-carousel__copy h2 { font-size: 2.25rem; }
		.problems-carousel__copy p { margin: 1.25rem 0 2rem; font-size: 1.125rem; }
		.problem-carousel-card { --problem-card-content-gap: 1.5rem; flex-basis: clamp(16rem, 72vw, 20.5rem); margin-right: 0; border-radius: 1.25rem; }
		.problem-carousel-card__header,
		.problem-carousel-card__conversation { flex-shrink: 0; }
		.problem-carousel-card__conversation { margin-top: auto; }
		.problems-carousel__controls { width: clamp(16rem, 72vw, 20.5rem); margin-top: 1rem; }
		.problem-chat > span:not(.problem-avatar, .problem-garna-mark) { font-size: .875rem; }
	}
	@media (min-width: 768px) and (max-width: 900px) {
		:global(html[lang='es']) .problem-carousel-card { padding: 1.125rem; }
		:global(html[lang='es']) .problem-carousel-card__header { gap: .5rem; }
		:global(html[lang='es']) .problem-carousel-card__conversation { gap: .875rem; }
		:global(html[lang='es']) .problem-chat > span:not(.problem-avatar, .problem-garna-mark) { padding: .625rem .875rem; }
		:global(html[lang='ru']) .problem-carousel-card { padding: 1.125rem; }
		:global(html[lang='ru']) .problem-carousel-card__header { gap: .65rem; }
		:global(html[lang='ru']) .problem-carousel-card__conversation { gap: 1.05rem; }
		:global(html[lang='ru']) .problem-chat > span:not(.problem-avatar, .problem-garna-mark) { padding-block: .78rem; }
	}
	@media (min-width: 421px) and (max-width: 767px) {
		:global(html[lang='ru']) .problem-carousel-card { padding: 1.125rem; }
		:global(html[lang='ru']) .problem-carousel-card__header { gap: .65rem; }
		:global(html[lang='ru']) .problem-carousel-card__conversation { gap: 1.05rem; }
		:global(html[lang='ru']) .problem-chat > span:not(.problem-avatar, .problem-garna-mark) { padding-block: .78rem; }
	}
	@media (min-width: 1080px) {
		.problem-carousel-card {
			--problem-desktop-ratio: .7599;
			flex-basis: min(43%, 35svh);
			height: auto;
			aspect-ratio: var(--problem-desktop-ratio);
			border-radius: calc(var(--problem-card-unit, 3.07px) * 9.12);
			gap: calc(var(--problem-card-unit, 3.07px) * 13.03);
