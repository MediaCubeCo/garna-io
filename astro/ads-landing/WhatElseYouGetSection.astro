---
import Section from '../components/layout/Section.astro';
import SectionHeader from '../components/layout/SectionHeader.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
---

<Section id="landing-benefits" contained={false} spacing="none" class="pt-20 pb-24 md:pt-24 lg:pt-48">
            <div class="mx-auto max-w-7xl px-6">
                <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
                    <div class="max-w-xl text-left">
                        <SectionHeader
                            align="left"
                            title={{ text: 'What Else You Get', translateKey: 'whatElseYouGet.title' }}
                            description={{ text: 'Practical tools and records that make international client payments easier to manage beyond the invoice itself', translateKey: 'whatElseYouGet.description' }}
                        />
                        <div class="mt-8">
                            <Button
								href="https://app.garna.io/en/auth/sign-up"
                                variant="primary"
                                effect="none"
                                icon="none"
                                size="header"
                                class="w-fit"
                            >
                                <span data-translate="whatElseYouGet.button">Create account</span>
                            </Button>
                        </div>
                    </div>
                    <div>
                        <div class="grid gap-4 sm:grid-cols-2" data-eor-benefit-cards>
                            <Card class="p-6" title={{ text: 'Flexible Withdrawals', translateKey: 'whatElseYouGet.benefits.withdrawals.title' }} description={{ text: 'Choose from the payout methods available to you, including bank accounts, cards, e-wallets, and crypto', translateKey: 'whatElseYouGet.benefits.withdrawals.description' }}>
                                <svg slot="visual" class="mb-5 block h-6 w-6 text-[#CBF300]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M12 3v12"></path>
									<path d="m7 10 5 5 5-5"></path>
									<path d="M5 21h14"></path>
                                </svg>
                            </Card>
                            <Card class="p-6" title={{ text: 'Tax-Ready Records', translateKey: 'whatElseYouGet.benefits.taxRecords.title' }} description={{ text: 'Keep invoices and payment records organized when it is time to report your international income', translateKey: 'whatElseYouGet.benefits.taxRecords.description' }}>
                                <svg slot="visual" class="mb-5 block h-6 w-6 text-[#CBF300]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
									<path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
									<path d="M8 13h8M8 17h5"></path>
                                </svg>
                            </Card>
                            <Card class="p-6" title={{ text: 'Visa-Ready Income Proof', translateKey: 'whatElseYouGet.benefits.visaProof.title' }} description={{ text: 'Use your official invoices and payment history as supporting records for digital nomad and visa applications', translateKey: 'whatElseYouGet.benefits.visaProof.description' }}>
                                <svg slot="visual" class="mb-5 block h-6 w-6 text-[#CBF300]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<rect x="3" y="4" width="18" height="16" rx="2"></rect>
									<circle cx="9" cy="11" r="2"></circle>
									<path d="M6 16c.8-1.4 1.8-2 3-2s2.2.6 3 2M15 9h3M15 13h3"></path>
                                </svg>
                            </Card>
                            <Card class="p-6" title={{ text: 'Payment Tracking', translateKey: 'whatElseYouGet.benefits.tracking.title' }} description={{ text: 'Follow invoice status, incoming payments, and available funds from one Garna account', translateKey: 'whatElseYouGet.benefits.tracking.description' }}>
                                <svg slot="visual" class="mb-5 block h-6 w-6 text-[#CBF300]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M4 19V9M10 19V5M16 19v-7M22 19V3"></path>
									<path d="M2 19h22"></path>
                                </svg>
                            </Card>
                        </div>
                    </div>
                </div>
            </div>
        </Section>
