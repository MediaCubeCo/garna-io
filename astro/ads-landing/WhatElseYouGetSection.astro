---
import StackedCardsSection from '../components/sections/StackedCardsSection.astro';

const cards = [
	{
		key: 'withdrawals',
		title: { text: 'Flexible Withdrawals', translateKey: 'whatElseYouGet.benefits.withdrawals.title' },
		description: { text: 'Split your withdrawals across different cards and accounts', translateKey: 'whatElseYouGet.benefits.withdrawals.description' },
		tags: [
			{ text: 'Cards', translateKey: 'whatElseYouGet.benefits.withdrawals.tags.0' },
			{ text: 'Bank accounts', translateKey: 'whatElseYouGet.benefits.withdrawals.tags.1' },
			{ text: 'Split payouts', translateKey: 'whatElseYouGet.benefits.withdrawals.tags.2' },
		],
	},
	{
		key: 'tax-guidance',
		title: { text: 'Tax Guidance', translateKey: 'whatElseYouGet.benefits.taxGuidance.title' },
		description: { text: 'Get free guidance from our tax team on paying taxes correctly in your country', translateKey: 'whatElseYouGet.benefits.taxGuidance.description' },
		tags: [
			{ text: 'Local taxes', translateKey: 'whatElseYouGet.benefits.taxGuidance.tags.0' },
			{ text: 'Expert guidance', translateKey: 'whatElseYouGet.benefits.taxGuidance.tags.1' },
			{ text: 'Included', translateKey: 'whatElseYouGet.benefits.taxGuidance.tags.2' },
		],
	},
	{
		key: 'digital-nomad-visa',
		title: { text: 'Digital Nomad Visa', translateKey: 'whatElseYouGet.benefits.visa.title' },
		description: { text: 'Use your Garna payment documents to support your digital nomad visa application', translateKey: 'whatElseYouGet.benefits.visa.description' },
		tags: [
			{ text: 'Payment documents', translateKey: 'whatElseYouGet.benefits.visa.tags.0' },
			{ text: 'Income proof', translateKey: 'whatElseYouGet.benefits.visa.tags.1' },
			{ text: 'Visa support', translateKey: 'whatElseYouGet.benefits.visa.tags.2' },
		],
	},
];
---

<StackedCardsSection
	id="what-else-you-get"
	title={{ text: 'What Else You Get', translateKey: 'whatElseYouGet.title' }}
	description={{ text: 'Practical tools and support for managing international client payments beyond the invoice itself', translateKey: 'whatElseYouGet.description' }}
	cards={cards}
	class="pt-20 pb-24 md:pt-24 lg:pt-48 lg:pb-32"
	splitClass="stacked-cards-grid gap-12 md:grid-cols-[0.88fr_1.12fr] md:items-start"
	stackBreakpoint="768px"
	timings={[[0.08, 0.5], [0.43, 0.92]]}
/>
