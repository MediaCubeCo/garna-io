        color: #ffffff;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.5);
        filter: none !important;
        outline: 0 !important;
        backdrop-filter: blur(16px);
        transition: border-color 500ms ease, color 500ms ease, transform 500ms ease, box-shadow 500ms ease, background-color 500ms ease;
    }

    .steps-flow-marker::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: rgba(94, 165, 0, 0.05);
        opacity: 0;
        pointer-events: none;
        transition: opacity 500ms ease;
    }

    .steps-flow-number {
        position: absolute;
        top: -0.75rem;
        right: -0.75rem;
        display: grid;
        width: 2rem;
        height: 2rem;
        place-items: center;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.1);
