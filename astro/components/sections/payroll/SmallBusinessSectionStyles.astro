<style is:global>
    @keyframes flow-line {
        from {
            stroke-dashoffset: 20;
        }
        to {
            stroke-dashoffset: 0;
        }
    }

    @keyframes pulse-box {
        0%,
        100% {
            transform: scale(1);
            box-shadow: 0 0 18px rgba(94, 165, 0, 0.18);
        }

        50% {
            transform: scale(1.05);
            box-shadow: 0 0 40px rgba(94, 165, 0, 0.5);
        }
    }

    .steps-flow {
        position: relative;
        isolation: isolate;
        overflow: visible;
        border: 0;
        background: transparent;
        box-shadow: none;
    }

    .steps-flow::before,
    .steps-flow::after,
    .steps-flow-item::before,
    .steps-flow-item:not(:last-child)::after {
        display: none;
    }

    .steps-flow-grid {
        position: relative;
        z-index: 2;
        overflow: visible;
        align-items: flex-start;
    }

    .steps-flow-item {
        position: relative;
        z-index: 1;
        display: flex;
        flex: 1 1 0%;
        width: 100%;
        flex-direction: column;
        align-items: center;
        min-height: auto;
        overflow: visible;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        box-shadow: none;
        text-align: center;
        cursor: pointer;
        opacity: 0;
        transform: translateY(16px);
        animation: routineCardIn 720ms cubic-bezier(0.16, 1, 0.3, 1) both;
        animation-delay: var(--step-delay, 0ms);
    }

    .steps-flow-marker {
