---
import Section from '../../../layout/Section.astro';
---

<Section
	spacing="default"
	layout="split"
	align="left"
	title={{ text: 'Pay contractors now, settle later' }}
	description={{ text: 'Execute global payouts immediately and repay Garna on a schedule that suits your business cash flow' }}
	class="payroll-deferred-section overflow-hidden border-[#020202]/0"
	containerClass="relative z-10"
	splitClass="payroll-deferred-grid"
	copyClass="payroll-deferred-copy w-full max-w-full break-words whitespace-normal [overflow-wrap:anywhere] [word-break:break-word]"
	titleClass="lg:text-5xl"
	descriptionClass="mb-12"
>
	<Fragment slot="copy">
<ul class="space-y-8">
    <li class="flex items-center gap-5">
        <div class="flex text-sm text-[#CBF300] font-mono bg-[#1A1A1A] w-9 h-8 border-white/10 border rounded-lg items-center justify-center">1</div>
        <span class="text-lg text-gray-300 font-manrope w-full">Immediate payouts, deferred settlement</span>
    </li>
    <li class="flex items-center gap-5">
        <div class="flex text-sm text-[#CBF300] font-mono bg-[#1A1A1A] w-9 h-8 border-white/10 border rounded-lg items-center justify-center">2</div>
        <span class="text-lg text-gray-300 font-manrope w-full">Flexible terms: 30, 60, or 90 days</span>
    </li>
    <li class="flex items-center gap-5">
        <div class="flex text-sm text-[#CBF300] font-mono bg-[#1A1A1A] w-9 h-8 border-white/10 border rounded-lg items-center justify-center">3</div>
        <span class="text-lg text-gray-300 font-manrope w-full">Facility limits from $50K to one million</span>
    </li>
    <li class="flex items-center gap-5">
        <div class="flex text-sm text-[#CBF300] font-mono bg-[#1A1A1A] w-9 h-8 border-white/10 border rounded-lg items-center justify-center">4</div>
        <span class="text-lg text-gray-300 font-manrope w-full">Instant allocation &amp; processing</span>
    </li>
</ul>
	</Fragment>
<div class="flex overflow-visible box-border md:px-0 h-auto pr-0 pl-0 relative items-center justify-center">


    <!-- Dashboard Container (Flat & Centered) -->
    <!-- Modified width for mobile to increase horizontal size as requested -->
    <div class="md:w-[480px] md:mx-auto md:transform md:scale-100 origin-center w-full max-w-md relative">

        <!-- Main Dashboard Card -->
        <div class="flex flex-col overflow-hidden z-10 bg-[#0c0c0c] max-w-md border-white/10 border rounded-2xl mr-auto ml-auto relative shadow-[0_20px_50px_-10px_rgba(0,0,0,0.5)] backdrop-blur-xl">
            <!-- Header with increased spacing -->
            <div class="flex w-full max-w-md border-white/5 border-b mr-auto pt-6 pr-6 pb-6 pl-6 items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="flex text-[#CBF300] bg-[#CBF300]/10 w-8 h-8 border-[#CBF300]/20 border rounded-lg items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-briefcase"><rect width="20" height="14" x="2" y="7" rx="2" ry="2" class=""></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                    </div>
                    <div class="">
                        <div class="text-sm font-medium text-white tracking-tight">Post-Payment Balance</div>
                        <div class="text-[10px] text-gray-500 font-medium font-sans">Revolving Facility</div>
                    </div>
                </div>
                <div class="flex items-center gap-2 bg-[#CBF300]/10 px-2 py-1 rounded-md border border-[#CBF300]/10">
                    <div class="h-1.5 w-1.5 rounded-full bg-[#CBF300] animate-pulse"></div>
                    <span class="text-[10px] font-semibold text-[#CBF300] uppercase tracking-wide font-sans">Active</span>
                </div>
            </div>

            <!-- Dashboard Content -->
            <div class="flex flex-col gap-6 w-full max-w-md pt-6 pr-6 pb-6 pl-6 gap-x-6 gap-y-6">
                <!-- Financial Metrics with rolling numbers -->
                <div class="flex items-end justify-between">
                    <div class="">
                        <div class="text-[11px] font-semibold text-gray-500 mb-1 uppercase tracking-wider font-sans">Outstanding</div>
                        <div class="text-3xl font-medium text-white tracking-tight flex items-baseline">
                            <span class="rolling-number font-manrope" data-target="124500" data-prefix="$">$4,098</span>
                            <span class="text-xl font-normal text-gray-500">.00</span>
                        </div>
                    </div>
                    <div class="text-right">
                        <div class="text-[11px] font-semibold text-gray-500 mb-1 uppercase tracking-wider font-sans">Available Limit</div>
                        <div class="text-lg font-medium text-gray-400 tracking-tight">
                            <span class="rolling-number font-sans" data-target="875500" data-prefix="$" data-suffix=".00">$28,821.00</span>
                        </div>
                    </div>
                </div>

                <!-- Progress/Limit Bar with animation -->
                <div class="space-y-2">
                    <div class="flex text-[10px] uppercase font-semibold text-gray-500 tracking-wide justify-between">
                        <span class="font-sans">Utilization 12.4%</span>

                    </div>
                    <div class="h-1.5 w-full bg-white/5 rounded-full overflow-hidden border border-white/5">
                        <div class="h-full bg-[#CBF300] rounded-full shadow-[0_0_10px_rgba(203, 243, 0,0.5)]" style="width: 12.4%; animation: utilizationLoop 6s infinite ease-out;"></div>
                    </div>
                </div>

                <!-- Chart Container with Animated HTML Bars -->
                <div class="flex-1 min-h-[160px] relative w-full bg-white/[0.01] rounded-lg border border-white/5 p-4 flex flex-col justify-end">
                    <div class="absolute top-3 left-3 flex gap-4">
                        <div class="flex items-center gap-1.5">
                            <div class="w-1.5 h-1.5 rounded-full bg-[#CBF300]"></div>
                            <span class="text-[10px] text-gray-500 font-medium font-sans">Payout Volume</span>
                        </div>
                    </div>

                    <!-- Bar Chart Implementation -->
                    <div class="flex items-end justify-between h-[110px] w-full px-1 gap-3">
                        <div class="flex flex-col items-center gap-2 w-full h-full justify-end">
                            <div class="w-2.5 rounded-t-[2px] bg-gradient-to-t from-[#3e6b00] to-[#CBF300]" style="height: 27%; animation: breatheBar 3s infinite ease-in-out; transform-origin: bottom;"></div>
                            <span class="text-[9px] text-gray-500 font-medium font-sans">Mon</span>
                        </div>
                        <div class="flex flex-col items-center gap-2 w-full h-full justify-end">
                            <div class="w-2.5 rounded-t-[2px] bg-gradient-to-t from-[#3e6b00] to-[#CBF300]" style="height: 60%; animation: breatheBar 4s infinite ease-in-out 0.5s; transform-origin: bottom;"></div>
                            <span class="text-[9px] text-gray-500 font-medium font-sans">Tue</span>
                        </div>
                        <div class="flex flex-col items-center gap-2 w-full h-full justify-end">
                            <div class="w-2.5 rounded-t-[2px] bg-gradient-to-t from-[#3e6b00] to-[#CBF300]" style="height: 45%; animation: breatheBar 3.5s infinite ease-in-out 0.2s; transform-origin: bottom;"></div>
                            <span class="text-[9px] text-gray-500 font-medium font-sans">Wed</span>
                        </div>
                        <div class="flex flex-col items-center gap-2 w-full h-full justify-end">
                            <div class="w-2.5 rounded-t-[2px] bg-gradient-to-t from-[#3e6b00] to-[#CBF300]" style="height: 81%; animation: breatheBar 4.5s infinite ease-in-out 0.7s; transform-origin: bottom;"></div>
                            <span class="text-[9px] text-gray-500 font-medium font-sans">Thu</span>
                        </div>
                        <div class="flex flex-col items-center gap-2 w-full h-full justify-end">
                            <div class="w-2.5 rounded-t-[2px] bg-gradient-to-t from-[#3e6b00] to-[#CBF300]" style="height: 54%; animation: breatheBar 3.8s infinite ease-in-out 0.3s; transform-origin: bottom;"></div>
                            <span class="text-[9px] text-gray-500 font-medium font-sans">Fri</span>
                        </div>
                        <div class="flex flex-col items-center gap-2 w-full h-full justify-end">
                            <div class="w-2.5 rounded-t-[2px] bg-gradient-to-t from-[#3e6b00] to-[#CBF300]" style="height: 100%; animation: breatheBar 4.2s infinite ease-in-out 0.1s; transform-origin: bottom;"></div>
                            <span class="text-[9px] text-gray-500 font-medium font-sans">Sat</span>
                        </div>
                        <div class="flex flex-col items-center gap-2 w-full h-full justify-end">
                            <div class="w-2.5 rounded-t-[2px] bg-gradient-to-t from-[#3e6b00] to-[#CBF300]" style="height: 72%; animation: breatheBar 3.2s infinite ease-in-out 0.4s; transform-origin: bottom;"></div>
                            <span class="text-[9px] text-gray-500 font-medium font-sans">Sun</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Floating Info Card (Depth Layer - Flat Position) -->
        <div class="z-20 lg:left-auto lg:-right-12 lg:ml-0 md:w-auto md:h-auto md:top-24 md:ml-0 md:right-2 w-[167px] h-[106px] ml-0 absolute top-24 right-[2px]" style="animation: floatCard 6s ease-in-out infinite">
    <div class="origin-top-left md:translate-x-0 md:scale-100 md:origin-top-right lg:right-[24px] bg-[#141414] opacity-100 w-52 border-white/10 border rounded-xl pt-4 pr-4 pb-4 pl-4 absolute right-[-32px] shadow-2xl backdrop-blur-md translate-x-6 scale-[0.8]">
    <div class="flex justify-between items-start gap-2 mb-3">
        <div class="text-[10px] uppercase font-medium text-gray-500 tracking-wider">Payout Processed</div>
        <span class="text-[10px] text-white bg-white/10 px-1.5 py-0.5 rounded font-sans whitespace-nowrap">Just now</span>
    </div>
    <div class="flex items-center gap-3 mb-3">
        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-gray-700 to-gray-800 border border-white/10 flex items-center justify-center text-[10px] text-white font-sans">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" class=""></path>
                <circle cx="9" cy="7" r="4" class=""></circle>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87" class=""></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75" class=""></path>
            </svg>
        </div>
        <div class="">
            <div class="text-xs text-white font-sans">Engineering Team</div>
            <div class="text-[10px] text-gray-500 font-sans">Vendor payout</div>
        </div>
    </div>
    <div class="pt-2 border-t border-white/5 flex justify-between items-center">
        <span class="text-[10px] text-gray-500 font-sans">Paid</span>
        <span class="text-xs text-[#CBF300] font-mono">$15,420.00</span>
    </div>
</div>
</div>
    </div>

    <!-- Script for Looping Animations -->

</div>
</Section>
<style is:global>
        @keyframes breatheBar {
            0%, 100% { transform: scaleY(1); opacity: 0.9; }
            50% { transform: scaleY(1.15); opacity: 1; }
        }
        @keyframes utilizationLoop {
            0% { width: 0%; opacity: 0.5; }
            15% { width: 12.4%; opacity: 1; }
            85% { width: 12.4%; opacity: 1; }
            95% { width: 12.4%; opacity: 0; }
            100% { width: 0%; opacity: 0; }
        }
        @keyframes floatCard {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }
    </style>
