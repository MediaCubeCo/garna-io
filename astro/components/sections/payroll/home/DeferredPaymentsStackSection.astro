---
import Section from '../../../layout/Section.astro';

const cards = [
	{ title: 'Immediate payouts, deferred settlement', description: 'Pay your global team today while preserving working capital', tags: ['Global payouts', 'Pay now', 'Settle later'] },
	{ title: 'Flexible terms: 30, 60, or 90 days', description: 'Choose a repayment schedule that follows your incoming cash flow', tags: ['Flexible terms', 'Cash flow', 'Your schedule'] },
	{ title: 'Facility limits from $50K to one million', description: 'Scale available funding as your contractor network grows', tags: ['Scalable limit', 'Team growth', 'More capacity'] },
	{ title: 'Instant allocation & processing', description: 'Move from approved allocation to processed payouts in one flow', tags: ['Allocation', 'Approval', 'Processing'] },
];
---

<Section
	spacing="none"
	layout="split"
	align="left"
	title={{ text: 'Pay contractors now, settle later' }}
	description={{ text: 'Execute global payouts immediately and repay Garna on a schedule that suits your business cash flow' }}
	class="deferred-stack-section py-16 lg:py-32"
	containerClass="deferred-stack-container relative z-10"
	splitClass="deferred-stack-grid gap-12 lg:grid-cols-[0.88fr_1.12fr] lg:items-start"
	copyClass="deferred-stack-copy max-w-xl text-left"
	titleClass="lg:text-5xl"
	descriptionClass="text-lg"
	contentClass="deferred-card-stack"
>
	{cards.map((card) => (
		<article class="deferred-stack-card">
			<div class="deferred-card-copy">
				<h3>{card.title}</h3>
				<div class="deferred-card-bottom">
					<p>{card.description}</p>
					<div class="deferred-card-footer" aria-hidden="true">
						{card.tags.map((tag) => <span>{tag}</span>)}
					</div>
				</div>
			</div>
		</article>
	))}
</Section>

<style is:global>
	.deferred-stack-section{--stack-top:112px;--card-gap:18px;--card-peek:76px}
	.deferred-card-stack{display:grid;gap:var(--card-gap)}
	.deferred-stack-card{position:relative;display:grid;grid-template-columns:minmax(0,1fr);grid-template-rows:minmax(0,1fr);min-height:clamp(270px,22vw,330px);align-items:stretch;align-content:stretch;overflow:hidden;border:1px solid rgba(255,255,255,.08);border-radius:18px;background:#0c0c0c;padding:clamp(16px,1.8vw,22px);box-shadow:inset 0 1px rgba(255,255,255,.055),0 28px 72px -62px rgba(0,0,0,.8)}
	.deferred-card-copy{display:flex;height:100%;min-width:0;flex-direction:column;justify-content:flex-start}
	.deferred-card-copy h3{max-width:520px;margin:0;color:#fff;font:500 clamp(1.32rem,1.8vw,1.72rem)/1.2 Manrope,sans-serif;letter-spacing:-.01em}
	.deferred-card-bottom{margin-top:auto}
	.deferred-card-copy p{max-width:560px;margin:0;color:#a1a1aa;font:400 15px/1.55 Manrope,sans-serif}
	.deferred-card-footer{display:flex;flex-wrap:wrap;gap:10px;padding-top:clamp(14px,1.8vw,22px)}
	.deferred-card-footer span{border:1px solid rgba(255,255,255,.1);border-radius:10px;background:rgba(255,255,255,.055);padding:9px 12px;color:rgba(255,255,255,.78);font:650 13px/1 Manrope,sans-serif;white-space:nowrap}
	.deferred-card-footer span:first-child{border-color:rgba(203,243,0,.26);background:rgba(203,243,0,.095);color:#cbf300}
	@media(max-width:1023px){.deferred-stack-card{min-height:270px}}
	@media(max-width:640px){.deferred-stack-card{min-height:210px}}
	@media(min-width:421px){.deferred-stack-section.is-stack-ready .deferred-stack-container{min-height:var(--stack-height,auto)}.deferred-stack-section.is-stack-ready .deferred-stack-grid{position:sticky;top:var(--stack-top);align-content:start;align-items:start}.deferred-stack-section.is-stack-ready .deferred-stack-copy{position:static}.deferred-stack-section.is-stack-ready .deferred-card-stack{position:relative;align-self:start;overflow:visible;padding-bottom:var(--stack-bottom,0)}.deferred-stack-section.is-stack-ready .deferred-stack-card{width:100%;transform:translateY(0);transition:transform 80ms linear;will-change:transform;z-index:1}.deferred-stack-section.is-stack-ready .deferred-stack-card:nth-child(n+2){position:absolute;inset:0 0 auto}.deferred-stack-section.is-stack-ready .deferred-stack-card:nth-child(2){transform:translateY(var(--card-2-y,calc(100% + 18px)));z-index:2}.deferred-stack-section.is-stack-ready .deferred-stack-card:nth-child(3){transform:translateY(var(--card-3-y,calc(200% + 36px)));z-index:3}.deferred-stack-section.is-stack-ready .deferred-stack-card:nth-child(4){transform:translateY(var(--card-4-y,calc(300% + 54px)));z-index:4}}
</style>

<script>
	type StackWindow=Window&{__deferredStackCleanup?:()=>void};
	const stackWindow=window as StackWindow; stackWindow.__deferredStackCleanup?.();
	const section=document.querySelector('.deferred-stack-section');
	const stackMode=matchMedia('(min-width:421px)'); const reduced=matchMedia('(prefers-reduced-motion:reduce)'); let frame:number|null=null;
	const clamp=(n:number)=>Math.min(1,Math.max(0,n)); const ease=(n:number)=>{const p=clamp(n);return p*p*(3-2*p)};
	const clearStack=()=>{if(!(section instanceof HTMLElement))return;const container=section.querySelector('.deferred-stack-container');section.classList.remove('is-stack-ready');if(container instanceof HTMLElement)container.style.removeProperty('--stack-height');['--stack-bottom','--card-2-y','--card-3-y','--card-4-y'].forEach(p=>section.style.removeProperty(p))};
	const headingsFitOneLine=(cards:Element[])=>cards.every(card=>{const h=card.querySelector('h3');if(!(h instanceof HTMLElement))return false;const range=document.createRange();range.selectNodeContents(h);const lines=new Set(Array.from(range.getClientRects()).filter(rect=>rect.width>1&&rect.height>1).map(rect=>Math.round(rect.top)));return lines.size<=1});
	const update=()=>{frame=null;if(!(section instanceof HTMLElement))return;const container=section.querySelector('.deferred-stack-container');const grid=section.querySelector('.deferred-stack-grid');const cards=Array.from(section.querySelectorAll('.deferred-stack-card'));if(!(container instanceof HTMLElement)||!(grid instanceof HTMLElement)||!(cards[0] instanceof HTMLElement))return;if(!stackMode.matches||!headingsFitOneLine(cards)){clearStack();return}section.classList.add('is-stack-ready');const s=getComputedStyle(section),gap=parseFloat(s.getPropertyValue('--card-gap'))||18,peek=parseFloat(s.getPropertyValue('--card-peek'))||68,h=cards[0].offsetHeight,distance=Math.max(900,Math.round((h+gap)*3.1));section.style.setProperty('--stack-bottom',`${peek*3}px`);container.style.setProperty('--stack-height',`${grid.offsetHeight+distance}px`);const top=parseFloat(s.getPropertyValue('--stack-top'))||112,rect=container.getBoundingClientRect(),release=Math.max(1,container.offsetHeight-grid.offsetHeight),progress=clamp((top-rect.top)/Math.min(distance,release)),starts=[h+gap,(h+gap)*2,(h+gap)*3],ends=[peek,peek*2,peek*3],timings=[[.06,.34],[.29,.62],[.57,.92]],positions=starts.map((start,i)=>{const [a,b]=timings[i];const p=reduced.matches?1:ease((progress-a)/(b-a));return start+(ends[i]-start)*p});section.style.setProperty('--card-2-y',`${positions[0].toFixed(2)}px`);section.style.setProperty('--card-3-y',`${positions[1].toFixed(2)}px`);section.style.setProperty('--card-4-y',`${positions[2].toFixed(2)}px`)};
	const requestUpdate=()=>{if(frame===null)frame=requestAnimationFrame(update)};
	addEventListener('scroll',requestUpdate,{passive:true});addEventListener('resize',requestUpdate);stackMode.addEventListener('change',requestUpdate);reduced.addEventListener('change',requestUpdate);requestUpdate();
	stackWindow.__deferredStackCleanup=()=>{if(frame!==null)cancelAnimationFrame(frame);removeEventListener('scroll',requestUpdate);removeEventListener('resize',requestUpdate);stackMode.removeEventListener('change',requestUpdate);reduced.removeEventListener('change',requestUpdate)};
</script>
