---
import Section from '../../../layout/Section.astro';
import Card from '../../../ui/Card.astro';
import CardIconVisual from '../../../visuals/CardIconVisual.astro';
import TestimonialAuthorVisual from '../../../visuals/TestimonialAuthorVisual.astro';
---

<Section
	title={{ text: 'Trusted by Those Who Build the Future' }}
	description={{ text: 'Find out why large companies and middle-sized businesses are switching to Garna. We set the standard for international payroll, trusted by professionals in over 150 countries' }}
	class="overflow-hidden border-t border-white/0 md:py-16"
	containerClass="relative z-10"
	headerClass="mb-16 max-w-5xl lg:mb-20"
	titleClass="mx-auto max-w-4xl lg:text-5xl"
	contentClass="grid grid-cols-1 gap-8 min-[961px]:grid-cols-3"
>
	<Card variant="testimonial" description="&quot;Finally, a platform that doesn't make me feel like a second-class citizen. Getting paid is instant, and I can withdraw to my local bank without the usual headache.&quot;">
		<CardIconVisual slot="visual" icon="lucide:star" surface="none" class="mb-6" />
		<TestimonialAuthorVisual image="/pages/payroll-solution-new/assets/03-83a1ae5f-c842-4ee9-a912-505fc66a1ee0_320w.webp" name="Sarah J." role="Senior UX Designer" />
	</Card>
	<Card variant="testimonial" description="&quot;Garna opened the US market for me. I can now accept payments from clients who only work with US entities and withdraw straight to my bank. Absolute game changer.&quot;">
		<CardIconVisual slot="visual" icon="lucide:shield-check" surface="none" class="mb-6" />
		<TestimonialAuthorVisual image="/pages/payroll-solution-new/assets/01-152b527e-f3bb-44db-98a8-e224a84a1318_320w.webp" name="Marcus C." role="Full Stack Developer" />
	</Card>
	<Card variant="testimonial" description="&quot;Had an issue with my local tax authorities before started using Garna. Now I have all the tax documents in place.&quot;">
		<CardIconVisual slot="visual" icon="lucide:file-check-2" surface="none" class="mb-6" />
		<TestimonialAuthorVisual image="/pages/payroll-solution-new/assets/05-f8322831-e2ba-4007-9960-8e7e82b00480_320w.webp" name="Elena V." role="Marketing Consultant" />
	</Card>
</Section>
