---
import Section from '../../../layout/Section.astro';
import Card from '../../../ui/Card.astro';
import TestimonialAuthorVisual from '../../../visuals/TestimonialAuthorVisual.astro';
---

<Section
	spacing="default"
	title={{ text: 'Trusted by 400+ Businesses Worldwide' }}
	description={{ text: 'Find out why large companies and middle-sized businesses are switching to Garna. We set the standard for international payroll, trusted by professionals in over 150 countries' }}
	class="overflow-hidden border-t border-white/0"
	containerClass="relative z-10"
	headerClass="mb-16 max-w-5xl lg:mb-20"
	titleClass="mx-auto max-w-4xl lg:text-5xl"
	contentClass="grid grid-cols-1 gap-6 min-[961px]:grid-cols-3"
>
	<Card variant="testimonial" bodyClass="flex-1" description="&quot;Garna combines flexible global payroll, reliable payment schedules, responsive support, and effortless withdrawals for contractors worldwide.&quot;">
		<TestimonialAuthorVisual image="/pages/payroll-solution-new/assets/03-83a1ae5f-c842-4ee9-a912-505fc66a1ee0_320w.webp" name="Anna Matafonova" role="COO, Amma" />
	</Card>
	<Card variant="testimonial" bodyClass="flex-1" description="&quot;We’ve worked with Garna for over a year. Onboarding and paperwork are fast, payments are reliable across regions, and the team resolves issues proactively.&quot;">
		<TestimonialAuthorVisual image="/pages/payroll-solution-new/assets/05-f8322831-e2ba-4007-9960-8e7e82b00480_320w.webp" name="Aleksandra Sulimko" role="COO, TheSoul Group" />
	</Card>
	<Card variant="testimonial" bodyClass="flex-1" description="&quot;Garna makes worldwide payouts efficient and seamless. The team communicates quickly, solves issues proactively, and has been a consistently reliable partner.&quot;">
		<TestimonialAuthorVisual image="/pages/payroll-solution-new/assets/01-152b527e-f3bb-44db-98a8-e224a84a1318_320w.webp" name="Serge L." role="CFO, Spendbase" />
	</Card>
</Section>
