---
import TabbedImageFeatureSection from '../../TabbedImageFeatureSection.astro';

const panels = [
	{
		key: 'api',
		tab: { text: 'API integration', translateKey: 'embeddedPayroll.tabs.api' },
		image: '/images/embedded-api-people-v10.jpg',
		imagePosition: 'center 42%',
		imagePositionMobile: '72% 42%',
		tag: { text: 'Built for product teams', translateKey: 'embeddedPayroll.panels.api.tag' },
		title: { text: 'API contractor management and payments', translateKey: 'embeddedPayroll.panels.api.title' },
		description: { text: 'Integrate global contractor payments directly into your platform', translateKey: 'embeddedPayroll.panels.api.description' },
		cta: { text: 'Learn more', translateKey: 'cta.learnMore', href: '/form' },
	},
	{
		key: 'brand',
		tab: { text: 'White Label', translateKey: 'embeddedPayroll.tabs.brand' },
		image: '/images/embedded-white-label-people-v3.jpg',
		copyWidthTablet: '460px',
		tag: { text: 'Built for payroll brands', translateKey: 'embeddedPayroll.panels.brand.tag' },
		title: { text: 'White-label contractor dashboard and payments', translateKey: 'embeddedPayroll.panels.brand.title' },
		description: { text: 'Launch payroll under your own brand, powered by Garna', translateKey: 'embeddedPayroll.panels.brand.description' },
		cta: { text: 'Learn more', translateKey: 'cta.learnMore', href: '/form' },
	},
];
---

<TabbedImageFeatureSection
	id="home-embedded-payroll"
	title={{ text: 'Embedded Payroll Infrastructure', translateKey: 'sectionHeadings.embeddedPayrollInfrastructure' }}
	description={{ text: 'Use Garna as your backend provider: integrate contractor management and payments into your product or launch full-fledged payroll services under your own brand', translateKey: 'sectionDescriptions.embeddedPayrollInfrastructure' }}
	panels={panels}
	tabsAriaLabel={{ text: 'Embedded payroll solutions', translateKey: 'embeddedPayroll.tabs.ariaLabel' }}
/>
