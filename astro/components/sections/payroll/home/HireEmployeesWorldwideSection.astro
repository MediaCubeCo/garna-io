---
import Section from '../../../layout/Section.astro';
import Card from '../../../ui/Card.astro';
import CardIconVisual from '../../../visuals/CardIconVisual.astro';
---

<Section
	title={{ text: 'Hire Employees Worldwide', translateKey: 'sectionHeadings.hireEmployeesWorldwide' }}
	description={{ text: 'Simplify the hiring process for employees and freelancers with Garna. Unlike other companies, we will resolve not only the financial, but also legal side while you are looking for the right specialists', translateKey: 'sectionDescriptions.hireEmployeesWorldwide' }}
	class="border-y border-[#020202]/0"
	headerClass="mb-16 max-w-5xl lg:mb-20"
	titleClass="mx-auto max-w-4xl lg:text-5xl"
	contentClass="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3"
>
	<Card title="Quick Global Employment" description="Hire employees anywhere in the world without setting up local legal entities">
		<CardIconVisual slot="visual" icon="lucide:globe-2" />
	</Card>
	<Card title="Immigration Assistance" description="We help you not only find talent, but also apply for a visa and permanent residence support">
		<CardIconVisual slot="visual" icon="lucide:plane" />
	</Card>
	<Card title="Flexible Worksite Coverage" description="Hire for offices, retail, factories, or remote teams: wherever your business operates">
		<CardIconVisual slot="visual" icon="lucide:building-2" />
	</Card>
	<Card title="24/7 Support" description="Our support team is available 24/7 to resolve any issue in just a few minutes">
		<CardIconVisual slot="visual" icon="lucide:headset" />
	</Card>
	<Card title="Seamless Integration" description="Garna integrates seamlessly with your existing HR processes and accounting payroll software">
		<CardIconVisual slot="visual" icon="lucide:blocks" />
	</Card>
	<Card title="Employee Benefits" description="A user-friendly personal dashboard for every team member: access to payslips, vacation management, and expense tracking in real time">
		<CardIconVisual slot="visual" icon="lucide:gift" />
	</Card>
</Section>
