---
import Section from '../../../layout/Section.astro';
import Card from '../../../ui/Card.astro';
---

<Section
	spacing="default"
	title={{ text: 'Hire Employees Worldwide', translateKey: 'sectionHeadings.hireEmployeesWorldwide' }}
	description={{ text: "Find and hire talents that you couldn't find locally without setting up a local legal entity", translateKey: 'sectionDescriptions.hireEmployeesWorldwide' }}
	class="border-y border-[#020202]/0"
	headerClass="mb-16 max-w-5xl lg:mb-20"
	titleClass="mx-auto max-w-4xl lg:text-5xl"
	contentClass="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3"
>
	<Card title={{ text: 'Quick Global Employment', translateKey: 'hireEmployees.cards.globalEmployment.title' }} description={{ text: 'Hire employees in 150+ countries without setting up local legal entities', translateKey: 'hireEmployees.cards.globalEmployment.description' }}>
		<svg slot="visual" class="mb-5 block h-6 w-6 text-[#CBF300]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="12" cy="12" r="10"></circle>
			<path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z"></path>
		</svg>
	</Card>
	<Card title={{ text: 'Immigration Assistance', translateKey: 'hireEmployees.cards.immigration.title' }} description={{ text: '70+ countries where we provide immigration assistance', translateKey: 'hireEmployees.cards.immigration.description' }}>
		<svg slot="visual" class="mb-5 block h-6 w-6 text-[#CBF300]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M17.8 19 15 12l6-6c.8-.8.8-2 0-2.8-.8-.8-2-.8-2.8 0l-6 6-7-2.8-2 2 5.7 3.8-3.2 3.2-2.5-.4-1.5 1.5 3.5 2 2 3.5 1.5-1.5-.4-2.5 3.2-3.2 3.8 5.7 2-2Z"></path>
		</svg>
	</Card>
	<Card class="md:col-span-2 lg:col-span-1" title={{ text: 'Stay compliant', translateKey: 'hireEmployees.cards.compliance.title' }} description={{ text: 'We tap into local regulatory expertise across markets, so you have freedom to grow wherever you go', translateKey: 'hireEmployees.cards.compliance.description' }}>
		<svg slot="visual" class="mb-5 block h-6 w-6 text-[#CBF300]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M20 13c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V5l8-3 8 3v8Z"></path>
			<path d="m9 12 2 2 4-4"></path>
		</svg>
	</Card>
</Section>
