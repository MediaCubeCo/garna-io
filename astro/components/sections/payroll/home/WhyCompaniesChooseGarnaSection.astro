---
import Section from '../../../layout/Section.astro';
import SegmentedControl from '../../../ui/SegmentedControl.astro';
---

<Section
	title={{ text: "Why Companies Choose Garna" }}
	description={{ text: "Why Garna? There are plenty of benefits we offer while handling every payment process on time and accurately" }}
	id="why-garna" headerClass="mb-10 max-w-5xl lg:mb-12" titleClass="text-3xl md:text-4xl lg:text-5xl" controlsClass="relative z-20 mb-16 flex justify-center" actionClass="relative z-20"
	action={{ label: { text: 'Book a demo' }, href: '#', variant: 'primary', icon: 'arrow-right' }}
>
<!-- Header -->


  <Fragment slot="controls">
	<SegmentedControl
		group="why-garna"
		items={[
			{ id: 'cor', label: { text: 'Contractor of Record' }, panelId: 'grid-cor' },
			{ id: 'eor', label: { text: 'Employer of Record' }, panelId: 'grid-eor' },
		]}
	/>
</Fragment>

  <!-- Flow: Contractor of Record -->
  <!-- CoR Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-8 transition-opacity duration-500 w-full gap-x-8 gap-y-8" id="grid-cor">
    <!-- Card 1 -->
    <div class="group hover:bg-[#111111] hover:border-white/10 transition-all duration-300 flex flex-col lg:col-span-3 lg:pl-8 bg-[#0A0A0A]/80 w-full border-white/5 border rounded-2xl pt-8 pr-8 pb-8 pl-8 backdrop-blur-sm justify-start">
      <div class="w-12 h-12 rounded-xl bg-[#5EA500]/10 flex items-center justify-center text-[#5EA500] mb-6 group-hover:scale-110 transition-transform duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14" class=""></polyline>
        </svg>
      </div>
      <h3 class="text-xl font-extralight text-white mb-4 tracking-tight font-sans">Cut Admin Work by 70%</h3>
      <p class="text-gray-400 text-base leading-relaxed font-thin font-manrope max-w-xl">Our contract and payment automation frees your HR and finance department from routine tasks</p>
    </div>

    <!-- Card 2 -->
    <div class="group hover:bg-[#111111] hover:border-white/10 transition-all duration-300 flex flex-col w-fill lg:col-span-3 lg:pl-8 bg-[#0A0A0A]/80 w-full border-white/5 border rounded-2xl pt-8 pr-8 pb-8 pl-8 backdrop-blur-sm justify-start">
      <div class="w-12 h-12 rounded-xl bg-[#5EA500]/10 flex items-center justify-center text-[#5EA500] mb-6 group-hover:scale-110 transition-transform duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
          <path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path>
          <path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path>
          <path d="M18 12a2 2 0 0 0 0 4h4v-4Z"></path>
        </svg>
      </div>
      <h3 class="text-xl text-white tracking-tight font-extralight mb-4">Flexible Funding: From Bank
        transfers to
        Crypto</h3>
      <p class="text-gray-400 text-base leading-relaxed font-thin font-manrope">You can make payments via traditional
        banking or digital assets for maximum speed</p>
    </div>

    <!-- Card 3 -->
    <div class="group hover:bg-[#111111] hover:border-white/10 transition-all duration-300 flex flex-col lg:col-span-2 lg:pl-8 lg:pr-8 lg:pt-8 lg:pb-8 bg-[#0A0A0A]/80 border-white/5 border rounded-2xl pt-8 pr-8 pb-8 pl-8 backdrop-blur-sm justify-start">
      <div class="w-12 h-12 rounded-xl bg-[#5EA500]/10 flex items-center justify-center text-[#5EA500] mb-6 group-hover:scale-110 transition-transform duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
          <path d="M3 3v18h18"></path>
          <path d="M18 17V9"></path>
          <path d="M13 17V5" class=""></path>
          <path d="M8 17v-3"></path>
        </svg>
      </div>
      <h3 class="text-xl text-white tracking-tight font-extralight mb-4">Flawless Reporting and Analytics
      </h3>
      <p class="text-gray-400 text-base leading-relaxed font-thin font-manrope">All invoices, transactions, and tax reports are gathered in one place</p>
    </div>

    <!-- Card 4 -->
    <div class="group hover:bg-[#111111] hover:border-white/10 transition-all duration-300 flex flex-col lg:col-span-2 lg:pl-8 lg:pr-8 lg:pt-8 lg:pb-8 bg-[#0A0A0A]/80 border-white/5 border rounded-2xl pt-8 pr-8 pb-8 pl-8 backdrop-blur-sm justify-start">
      <div class="w-12 h-12 rounded-xl bg-[#5EA500]/10 flex items-center justify-center text-[#5EA500] mb-6 group-hover:scale-110 transition-transform duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" class=""></path>
          <path d="m9 12 2 2 4-4"></path>
        </svg>
      </div>
      <h3 class="text-xl text-white tracking-tight font-extralight mb-4">100% Intellectual Property
        Protection
      </h3>
      <p class="text-gray-400 text-base leading-relaxed font-thin font-manrope">We legally guarantee that all work
        produced by your contractors belongs exclusively to you</p>
    </div>

    <!-- Card 5 -->
    <div class="group hover:bg-[#111111] hover:border-white/10 transition-all duration-300 flex flex-col lg:col-span-2 lg:pl-8 lg:pr-8 lg:pt-8 lg:pb-8 bg-[#0A0A0A]/80 border-white/5 border rounded-2xl pt-8 pr-8 pb-8 pl-8 backdrop-blur-sm justify-start">
      <div class="w-12 h-12 rounded-xl bg-[#5EA500]/10 flex items-center justify-center text-[#5EA500] mb-6 group-hover:scale-110 transition-transform duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
          <path d="m18 16 4-4-4-4"></path>
          <path d="m6 8-4 4 4 4"></path>
          <path d="m14.5 4-5 16" class=""></path>
        </svg>
      </div>
      <h3 class="text-xl font-extralight text-white mb-4 tracking-tight font-sans">Scale with the API</h3>
      <p class="text-gray-400 text-base leading-relaxed font-thin font-manrope">Integrate bulk payments directly into your internal systems and automate workflows programmatically</p>
    </div>
  </div>

  <!-- EoR Grid -->
  <div id="grid-eor" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-8 w-full hidden transition-opacity duration-500">
    <!-- Card 1 -->
    <div class="lg:col-span-3 group bg-[#0A0A0A]/80 backdrop-blur-sm border border-white/5 rounded-2xl p-8 hover:bg-[#111111] hover:border-white/10 transition-all duration-300 flex flex-col justify-start">
      <div class="w-12 h-12 rounded-xl bg-[#5EA500]/10 flex items-center justify-center text-[#5EA500] mb-6 group-hover:scale-110 transition-transform duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
          <path d="M2 12h20"></path>
        </svg>
      </div>
      <h3 class="text-xl font-extralight text-white mb-4 tracking-tight font-sans">Access to the best
        specialists in 150+ countries</h3>
      <p class="text-gray-400 text-base leading-relaxed font-thin font-manrope max-w-xl">Hunt the best
        specialists wherever they are without wasting time and money on registering legal entities</p>
    </div>

    <!-- Card 2 -->
    <div class="lg:col-span-3 group bg-[#0A0A0A]/80 backdrop-blur-sm border border-white/5 rounded-2xl p-8 hover:bg-[#111111] hover:border-white/10 transition-all duration-300 flex flex-col justify-start">
      <div class="w-12 h-12 rounded-xl bg-[#5EA500]/10 flex items-center justify-center text-[#5EA500] mb-6 group-hover:scale-110 transition-transform duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
          <path d="M3 11h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5Zm0 0a9 9 0 1 1 18 0m0 0v5a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3Z">
          </path>
          <path d="M21 16v2a4 4 0 0 1-4 4h-5"></path>
        </svg>
      </div>
      <h3 class="text-xl font-extralight text-white mb-4 tracking-tight font-sans">24/7 support</h3>
      <p class="text-gray-400 text-base leading-relaxed font-thin font-manrope">We provide quick solutions to
        any issues both for the company and for each employee around the clock</p>
    </div>

    <!-- Card 3 -->
    <div class="lg:col-span-2 group bg-[#0A0A0A]/80 backdrop-blur-sm border border-white/5 rounded-2xl p-8 hover:bg-[#111111] hover:border-white/10 transition-all duration-300 flex flex-col justify-start">
      <div class="w-12 h-12 rounded-xl bg-[#5EA500]/10 flex items-center justify-center text-[#5EA500] mb-6 group-hover:scale-110 transition-transform duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
          <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
          <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
          <path d="m9 15 2 2 4-4"></path>
        </svg>
      </div>
      <h3 class="text-xl font-extralight text-white mb-4 tracking-tight font-sans">100% compliance with the laws
      </h3>
      <p class="text-gray-400 text-base leading-relaxed font-thin font-manrope">We assume full responsibility
        for compliance with the labor code of each country, from taxes to social benefits. Our team is
        monitoring any legal changes</p>
    </div>

    <!-- Card 4 -->
    <div class="lg:col-span-2 group bg-[#0A0A0A]/80 backdrop-blur-sm border border-white/5 rounded-2xl p-8 hover:bg-[#111111] hover:border-white/10 transition-all duration-300 flex flex-col justify-start">
      <div class="w-12 h-12 rounded-xl bg-[#5EA500]/10 flex items-center justify-center text-[#5EA500] mb-6 group-hover:scale-110 transition-transform duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
      </div>
      <h3 class="text-xl font-extralight text-white mb-4 tracking-tight font-sans">Automated payments</h3>
      <p class="text-gray-400 text-base leading-relaxed font-thin font-manrope">Make payments in one click in
        any currency. The system calculates taxes and other contributions immediately</p>
    </div>

    <!-- Card 5 -->
    <div class="lg:col-span-2 group bg-[#0A0A0A]/80 backdrop-blur-sm border border-white/5 rounded-2xl p-8 hover:bg-[#111111] hover:border-white/10 transition-all duration-300 flex flex-col justify-start">
      <div class="w-12 h-12 rounded-xl bg-[#5EA500]/10 flex items-center justify-center text-[#5EA500] mb-6 group-hover:scale-110 transition-transform duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
          <rect width="7" height="9" x="3" y="3" rx="1"></rect>
          <rect width="7" height="5" x="14" y="3" rx="1"></rect>
          <rect width="7" height="9" x="14" y="12" rx="1"></rect>
          <rect width="7" height="5" x="3" y="16" rx="1"></rect>
        </svg>
      </div>
      <h3 class="text-xl font-extralight text-white mb-4 tracking-tight font-sans">Shared dashboard</h3>
      <p class="text-gray-400 text-base leading-relaxed font-thin font-manrope">Management of contracts,
        expenses, income, and vacations is available in one interface</p>
    </div>
  </div>
</Section>
