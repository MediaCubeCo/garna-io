---
import Section from '../../layout/Section.astro';
---

<Section
	title={{ text: 'How to get started', translateKey: 'howTo.title' }}
	description={{ text: 'Start using Garna in a few simple steps', translateKey: 'howTo.description' }}
	spacing="none"
	class="creator-process-section pt-16 pb-8 lg:pt-32 lg:pb-0"
	headerClass="mb-14 max-w-4xl lg:mb-16"
	titleClass="mx-auto max-w-4xl lg:text-5xl"
	contentClass="creator-process-scroll"
>
	<div class="creator-process-pin" data-creator-process>
		<div class="creator-process-visual-stage" aria-label="Creator payout setup visual">
			<div class="creator-process-visual is-active" data-process-visual="0">
				<div class="creator-mini-window">
					<h4 class="creator-mini-title" data-translate="howTo.panel.signup.title">Sign up in Garna</h4>
					<div class="creator-mini-form">
						<div class="creator-mini-fields">
							<label class="creator-mini-field creator-mini-field--wide">
								<span data-translate="howTo.panel.signup.companyNameLabel">Company name</span>
								<strong>Northstar Labs Ltd.</strong>
							</label>
							<div class="creator-mini-grid">
								<label class="creator-mini-field">
									<span data-translate="howTo.panel.signup.registrationNumberLabel">Registration number</span>
									<strong>HE 482913</strong>
								</label>
								<label class="creator-mini-field">
									<span data-translate="howTo.panel.signup.countryLabel">Country of registration</span>
									<strong>Cyprus</strong>
								</label>
							</div>
							<label class="creator-mini-field creator-mini-field--wide">
								<span data-translate="howTo.panel.signup.businessEmailLabel">Business email</span>
								<strong>finance@northstarlabs.io</strong>
							</label>
							<label class="creator-mini-field creator-mini-field--wide">
								<span data-translate="howTo.panel.signup.registrationDateLabel">Date of registration</span>
								<strong>02.02.2022</strong>
							</label>
						</div>
						<button class="creator-mini-button" type="button" data-translate="howTo.panel.signup.continueButton">Continue</button>
					</div>
				</div>
			</div>
			<div class="creator-process-visual" data-process-visual="1">
				<div class="creator-mini-window creator-team-window">
					<h4 class="creator-mini-title" data-translate="howTo.panel.invite.title">Invite contractors</h4>
					<div class="creator-mini-form">
						<div class="creator-mini-fields">
							<label class="creator-mini-field creator-mini-field--wide">
								<span data-translate="howTo.panel.invite.roleLabel">Role</span>
								<strong data-translate="howTo.panel.invite.roleValue">Design contractor</strong>
							</label>
							<label class="creator-mini-field creator-mini-field--wide">
								<span data-translate="howTo.panel.invite.emailLabel">Email</span>
								<div class="creator-invite-emails" aria-hidden="true">
								<span>maya@northstarlabs.io</span>
								<span>alex@northstarlabs.io</span>
								<span>sarah@northstarlabs.io</span>
								<span>leo@northstarlabs.io</span>
							</div>
						</label>
							<label class="creator-mini-field creator-mini-field--wide">
								<span data-translate="howTo.panel.invite.agreementLabel">Agreement</span>
								<strong data-translate="howTo.panel.invite.agreementValue">Client terms</strong>
							</label>
							<label class="creator-mini-field creator-mini-field--wide">
								<span data-translate="howTo.panel.invite.accessLabel">Access</span>
								<strong data-translate="howTo.panel.invite.accessValue">Contractor dashboard</strong>
							</label>
						</div>
						<button class="creator-mini-button" type="button" data-translate="howTo.panel.invite.sendInvitesButton">Send invites</button>
					</div>
				</div>
			</div>
			<div class="creator-process-visual" data-process-visual="2">
				<div class="creator-mini-window creator-wallet-panel">
					<div class="creator-wallet-header">
						<h4 class="creator-mini-title" data-translate="howTo.panel.fund.title">Balance</h4>
						<div class="creator-wallet-currency" aria-hidden="true">
							<span>USD</span>
							<span>EUR</span>
						</div>
					</div>
					<div class="creator-wallet-account">
						<div class="creator-wallet-account-top">
							<span data-translate="howTo.panel.fund.paymentAccount">Payment account USD</span>
						</div>
						<strong data-process-wallet-counter data-process-wallet-value="10000">10 000.00 $</strong>
						<div class="creator-wallet-number">
							<span data-translate="howTo.panel.fund.accountNumber">Account number</span>
							<b>PT52 7869 1200 9000 2124</b>
						</div>
						<div class="creator-wallet-actions" aria-hidden="true">
							<span data-translate="howTo.panel.fund.actions.send">Send</span>
							<span data-translate="howTo.panel.fund.actions.withdraw">Withdraw</span>
							<span data-translate="howTo.panel.fund.actions.topUp">Top up</span>
						</div>
					</div>
					<div class="creator-wallet-templates" aria-hidden="true">
						<div class="creator-wallet-section-head">
							<span data-translate="howTo.panel.fund.templates">Templates</span>
							<strong data-translate="howTo.panel.fund.all">All</strong>
						</div>
						<div class="creator-wallet-template-list">
							<div>
								<span data-translate="howTo.panel.fund.n26Card">N26 card</span>
								<b><i></i><i></i></b>
							</div>
							<div>
								<span data-translate="howTo.panel.fund.designerPayout">Designer payout</span>
								<b><i></i><i></i></b>
							</div>
							<div>
								<span data-translate="howTo.panel.fund.lewisAccount">M. Lewis account</span>
								<b><i></i><i></i></b>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="creator-process-visual" data-process-visual="3">
				<div class="creator-bulk-panel">
					<div class="creator-bulk-header">
						<h4 class="creator-mini-title" data-translate="howTo.panel.send.title">Mass transfer</h4>
					</div>
					<p class="creator-bulk-note" data-translate="howTo.panel.send.description">Upload a file and send multiple payouts in one flow</p>
					<div class="creator-bulk-file">
						<div>
							<span data-translate="howTo.panel.send.uploadedFile">Uploaded file</span>
							<strong data-translate="howTo.panel.send.fileName">New transactions.csv</strong>
						</div>
						<b>CSV</b>
					</div>
					<div class="creator-bulk-stats">
						<div>
							<span data-translate="howTo.panel.send.transactions">Transactions</span>
							<strong>100</strong>
						</div>
						<div>
							<span data-translate="howTo.panel.send.totalAmount">Total amount</span>
							<strong>$3,882,884</strong>
						</div>
					</div>
					<div class="creator-visual-action" data-translate="howTo.panel.send.sendTransfers">Send transfers</div>
				</div>
			</div>
			<div class="creator-process-progress" aria-hidden="true">
				<span class="is-active"></span>
				<span></span>
				<span></span>
				<span></span>
			</div>
		</div>
	</div>
	<div class="creator-process-copy">
		<article class="creator-process-step is-active" data-process-step="0">
			<span>01</span>
			<h3 data-translate="howTo.steps.step1.title">Setup your account</h3>
			<p data-translate="howTo.steps.step1.description">Create your company profile and verify your business details to get access to the platform</p>
		</article>
		<article class="creator-process-step" data-process-step="1">
			<span>02</span>
			<h3 data-translate="howTo.steps.step2.title">Invite your team</h3>
			<p data-translate="howTo.steps.step2.description">Add contractors to the dashboard and assign roles, access, and agreement terms</p>
		</article>
		<article class="creator-process-step" data-process-step="2">
			<span>03</span>
			<h3 data-translate="howTo.steps.step3.title">Fund your balance</h3>
			<p data-translate="howTo.steps.step3.description">Top up your corporate wallet using bank transfer, SWIFT, SEPA, or crypto assets</p>
		</article>
		<article class="creator-process-step" data-process-step="3">
			<span>04</span>
			<h3 data-translate="howTo.steps.step4.title">Send payouts</h3>
			<p data-translate="howTo.steps.step4.description">Execute global payrolls in one click with automated tax handling and compliance</p>
		</article>
	</div>
	<div class="creator-process-fallback" data-process-fallback></div>
</Section>

<script is:inline>
	(() => {
		const creatorProcess = document.querySelector('[data-creator-process]');
		const creatorProcessSteps = Array.from(document.querySelectorAll('[data-process-step]'));
		const creatorProcessVisuals = Array.from(document.querySelectorAll('[data-process-visual]'));
		const creatorProcessProgress = Array.from(document.querySelectorAll('.creator-process-progress span'));
		const creatorProcessFallback = document.querySelector('[data-process-fallback]');
		const reduceCreatorProcessMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		const formatWalletCounter = (value) => {
			const [integerPart, decimalPart] = value.toFixed(2).split('.');
			return `${integerPart.replace(/\B(?=(\d{3})+(?!\d))/g, ' ')}.${decimalPart} $`;
		};

		const animateWalletCounter = (visual) => {
			if (!(visual instanceof HTMLElement)) return;
			const counter = visual.querySelector('[data-process-wallet-counter]');
			if (!(counter instanceof HTMLElement)) return;

			const target = Number(counter.getAttribute('data-process-wallet-value')) || 10000;
			if (reduceCreatorProcessMotion.matches) {
				counter.textContent = formatWalletCounter(target);
				return;
			}

			let startedAt = null;
			const delay = 420;
			const duration = 1250;
			counter.textContent = formatWalletCounter(0);

			const animate = (timestamp) => {
				startedAt ??= timestamp;
				const elapsed = Math.max(0, timestamp - startedAt - delay);
				const progress = Math.min(1, elapsed / duration);
				const easedProgress = 1 - Math.pow(1 - progress, 3);
				counter.textContent = formatWalletCounter(target * easedProgress);
				if (progress < 1 && visual.classList.contains('is-content-active')) {
					window.requestAnimationFrame(animate);
				}
			};

			window.requestAnimationFrame(animate);
		};

		const completeWalletCounter = (visual) => {
			if (!(visual instanceof HTMLElement)) return;
			const counter = visual.querySelector('[data-process-wallet-counter]');
			if (!(counter instanceof HTMLElement)) return;
			const target = Number(counter.getAttribute('data-process-wallet-value')) || 10000;
			counter.textContent = formatWalletCounter(target);
		};

		if (creatorProcess && creatorProcessSteps.length && creatorProcessVisuals.length) {
			const creatorProcessScroll = creatorProcess.closest('.creator-process-scroll');
			let creatorProcessFrame = null;
			let creatorProcessCurrentIndex = -1;
			let creatorProcessContentIndex = -1;

			const restartCreatorProcessContent = (visual) => {
				if (!(visual instanceof HTMLElement)) return;
				visual.classList.remove('is-content-active');
				void visual.offsetWidth;
				visual.classList.add('is-content-active');
				animateWalletCounter(visual);
			};

			const setCreatorProcessStep = (index, stepProgress = 1, shouldAnimateContent = true) => {
				if (index !== creatorProcessCurrentIndex) {
					creatorProcessCurrentIndex = index;
					creatorProcessContentIndex = -1;
				}

				const clampedStepProgress = Math.min(1, Math.max(0, stepProgress));
				const progressTrack = creatorProcessProgress[0]?.parentElement;
				if (progressTrack instanceof HTMLElement) {
					progressTrack.style.setProperty('--creator-process-step-progress', `${clampedStepProgress * 100}%`);
				}

				creatorProcessSteps.forEach((step) => {
					step.classList.toggle('is-active', step.getAttribute('data-process-step') === String(index));
				});

				creatorProcessVisuals.forEach((visual, visualIndex) => {
					const isActiveVisual = visual.getAttribute('data-process-visual') === String(index);
					const stackDistance = (visualIndex - index + creatorProcessVisuals.length) % creatorProcessVisuals.length;

					visual.classList.toggle('is-active', isActiveVisual);
					visual.classList.toggle('is-stack-one', !isActiveVisual && stackDistance === 1);
					visual.classList.toggle('is-stack-two', !isActiveVisual && stackDistance === 2);
					visual.classList.toggle('is-stack-three', !isActiveVisual && stackDistance === 3);
					visual.classList.toggle('is-stack-four', !isActiveVisual && stackDistance === 4);
					visual.classList.toggle('is-stack-five', !isActiveVisual && stackDistance === 5);

					if (!isActiveVisual) {
						visual.classList.remove('is-content-active');
						completeWalletCounter(visual);
					} else if (shouldAnimateContent && creatorProcessContentIndex !== index) {
						restartCreatorProcessContent(visual);
						creatorProcessContentIndex = index;
					}
				});

				creatorProcessProgress.forEach((dot, dotIndex) => {
					dot.classList.toggle('is-active', dotIndex === index);
				});
			};

			const updateCreatorProcessStep = () => {
				creatorProcessFrame = null;
				if (!creatorProcessScroll) return;

				const rect = creatorProcessScroll.getBoundingClientRect();
				const scrollDistance = Math.max(1, rect.height - window.innerHeight);
				const processStyles = window.getComputedStyle(creatorProcessScroll);
				const cssStickyOffset = Number.parseFloat(processStyles.getPropertyValue('--creator-process-top-offset'));
				const computedStickyTop =
					creatorProcess instanceof HTMLElement
						? Number.parseFloat(window.getComputedStyle(creatorProcess).top)
						: Number.NaN;
				const stickyOffset =
					window.innerWidth > 980
						? Number.isFinite(computedStickyTop)
							? computedStickyTop
							: Number.isFinite(cssStickyOffset)
								? cssStickyOffset
								: 0
						: 0;
				const progress = Math.min(1, Math.max(0, (stickyOffset - rect.top) / scrollDistance));
				const rawStepProgress = progress * creatorProcessSteps.length;
				const index = Math.min(creatorProcessSteps.length - 1, Math.floor(rawStepProgress));
				const stepProgress = Math.min(1, rawStepProgress - index);
				const shouldAnimateContent = rect.top < window.innerHeight && rect.bottom > stickyOffset;

				setCreatorProcessStep(index, stepProgress, shouldAnimateContent);
			};

			const requestCreatorProcessUpdate = () => {
				if (creatorProcessFrame !== null) return;
				creatorProcessFrame = window.requestAnimationFrame(updateCreatorProcessStep);
			};

			updateCreatorProcessStep();
			window.addEventListener('scroll', requestCreatorProcessUpdate, { passive: true });
			window.addEventListener('resize', requestCreatorProcessUpdate);
		}

		if (creatorProcessFallback && creatorProcessSteps.length && creatorProcessVisuals.length) {
			creatorProcessSteps.forEach((step, index) => {
				const visual = creatorProcessVisuals[index];
				const visualContent = visual?.firstElementChild?.cloneNode(true);
				const stepContent = step.cloneNode(true);
				const fallbackItem = document.createElement('article');
				const visualShell = document.createElement('div');

				fallbackItem.className = 'creator-process-fallback-item';
				visualShell.className = 'creator-process-fallback-visual';
				visualShell.setAttribute('data-process-fallback-visual', String(index));
				stepContent.className = 'creator-process-fallback-copy';
				stepContent.removeAttribute('data-process-step');

				if (visualContent) {
					visualShell.appendChild(visualContent);
				}

				fallbackItem.append(stepContent, visualShell);
				creatorProcessFallback.appendChild(fallbackItem);
			});

			const activateCreatorFallbackVisual = (visual) => {
				if (!(visual instanceof HTMLElement)) return;
				visual.classList.add('is-active', 'is-content-active');
				animateWalletCounter(visual);
			};
			const creatorFallbackVisuals = Array.from(
				creatorProcessFallback.querySelectorAll('.creator-process-fallback-visual'),
			);

			if (reduceCreatorProcessMotion.matches || !('IntersectionObserver' in window)) {
				creatorFallbackVisuals.forEach(activateCreatorFallbackVisual);
			} else {
				const creatorFallbackObserver = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							activateCreatorFallbackVisual(entry.target);
							creatorFallbackObserver.unobserve(entry.target);
						});
					},
					{ threshold: 0.28, rootMargin: '0px 0px -12% 0px' },
				);

				creatorFallbackVisuals.forEach((visual) => creatorFallbackObserver.observe(visual));
			}
		}

	})();
</script>

<style>
	:global(.creator-process-scroll) {
		--creator-process-card-height: 360px;
		--creator-process-top-offset: 124px;
		--creator-process-bottom-offset: 64px;
		--creator-process-content-height: calc(var(--creator-process-card-height) + 120px);
		--creator-process-sticky-offset: calc((100vh - var(--creator-process-content-height)) / 2 + 36px);
		--creator-process-visual-offset-y: -28px;
		display: grid;
		min-height: 540vh;
		grid-template-columns: minmax(0, 1.06fr) minmax(320px, 0.94fr);
		align-items: start;
		gap: clamp(28px, 5vw, 72px);
	}

	.creator-process-pin {
		position: sticky;
		top: var(--creator-process-sticky-offset);
		display: grid;
		min-width: 0;
	}

	.creator-process-visual-stage {
		--creator-process-progress-y: calc(50% + 180px + 32px + var(--creator-process-visual-offset-y));
		position: relative;
		width: 100%;
		height: var(--creator-process-content-height);
		min-height: 420px;
		overflow: hidden;
		border-radius: 28px;
		background: transparent;
	}

	.creator-process-visual {
		position: absolute;
		inset: 0;
		z-index: 1;
		display: grid;
		place-items: center;
		overflow: hidden;
		padding: clamp(34px, 5vw, 74px);
		opacity: 0.06;
		filter: brightness(0.64) saturate(0.86);
		transform: translateY(calc(-70px + var(--creator-process-visual-offset-y))) scale(0.84);
		transform-origin: center center;
		transition:
			filter 720ms cubic-bezier(0.22, 1, 0.36, 1),
			transform 720ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.creator-process-visual.is-active {
		z-index: 5;
		opacity: 1;
		filter: none;
		transform: translateY(var(--creator-process-visual-offset-y)) scale(1);
	}

	.creator-process-visual.is-stack-one {
		z-index: 4;
		opacity: 1;
		filter: brightness(0.94) saturate(0.98);
		transform: translateY(calc(-26px + var(--creator-process-visual-offset-y))) scale(0.92);
	}

	.creator-process-visual.is-stack-two {
		z-index: 3;
		opacity: 1;
		filter: brightness(0.9) saturate(0.96);
		transform: translateY(calc(-50px + var(--creator-process-visual-offset-y))) scale(0.84);
	}

	.creator-process-visual.is-stack-three {
		z-index: 2;
		opacity: 1;
		filter: brightness(0.86) saturate(0.94);
		transform: translateY(calc(-70px + var(--creator-process-visual-offset-y))) scale(0.77);
	}

	.creator-process-visual.is-stack-four {
		z-index: 1;
		opacity: 1;
		filter: brightness(0.82) saturate(0.92);
		transform: translateY(calc(-88px + var(--creator-process-visual-offset-y))) scale(0.71);
	}

	.creator-process-visual.is-stack-five {
		z-index: 0;
		opacity: 1;
		filter: brightness(0.78) saturate(0.9);
		transform: translateY(calc(-104px + var(--creator-process-visual-offset-y))) scale(0.66);
	}

	.creator-process-progress {
		--creator-process-step-progress: 0%;
		position: absolute;
		left: 50%;
		top: clamp(22px, var(--creator-process-progress-y), calc(100% - 10px));
		z-index: 6;
		display: flex;
		justify-content: center;
		gap: 8px;
		pointer-events: none;
		transform: translate(-50%, -50%);
	}

	.creator-process-progress span {
		width: 8px;
		height: 8px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.16);
		transition:
			width 240ms ease,
			background 180ms ease;
	}

	.creator-process-progress span.is-active {
		width: 76px;
		background:
			linear-gradient(
				90deg,
				#CBF300 0 var(--creator-process-step-progress),
				rgba(203, 243, 0, 0.18) var(--creator-process-step-progress) 100%
			);
		box-shadow: inset 0 0 0 1px rgba(203, 243, 0, 0.18);
	}

	.creator-process-copy {
		position: sticky;
		top: var(--creator-process-sticky-offset);
		min-width: 0;
		height: var(--creator-process-content-height);
		min-height: 420px;
	}

	.creator-process-step {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		padding: clamp(104px, calc((var(--creator-process-content-height) - 244px) / 2), 132px) 0 0;
		opacity: 0;
		pointer-events: none;
		transition: opacity 280ms ease;
	}

	.creator-process-step.is-active {
		opacity: 1;
		pointer-events: auto;
	}

	.creator-process-step > span,
	.creator-process-fallback-copy > span {
		display: inline-flex;
		width: fit-content;
		margin-bottom: 22px;
		border: 1px solid rgba(203, 243, 0, 0.16);
		border-radius: 999px;
		background: rgba(203, 243, 0, 0.07);
		padding: 7px 10px;
		color: #CBF300;
		font-family: "Geist Mono", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.creator-process-step h3,
	.creator-process-fallback-copy h3 {
		max-width: 560px;
		margin: 0;
		color: #fff;
		font-family: Manrope, sans-serif;
		font-size: clamp(2rem, 3.8vw, 3.8rem);
		font-weight: 400;
		line-height: 1.08;
		letter-spacing: 0;
	}

	.creator-process-step p,
	.creator-process-fallback-copy p {
		max-width: 520px;
		margin: 22px 0 0;
		color: #a1a1aa;
		font-family: Manrope, sans-serif;
		font-size: clamp(1rem, 1.4vw, 1.2rem);
		line-height: 1.55;
	}

	.creator-process-fallback {
		display: none;
	}

	:global(.creator-process-fallback-item) {
		min-width: 0;
	}

	:global(.creator-process-fallback-visual),
	:global(.creator-process-fallback-copy) {
		min-width: 0;
	}

	.creator-mini-window,
	.creator-balance-card,
	.creator-chat-card,
	.creator-details-sheet,
	.creator-wallet-panel,
	.creator-bulk-panel,
	.creator-withdraw-panel,
	.creator-invoice-doc {
		display: flex;
		width: min(100%, 430px);
