---
import Section from '../../layout/Section.astro';
---

<Section contained={false} spacing="none" class="relative py-20 lg:py-28">
            <div class="garna-container">
                <div class="reveal max-w-5xl text-left font-manrope">
                        <h2 class="max-w-4xl text-left text-4xl font-normal leading-tight text-white lg:text-5xl font-manrope" data-translate="intro.title" data-title-break-after-words="en:4,ru:5,pt:5,es:6">
                            Payroll That Actually Works<br>for Small Businesses
                        </h2>
                </div>

                <div class="reveal mt-10 w-full border-y border-white/10 py-8" style="--delay: 80ms">
                    <div class="grid gap-y-6">
                        <div class="grid gap-4 md:grid-cols-[3.5rem_minmax(0,1fr)]">
                            <span class="font-manrope text-sm font-semibold text-[#5EA500]">01</span>
                            <div>
                                <h3 class="text-base font-semibold text-white font-manrope" data-translate="intro.point1.title">Payroll shouldn’t slow your business down</h3>
                                <p class="mt-2 text-sm leading-6 text-gray-400" data-translate="intro.point1.description">
                                    Payroll shouldn’t slow your business down. For small businesses, payroll can turn into chaos: endless tables, manual recalculation of taxes, and the fear of missing a deadline. Every hour spent on accounting and administration is an hour stolen from your growth.
                                </p>
                            </div>
                        </div>
                        <div class="grid gap-4 md:grid-cols-[3.5rem_minmax(0,1fr)]">
                            <span class="font-manrope text-sm font-semibold text-[#5EA500]">02</span>
                            <div>
                                <h3 class="text-base font-semibold text-white font-manrope" data-translate="intro.point2.title">With Garna, the calculation takes no time</h3>
                            </div>
                        </div>
                        <div class="grid gap-4 md:grid-cols-[3.5rem_minmax(0,1fr)]">
                            <span class="font-manrope text-sm font-semibold text-[#5EA500]">03</span>
                            <div>
                                <h3 class="text-base font-semibold text-white font-manrope" data-translate="intro.point3.title">Save all essentials in one place</h3>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="reveal payroll-routine-visual mt-12 rounded-[24px] border border-white/10 p-4 md:p-6 lg:p-7"
                        style="--delay: 140ms" aria-label="Payroll automation visual" data-translate-aria-label="routineVisual.ariaLabel">
                        <div class="relative z-10 flex items-start justify-between gap-4 border-b border-white/10 pb-5 sm:items-center">
                            <div class="min-w-0">
                                <div class="text-sm font-semibold text-white font-manrope" data-translate="routineVisual.title">Payroll Autopilot</div>
                                <div class="mt-1 text-xs text-gray-500" data-translate="routineVisual.subtitle">Calculating June payroll</div>
                            </div>
                            <div
                                class="routine-pulse shrink-0 rounded-full border border-[#5EA500]/30 bg-[#5EA500]/10 px-3 py-1 text-xs font-semibold text-[#5EA500]">
                                <span data-translate="routineVisual.live">Live</span>
                            </div>
                        </div>

                        <div class="routine-layout-grid relative z-10 mt-6 grid gap-4">
                            <div class="routine-panel rounded-2xl p-4 md:p-5" style="--routine-panel-delay: 0ms;">
                                <div class="text-xs font-semibold uppercase tracking-wide text-gray-500 font-manrope">
                                    <span data-translate="routineVisual.beforeGarna">Before Garna</span>
                                </div>
                                <div class="mt-4 grid min-h-0 grid-rows-3 gap-3">
                                <div class="routine-card routine-card--before routine-card--blue flex items-center rounded-2xl border p-4"
                                    style="--routine-delay: 80ms">
                                    <div class="flex w-full items-center gap-3">
                                        <div
                                            class="routine-before-icon flex h-9 w-9 items-center justify-center rounded-lg">
                                            <iconify-icon icon="solar:document-text-linear" width="19" height="19"></iconify-icon>
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <div class="text-sm font-semibold text-white font-manrope" data-translate="routineVisual.spreadsheets">Spreadsheets</div>
                                            <div class="text-xs text-gray-500" data-translate="routineVisual.rowsCurrencies">18 rows, 4 currencies</div>
                                        </div>
                                        <div class="routine-card__status ml-auto shrink-0 rounded-lg px-2 py-1 text-[11px] text-gray-400">
                                            CSV
                                        </div>
                                    </div>
                                </div>
                                <div class="routine-card routine-card--before routine-card--yellow flex items-center rounded-2xl border p-4"
                                    style="--routine-delay: 180ms">
                                    <div class="flex w-full items-center gap-3">
                                        <div
                                            class="routine-before-icon flex h-9 w-9 items-center justify-center rounded-lg">
                                            <iconify-icon icon="solar:danger-triangle-linear" width="19" height="19"></iconify-icon>
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <div class="text-sm font-semibold text-white font-manrope" data-translate="routineVisual.deadlineRisk">Deadline risk</div>
                                            <div class="text-xs text-gray-500" data-translate="routineVisual.taxTotalsChanged">Tax totals changed manually</div>
                                        </div>
                                        <div class="routine-card__status ml-auto shrink-0 rounded-lg px-2 py-1 text-[11px] text-gray-400">
                                            <span data-translate="routineVisual.openCount">3 open</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="routine-card routine-card--before routine-card--red flex items-center rounded-2xl border p-4"
                                    style="--routine-delay: 280ms">
                                    <div class="flex w-full items-center gap-3">
                                        <div
                                            class="routine-before-icon flex h-9 w-9 items-center justify-center rounded-lg">
                                            <iconify-icon icon="solar:document-add-linear" width="19" height="19"></iconify-icon>
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <div class="text-sm font-semibold text-white font-manrope" data-translate="routineVisual.contracts">Contracts</div>
                                            <div class="text-xs text-gray-500" data-translate="routineVisual.missingInvoiceLinks">Missing invoice links</div>
                                        </div>
                                        <div class="routine-card__status ml-auto shrink-0 rounded-lg px-2 py-1 text-[11px] text-gray-400">
                                            <span data-translate="routineVisual.review">review</span>
                                        </div>
                                    </div>
                                </div>
                                </div>
                            </div>

                            <div class="automation-core rounded-2xl p-4 text-center md:p-5">
                                <div class="relative z-10 flex h-full min-h-[15rem] flex-col justify-between gap-4">
                                    <div class="grid grid-cols-2 gap-2 text-left" data-routine-stat-group data-layout="stacked">
                                        <div class="rounded-xl border border-slate-500/20 bg-slate-500/[0.045] p-2.5">
                                            <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-gray-500">
                                                <span data-translate="routineVisual.rules">Rules</span>
                                            </div>
                                            <div class="routine-stat-row mt-1 text-xs font-semibold leading-4 text-white font-manrope" data-routine-stat-row>
                                                <span class="routine-stat-part" data-translate="routineVisual.matchedRulesNumber">9</span>
                                                <span class="routine-stat-part" data-translate="routineVisual.matchedRulesLabel">matched</span>
                                            </div>
                                        </div>
                                        <div class="rounded-xl border border-slate-500/20 bg-slate-500/[0.045] p-2.5">
                                            <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-gray-500">
                                                <span data-translate="routineVisual.docs">Docs</span>
                                            </div>
                                            <div class="routine-stat-row mt-1 text-xs font-semibold leading-4 text-white font-manrope" data-routine-stat-row>
                                                <span class="routine-stat-part" data-translate="routineVisual.autoLinkedLine1">Auto</span>
                                                <span class="routine-stat-part" data-translate="routineVisual.autoLinkedLine2">linked</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div>
                                        <div class="automation-core__ring mx-auto">
                                            <span class="relative z-10 text-xs font-semibold text-gray-200 font-manrope">70%</span>
                                        </div>
                                        <div class="relative z-10 mt-3 text-[10px] font-semibold uppercase tracking-[0.14em] text-gray-400">
                                            <span data-translate="routineVisual.automationLayer">automation layer</span>
                                        </div>
                                        <div class="relative z-10 mt-1 text-[11px] leading-4 text-gray-500">
                                            <span data-translate="routineVisual.rulesDocsMatched">rules and docs matched</span>
                                        </div>
                                    </div>
                                    <div>
                                        <div class="routine-process-row relative z-10 flex items-center justify-between gap-2">
                                             <span class="relative z-10 h-2 w-2 rounded-full bg-slate-500 shadow-[0_0_12px_rgba(148,163,184,0.42)]"></span>
                                             <span class="relative z-10 h-2 w-2 rounded-full bg-slate-400 shadow-[0_0_12px_rgba(148,163,184,0.42)]"></span>
                                             <span class="relative z-10 h-2 w-2 rounded-full bg-slate-500 shadow-[0_0_12px_rgba(148,163,184,0.42)]"></span>
                                        </div>
                                        <div class="relative z-10 mt-2 grid grid-cols-3 gap-2 text-[10px] font-medium text-gray-500">
                                            <span data-translate="routineVisual.clean">Clean</span>
                                            <span data-translate="routineVisual.calculate">Calculate</span>
                                            <span data-translate="routineVisual.ready">Ready</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="routine-panel routine-panel--after rounded-2xl p-4 md:p-5" style="--routine-panel-delay: 600ms;">
                                <div class="text-xs font-semibold uppercase tracking-wide text-[#5EA500] font-manrope">
                                    <span data-translate="routineVisual.withGarna">With Garna</span>
                                </div>
                                <div class="mt-4 grid min-h-0 grid-rows-3 gap-3">
                                <div class="routine-card routine-card--soft routine-card--green flex items-center rounded-2xl border p-4"
                                    style="--routine-delay: 360ms;">
                                    <div class="flex w-full items-center justify-between gap-3">
                                        <div class="min-w-0 flex-1">
                                            <div class="text-sm font-semibold text-white font-manrope" data-translate="routineVisual.salariesCalculated">Salaries calculated</div>
                                            <div class="text-xs text-gray-500" data-translate="routineVisual.batchPrepared">$79,940 batch prepared</div>
                                        </div>
                                        <div class="ml-auto shrink-0 rounded-lg border border-[#5EA500]/25 bg-[#5EA500]/10 px-2 py-1 text-[11px] font-semibold text-[#5EA500]">
                                             <span data-translate="routineVisual.peopleCount">24 people</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="routine-card routine-card--soft routine-card--green flex items-center rounded-2xl border p-4"
                                    style="--routine-delay: 460ms;">
                                    <div class="flex w-full items-center justify-between gap-3">
                                        <div class="min-w-0 flex-1">
                                            <div class="text-sm font-semibold text-white font-manrope" data-translate="routineVisual.taxesApplied">Taxes applied</div>
                                            <div class="text-xs text-gray-500" data-translate="routineVisual.localRulesMatched">9 local rule sets matched</div>
                                        </div>
                                        <div class="ml-auto shrink-0 rounded-lg border border-[#5EA500]/25 bg-[#5EA500]/10 px-2 py-1 text-[11px] font-semibold text-[#5EA500]">
                                             <span data-translate="routineVisual.passed">passed</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="routine-card routine-card--soft routine-card--green flex items-center rounded-2xl border p-4"
                                    style="--routine-delay: 560ms;">
                                    <div class="flex w-full items-center justify-between gap-3">
                                        <div class="min-w-0 flex-1">
                                            <div class="text-sm font-semibold text-white font-manrope" data-translate="routineVisual.readyToPay">Ready to pay</div>
                                            <div class="text-xs text-gray-500" data-translate="routineVisual.paymentRailsRouted">SWIFT, SEPA, crypto routed</div>
                                        </div>
                                        <div class="ml-auto shrink-0 rounded-lg border border-[#5EA500]/25 bg-[#5EA500]/10 px-2 py-1 text-[11px] font-semibold text-[#5EA500]">
                                             <span data-translate="routineVisual.queued">queued</span>
                                        </div>
                                    </div>
                                </div>
                                </div>
                            </div>
                        </div>
                    </div>
            </div>
        </Section>
