---
import Section from '../../layout/Section.astro';
---

<Section contained={false} spacing="none" class="border-y lg:py-32 border-[#020202]/0 pt-16 pb-16">
        <div class="max-w-7xl mr-auto ml-auto pr-6 pl-6">
            <div class="lg:mb-20 text-center mb-16">
                <h2 class="lg:text-5xl text-4xl font-normal text-white tracking-tight font-manrope mb-6"
                    data-translate="whyGarna.title">Why Garna stands out</h2>
                <p class="text-xl font-light text-gray-400 font-manrope" data-translate="whyGarna.description">Discover
                    the key benefits that make payroll simple, global, and secure</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <div
                    class="glass-card transition-all duration-300 hover:bg-[#0c0c0c] group bg-[#0c0c0c] rounded-2xl pt-8 pr-8 pb-8 pl-8">
                    <div
                        class="w-12 h-12 rounded-xl bg-[#5EA500]/10 flex items-center justify-center text-[#5EA500] mb-6 group-hover:scale-110 transition-transform">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                            data-lucide="clock" aria-hidden="true" class="lucide lucide-clock w-6 h-6">
                            <path d="M12 6v6l4 2"></path>
                            <circle cx="12" cy="12" r="10"></circle>
                        </svg>
                    </div>
                    <h3 class="text-xl font-normal text-white mb-3 font-sans"
                        data-translate="whyGarna.cards.adminTime.title">Cut admin time</h3>
                    <p class="leading-relaxed text-base text-gray-500 font-manrope"
                        data-translate="whyGarna.cards.adminTime.description">Automated contracts and payroll reduce
                        admin work by up to 70%</p>
                </div>

                <div
                    class="glass-card transition-all duration-300 hover:bg-[#0c0c0c] group bg-[#0c0c0c] rounded-2xl pt-8 pr-8 pb-8 pl-8">
                    <div
                        class="w-12 h-12 rounded-xl bg-[#5EA500]/10 flex items-center justify-center text-[#5EA500] mb-6 group-hover:scale-110 transition-transform">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                            data-lucide="wallet" aria-hidden="true" class="lucide lucide-wallet w-6 h-6">
                            <path
                                d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1">
                            </path>
                            <path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-normal text-white mb-3 font-sans"
                        data-translate="whyGarna.cards.topUp.title">Top up via bank or crypto</h3>
                    <p class="leading-relaxed text-base text-gray-500 font-manrope"
                        data-translate="whyGarna.cards.topUp.description">Fund payouts using bank transfers or crypto
                    </p>
                </div>

                <div
                    class="glass-card transition-all duration-300 hover:bg-[#0c0c0c] group bg-[#0c0c0c] rounded-2xl pt-8 pr-8 pb-8 pl-8">
                    <div
                        class="w-12 h-12 rounded-xl bg-[#5EA500]/10 flex items-center justify-center text-[#5EA500] mb-6 group-hover:scale-110 transition-transform">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                            data-lucide="file-text" aria-hidden="true" class="lucide lucide-file-text w-6 h-6">
                            <path
                                d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z">
                            </path>
                            <path d="M14 2v5a1 1 0 0 0 1 1h5"></path>
                            <path d="M10 9H8"></path>
                            <path d="M16 13H8"></path>
                            <path d="M16 17H8"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-normal text-white mb-3 font-sans"
                        data-translate="whyGarna.cards.reporting.title">Perfect reporting</h3>
                    <p class="leading-relaxed text-base text-gray-500 font-manrope"
                        data-translate="whyGarna.cards.reporting.description">Agreements, invoices, transactions, and
                        exports in one place</p>
                </div>

                <div
                    class="glass-card transition-all duration-300 hover:bg-[#0c0c0c] group bg-[#0c0c0c] rounded-2xl pt-8 pr-8 pb-8 pl-8">
                    <div
                        class="w-12 h-12 rounded-xl bg-[#5EA500]/10 flex items-center justify-center text-[#5EA500] mb-6 group-hover:scale-110 transition-transform">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                            data-lucide="lock" aria-hidden="true" class="lucide lucide-lock w-6 h-6">
                            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-normal text-white mb-3 font-sans" data-translate="whyGarna.cards.ip.title">
                        Full ownership of IP</h3>
                    <p class="leading-relaxed text-base text-gray-500 font-manrope"
                        data-translate="whyGarna.cards.ip.description">All contractor work results belong entirely to
                        you</p>
                </div>

                <div
                    class="glass-card transition-all duration-300 hover:bg-[#0c0c0c] group bg-[#0c0c0c] rounded-2xl pt-8 pr-8 pb-8 pl-8">
                    <div
                        class="w-12 h-12 rounded-xl bg-[#5EA500]/10 flex items-center justify-center text-[#5EA500] mb-6 group-hover:scale-110 transition-transform">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                            data-lucide="code-2" aria-hidden="true" class="lucide lucide-code-2 w-6 h-6">
                            <path d="m18 16 4-4-4-4"></path>
                            <path d="m6 8-4 4 4 4"></path>
                            <path d="m14.5 4-5 16"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-normal text-white mb-3 font-sans" data-translate="whyGarna.cards.api.title">
                        Scale with API</h3>
                    <p class="leading-relaxed text-base text-gray-500 font-manrope"
                        data-translate="whyGarna.cards.api.description">Run mass payouts and workflows programmatically
                    </p>
                </div>

                <div
                    class="glass-card flex flex-col transition-all duration-300 hover:bg-[#0c0c0c] hover:border-[#5EA500]/40 group overflow-hidden text-center bg-[#0c0c0c] border-[#5EA500]/20 border rounded-2xl pt-8 pr-8 pb-8 pl-8 relative shadow-[0_0_30px_-10px_rgba(94,165,0,0.1)] items-center justify-center">
                    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-32 h-1 bg-[#5EA500] blur-[20px] opacity-40">
                    </div>

                    <h3 class="text-xl font-normal text-white mb-3 font-sans relative z-10"
                        data-translate="whyGarna.cta.title">Ready to get started?</h3>
                    <p class="leading-relaxed text-base text-gray-500 font-manrope max-w-xs z-10 mb-8 relative"
                        data-translate="whyGarna.cta.description">Join thousands of businesses streamlining their global
                        payroll today</p>

                    <a href="#" onclick="event.preventDefault(); if (window.GarnaWidget) window.GarnaWidget.open({ trackingCta: 'why_garna_demo' });"
                        class="group inline-flex items-center gap-2 transition-all hover:scale-105 text-base font-normal text-white font-manrope bg-[#5EA500] z-10 rounded-xl pt-3 pr-8 pb-3 pl-8 relative shadow-[0_0_20px_-5px_rgba(94,165,0,0.5)]"
                        data-translate="whyGarna.cta.button">Book a demo</a>
                </div>
            </div>
        </div>
    </Section>
