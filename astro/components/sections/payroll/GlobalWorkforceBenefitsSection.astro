---
import Section from '../../layout/Section.astro';
---

<Section contained={false} spacing="none" class="pt-48 pb-24">
            <div class="mx-auto max-w-7xl px-6">
                <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
                    <div class="max-w-xl text-left">
                        <h2 class="font-manrope text-4xl font-normal leading-tight text-white text-left lg:text-5xl" data-translate="globalWorkforce.title">Grow Your Global Workforce Faster</h2>
                        <p data-garna-subtitle class="mt-6 text-lg leading-relaxed text-gray-400" data-translate="globalWorkforce.description">An Employer of Record helps companies hire international employees without opening local entities. Garna legally employs the worker on your behalf while you manage their day-to-day work, responsibilities, and performance</p>
                    </div>
                    <div>
                        <div class="grid gap-4 sm:grid-cols-2">
                            <article class="surface-soft rounded-2xl p-6">
                                <iconify-icon icon="lucide:rocket" width="28" class="text-[#5EA500]"></iconify-icon>
                                <h3 class="mt-5 text-xl font-semibold text-white" data-translate="globalWorkforce.benefits.hireGlobally.title">Hire Globally Faster</h3>
                                <p class="mt-3 text-sm leading-relaxed text-gray-400" data-translate="globalWorkforce.benefits.hireGlobally.description">Bring in talented people from all over the world and make hiring faster than before</p>
                            </article>
                            <article class="surface-soft rounded-2xl p-6">
                                <iconify-icon icon="lucide:map" width="28" class="text-[#5EA500]"></iconify-icon>
                                <h3 class="mt-5 text-xl font-semibold text-white" data-translate="globalWorkforce.benefits.newMarkets.title">Expand Into New Markets</h3>
                                <p class="mt-3 text-sm leading-relaxed text-gray-400" data-translate="globalWorkforce.benefits.newMarkets.description">Test and enter new regions without operational overhead or local entity setup</p>
                            </article>
                            <article class="surface-soft rounded-2xl p-6">
                                <iconify-icon icon="lucide:shield-check" width="28" class="text-[#5EA500]"></iconify-icon>
                                <h3 class="mt-5 text-xl font-semibold text-white" data-translate="globalWorkforce.benefits.reduceRisks.title">Reduce the Risks</h3>
                                <p class="mt-3 text-sm leading-relaxed text-gray-400" data-translate="globalWorkforce.benefits.reduceRisks.description">Prevent mistakes that can arise during hiring and offboarding in different countries</p>
                            </article>
                            <article class="surface-soft rounded-2xl p-6">
                                <iconify-icon icon="lucide:scale" width="28" class="text-[#5EA500]"></iconify-icon>
                                <h3 class="mt-5 text-xl font-semibold text-white" data-translate="globalWorkforce.benefits.compliance.title">Maintain Law Compliance</h3>
                                <p class="mt-3 text-sm leading-relaxed text-gray-400" data-translate="globalWorkforce.benefits.compliance.description">Get global payroll sorted out without juggling a million rules and regulations</p>
                            </article>
                        </div>
                    </div>
                </div>
            </div>
        </Section>
