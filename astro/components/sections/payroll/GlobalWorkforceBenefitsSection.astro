---
import Section from '../../layout/Section.astro';
import Card from '../../ui/Card.astro';
import CardIconVisual from '../../visuals/CardIconVisual.astro';
---

<Section contained={false} spacing="none" class="pt-48 pb-24">
            <div class="mx-auto max-w-7xl px-6">
                <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
                    <div class="max-w-xl text-left lg:sticky lg:top-28 lg:self-start" data-sticky-column>
                        <h2 class="font-manrope text-4xl font-normal leading-tight text-white text-left lg:text-5xl" data-translate="globalWorkforce.title">Grow Your Global Workforce Faster</h2>
                        <p data-garna-subtitle class="mt-6 text-lg leading-relaxed text-gray-400" data-translate="globalWorkforce.description">An Employer of Record helps companies hire international employees without opening local entities. Garna legally employs the worker on your behalf while you manage their day-to-day work, responsibilities, and performance</p>
                    </div>
                    <div>
                        <div class="grid gap-4 sm:grid-cols-2" data-eor-benefit-cards>
                            <Card class="p-6" title={{ text: 'Hire Globally Faster', translateKey: 'globalWorkforce.benefits.hireGlobally.title' }} description={{ text: 'Bring in talented people from all over the world and make hiring faster than before', translateKey: 'globalWorkforce.benefits.hireGlobally.description' }}>
                                <CardIconVisual slot="visual" icon="lucide:rocket" />
                            </Card>
                            <Card class="p-6" title={{ text: 'Expand Into New Markets', translateKey: 'globalWorkforce.benefits.newMarkets.title' }} description={{ text: 'Test and enter new regions without operational overhead or local entity setup', translateKey: 'globalWorkforce.benefits.newMarkets.description' }}>
                                <CardIconVisual slot="visual" icon="lucide:map" />
                            </Card>
                            <Card class="p-6" title={{ text: 'Reduce the Risks', translateKey: 'globalWorkforce.benefits.reduceRisks.title' }} description={{ text: 'Prevent mistakes that can arise during hiring and offboarding in different countries', translateKey: 'globalWorkforce.benefits.reduceRisks.description' }}>
                                <CardIconVisual slot="visual" icon="lucide:shield-check" />
                            </Card>
                            <Card class="p-6" title={{ text: 'Maintain Law Compliance', translateKey: 'globalWorkforce.benefits.compliance.title' }} description={{ text: 'Get global payroll sorted out without juggling a million rules and regulations', translateKey: 'globalWorkforce.benefits.compliance.description' }}>
                                <CardIconVisual slot="visual" icon="lucide:scale" />
                            </Card>
                        </div>
                    </div>
                </div>
            </div>
        </Section>
