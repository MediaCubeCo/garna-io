---
import Section from '../../layout/Section.astro';
import Card from '../../ui/Card.astro';
import Button from '../../ui/Button.astro';
---

<Section contained={false} spacing="none" class="pt-48 pb-24">
            <div class="mx-auto max-w-7xl px-6">
                <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
                    <div class="max-w-xl text-left">
                        <h2 class="font-manrope text-4xl font-normal leading-tight text-white text-left lg:text-5xl" data-translate="globalWorkforce.title">Grow Your Global Workforce Faster</h2>
                        <p data-garna-subtitle class="mt-6 text-lg leading-relaxed text-gray-400" data-translate="globalWorkforce.description">As your Employer of Record, Garna manages legal employment, payroll, and compliance while you manage employees' day-to-day activities</p>
                        <div class="mt-8">
                            <Button
                                href="#"
                                onclick="event.preventDefault(); if (window.GarnaWidget) window.GarnaWidget.open({ trackingCta: 'eor_workforce_benefits_demo' });"
                                variant="primary"
                                effect="none"
                                icon="none"
                                size="header"
                                class="w-fit"
                            >
                                <span data-translate="dashboardCta.button">Book a demo</span>
                            </Button>
                        </div>
                    </div>
                    <div>
                        <div class="grid gap-4 sm:grid-cols-2" data-eor-benefit-cards>
                            <Card class="p-6" title={{ text: 'Hire Globally Faster', translateKey: 'globalWorkforce.benefits.hireGlobally.title' }} description={{ text: 'Bring in talent from anywhere and onboard in days, not months', translateKey: 'globalWorkforce.benefits.hireGlobally.description' }}>
                                <iconify-icon slot="visual" icon="lucide:timer-reset" width="24" height="24" class="mb-5 block h-6 w-6 text-[#CBF300]" aria-hidden="true"></iconify-icon>
                            </Card>
                            <Card class="p-6" title={{ text: 'Expand Into New Markets', translateKey: 'globalWorkforce.benefits.newMarkets.title' }} description={{ text: 'Test and enter new regions without operational overhead', translateKey: 'globalWorkforce.benefits.newMarkets.description' }}>
                                <iconify-icon slot="visual" icon="lucide:map-pinned" width="24" height="24" class="mb-5 block h-6 w-6 text-[#CBF300]" aria-hidden="true"></iconify-icon>
                            </Card>
                            <Card class="p-6" title={{ text: 'Reduce Global Hiring Costs', translateKey: 'globalWorkforce.benefits.reduceRisks.title' }} description={{ text: 'Avoid the burden of multiple providers, entities, and payment solutions', translateKey: 'globalWorkforce.benefits.reduceRisks.description' }}>
                                <iconify-icon slot="visual" icon="lucide:circle-dollar-sign" width="24" height="24" class="mb-5 block h-6 w-6 text-[#CBF300]" aria-hidden="true"></iconify-icon>
                            </Card>
                            <Card class="p-6" title={{ text: 'Maintain Law Compliance', translateKey: 'globalWorkforce.benefits.compliance.title' }} description={{ text: 'Local labor law, tax, and social contributions, handled per country', translateKey: 'globalWorkforce.benefits.compliance.description' }}>
                                <iconify-icon slot="visual" icon="lucide:file-check-2" width="24" height="24" class="mb-5 block h-6 w-6 text-[#CBF300]" aria-hidden="true"></iconify-icon>
                            </Card>
                        </div>
                    </div>
                </div>
            </div>
        </Section>
