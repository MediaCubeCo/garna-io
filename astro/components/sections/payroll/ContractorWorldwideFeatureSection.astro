---
import Section from '../../layout/Section.astro';
import SectionHeader from '../../layout/SectionHeader.astro';
import Button from '../../ui/Button.astro';
---

<Section spacing="default" contentClass="contractor-worldwide-feature-content">
	<div class="contractor-worldwide-feature">
		<div class="contractor-worldwide-feature__visual" data-contractor-cost-visual aria-hidden="true">
			<img src="/pages/payroll-solution-new/assets/contractor-cost-human-upscaled.jpg" alt="" loading="lazy" />
			<div class="contractor-worldwide-feature__shade"></div>
			<div class="contractor-worldwide-feature__notice contractor-worldwide-feature__notice--quote">
				<div class="contractor-worldwide-feature__quote-top">
					<span data-translate="contractorCost.visual.estimate">Monthly cost estimate</span>
					<strong data-translate="contractorCost.visual.ready">Ready</strong>
				</div>
				<div class="contractor-worldwide-feature__quote-main">
					<strong>$18,420</strong>
					<span data-translate="contractorCost.visual.description">Fees, FX, admin time, and compliance in one view</span>
				</div>
			</div>
		</div>

		<div class="contractor-worldwide-feature__copy">
			<SectionHeader
				align="left"
				title={{ text: 'See What Global Contractor Management Costs You', translateKey: 'contractorCost.title' }}
				description={{ text: 'Contractor fees are only part of the cost. Consider payment fees, FX, admin time, compliance, and multiple software subscriptions', translateKey: 'contractorCost.description' }}
				descriptionClass="max-w-[31rem]"
			/>
			<div class="contractor-worldwide-feature__controls">
				<Button
					href="#"
					size="header"
					variant="primary"
					effect="none"
					icon="none"
					onclick="event.preventDefault(); if (window.GarnaWidget) window.GarnaWidget.open({ trackingCta: 'contractor_worldwide_demo' });"
				>
					<span data-translate="contractorCost.button">Get a Custom Quote</span>
				</Button>
			</div>
		</div>
	</div>
</Section>

<script>
	const setupContractorCostNotice = () => {
		const visuals = document.querySelectorAll<HTMLElement>('[data-contractor-cost-visual]');
		if (!visuals.length) return;

		const designWidth = 438;
		const designLeft = 32;
		const designBottom = 28;

		const syncNoticeScale = (visual: HTMLElement) => {
			const width = visual.getBoundingClientRect().width;
			const isAdaptiveStackedLayout = window.matchMedia('(min-width: 561px) and (max-width: 900px)').matches;
			const scale = !isAdaptiveStackedLayout && width > 0 ? width / designWidth : 1;
			visual.style.setProperty('--contractor-cost-notice-scale', scale.toString());
			visual.style.setProperty('--contractor-cost-notice-left', `${designLeft * scale}px`);
			visual.style.setProperty('--contractor-cost-notice-bottom', `${designBottom * scale}px`);
		};

		visuals.forEach((visual) => {
			syncNoticeScale(visual);

			if ('ResizeObserver' in window) {
				const observer = new ResizeObserver(() => syncNoticeScale(visual));
				observer.observe(visual);
				return;
			}

			window.addEventListener('resize', () => syncNoticeScale(visual), { passive: true });
		});
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', setupContractorCostNotice, { once: true });
	} else {
		setupContractorCostNotice();
	}
</script>

<style>
	:global(.contractor-worldwide-feature-content) {
		display: block;
	}

	.contractor-worldwide-feature {
		display: grid;
		grid-template-columns: minmax(0, 0.88fr) minmax(18rem, 1.12fr);
		align-items: center;
		gap: clamp(2.5rem, 7vw, 7rem);
	}

	.contractor-worldwide-feature__copy {
		max-width: 34rem;
		text-align: left;
	}

	.contractor-worldwide-feature__controls {
		display: flex;
		margin-top: 2.5rem;
	}

	.contractor-worldwide-feature__visual {
		--contractor-cost-notice-scale: 1;
		--contractor-cost-notice-left: 2rem;
		--contractor-cost-notice-bottom: 1.75rem;
		position: relative;
		min-height: clamp(30rem, 47vw, 38rem);
		overflow: hidden;
		border: 1px solid rgb(255 255 255 / 0.1);
		border-radius: 1.75rem;
		background: #0a0a0a;
		box-shadow: 0 32px 90px -56px rgb(0 0 0 / 0.95);
	}

	.contractor-worldwide-feature__visual > img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 34% center;
		transform: scale(1.24);
		transform-origin: center bottom;
		filter: brightness(0.94) contrast(1.04) saturate(0.98);
	}

	.contractor-worldwide-feature__shade {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgb(0 0 0 / 0.02), rgb(0 0 0 / 0.2)),
			linear-gradient(90deg, rgb(0 0 0 / 0.02), rgb(0 0 0 / 0.16));
	}

	.contractor-worldwide-feature__notice {
		position: absolute;
		right: clamp(1rem, 3vw, 2rem);
		bottom: clamp(1rem, 3vw, 2rem);
		left: clamp(1rem, 3vw, 2rem);
		z-index: 2;
		display: flex;
		min-height: 4.7rem;
		align-items: center;
		gap: 0.85rem;
		border: 1px solid rgb(255 255 255 / 0.12);
		border-radius: 1.25rem;
		background: rgb(7 8 10 / 0.72);
		padding: 0.68rem 0.9rem;
		color: #fff;
		text-align: left;
		backdrop-filter: blur(14px);
	}

	.contractor-worldwide-feature__notice--quote {
		display: grid;
		right: auto;
		bottom: var(--contractor-cost-notice-bottom);
		left: var(--contractor-cost-notice-left);
		width: 23.5rem;
		height: 6rem;
		box-sizing: border-box;
		min-height: 0;
		align-items: stretch;
		gap: 0.44rem;
		border-radius: 1.25rem;
		padding: 0.88rem 1rem;
		transform: scale(var(--contractor-cost-notice-scale));
		transform-origin: left bottom;
	}

	.contractor-worldwide-feature__quote-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.contractor-worldwide-feature__quote-top span {
		color: rgb(255 255 255 / 0.58);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.contractor-worldwide-feature__quote-top strong {
		border-radius: 9999px;
		background: #cbf300;
		padding: 0.34rem 0.58rem;
		color: #080808;
		font-size: 0.62rem;
		font-weight: 800;
		line-height: 1;
		text-transform: uppercase;
	}

	.contractor-worldwide-feature__quote-main {
		display: grid;
		grid-template-columns: 10.9rem minmax(0, 1fr);
		align-items: end;
		gap: 0.75rem;
	}

	.contractor-worldwide-feature__quote-main strong {
		color: #fff;
		font-family: Manrope, sans-serif;
		font-size: 2.55rem;
		font-weight: 700;
		line-height: 1;
		letter-spacing: 0;
	}

	.contractor-worldwide-feature__quote-main span {
		justify-self: end;
		width: 9.35rem;
		color: rgb(255 255 255 / 0.68);
		font-size: 0.78rem;
		font-weight: 600;
		line-height: 1.28;
		text-align: right;
	}

	.contractor-worldwide-feature__avatar {
		position: relative;
		flex: 0 0 3.1rem;
		width: 3.1rem;
		height: 3.1rem;
	}

	.contractor-worldwide-feature__avatar > img {
		width: 100%;
		height: 100%;
		border-radius: 9999px;
		object-fit: cover;
	}

	.contractor-worldwide-feature__avatar > span {
		position: absolute;
		right: -0.12rem;
		bottom: -0.08rem;
		display: grid;
		width: 1rem;
		height: 1rem;
		place-items: center;
		border-radius: 9999px;
		background: #cbf300;
		color: #080808;
		font-size: 0.58rem;
		font-weight: 800;
	}

	.contractor-worldwide-feature__notice-copy {
		display: flex;
		min-width: 0;
		flex: 1;
		flex-direction: column;
		gap: 0.22rem;
	}

	.contractor-worldwide-feature__notice-copy strong {
		overflow: hidden;
		color: #fff;
		font-size: 0.98rem;
		font-weight: 650;
		line-height: 1.15;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.contractor-worldwide-feature__notice-copy small {
		overflow: hidden;
		color: rgb(255 255 255 / 0.64);
		font-size: 0.76rem;
		line-height: 1.2;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.contractor-worldwide-feature__badge {
		position: absolute;
		top: 0.95rem;
		right: 0.9rem;
		border-radius: 9999px;
		background: #cbf300;
		padding: 0.32rem 0.48rem;
		color: #080808;
		font-size: 0.55rem;
		font-weight: 800;
		line-height: 1;
		text-transform: uppercase;
	}

	@media (max-width: 900px) {
		.contractor-worldwide-feature {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.contractor-worldwide-feature__copy {
			order: 1;
			max-width: 38rem;
		}

		.contractor-worldwide-feature__visual {
			order: 2;
			min-height: auto;
			aspect-ratio: 1.18;
			border-radius: 1.35rem;
		}

		.contractor-worldwide-feature__notice--quote {
			right: clamp(1rem, 3vw, 2rem);
			bottom: clamp(1rem, 3vw, 2rem);
			left: clamp(1rem, 3vw, 2rem);
			width: auto;
			height: auto;
			min-height: 6.3rem;
			transform: none;
		}
	}

	@media (max-width: 560px) {
		.contractor-worldwide-feature {
			gap: 2rem;
		}

		.contractor-worldwide-feature__controls {
			margin-top: 2rem;
		}

		.contractor-worldwide-feature__visual {
			aspect-ratio: 0.9;
			border-radius: 1.25rem;
		}

		.contractor-worldwide-feature__notice {
			border-radius: 1rem;
		}

		.contractor-worldwide-feature__notice--quote {
			right: auto;
			bottom: var(--contractor-cost-notice-bottom);
			left: var(--contractor-cost-notice-left);
			width: 23.5rem;
			height: 6rem;
			border-radius: 1.25rem;
			min-height: 0;
			padding: 0.88rem 1rem;
			transform: scale(var(--contractor-cost-notice-scale));
		}

		.contractor-worldwide-feature__quote-main {
			grid-template-columns: 10.9rem minmax(0, 1fr);
			gap: 0.75rem;
		}

		.contractor-worldwide-feature__quote-main span {
			justify-self: end;
			width: 9.35rem;
			text-align: right;
		}
	}
</style>
