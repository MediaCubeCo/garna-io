---
import Section from '../../layout/Section.astro';

interface Props {
	audience?: 'enterprise' | 'growing';
}

const { audience = 'enterprise' } = Astro.props;
const copy = {
	enterprise: {
		title: 'Garna Solutions for Enterprises',
		contractorsTitle: 'Pay Global Contractors in 3 Clicks',
		contractorsDescription: "With Garna, you can cut administrative costs and manage contractor onboarding, invoicing, and compliance regulations. Get their pay out to them with ease, no matter where they're based or how many of them you have. API payments set up lets enterprises automate contractor payouts straight from their own system",
		employeesDescription: "No need to open up local offices in different countries just to get the right people on board. That's where the employer of record superstructure comes at hand. This lets you hire people across the world while all the usual employer duties get taken care of: payroll, compliance, taxes, and the local employment rules",
	},
	growing: {
		title: 'Garna Solutions for Growing Businesses',
		contractorsTitle: 'Pay Global Contractors',
		contractorsDescription: 'Run payroll for all your employees, freelancers, and contractors from one single system. Garna simplifies payroll by automating all the key elements, like calculations, payments and compliance processes, so you can focus on growth without the stress of manual paperwork',
		employeesDescription: 'Need to hire and pay team members in loads of different countries? No need to build a separate payroll system for each one. Garna lets you automate your payroll, cut down on compliance risks and manage international staff from one easy-to-use hub',
	},
}[audience];
---

<Section contained={false} spacing="none" class="py-16 lg:py-28">
        <div class="max-w-7xl mr-auto ml-auto pr-6 pl-6">
            <div class="mx-auto max-w-4xl text-center">
                <h2 class="text-4xl font-normal tracking-tight text-white font-manrope lg:text-5xl" data-translate="solutions.title">{copy.title}</h2>
            </div>

            <div class="mt-12 rounded-2xl border border-white/10 bg-[#0b0b0b] p-6 md:p-10 lg:p-12">
                <div class="grid items-stretch gap-10 md:grid-cols-2 md:gap-0">
                    <div class="flex flex-col md:pr-10 lg:pr-14">
                        <h3 class="text-2xl font-semibold text-white font-manrope" data-translate="solutions.contractors.title">{copy.contractorsTitle}</h3>
                        <p class="mt-6 text-base leading-relaxed text-gray-400 font-manrope md:text-lg" data-translate="solutions.contractors.description">{copy.contractorsDescription}</p>
                        <a href="/en/contractor-of-record" class="group mt-auto inline-flex w-fit items-center gap-2 pt-8 font-manrope text-base font-normal text-[#5EA500] transition-colors duration-200 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#5EA500]">
                            <span data-translate="common.learnMore">Learn more</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                                stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                                class="h-5 w-5 transition-transform duration-200 group-hover:translate-x-1">
                                <path d="M5 12h14"></path>
                                <path d="m12 5 7 7-7 7"></path>
                            </svg>
                        </a>
                    </div>

                    <div class="flex flex-col border-t border-white/10 pt-10 md:border-l md:border-t-0 md:pl-10 md:pt-0 lg:pl-14">
                        <h3 class="text-2xl font-semibold text-white font-manrope" data-translate="solutions.employees.title">Hire Employees Worldwide</h3>
                        <p class="mt-6 text-base leading-relaxed text-gray-400 font-manrope md:text-lg" data-translate="solutions.employees.description">{copy.employeesDescription}</p>
                        <a href="/en/employer-of-record" class="group mt-auto inline-flex w-fit items-center gap-2 pt-8 font-manrope text-base font-normal text-[#5EA500] transition-colors duration-200 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#5EA500]">
                            <span data-translate="common.learnMore">Learn more</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                                stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                                class="h-5 w-5 transition-transform duration-200 group-hover:translate-x-1">
                                <path d="M5 12h14"></path>
                                <path d="m12 5 7 7-7 7"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </Section>
