---
import Button from '../../ui/Button.astro';
import HeroStatsRow from '../../ui/HeroStatsRow.astro';

const stats = [
	{
		value: '400+',
		label: 'businesses using Garna',
		labelKey: 'homeProof.stats.businesses.label',
	},
	{
		value: '$110M+',
		label: 'paid to specialists',
		labelKey: 'homeProof.stats.paid.label',
	},
	{
		value: '38 000+',
		label: 'talents already use Garna',
		labelKey: 'homeProof.stats.talents.label',
	},
];

const heroMedia = {
	video: '/pages/payroll-solution-new/assets/contractor-hero-background.mp4?v=5d095151',
};
---

<section class="contractor-hero" data-section-kind="hero">
	<div class="contractor-hero__media" aria-hidden="true">
		<video
			class="contractor-hero__video"
			src={heroMedia.video}
			autoplay
			muted
			loop
			playsinline
			preload="auto"
		></video>
	</div>

	<div class="contractor-hero__grid mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-[minmax(0,0.62fr)_minmax(0,0.38fr)] lg:items-center lg:gap-14">
		<div class="contractor-hero__copy">
			<div class="contractor-hero__text">
				<h1 class="garna-hero-title-gradient" data-translate="hero.title">Pay Contractors Anywhere, Without the Hassle</h1>
				<p data-garna-subtitle data-translate="hero.description">
					One transfer — countless possibilities. Pay remunerations in over 150 countries with minimal effort
				</p>
			</div>

			<Button
				href="#"
				variant="primary"
				size="hero"
				effect="rotating-flare"
				icon="arrow-up-right"
				class="contractor-hero__cta w-fit"
				onclick="event.preventDefault(); if (window.GarnaWidget) window.GarnaWidget.open({ trackingCta: 'hero_demo' });"
			>
				<span data-translate="hero.cta">Book a demo</span>
			</Button>

			<HeroStatsRow stats={stats} ariaLabel="Garna contractor proof points" />
		</div>

		<div class="contractor-hero__space" aria-hidden="true"></div>
	</div>
</section>

<style>
	.contractor-hero {
		--contractor-hero-video-right: 0px;
		--contractor-hero-video-width: min(82.08rem, 84.24vw);
		--contractor-hero-video-reveal-start: clamp(18rem, 28vw, 24rem);
		--contractor-hero-video-reveal-end: calc(var(--contractor-hero-video-reveal-start) + clamp(24rem, 36vw, 32rem));
		--contractor-hero-video-mask-solid: 52%;
		--contractor-hero-video-mask-clear: 82%;
		--garna-hero-stat-value-size: clamp(1.55rem, 1.8vw, 1.95rem);
		--garna-hero-stat-label-size: clamp(0.82rem, 0.9vw, 0.875rem);
		--garna-hero-stat-value-size-tablet: clamp(1.4rem, 2.4vw, 1.55rem);
		--garna-hero-stat-label-size-tablet: clamp(0.8rem, 1.2vw, 0.82rem);
		--garna-hero-stat-value-size-mobile: clamp(1.25rem, 4.4vw, 1.4rem);
		--garna-hero-stat-label-size-mobile: clamp(0.75rem, 2.8vw, 0.8rem);
		position: relative;
		display: flex;
		box-sizing: border-box;
		width: 100%;
		height: auto;
		min-height: 100vh;
		min-height: 100dvh;
		align-items: stretch;
		overflow: hidden;
		padding: clamp(8.5rem, 13vw, 12rem) 0 clamp(4.5rem, 8vw, 7rem);
		color: #ffffff;
		isolation: isolate;
		background: #101010;
	}

	.contractor-hero::before,
	.contractor-hero::after {
		position: absolute;
		z-index: 1;
		pointer-events: none;
	}

	.contractor-hero::before {
		content: none;
	}

	.contractor-hero::after {
		content: '';
		inset: 0;
		width: auto;
		background:
			linear-gradient(180deg, rgb(16 16 16 / 0.16), transparent 20%, transparent 74%, rgb(16 16 16 / 0.2)),
			rgb(16 16 16 / 0.14);
	}

	.contractor-hero__media {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.contractor-hero__media::after {
		content: none;
	}

	.contractor-hero__video {
		position: absolute;
		top: 0;
		right: var(--contractor-hero-video-right);
		bottom: auto;
		left: auto;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 32% 50%;
		opacity: 1;
		-webkit-mask-image: linear-gradient(
			90deg,
			transparent 0,
			transparent var(--contractor-hero-video-reveal-start),
			#000 var(--contractor-hero-video-reveal-end)
		);
		mask-image: linear-gradient(
			90deg,
			transparent 0,
			transparent var(--contractor-hero-video-reveal-start),
			#000 var(--contractor-hero-video-reveal-end)
		);
	}

	.contractor-hero__grid,
	.contractor-hero__copy,
	.contractor-hero__space {
		position: relative;
		z-index: 2;
	}

	.contractor-hero__grid {
		flex: 1;
	}

	.contractor-hero__copy {
		display: flex;
		width: 100%;
		min-height: min(40rem, calc(100svh - clamp(13rem, 21vw, 19rem)));
		flex-direction: column;
		align-items: flex-start;
		text-align: left;
	}

	.contractor-hero__text {
		width: 100%;
	}

	.contractor-hero__copy h1 {
		margin: 0;
		max-width: 18ch;
		padding-bottom: 0.1em;
		font-family: Manrope, sans-serif;
		font-size: 2.75rem;
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: 0;
	}

	.contractor-hero__copy p {
		max-width: 36rem;
		margin: 1.25rem 0 0;
		color: rgb(255 255 255 / 0.62);
		font-family: Manrope, sans-serif;
		font-size: 1.125rem;
		font-weight: 500;
		line-height: 1.58;
	}

	:global(.contractor-hero__cta) {
		margin-top: 2.5rem;
	}

	:global(.contractor-hero .garna-hero-stats-row) {
		margin-top: auto;
		padding-top: clamp(3.5rem, 8svh, 6rem);
	}

	.contractor-hero__space {
		min-height: min(40rem, calc(100svh - clamp(13rem, 21vw, 19rem)));
	}

	@media (min-width: 768px) {
		.contractor-hero__copy h1 {
			font-size: 3.35rem;
		}

		.contractor-hero__copy p {
			font-size: 1.25rem;
		}
	}

	@media (min-width: 1024px) {
		.contractor-hero__copy h1 {
			font-size: 54px;
		}
	}

	@media (min-width: 1024px) and (max-width: 1099px) {
		.contractor-hero__copy p {
			max-width: 29rem;
		}
	}

	@media (min-width: 1100px) {
		.contractor-hero__copy h1 {
			font-size: 58px;
		}
	}

	@media (min-width: 1280px) {
		.contractor-hero__copy h1 {
			font-size: 64px;
		}
	}

	@media (min-width: 1200px) and (max-width: 1279px) {
		.contractor-hero__video {
			object-position: 42% 50%;
		}
	}

	@media (min-width: 1100px) and (max-width: 1199px) {
		.contractor-hero__video {
			object-position: 50% 50%;
		}
	}

	@media (min-width: 1024px) and (max-width: 1099px) {
		.contractor-hero__video {
			object-position: 60% 50%;
		}
	}

	@media (min-width: 1600px) {
		.contractor-hero__video {
			transform: translateX(clamp(3rem, 3.25vw, 4rem));
		}
	}

	@media (max-width: 1023px) {
		.contractor-hero {
			--contractor-hero-video-reveal-start: 20%;
			--contractor-hero-video-reveal-end: 68%;
			--contractor-hero-video-mask-solid: 42%;
			--contractor-hero-video-mask-clear: 82%;
			height: auto;
			min-height: 100vh;
			min-height: 100dvh;
			padding: 7rem 0 clamp(4rem, 9vw, 5.5rem);
		}

		.contractor-hero::before {
			content: none;
		}

		.contractor-hero::after {
			content: '';
			inset: 0;
			width: auto;
			background: rgb(16 16 16 / 0.28);
		}

		.contractor-hero__grid {
			gap: clamp(2.65rem, 7vw, 4rem);
		}

		.contractor-hero__copy {
			min-height: 0;
			max-width: 47rem;
		}

		.contractor-hero__space {
			min-height: clamp(10rem, 28vw, 16rem);
		}

		.contractor-hero__video {
			inset: 0;
			width: 100%;
			height: 100%;
			opacity: 1;
			object-position: 62% center;
		}
	}

	@media (min-width: 768px) and (max-width: 1023px) {
		.contractor-hero {
			--contractor-hero-video-reveal-start: 14%;
			--contractor-hero-video-reveal-end: 52%;
			--contractor-hero-video-mask-solid: 48%;
			--contractor-hero-video-mask-clear: 86%;
		}

		.contractor-hero__grid {
			align-items: center;
		}

		.contractor-hero__copy {
			min-height: min(34rem, calc(100svh - 17rem));
			transform: translateY(clamp(2.5rem, 6svh, 4rem));
		}

		.contractor-hero__copy p {
			max-width: 26rem;
		}

		:global(.contractor-hero .garna-hero-stats-row) {
			margin-top: auto;
			padding-top: clamp(3.5rem, 8svh, 5rem);
		}
	}

	@media (max-width: 767px) and (min-height: 720px) {
		.contractor-hero__copy {
			min-height: min(43rem, calc(100svh - 12.5rem));
		}

		:global(.contractor-hero .garna-hero-stats-row) {
			margin-top: auto;
		}
	}

	@media (min-width: 641px) and (max-width: 767px) {
		.contractor-hero__grid {
			align-items: center;
		}

		.contractor-hero__copy {
			min-height: min(34rem, calc(100svh - 17rem));
		}

		.contractor-hero__copy p {
			max-width: 25.5rem;
		}
	}

	@media (min-width: 641px) and (max-width: 1023px) and (max-height: 680px) {
		.contractor-hero__copy {
			min-height: auto;
			transform: none;
		}

		:global(.contractor-hero .garna-hero-stats-row) {
			margin-top: clamp(3.5rem, 8svh, 5rem);
			padding-top: 0;
		}
	}

	@media (min-width: 480px) and (max-width: 640px) {
		.contractor-hero {
			--contractor-hero-video-reveal-start: 18%;
			--contractor-hero-video-reveal-end: 58%;
			--contractor-hero-video-mask-solid: 38%;
			--contractor-hero-video-mask-clear: 80%;
		}

		.contractor-hero__copy p {
			max-width: 20rem;
		}
	}

	@media (min-width: 480px) and (max-width: 640px) and (max-height: 720px) {
		:global(.contractor-hero .garna-hero-stats-row) {
			margin-top: clamp(3.5rem, 8svh, 5rem);
		}
	}

	@media (orientation: landscape) and (max-height: 680px) {
		.contractor-hero {
			height: auto;
			min-height: 100vh;
			min-height: 100dvh;
			padding: clamp(5.5rem, 22svh, 7rem) 0 clamp(1rem, 5svh, 2rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contractor-hero__video {
			animation: none;
		}
	}
</style>
