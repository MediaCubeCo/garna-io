---
import Section from '../../layout/Section.astro';
---

<Section contained={false} spacing="none" class="relative py-20 lg:py-28">
            <div class="garna-container">
                <div class="grid gap-12 lg:grid-cols-[0.82fr_1.18fr]">
                    <div class="reveal text-left">
                        <h2 class="text-left text-4xl font-normal leading-tight text-white lg:text-5xl font-manrope" data-translate="why.title">
                            Why Small Businesses Choose Payroll Solution by Garna
                        </h2>
                        <p data-garna-subtitle class="mt-5 text-left text-xl font-light leading-8 text-gray-400 font-manrope" data-translate="why.description">
                            Our advantages that save you time and money
                        </p>
                    </div>
                    <div class="grid gap-4 md:grid-cols-2">
                        <div class="reveal why-card rounded-2xl border p-5" style="--delay: 40ms">
                            <iconify-icon icon="solar:document-text-linear" class="mb-4 text-2xl text-[#CBF300]"></iconify-icon>
                            <h3 class="font-semibold text-white font-manrope" data-translate="why.item1.title">Reducing the admin by 70%</h3>
                            <p class="mt-2 text-sm leading-6 text-gray-400" data-translate="why.item1.description">Automated contracts and calculations free you from working with documentation</p>
                        </div>
                        <div class="reveal why-card rounded-2xl border p-5" style="--delay: 80ms">
                            <iconify-icon icon="solar:chart-square-linear" class="mb-4 text-2xl text-[#CBF300]"></iconify-icon>
                            <h3 class="font-semibold text-white font-manrope" data-translate="why.item2.title">Transparent reporting</h3>
                            <p class="mt-2 text-sm leading-6 text-gray-400" data-translate="why.item2.description">All contracts, invoices, and transactions are available in one place within the service</p>
                        </div>
                        <div class="reveal why-card rounded-2xl border p-5" style="--delay: 120ms">
                            <iconify-icon icon="solar:tag-price-linear" class="mb-4 text-2xl text-[#CBF300]"></iconify-icon>
                            <h3 class="font-semibold text-white font-manrope" data-translate="why.item3.title">No hidden fees</h3>
                            <p class="mt-2 text-sm leading-6 text-gray-400" data-translate="why.item3.description">Clear and transparent pricing, adapted to your budget</p>
                        </div>
                        <div class="reveal why-card rounded-2xl border p-5" style="--delay: 160ms">
                            <iconify-icon icon="solar:code-square-linear" class="mb-4 text-2xl text-[#CBF300]"></iconify-icon>
                            <h3 class="font-semibold text-white font-manrope" data-translate="why.item4.title">Scalability via API</h3>
                            <p class="mt-2 text-sm leading-6 text-gray-400" data-translate="why.item4.description">Launch mass payouts automatically as your business grows</p>
                        </div>
                        <div class="reveal why-card rounded-2xl border p-5 md:col-span-2" style="--delay: 200ms">
                            <iconify-icon icon="solar:headphones-round-linear" class="mb-4 text-2xl text-[#CBF300]"></iconify-icon>
                            <h3 class="font-semibold text-white font-manrope" data-translate="why.item5.title">24/7 support</h3>
                            <p class="mt-2 text-sm leading-6 text-gray-400" data-translate="why.item5.description">Our personal team of experts is always in touch with you and your team</p>
                        </div>
                    </div>
                </div>
            </div>
        </Section>
