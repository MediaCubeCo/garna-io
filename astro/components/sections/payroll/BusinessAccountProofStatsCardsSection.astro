---
import Section from '../../layout/Section.astro';

type ProofStat = {
	value: string;
	label: string;
	labelKey?: string;
	image: string;
	alt: string;
	featured?: boolean;
	imagePosition?: string;
	imageOrigin?: string;
	imageOffsetY?: string;
	imageScale?: number;
	notice: {
		icon: 'check' | 'receipt' | 'transfer' | 'contract' | 'payroll' | 'calculator';
		label?: string;
		labelKey?: string;
		status?: string;
		statusKey?: string;
		title: string;
		titleKey?: string;
		meta: string;
		metaKey?: string;
		detail?: string;
		detailKey?: string;
		amount?: string;
		timestamp?: string;
		timestampKey?: string;
		method?: string;
		endpoint?: string;
		responseTime?: string;
		paymentId?: string;
		amountLabel?: string;
		statusLabel?: string;
		statusLabelKey?: string;
		tone: 'bank' | 'card' | 'crypto';
	};
};

type LocalizedText = {
	text: string;
	translateKey?: string;
};

interface Props {
	title?: LocalizedText;
	description?: LocalizedText;
	action?: {
		label: LocalizedText;
		href: string;
		variant?: 'primary' | 'secondary' | 'ghost' | 'glow';
		icon?: 'none' | 'arrow-up-right' | 'arrow-right';
		effect?: 'none' | 'rotating-flare';
	};
	stats?: ProofStat[];
	carouselLabel?: string;
	carouselLabelKey?: string;
	class?: string;
}

const defaultStat: ProofStat = {
	value: '',
	label: '',
	image: '/images/business-account/api-payments-integration-upscaled.jpg',
	alt: 'A woman using her phone in a bright cafe',
	imagePosition: 'center center',
	notice: {
		icon: 'contract',
		label: 'API payment',
		timestamp: 'Processed',
		title: 'Payment created',
		meta: 'Created via API and confirmed automatically',
		amount: '$12,680',
		tone: 'bank',
	},
};

const {
	title = { text: 'Connect Global Payments to Your Platform', translateKey: 'apiPayments.title' },
	description = {
		text: 'Integrate Garna Business Account into your own platform and manage payments seamlessly under the hood',
		translateKey: 'apiPayments.description',
	},
	action,
	stats = [defaultStat],
	class: className = '',
} = Astro.props;

const stat = stats[0] ?? defaultStat;
---

<Section
	class:list={['api-payments-section overflow-hidden', className]}
	width="content"
	spacing="default"
	layout="split"
	align="left"
	title={title}
	description={description}
	action={action}
	splitClass="api-payments-layout"
	copyClass="api-payments-copy"
	headerClass="api-payments-header"
	descriptionClass="api-payments-description"
	actionClass="api-payments-action"
	contentClass="api-payments-visual-wrap"
>
	<article class="api-payments-visual">
		<img src={stat.image} alt={stat.alt} loading="lazy" style={stat.imagePosition ? `object-position: ${stat.imagePosition};` : undefined} />
		<div class:list={['api-payments-notice', `api-payments-notice--${stat.notice.tone}`]}>
			<div class="api-payments-notice__top">
				<span data-translate={stat.notice.labelKey}>{stat.notice.label || 'API payment'}</span>
				<strong data-translate={stat.notice.timestampKey}>{stat.notice.timestamp || 'Processed'}</strong>
			</div>
			<div class="api-payments-notice__main">
				<strong>{stat.notice.amount || '$12,680'}</strong>
				<span data-translate={stat.notice.metaKey}>{stat.notice.meta || 'Created via API and confirmed automatically'}</span>
			</div>
		</div>
	</article>
</Section>

<style>
	.api-payments-section { background: transparent; }

	:global(.api-payments-layout) {
		gap: clamp(2.5rem, 7vw, 7rem);
		grid-template-columns: minmax(0, 0.88fr) minmax(18rem, 1.12fr);
	}

	:global(.api-payments-copy) { max-width: 34rem; }
	:global(.api-payments-header) { margin: 0; }

	:global(.api-payments-description) {
		max-width: 31rem;
		margin-inline: 0;
	}

	:global(.api-payments-action) { margin-top: 2.25rem; }

	.api-payments-visual {
		position: relative;
		min-height: clamp(30rem, 47vw, 38rem);
		overflow: hidden;
		border: 1px solid rgb(255 255 255 / 0.1);
		border-radius: 28px;
		background: #0a0a0a;
		box-shadow: 0 28px 90px -58px rgb(0 0 0 / 0.95);
		isolation: isolate;
		contain: paint;
		container-type: inline-size;
	}

	.api-payments-visual::after {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: rgb(0 0 0 / 0.035);
		content: '';
		pointer-events: none;
	}

	.api-payments-visual > img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center center;
		backface-visibility: hidden;
		transform: translate3d(0, 0, 0) scale(1.002);
		transform-origin: center;
		transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
		will-change: transform;
	}

	.api-payments-visual:hover > img { transform: translate3d(0, 0, 0) scale(1.035); }

	.api-payments-notice {
		position: absolute;
		z-index: 2;
		right: min(2rem, 6.8817cqw);
		bottom: min(1.75rem, 6.0215cqw);
		left: min(2rem, 6.8817cqw);
		display: grid;
		height: min(6rem, 20.6452cqw);
		box-sizing: border-box;
		align-items: stretch;
		gap: min(0.44rem, 1.514cqw);
		padding: min(0.88rem, 3.028cqw) min(1rem, 3.4409cqw);
		border: min(1px, 0.2151cqw) solid rgb(255 255 255 / 0.12);
		border-radius: min(1.25rem, 4.3011cqw);
		background: rgb(7 8 10 / 0.72);
		color: #fff;
		font-family: Manrope, sans-serif;
		box-shadow: 0 min(0.65rem, 2.2366cqw) min(1.8rem, 6.1935cqw) rgb(0 0 0 / 0.2);
		backdrop-filter: blur(min(14px, 3.0108cqw));
		overflow: hidden;
	}

	.api-payments-notice__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: min(0.75rem, 2.5806cqw);
	}

	.api-payments-notice__top span {
		color: rgb(255 255 255 / 0.62);
		font-size: min(0.72rem, 2.4774cqw);
		font-weight: 700;
		letter-spacing: min(0.08em, 0.1982cqw);
		text-transform: uppercase;
	}

	.api-payments-notice__top strong {
		border-radius: 9999px;
		background: #cbf300;
		padding: min(0.34rem, 1.1699cqw) min(0.58rem, 1.9957cqw);
		color: #080808;
		font-size: min(0.61rem, 2.0989cqw);
		font-weight: 800;
		line-height: 1;
		text-transform: uppercase;
	}

	.api-payments-notice__main {
		display: grid;
		grid-template-columns: min(10.9rem, 37.5054cqw) minmax(0, 1fr);
		align-items: end;
		gap: min(0.75rem, 2.5806cqw);
	}

	.api-payments-notice__main strong {
		color: #fff;
		font-family: Manrope, sans-serif;
		font-size: min(2.55rem, 8.7742cqw);
		font-weight: 700;
		line-height: 1;
		letter-spacing: 0;
	}

	.api-payments-notice__main span {
		justify-self: end;
		width: min(9.35rem, 32.172cqw);
		color: rgb(255 255 255 / 0.68);
		font-size: min(0.78rem, 2.6839cqw);
		font-weight: 600;
		line-height: 1.28;
		text-align: right;
	}

	@media (max-width: 1023px) {
		:global(.api-payments-layout) {
			grid-template-columns: minmax(22rem, 0.92fr) minmax(0, 1.08fr);
			gap: 3rem;
		}
	}

	@media (min-width: 768px) {
		:global(.api-payments-visual-wrap) { order: -1; }
		:global(.api-payments-copy) { order: 1; }
	}

	@media (max-width: 767px) {
		:global(.api-payments-layout) { grid-template-columns: minmax(0, 1fr); gap: 2.75rem; }
		:global(.api-payments-copy) { max-width: 36rem; }

		.api-payments-visual {
			min-height: 0;
			aspect-ratio: 1.18;
			border-radius: 22px;
		}

	}

	@media (max-width: 560px) {
		.api-payments-visual { aspect-ratio: 0.9; }
	}

	@media (prefers-reduced-motion: reduce) {
		.api-payments-visual > img { transition: none; }
	}
</style>
