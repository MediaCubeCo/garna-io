<script is:inline>
                    (function () {
                        const wrapper = document.currentScript.parentElement;
                        const content = wrapper.querySelector('.glass');

                        if (wrapper && content) {
                            const updateHeight = () => {
                                const rect = content.getBoundingClientRect();
                                // Set the wrapper height to match the exact visual height of the scaled child
                                if (rect.height > 0) {
                                    wrapper.style.height = rect.height + 'px';
                                }
                            };

                            // Update immediately, on resize, and on load
                            updateHeight();
                            window.addEventListener('resize', updateHeight);
                            new ResizeObserver(updateHeight).observe(content);
                            window.addEventListener('load', updateHeight);

                            // Fallback polling for slow loads
                            setTimeout(updateHeight, 500);
                            setTimeout(updateHeight, 1500);
                        }
                    })();
                </script>