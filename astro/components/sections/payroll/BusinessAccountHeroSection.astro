</style>

<script>
	const syncBusinessHeroImages = () => {
		const isRussian = document.documentElement.lang.toLowerCase().split('-')[0] === 'ru';

		document.querySelectorAll<HTMLImageElement>('[data-business-hero-image]').forEach((image) => {
			const nextSource = isRussian ? image.dataset.srcRu : image.dataset.srcDefault;
			const nextAlt = isRussian ? image.dataset.altRu : image.dataset.altDefault;

			if (nextSource && image.getAttribute('src') !== nextSource) image.src = nextSource;
			image.alt = nextAlt || '';
			image.lang = isRussian ? 'ru' : '';
		});
	};

	const formatBusinessBalance = (value: number) => {
		const integer = Math.round(value).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
		return `${integer},00 $`;
	};

	const initBusinessBalanceCounters = () => {
		document.querySelectorAll<HTMLElement>('[data-business-balance-counter]').forEach((counter) => {
			if (counter.dataset.counterReady === 'true') return;
			counter.dataset.counterReady = 'true';

			const renderFinalValue = () => {
				counter.textContent = formatBusinessBalance(10000);
			};

			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				renderFinalValue();
				return;
			}

			const observer = new IntersectionObserver((entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				observer.disconnect();

				const duration = 1500;
				let startedAt: number | null = null;

				const update = (timestamp: number) => {
					startedAt ??= timestamp;
					const progress = Math.min((timestamp - startedAt) / duration, 1);
					const easedProgress = 1 - Math.pow(1 - progress, 3);
					counter.textContent = formatBusinessBalance(10000 * easedProgress);

					if (progress < 1) requestAnimationFrame(update);
					else renderFinalValue();
				};

				requestAnimationFrame(update);
			}, { threshold: .35 });

			observer.observe(counter);
		});
	};

	syncBusinessHeroImages();
	initBusinessBalanceCounters();
	document.addEventListener('astro:page-load', syncBusinessHeroImages);
	document.addEventListener('astro:page-load', initBusinessBalanceCounters);
	window.addEventListener('garna:page-mounted', syncBusinessHeroImages);
</script>
