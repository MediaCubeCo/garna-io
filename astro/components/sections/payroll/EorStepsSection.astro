---
import Section from '../../layout/Section.astro';
---

<Section contained={false} spacing="none" id="how-it-works" class="py-24">
            <div class="mx-auto max-w-7xl px-6">
                <div class="mx-auto max-w-3xl text-center">
                    <h2 class="font-manrope text-4xl font-normal leading-tight text-white lg:text-5xl" data-translate="steps.title">Steps to take with Garna</h2>
                </div>
                <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-6">
                    <article class="surface-soft rounded-2xl p-5 lg:col-span-2">
                        <div data-eor-step-visual class="relative flex h-44 items-center justify-center overflow-hidden px-3">
                            <div class="relative w-full max-w-[18rem] rounded-2xl border border-white/10 bg-[#111111] p-5">
                                <div class="mb-4 flex items-center justify-between">
                                    <span class="rounded-full bg-[#5EA500]/20 px-3 py-1 text-xs font-semibold text-[#5EA500]" data-translate="visual.steps.profile">Profile</span>
                                    <span class="text-xs font-semibold text-gray-500" data-translate="visual.steps.threeMin">3 min</span>
                                </div>
                                <div class="space-y-2">
                                    <div class="h-2.5 w-3/4 rounded-full bg-white/20"></div>
                                    <div class="h-2.5 w-1/2 rounded-full bg-white/10"></div>
                                </div>
                                <div class="mt-5 flex items-center gap-3">
                                    <div class="grid flex-1 grid-cols-3 gap-2">
                                        <span class="inline-flex h-7 items-center justify-center rounded-lg bg-[#5EA500] text-xs font-semibold text-[#050505]" data-translate="visual.steps.start">Start</span>
                                        <span class="h-7 rounded-lg bg-white/12"></span>
                                        <span class="h-7 rounded-lg bg-white/12"></span>
                                    </div>
                                    <span class="inline-flex shrink-0 items-center gap-1.5 text-xs font-semibold text-[#5EA500]">
                                        <span class="h-1.5 w-1.5 rounded-full bg-[#5EA500]"></span>
                                        <span data-translate="visual.cards.ready">Ready</span>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <span class="mt-6 block text-sm font-semibold text-[#5EA500]">01</span>
                        <h3 class="mt-3 text-xl font-semibold text-white" data-translate="steps.items.companyAccount.title">Set up your company account</h3>
                        <p class="mt-3 text-sm leading-relaxed text-gray-400" data-translate="steps.items.companyAccount.description">Complete a quick profile check, fill in the required fields, and get access to a customized service flow</p>
                    </article>
                    <article class="surface-soft rounded-2xl p-5 lg:col-span-2">
                        <div data-eor-step-visual class="relative flex h-44 items-center justify-center overflow-hidden px-2">
                            <div class="grid w-full max-w-[16rem] grid-cols-[4rem_2.5rem_minmax(0,1fr)] items-center gap-2">
                                <div class="flex h-16 w-16 items-center justify-center rounded-full border border-[#5EA500]/30 bg-[#5EA500]/16 text-[#5EA500] shadow-2xl shadow-black/30">
                                    <iconify-icon icon="lucide:user-round" width="28"></iconify-icon>
                                </div>
                                <div class="flex items-center justify-center">
                                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-[#5EA500] text-[#050505] shadow-xl shadow-black/30">
                                        <iconify-icon icon="lucide:arrow-right" width="17"></iconify-icon>
                                    </span>
                                </div>
                                <div class="grid min-w-0 gap-2">
                                    <div class="flex min-w-0 items-center gap-2 rounded-xl border border-white/10 bg-[#111111] px-3 py-2.5 shadow-xl shadow-black/35">
                                    <iconify-icon icon="lucide:wallet" width="17" class="shrink-0 text-[#5EA500]"></iconify-icon>
                                    <span class="truncate text-sm font-semibold text-white" data-translate="visual.cards.finance">Finance</span>
                                    </div>
                                    <div class="flex min-w-0 items-center gap-2 rounded-xl border border-white/10 bg-[#111111] px-3 py-2.5 shadow-xl shadow-black/35">
                                    <iconify-icon icon="lucide:shield-check" width="17" class="shrink-0 text-[#5EA500]"></iconify-icon>
                                    <span class="truncate text-sm font-semibold text-white" data-translate="visual.steps.access">Access</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <span class="mt-6 block text-sm font-semibold text-[#5EA500]">02</span>
                        <h3 class="mt-3 text-xl font-semibold text-white" data-translate="steps.items.financialContact.title">Assign a financial contact</h3>
                        <p class="mt-3 text-sm leading-relaxed text-gray-400" data-translate="steps.items.financialContact.description">Choose the person responsible for financial matters, from a finance director to yourself</p>
                    </article>
                    <article class="surface-soft rounded-2xl p-5 lg:col-span-2">
                        <div data-eor-step-visual class="relative flex h-44 items-center justify-center overflow-visible px-3">
                            <div class="grid w-full max-w-[18rem] gap-2 rounded-2xl border border-white/10 bg-[#111111] p-3 shadow-[0_18px_34px_-30px_rgba(0,0,0,0.95)]">
                                <div class="flex items-center justify-between">
                                    <span class="rounded-xl border border-white/10 bg-[#111111] px-3 py-1.5 text-xs font-semibold text-gray-300 shadow-xl shadow-black/35" data-translate="visual.steps.portugal">Portugal</span>
                                    <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-[#5EA500] text-[#050505] shadow-xl shadow-black/30">
                                        <iconify-icon icon="lucide:file-text" width="19"></iconify-icon>
                                    </span>
                                </div>
                                <div class="space-y-1.5 px-1">
                                    <p class="text-sm font-semibold text-white" data-translate="visual.steps.eorContract">EoR contract</p>
                                    <div class="h-1.5 rounded-full bg-white/20"></div>
                                    <div class="h-1.5 w-4/5 rounded-full bg-white/10"></div>
                                    <div class="h-1.5 w-2/3 rounded-full bg-[#5EA500]"></div>
                                </div>
                                <div class="flex items-center justify-between rounded-xl border border-white/10 bg-[#111111] px-3 py-1.5 text-xs shadow-xl shadow-black/35">
                                    <span class="text-gray-500" data-translate="visual.cards.salary">Salary</span>
                                    <span class="font-semibold text-white">EUR 4,800</span>
                                </div>
                            </div>
                        </div>
                        <span class="mt-6 block text-sm font-semibold text-[#5EA500]">03</span>
                        <h3 class="mt-3 text-xl font-semibold text-white" data-translate="steps.items.contract.title">Create your first EoR contract</h3>
                        <p class="mt-3 text-sm leading-relaxed text-gray-400" data-translate="steps.items.contract.description">Add country, position, salary, start date, currency, and work visa requirements</p>
                    </article>
                    <article class="surface-soft rounded-2xl p-5 lg:col-span-3">
                        <div data-eor-step-visual class="relative flex h-44 items-center justify-center overflow-hidden px-3">
                            <div class="grid w-full max-w-md grid-cols-[1fr_auto_1fr] items-center gap-4">
                                <div class="rounded-2xl border border-white/10 bg-[#111111] p-4 shadow-xl shadow-black/35">
                                    <div class="mb-3 flex h-5 items-center text-[#5EA500]">
                                        <iconify-icon icon="lucide:mail" width="18"></iconify-icon>
                                    </div>
                                    <p class="text-xs text-gray-500" data-translate="visual.steps.invite">Invite</p>
                                    <p class="mt-2 text-sm font-semibold text-white" data-translate="visual.steps.employeeEmail">Employee email</p>
                                </div>
                                <span class="flex h-12 w-12 items-center justify-center rounded-full bg-[#5EA500] text-[#050505] shadow-xl shadow-black/30">
                                    <iconify-icon icon="lucide:send" width="20"></iconify-icon>
                                </span>
                                <div class="rounded-2xl border border-white/10 bg-[#111111] p-4 shadow-xl shadow-black/35">
                                    <div class="mb-3 flex h-5 items-center text-[#5EA500]">
                                        <iconify-icon icon="lucide:badge-check" width="18"></iconify-icon>
                                    </div>
                                    <p class="text-xs text-gray-500" data-translate="visual.steps.account">Account</p>
                                    <p class="mt-2 text-sm font-semibold text-white" data-translate="visual.steps.readyToPay">Ready to pay</p>
                                </div>
                            </div>
                        </div>
                        <span class="mt-6 block text-sm font-semibold text-[#5EA500]">04</span>
                        <h3 class="mt-3 text-xl font-semibold text-white" data-translate="steps.items.invite.title">Invite an employee</h3>
                        <p class="mt-3 text-sm leading-relaxed text-gray-400" data-translate="steps.items.invite.description">The employee receives an invitation by email and creates a Garna account to receive payments</p>
                    </article>
                    <article class="surface-soft rounded-2xl p-5 lg:col-span-3">
                        <div data-eor-step-visual class="relative flex h-44 items-center justify-center overflow-hidden px-3">
                            <div class="w-full max-w-sm">
                                <div class="relative rounded-2xl border border-white/10 bg-[#111111] p-4 shadow-2xl shadow-black/45">
                                    <div class="absolute -right-3 -top-3 flex h-11 w-11 items-center justify-center rounded-2xl bg-[#5EA500] text-[#050505]">
                                        <iconify-icon icon="lucide:circle-dollar-sign" width="22"></iconify-icon>
                                    </div>
                                    <p class="text-xs text-gray-500" data-translate="visual.steps.walletBalance">Wallet balance</p>
                                    <p class="mt-1 text-2xl font-semibold text-white">$84,250</p>
                                    <div class="mt-4 h-2 overflow-hidden rounded-full bg-white/10">
                                        <div class="h-full w-[82%] rounded-full bg-[#5EA500]"></div>
                                    </div>
                                </div>
                                <div class="mt-4 flex flex-wrap gap-2">
                                    <span class="rounded-full bg-white/10 px-3 py-1 text-xs text-gray-300">SWIFT</span>
                                    <span class="rounded-full bg-white/10 px-3 py-1 text-xs text-gray-300">SEPA</span>
                                    <span class="rounded-full bg-[#5EA500]/20 px-3 py-1 text-xs text-[#5EA500]" data-translate="visual.steps.crypto">Crypto</span>
                                    <span class="rounded-full bg-[#5EA500]/20 px-3 py-1 text-xs font-semibold text-[#5EA500]" data-translate="visual.steps.funded">Funded</span>
                                </div>
                            </div>
                        </div>
                        <span class="mt-6 block text-sm font-semibold text-[#5EA500]">05</span>
                        <h3 class="mt-3 text-xl font-semibold text-white" data-translate="steps.items.fundWallet.title">Fund your wallet and run payroll</h3>
                        <p class="mt-3 text-sm leading-relaxed text-gray-400" data-translate="steps.items.fundWallet.description">Use SWIFT, SEPA, or crypto funding and start paying salary today</p>
                    </article>
                </div>
            </div>
        </Section>
