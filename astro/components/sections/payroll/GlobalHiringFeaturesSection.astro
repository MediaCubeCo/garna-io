---
import Section from '../../layout/Section.astro';
---

<Section contained={false} spacing="none" class="py-24">
            <div class="mx-auto max-w-7xl px-6">
                <div class="mx-auto max-w-4xl text-center">
                    <h2 class="font-manrope text-4xl font-normal leading-tight text-white text-center lg:text-5xl" data-translate="hirePay.title">Everything You Need to Hire <br class="hidden md:block">and Pay Globally</h2>
                    <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-gray-400" data-translate="hirePay.description">Garna offers a flexible hiring system that helps companies hire international staff without walking the bureaucratic extra mile</p>
                </div>
                <div class="relative mt-12 -mr-6 md:mr-0" data-eor-card-scroll-shell data-eor-scroll-start="true" data-eor-scroll-end="false">
                    <div class="eor-card-edge eor-card-edge--left md:hidden">
                        <button type="button" data-eor-card-scroll-prev aria-label="Scroll cards left" class="eor-card-edge-button">
                            <iconify-icon icon="lucide:arrow-left" width="20" height="20"></iconify-icon>
                        </button>
                    </div>
                    <div class="eor-card-edge eor-card-edge--right md:hidden">
                        <button type="button" data-eor-card-scroll-next aria-label="Scroll cards right" class="eor-card-edge-button">
                            <iconify-icon icon="lucide:arrow-right" width="20" height="20"></iconify-icon>
                        </button>
                    </div>
                    <div class="eor-card-scroll flex gap-4 overflow-x-auto pr-6 md:grid md:grid-cols-2 md:overflow-visible md:pr-0 lg:grid-cols-3">
                    <article class="surface-soft min-w-[320px] rounded-2xl bg-[#0b0b0b] p-5 md:min-w-0">
                        <div class="relative flex h-40 items-center justify-center overflow-hidden rounded-xl bg-[#0b0b0b]">
                            <div class="relative h-[8.75rem] w-[16.5rem] sm:w-[18rem]">
                                <div class="absolute left-0 top-0 w-[13.25rem] rounded-xl border border-white/10 bg-[#141414] px-4 py-3 text-white">
                                    <p class="text-[10px] text-gray-500" data-translate="visual.cards.entity">Entity</p>
                                    <p class="text-lg font-semibold">$678,200</p>
                                    <div class="mt-3 flex items-end gap-2">
                                        <span class="h-5 w-6 rounded bg-[#5EA500]/35"></span>
                                        <span class="h-7 w-6 rounded bg-[#5EA500]/50"></span>
                                        <span class="h-9 w-6 rounded bg-[#5EA500]/70"></span>
                                        <span class="h-11 w-6 rounded bg-[#5EA500]/85"></span>
                                        <span class="h-12 w-6 rounded bg-[#5EA500]"></span>
                                    </div>
                                </div>
                                <div class="absolute right-1 top-[3.15rem] rounded-xl border border-white/10 bg-[#191919] px-4 py-3 text-white">
                                    <p class="text-[10px] text-gray-500" data-translate="visual.cards.employees">Employees</p>
                                    <p class="mt-2 text-sm font-semibold text-[#5EA500]" data-translate="visual.cards.readyCount">+87 ready</p>
                                </div>
                            </div>
                        </div>
                        <h3 class="mt-6 text-xl font-semibold text-white" data-translate="hirePay.cards.entities.title">Hire globally without opening entities</h3>
                        <p class="mt-3 text-sm leading-relaxed text-gray-400" data-translate="hirePay.cards.entities.description">Hire employees around the globe without opening a local office or navigating its legal infrastructure</p>
                    </article>
                    <article id="eor-card-workforce" class="surface-soft min-w-[320px] scroll-ml-6 rounded-2xl bg-[#0b0b0b] p-5 md:min-w-0">
                        <div class="flex h-40 items-center justify-center overflow-hidden rounded-xl bg-[#0b0b0b]">
                            <div class="w-[82%] rounded-xl border border-white/10 bg-[#141414] p-4 text-white">
                                <p class="text-sm font-semibold" data-translate="visual.cards.workforceMix">Workforce mix</p>
                                <div class="mt-4 space-y-3">
                                    <div class="flex items-center justify-between text-xs"><span data-translate="visual.cards.fullTime">Full-time</span><span class="font-semibold">42%</span></div>
                                    <div class="h-2 rounded-full bg-white/10"><div class="h-2 w-[42%] rounded-full bg-[#5EA500]"></div></div>
                                    <div class="flex items-center justify-between text-xs"><span data-translate="visual.cards.contractors">Contractors</span><span class="font-semibold">38%</span></div>
                                    <div class="h-2 rounded-full bg-white/10"><div class="h-2 w-[38%] rounded-full bg-[#5EA500]"></div></div>
                                </div>
                            </div>
                        </div>
                        <h3 class="mt-6 text-xl font-semibold text-white" data-translate="hirePay.cards.workforce.title">Employ any type of workforce</h3>
                        <p class="mt-3 text-sm leading-relaxed text-gray-400" data-translate="hirePay.cards.workforce.description">Manage full-timers, contractors, freelancers, and distributed staff from a single place</p>
                    </article>
                    <article class="surface-soft min-w-[320px] rounded-2xl bg-[#0b0b0b] p-5 md:min-w-0">
                        <div class="flex h-40 items-center justify-center overflow-hidden rounded-xl bg-[#0b0b0b]">
                            <div class="w-[82%] rounded-xl border border-white/10 bg-[#141414] p-4 text-white">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-sm font-semibold" data-translate="visual.cards.payrollRun">Payroll run</p>
                                        <p class="text-xs text-gray-500" data-translate="visual.cards.thisMonth">This month</p>
                                    </div>
                                    <span class="rounded-full bg-[#5EA500]/15 px-3 py-1 text-xs font-semibold text-[#5EA500]" data-translate="visual.cards.ready">Ready</span>
                                </div>
                                <div class="mt-4 grid grid-cols-3 gap-3 text-xs">
                                    <div><p class="text-gray-500" data-translate="visual.cards.salary">Salary</p><p class="font-semibold">$48.6k</p></div>
                                    <div><p class="text-gray-500" data-translate="visual.cards.tax">Tax</p><p class="font-semibold">$8.2k</p></div>
                                    <div><p class="text-gray-500">FX</p><p class="font-semibold">4</p></div>
                                </div>
                            </div>
                        </div>
                        <h3 class="mt-6 text-xl font-semibold text-white" data-translate="hirePay.cards.payroll.title">Offer payroll that runs smoothly</h3>
                        <p class="mt-3 text-sm leading-relaxed text-gray-400" data-translate="hirePay.cards.payroll.description">Pay staff, contractors, taxes, and multi-currency payouts automatically and without stress</p>
                    </article>
                    <article class="surface-soft min-w-[320px] rounded-2xl bg-[#0b0b0b] p-5 md:min-w-0">
                        <div class="flex h-40 items-center justify-center overflow-hidden rounded-xl bg-[#0b0b0b]">
                            <div class="w-[82%] rounded-xl border border-white/10 bg-[#141414] p-4 text-white">
                                <div class="flex items-center gap-3">
                                    <div class="flex h-12 min-h-12 w-12 min-w-12 shrink-0 items-center justify-center rounded-full bg-[#5EA500]/15 text-xl text-[#5EA500]">!</div>
                                    <div>
                                        <p class="text-sm font-semibold" data-translate="visual.cards.complianceAlert">Compliance alert</p>
                                        <p class="text-xs text-gray-500" data-translate="visual.cards.minimumWageRule">New minimum wage rule</p>
                                    </div>
                                </div>
                                <div class="mt-4 rounded-lg bg-[#5EA500]/10 px-3 py-2 text-xs text-[#5EA500]" data-translate="visual.cards.reviewedBeforePayroll">Reviewed before payroll</div>
                            </div>
                        </div>
                        <h3 class="mt-6 text-xl font-semibold text-white" data-translate="hirePay.cards.compliance.title">Ensure compliance in every market</h3>
                        <p class="mt-3 text-sm leading-relaxed text-gray-400" data-translate="hirePay.cards.compliance.description">Stay aligned with local labor laws, tax regulations, and country-specific rules</p>
                    </article>
                    <article class="surface-soft min-w-[320px] rounded-2xl bg-[#0b0b0b] p-5 md:min-w-0">
                        <div class="flex h-40 items-center justify-center overflow-hidden rounded-xl bg-[#0b0b0b]">
                            <div class="w-full max-w-[15rem] space-y-2">
                                <div class="flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-[#141414] px-5 py-3 text-white">
                                    <span class="flex min-w-0 items-center gap-3">
                                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#5EA500]/20 text-[#5EA500]">
                                            <iconify-icon icon="lucide:users-round" width="16" height="16"></iconify-icon>
                                        </span>
                                        <span class="text-lg font-semibold">HRIS</span>
                                    </span>
                                    <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#5EA500]/15 text-[#5EA500]">
                                        <iconify-icon icon="lucide:check" width="14" height="14"></iconify-icon>
                                    </span>
                                </div>
                                <div class="flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-[#191919] px-5 py-3 text-white opacity-90">
                                    <span class="flex min-w-0 items-center gap-3">
                                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#5EA500]/20 text-[#5EA500]">
                                            <iconify-icon icon="lucide:wallet" width="16" height="16"></iconify-icon>
                                        </span>
                                        <span class="text-lg font-semibold" data-translate="visual.cards.finance">Finance</span>
                                    </span>
                                    <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#5EA500]/15 text-[#5EA500]">
                                        <iconify-icon icon="lucide:check" width="14" height="14"></iconify-icon>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <h3 class="mt-6 text-xl font-semibold text-white" data-translate="hirePay.cards.integrations.title">Integrate EoR into your tools</h3>
                        <p class="mt-3 text-sm leading-relaxed text-gray-400" data-translate="hirePay.cards.integrations.description">Connect with existing HR, finance, and workforce management tools without disrupting your processes</p>
                    </article>
                    <article class="surface-soft min-w-[320px] rounded-2xl bg-[#0b0b0b] p-5 md:min-w-0">
                        <div class="flex h-40 items-center justify-center overflow-hidden rounded-xl bg-[#0b0b0b]">
                            <div class="flex w-full max-w-[16rem] items-center justify-between gap-3 rounded-xl border border-white/10 bg-[#141414] px-4 py-5 text-white">
                                <div class="rounded-full border-2 border-[#5EA500]/50 px-3 py-2 text-sm font-semibold text-[#5EA500]">SOC</div>
                                <div class="flex min-w-0 items-center gap-1 text-[#5EA500]" aria-label="Certified">
                                    <iconify-icon icon="lucide:star" width="17" height="17"></iconify-icon>
                                    <iconify-icon icon="lucide:star" width="17" height="17"></iconify-icon>
                                    <iconify-icon icon="lucide:star" width="17" height="17"></iconify-icon>
                                </div>
                                <div class="text-xl font-black text-white">ISO</div>
                            </div>
                        </div>
                        <h3 class="mt-6 text-xl font-semibold text-white" data-translate="hirePay.cards.fastMoving.title">Built for fast-moving companies</h3>
                        <p class="mt-3 text-sm leading-relaxed text-gray-400" data-translate="hirePay.cards.fastMoving.description">Support startups entering new markets and larger teams managing global workforce operations</p>
                    </article>
                    </div>
                </div>
            </div>
            </div>
        </Section>
