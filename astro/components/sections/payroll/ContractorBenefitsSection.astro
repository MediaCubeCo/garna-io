---
import Section from '../../layout/Section.astro';
import SectionHeader from '../../layout/SectionHeader.astro';
import Button from '../../ui/Button.astro';
---

<Section contained={false} spacing="none" class="py-16 lg:py-32">
        <div class="h-fit max-w-7xl mr-auto ml-auto pr-6 pl-6">
            <div class="lg:mb-20 text-center mb-16">
                <SectionHeader
                    title={{ text: 'Contractor Agreements, Invoices, and IP Rights in One Flow', translateKey: 'contractorBenefits.title' }}
                    description={{ text: 'Bring contractor paperwork, consolidated billing, and rights transfer into one managed platform', translateKey: 'contractorBenefits.description' }}
                    class="mx-auto max-w-5xl"
                />
                <div class="mt-10 flex justify-center">
                    <Button
                        href="#"
                        variant="primary"
                        size="header"
                        effect="none"
                        icon="none"
                        onclick="event.preventDefault(); if (window.GarnaWidget) window.GarnaWidget.open({ trackingCta: 'contractor_benefits_demo' });"
                    >
                        <span data-translate="whyGarna.cta.button">Book a demo</span>
                    </Button>
                </div>
            </div>

            <div class="contractor-benefits-grid grid grid-cols-1 gap-6 lg:grid-cols-3">
                <!-- Card 3: Payment Methods (Moved to First) -->
                <div
                    class="contractor-benefits-card glass-card flex flex-col overflow-hidden border border-white/[0.08] bg-[#0c0c0c]/[0.72] md:items-center md:text-center md:pt-10 md:pr-10 md:pb-10 md:pl-10 lg:min-h-[520px] lg:items-stretch lg:text-left lg:pl-8 lg:pt-8 lg:pb-8 lg:pr-8 rounded-3xl pt-6 pr-6 pb-6 pl-6 relative"
                    data-card-glow="true"
                    data-interactive="true">
                    <h3 class="mx-auto max-w-md text-[26px] font-medium leading-tight text-center text-white tracking-tight font-manrope"
                        data-translate="contractorBenefits.methods.title">One Contract Instead of&nbsp;Dozens</h3>
                    <p class="mx-auto mt-4 max-w-md leading-relaxed md:mb-3 text-base font-semibold text-center text-gray-400 font-manrope"
                        data-translate="contractorBenefits.methods.description">Manage everything through one contract and a single consolidated invoice</p>

                    <div
                        class="contractor-benefits-visual-shell md:mt-8 lg:mt-auto md:max-w-md lg:max-w-full w-full max-w-md mt-6 mr-auto ml-auto text-left">
                        <div class="contractor-benefits-visual-stage contractor-benefits-visual-stage--folder">
                            <div class="contract-folder-visual relative mx-auto h-[318px] w-full max-w-[318px]">
                                <div class="contract-folder-papers" aria-hidden="true">
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                </div>
                                <svg class="contract-folder-svg" viewBox="0 0 292 292" fill="none" aria-hidden="true">
                                    <defs>
                                        <linearGradient id="contract-folder-inner-light" x1="92" y1="78" x2="202" y2="242" gradientUnits="userSpaceOnUse">
                                            <stop stop-color="white" stop-opacity="0.045" />
                                            <stop offset="0.48" stop-color="white" stop-opacity="0.012" />
                                            <stop offset="1" stop-color="white" stop-opacity="0" />
                                        </linearGradient>
                                        <linearGradient id="contract-folder-inner-depth" x1="154" y1="152" x2="154" y2="262" gradientUnits="userSpaceOnUse">
                                            <stop stop-color="#050607" stop-opacity="0" />
                                            <stop offset="1" stop-color="#050607" stop-opacity="0.36" />
                                        </linearGradient>
                                    </defs>
                                    <g>
                                        <path d="M61 91C61 83.8 66.8 78 74 78H217C224.2 78 230 83.8 230 91V132C230 137 233.1 141.5 237.8 143.2L245.4 146C250.5 147.9 253.9 152.7 253.9 158.1V204.9C253.9 210.1 250.7 214.8 245.8 216.8L238 220C233.2 222 230 226.7 230 231.9V249C230 256.2 224.2 262 217 262H74C66.8 262 61 256.2 61 249V91Z" fill="#070809" />
                                        <path d="M61 91C61 83.8 66.8 78 74 78H217C224.2 78 230 83.8 230 91V132C230 137 233.1 141.5 237.8 143.2L245.4 146C250.5 147.9 253.9 152.7 253.9 158.1V204.9C253.9 210.1 250.7 214.8 245.8 216.8L238 220C233.2 222 230 226.7 230 231.9V249C230 256.2 224.2 262 217 262H74C66.8 262 61 256.2 61 249V91Z" fill="url(#contract-folder-inner-light)" />
                                        <path d="M61 91C61 83.8 66.8 78 74 78H217C224.2 78 230 83.8 230 91V132C230 137 233.1 141.5 237.8 143.2L245.4 146C250.5 147.9 253.9 152.7 253.9 158.1V204.9C253.9 210.1 250.7 214.8 245.8 216.8L238 220C233.2 222 230 226.7 230 231.9V249C230 256.2 224.2 262 217 262H74C66.8 262 61 256.2 61 249V91Z" fill="url(#contract-folder-inner-depth)" />
                                        <path d="M75 86H216C220.4 86 222 89.6 222 94V132.8C222 143.6 228.7 153.3 238.8 157L241.9 158.1C245 159.2 247 162.1 247 165.3V199.9C247 203.1 245.1 205.9 242.2 207.1L235 210.1C227.1 213.4 222 221.1 222 229.6V246C222 250.4 218.4 254 214 254H75C70.6 254 67 250.4 67 246V94C67 89.6 70.6 86 75 86Z" stroke="white" stroke-opacity="0.075" />
                                    </g>
                                </svg>
                                <div class="contract-folder-label">
                                    <em data-translate="contractorBenefits.visual.folderTag">All in one</em>
                                    <span data-translate="contractorBenefits.visual.contractsFolder">Contracts</span>
                                    <small>Northstar Labs / Garna</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 2: All-in-one App (Unchanged) -->
                <div
                    class="contractor-benefits-card contractor-savings-card glass-card flex flex-col overflow-hidden border border-white/[0.08] bg-[#0c0c0c]/[0.72] group md:items-center lg:min-h-[520px] lg:items-stretch md:text-center lg:text-left rounded-3xl pt-8 pr-8 pb-6 pl-8 relative"
                    data-card-glow="true"
                    data-interactive="true">
                    <h3 class="mx-auto max-w-md text-[26px] font-medium leading-tight text-center text-white tracking-tight font-manrope"
                        data-translate="contractorBenefits.mobile.title">Cut administrative costs</h3>
                    <p class="mx-auto mt-4 max-w-md leading-relaxed text-base font-semibold text-center text-gray-400 font-manrope"
                        data-translate="contractorBenefits.mobile.description">Garna handles all paperwork for you: from agreements execution to invoices and custom documents</p>

                    <div class="contractor-benefits-visual-shell md:mt-8 lg:mt-auto w-full max-w-md mt-6 mr-auto ml-auto text-left">
                        <div class="contractor-benefits-visual-stage contractor-benefits-visual-stage--savings">
                            <div class="contractor-savings-visual relative mx-auto grid h-[268px] w-full max-w-[292px] place-items-center">
                                <div class="contractor-savings-ring relative grid h-[270px] w-[270px] -translate-y-2 place-items-center rounded-full shadow-[0_22px_62px_-56px_rgba(203,243,0,0.42)]">
                                    <svg class="savings-ring-svg absolute inset-0 h-full w-full -rotate-90" viewBox="0 0 270 270" aria-hidden="true">
                                        <circle cx="135" cy="135" r="118" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="11" />
                                        <circle class="savings-ring-progress" cx="135" cy="135" r="118" fill="none" stroke="#CBF300" stroke-width="11" stroke-dasharray="574 742" stroke-dashoffset="-7" />
                                    </svg>
                                    <div class="absolute inset-4 rounded-full bg-[#080808] shadow-[inset_0_0_0_1px_rgba(255,255,255,0.08)]"></div>
                                    <div class="savings-ring-content relative flex h-[224px] w-[224px] flex-col items-center justify-center rounded-full bg-white/[0.035] px-5 text-center">
                                        <span class="block text-[10px] font-bold uppercase tracking-[0.14em] text-gray-500" data-translate="contractorBenefits.visual.timeSaved">Time saved</span>
                                        <strong class="mt-2 block text-5xl font-semibold leading-none text-white font-manrope" data-translate="contractorBenefits.visual.timeSavedValue">8.5h</strong>
                                        <span class="mt-2 block text-[11px] font-bold uppercase tracking-[0.1em] text-[#CBF300]" data-translate="contractorBenefits.visual.perCycle">per cycle</span>
                                        <div class="mt-4 flex flex-col items-center gap-1.5">
                                            <div class="flex items-center justify-center gap-1.5">
                                                <span class="min-w-[54px] rounded-full bg-white/[0.055] px-3 py-1.5 text-center text-[10px] font-bold leading-none text-gray-300" data-translate="contractorBenefits.visual.invoices">Invoices</span>
                                                <span class="min-w-[54px] rounded-full bg-white/[0.055] px-3 py-1.5 text-center text-[10px] font-bold leading-none text-gray-300" data-translate="contractorBenefits.visual.docs">Docs</span>
                                            </div>
                                            <span class="min-w-[76px] rounded-full bg-white/[0.055] px-3 py-1.5 text-center text-[10px] font-bold leading-none text-gray-300" data-translate="contractorBenefits.visual.agreements">Agreements</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 1: Early Payout (Moved to Last) -->
                <div
                    class="contractor-benefits-card glass-card flex flex-col overflow-hidden border border-white/[0.08] bg-[#0c0c0c]/[0.72] group md:items-center md:text-center md:pt-10 md:pr-10 md:pb-10 md:pl-10 lg:min-h-[520px] lg:items-stretch lg:text-left lg:pl-8 lg:pr-8 lg:pt-8 lg:pb-8 rounded-3xl pt-6 pr-6 pb-6 pl-6 relative"
                    data-card-glow="true"
                    data-interactive="true">
                    <h3 class="mx-auto max-w-md text-[26px] font-medium leading-tight text-center text-white tracking-tight font-manrope"
                        data-translate="contractorBenefits.earlyPayout.title">Direct Intellectual Property transition</h3>
                    <p class="mx-auto mt-4 max-w-md leading-relaxed md:mb-3 text-base font-semibold text-center text-gray-400 font-manrope"
                        data-translate="contractorBenefits.earlyPayout.description">We make sure that all IPs created by contractors are transferred directly and carefully to you</p>

                    <div class="contractor-benefits-visual-shell contractor-benefits-visual-shell--ip lg:mt-auto lg:max-w-full md:mt-8 md:max-w-md md:ml-auto md:mr-auto w-full max-w-md mt-6 mr-auto ml-auto text-left">
                        <div class="contractor-benefits-visual-stage contractor-benefits-visual-stage--ip">
                            <div class="ip-document-visual relative mx-auto grid h-[268px] w-full max-w-[292px] place-items-center">
                                <article class="ip-document-sheet">
                                    <div class="ip-document-heading">
                                        <span data-translate="contractorBenefits.visual.ipAssignment">IP assignment</span>
                                        <strong data-translate="contractorBenefits.visual.rightsTransfer">Rights transfer</strong>
                                    </div>

                                    <div class="ip-document-lines" aria-hidden="true">
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                    </div>

                                    <div class="ip-document-signatures">
                                        <div>
                                            <strong>S. Lewis</strong>
                                            <span data-translate="contractorBenefits.visual.contractor">Contractor</span>
                                        </div>
                                        <div>
                                            <strong>N. Labs</strong>
                                            <span data-translate="contractorBenefits.visual.client">Client</span>
                                        </div>
                                    </div>
                                </article>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Section>

<style is:global>
    .contractor-benefits-card {
        --garna-card-glow-x: 50%;
        --garna-card-glow-y: 50%;
        --garna-card-glow-radius: 60vw;
        --garna-card-border-glow-radius: 14rem;
        isolation: isolate;
        transition: border-color 300ms ease;
    }

    .contractor-benefits-card::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 0;
        border-radius: inherit;
        background: radial-gradient(
            circle var(--garna-card-glow-radius) at var(--garna-card-glow-x) var(--garna-card-glow-y),
            rgba(255, 255, 255, 0.12) 0%,
            rgba(255, 255, 255, 0.075) 18%,
            rgba(255, 255, 255, 0.035) 40%,
            transparent 70%
        );
        opacity: 0;
        pointer-events: none;
        transition: opacity 300ms ease;
    }

    .contractor-benefits-card > * {
        position: relative;
        z-index: 1;
    }

    @supports ((-webkit-mask-composite: xor) or (mask-composite: exclude)) {
        .contractor-benefits-card::after {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 2;
            padding: 1px;
            border-radius: inherit;
            background: radial-gradient(
                circle var(--garna-card-border-glow-radius) at var(--garna-card-glow-x) var(--garna-card-glow-y),
                rgba(255, 255, 255, 0.9) 0%,
                rgba(255, 255, 255, 0.52) 24%,
                rgba(255, 255, 255, 0.2) 50%,
                transparent 76%
            );
            opacity: 0;
            pointer-events: none;
            transition: opacity 300ms ease;
            -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            -webkit-mask-composite: xor;
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask-composite: exclude;
        }
    }

    .contractor-benefits-card[data-interactive='true']:is(:hover, :focus-within, [data-pointer-active='true']) {
        border-color: rgba(255, 255, 255, 0.15);
    }

    @media (hover: hover) and (pointer: fine) {
        .contractor-benefits-card[data-card-glow='true']:is(:hover, :focus-within, [data-pointer-active='true'])::before {
            opacity: 1;
        }

        @supports ((-webkit-mask-composite: xor) or (mask-composite: exclude)) {
            .contractor-benefits-card[data-card-glow='true']:is(:hover, :focus-within, [data-pointer-active='true'])::after {
                opacity: 1;
            }
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .contractor-benefits-card {
            --garna-card-glow-x: 50% !important;
            --garna-card-glow-y: 50% !important;
        }

        .contractor-benefits-card::before,
        .contractor-benefits-card::after {
            transition: none;
        }
    }

    .contractor-benefits-grid {
        grid-auto-rows: 1fr;
        --contract-folder-visual-scale: 1.045;
        --contract-savings-visual-scale: 1;
        --contract-ip-visual-scale: 1.04;
    }

    .contractor-benefits-visual-shell {
        display: grid;
        /* Fixed-size artwork must not enlarge the track used for centering. */
        grid-template-columns: minmax(0, 1fr);
        place-items: center;
        min-width: 0;
        container: benefits-visual / inline-size;
    }

    .contractor-benefits-visual-stage {
        --contract-visual-fit: clamp(0.88, calc(100cqw / 300px), 1);
        display: grid;
        place-items: center;
        justify-self: center;
        max-width: none;
        margin-inline: 0;
        transform-origin: center;
    }

    .contractor-benefits-visual-stage--folder {
        width: 318px;
        transform: scale(calc(var(--contract-folder-visual-scale) * var(--contract-visual-fit)));
    }

    @media (min-width: 768px) and (max-width: 1023px) {
        .contractor-benefits-card {
            padding: 40px;
        }

        .contractor-benefits-card > p {
            margin-bottom: 32px;
        }

        .contractor-benefits-visual-shell {
            height: 268px;
            flex-shrink: 0;
            margin-top: auto;
        }

        .contractor-benefits-visual-stage--folder {
            height: 268px;
            grid-template-rows: minmax(0, 1fr);
        }
    }

    .contractor-benefits-visual-stage--savings {
        width: 292px;
        transform: scale(calc(var(--contract-savings-visual-scale) * var(--contract-visual-fit)));
    }

    .contractor-benefits-visual-stage--ip {
        width: 292px;
        transform: scale(calc(var(--contract-ip-visual-scale) * var(--contract-visual-fit)));
    }

    @media (max-width: 767px) {
        .contractor-benefits-visual-shell--ip {
            flex-grow: 1;
        }
    }

    .contractor-savings-ring {
        margin-inline: auto;
        justify-self: center;
        box-shadow: 0 22px 64px -54px rgba(203, 243, 0, 0.6);
    }

    .contractor-savings-card .contractor-savings-visual {
        width: 292px;
        max-width: none;
        margin-inline: auto;
        justify-items: center;
    }

    .contract-folder-visual {
        width: 318px;
        max-width: none;
        /* Artwork spans x=62.36..290.56 in the 318px scene, including the fanned papers. */
        transform: translateX(-17.46px);
    }

    .ip-document-visual {
        width: 292px;
        max-width: none;
    }

    .savings-ring-content {
        box-shadow: inset 0 0 34px rgba(203, 243, 0, 0.025);
    }

    .ip-document-visual {
        isolation: isolate;
    }

    .ip-document-visual::before,
    .ip-document-visual::after {
        position: absolute;
        width: 160px;
        height: 214px;
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 0.36rem;
        background: #0a0b0c;
        content: "";
        pointer-events: none;
    }

    .ip-document-visual::before {
        z-index: 0;
        transform: translateX(-32px);
    }

    .ip-document-visual::after {
        z-index: 1;
        transform: translateX(32px);
    }

    .ip-document-sheet {
        position: relative;
        z-index: 2;
        display: grid;
        width: 188px;
        height: 252px;
        grid-template-rows: auto auto 1fr auto;
        row-gap: 0.82rem;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 0.36rem;
        background: #08090a;
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.055),
            0 26px 54px -42px rgba(0, 0, 0, 0.95);
        padding: 1.05rem 0.95rem 0.7rem;
        transform: none;
    }

    .ip-document-sheet::before {
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(255, 255, 255, 0.018), transparent 22%);
        content: "";
        pointer-events: none;
    }

    .ip-document-sheet > * {
        position: relative;
        z-index: 1;
    }

    .ip-document-heading {
        position: relative;
        display: grid;
        gap: 0.28rem;
    }

    .ip-document-heading span {
        color: rgba(255, 255, 255, 0.36);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }

    .ip-document-heading strong {
        color: rgba(255, 255, 255, 0.86);
        font-family: "Manrope", sans-serif;
        font-size: 13px;
        font-weight: 750;
        line-height: 1.15;
    }

    .ip-document-lines {
        display: grid;
        gap: 0.48rem;
        align-self: start;
    }

    .ip-document-lines span {
        display: block;
        width: 86%;
        height: 1.5px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.18);
    }

    .ip-document-lines span:nth-child(2),
    .ip-document-lines span:nth-child(6) {
        width: 78%;
    }

    .ip-document-lines span:nth-child(3),
    .ip-document-lines span:nth-child(8) {
        width: 92%;
    }

    .ip-document-lines span:nth-child(4),
    .ip-document-lines span:nth-child(9) {
        width: 68%;
    }

    .ip-document-lines span:nth-child(5),
    .ip-document-lines span:nth-child(7) {
        width: 82%;
    }

    .ip-document-signatures {
        align-self: end;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.65rem;
        padding-top: 0;
    }

    .ip-document-signatures div {
        display: grid;
        gap: 0.16rem;
        min-width: 0;
        padding-top: 0;
    }

    .ip-document-signatures div::after {
        display: block;
        width: 100%;
        height: 1px;
        background: rgba(255, 255, 255, 0.16);
        content: "";
        order: 2;
    }

    .ip-document-signatures span {
        display: block;
        color: rgba(255, 255, 255, 0.38);
        font-size: 8px;
        font-weight: 700;
        order: 3;
    }

    .ip-document-signatures strong {
        display: block;
        overflow: hidden;
        color: #CBF300;
        font-family: "Brush Script MT", "Segoe Script", cursive;
        font-size: 20px;
        font-weight: 400;
        line-height: 1;
        order: 1;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .contract-folder-visual {
        isolation: isolate;
    }

    .contract-folder-papers {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
    }

    .contract-folder-papers span {
        position: absolute;
        top: 58px;
        left: 78px;
        width: 160px;
        height: 200px;
        border: 1px solid rgba(255, 255, 255, 0.09);
        border-radius: 0.38rem;
        background: #17191b;
        box-shadow: 0 12px 26px -22px rgba(0, 0, 0, 0.88);
        transform-origin: 14% 94%;
    }

    .contract-folder-papers span:nth-child(1) {
        transform: none;
    }

    .contract-folder-papers span:nth-child(2) {
        transform: translate(11px, -4px) rotate(5deg);
    }

    .contract-folder-papers span:nth-child(3) {
        transform: translate(22px, -8px) rotate(10deg);
    }

    .contract-folder-svg {
        position: absolute;
        top: -10px;
        left: 50%;
        z-index: 1;
        width: 332px;
        height: 332px;
        max-width: none;
        transform: translateX(-50%);
        pointer-events: none;
        user-select: none;
    }

    .contract-folder-label {
        position: absolute;
        top: 128px;
        left: 84px;
        z-index: 2;
        display: grid;
        gap: 0.25rem;
        width: 142px;
        font-family: "Manrope", sans-serif;
    }

    .contract-folder-label span {
        color: rgba(255, 255, 255, 0.86);
        font-size: 19px;
        font-weight: 700;
        letter-spacing: -0.01em;
    }

    .contract-folder-label small {
        color: rgba(255, 255, 255, 0.42);
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .contract-folder-label em {
        margin-bottom: 0.38rem;
        color: #CBF300;
        font-size: 8px;
        font-style: normal;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }
</style>
