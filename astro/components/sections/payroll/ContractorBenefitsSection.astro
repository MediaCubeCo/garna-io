---
import Section from '../../layout/Section.astro';
import SectionHeader from '../../layout/SectionHeader.astro';
import Button from '../../ui/Button.astro';
---

<Section contained={false} spacing="none" class="py-16 lg:py-32">
        <div class="h-fit max-w-7xl mr-auto ml-auto pr-6 pl-6">
            <div class="lg:mb-20 text-center mb-16">
                <SectionHeader
                    title={{ text: 'Contractor Agreements, Invoices, and IP Rights in One Flow', translateKey: 'contractorBenefits.title' }}
                    description={{ text: 'Bring contractor paperwork, consolidated billing, and rights transfer into one managed platform', translateKey: 'contractorBenefits.description' }}
                    class="mx-auto max-w-5xl"
                />
                <div class="mt-10 flex justify-center">
                    <Button
                        href="#"
                        variant="primary"
                        size="header"
                        effect="none"
                        icon="none"
                        onclick="event.preventDefault(); if (window.GarnaWidget) window.GarnaWidget.open({ trackingCta: 'contractor_benefits_demo' });"
                    >
                        <span data-translate="whyGarna.cta.button">Book a demo</span>
                    </Button>
                </div>
            </div>

            <div class="contractor-benefits-grid grid grid-cols-1 gap-6 lg:grid-cols-3">
                <!-- Card 3: Payment Methods (Moved to First) -->
                <div
                    class="glass-card flex flex-col overflow-hidden border border-white/[0.08] bg-[#0c0c0c]/[0.72] md:items-center md:text-center md:pt-10 md:pr-10 md:pb-10 md:pl-10 lg:min-h-[520px] lg:items-stretch lg:text-left lg:pl-8 lg:pt-8 lg:pb-8 lg:pr-8 rounded-3xl pt-6 pr-6 pb-6 pl-6 relative">
                    <h3 class="mx-auto max-w-md text-[26px] font-medium leading-tight text-center text-white tracking-tight font-manrope"
                        data-translate="contractorBenefits.methods.title">One Contract Instead of&nbsp;Dozens</h3>
                    <p class="mx-auto mt-4 max-w-md leading-relaxed md:mb-3 text-base font-semibold text-center text-gray-400 font-manrope"
                        data-translate="contractorBenefits.methods.description">Manage everything through one contract and a single consolidated invoice</p>

                    <div
                        class="contractor-benefits-visual-shell md:mt-8 lg:mt-auto md:max-w-md lg:max-w-full w-full max-w-md mt-6 mr-auto ml-auto text-left">
                        <div class="relative mx-auto w-full max-w-[292px]">
                            <article class="flex h-[268px] flex-col justify-between rounded-[1.2rem] border border-white/10 bg-[#050505] p-4 shadow-2xl">
                                <div class="flex items-start gap-2">
                                    <img src="/pages/payroll-solution-new/assets/northstar-labs-logo.svg" alt="" loading="lazy" aria-hidden="true"
                                        class="h-8 w-8 shrink-0 rounded-lg object-cover" />
                                    <div class="min-w-0 flex-1">
                                        <strong class="block text-sm font-semibold leading-tight text-white font-manrope">Northstar Labs</strong>
                                        <small class="mt-0.5 block text-[11px] leading-tight text-gray-500" data-translate="contractorBenefits.visual.clientAgreement">Client agreement</small>
                                    </div>
                                    <span class="mt-0.5 min-w-[48px] rounded-full bg-[#CBF300]/10 px-2.5 py-1 text-center text-[9px] font-bold leading-none text-[#CBF300]" data-translate="contractorBenefits.visual.signed">Signed</span>
                                </div>

                                <div class="rounded-xl bg-white/[0.04] p-2.5">
                                    <div class="grid gap-1.5">
                                        <div class="flex items-center justify-between gap-3">
                                            <span class="text-[11px] font-medium text-gray-500" data-translate="contractorBenefits.visual.client">Client</span>
                                            <strong class="truncate text-[11px] font-semibold text-white">Northstar Labs</strong>
                                        </div>
                                        <div class="flex items-center justify-between gap-3">
                                            <span class="text-[11px] font-medium text-gray-500" data-translate="contractorBenefits.visual.provider">Provider</span>
                                            <strong class="truncate text-[11px] font-semibold text-white">Garna</strong>
                                        </div>
                                        <div class="flex items-center justify-between gap-3">
                                            <span class="text-[11px] font-medium text-gray-500" data-translate="contractorBenefits.visual.effective">Effective</span>
                                            <strong class="truncate text-[11px] font-semibold text-white" data-translate="contractorBenefits.visual.effectiveDate">Feb 2026</strong>
                                        </div>
                                    </div>
                                </div>

                                <div class="grid gap-1.5">
                                    <div class="flex items-center justify-between rounded-lg bg-white/[0.032] px-2.5 py-1.5">
                                        <span class="flex items-center gap-1.5 text-[11px] font-medium text-gray-200">
                                            <img src="/pages/payroll-solution-new/assets/contractor-avatar-maya-v2.webp" alt="" loading="lazy" aria-hidden="true"
                                                class="h-4 w-4 rounded-full object-cover" />
                                            Maya Chen
                                        </span>
                                        <span class="text-[11px] font-semibold text-gray-500" data-translate="contractorBenefits.visual.design">Design</span>
                                    </div>
                                    <div class="flex items-center justify-between rounded-lg bg-white/[0.032] px-2.5 py-1.5">
                                        <span class="flex items-center gap-1.5 text-[11px] font-medium text-gray-200">
                                            <img src="/pages/payroll-solution-new/assets/contractor-avatar-alex-v2.webp" alt="" loading="lazy" aria-hidden="true"
                                                class="h-4 w-4 rounded-full object-cover" />
                                            Alex Rivera
                                        </span>
                                        <span class="text-[11px] font-semibold text-gray-500" data-translate="contractorBenefits.visual.engineering">Engineering</span>
                                    </div>
                                </div>

                                <div class="flex items-center justify-between gap-3 rounded-lg border border-[#CBF300]/35 px-2.5 py-2">
                                    <span class="text-[11px] text-gray-400" data-translate="contractorBenefits.visual.monthlyInvoice">Monthly invoice</span>
                                    <strong class="text-sm font-semibold text-white">$18,420</strong>
                                </div>
                            </article>
                        </div>
                    </div>
                </div>

                <!-- Card 2: All-in-one App (Unchanged) -->
                <div
                    class="contractor-savings-card glass-card flex flex-col overflow-hidden border border-white/[0.08] bg-[#0c0c0c]/[0.72] group md:items-center lg:min-h-[520px] lg:items-stretch md:text-center lg:text-left rounded-3xl pt-8 pr-8 pb-6 pl-8 relative">
                    <h3 class="mx-auto max-w-md text-[26px] font-medium leading-tight text-center text-white tracking-tight font-manrope"
                        data-translate="contractorBenefits.mobile.title">Cut administrative costs</h3>
                    <p class="mx-auto mt-4 max-w-md leading-relaxed text-base font-semibold text-center text-gray-400 font-manrope"
                        data-translate="contractorBenefits.mobile.description">Garna handles all paperwork for you: from agreements execution to invoices and custom documents</p>

                    <div class="contractor-benefits-visual-shell md:mt-8 lg:mt-auto w-full max-w-md mt-6 mr-auto ml-auto text-left">
                        <div class="contractor-savings-visual relative mx-auto grid h-[268px] w-full max-w-[292px] place-items-center">
                            <div class="contractor-savings-ring relative grid h-[270px] w-[270px] -translate-y-2 place-items-center rounded-full shadow-[0_22px_62px_-56px_rgba(203,243,0,0.42)]">
                                <svg class="savings-ring-svg absolute inset-0 h-full w-full -rotate-90" viewBox="0 0 270 270" aria-hidden="true">
                                    <circle cx="135" cy="135" r="118" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="11" />
                                    <circle class="savings-ring-progress" cx="135" cy="135" r="118" fill="none" stroke="#CBF300" stroke-width="11" stroke-dasharray="574 742" stroke-dashoffset="-7" />
                                </svg>
                                <div class="absolute inset-4 rounded-full bg-[#080808] shadow-[inset_0_0_0_1px_rgba(255,255,255,0.08)]"></div>
                                <div class="savings-ring-content relative flex h-[224px] w-[224px] flex-col items-center justify-center rounded-full bg-white/[0.035] px-5 text-center">
                                    <span class="block text-[10px] font-bold uppercase tracking-[0.14em] text-gray-500" data-translate="contractorBenefits.visual.timeSaved">Time saved</span>
                                    <strong class="mt-2 block text-5xl font-semibold leading-none text-white font-manrope" data-translate="contractorBenefits.visual.timeSavedValue">8.5h</strong>
                                    <span class="mt-2 block text-[11px] font-bold uppercase tracking-[0.1em] text-[#CBF300]" data-translate="contractorBenefits.visual.perCycle">per cycle</span>
                                    <div class="mt-4 flex flex-col items-center gap-1.5">
                                        <div class="flex items-center justify-center gap-1.5">
                                            <span class="min-w-[54px] rounded-full bg-white/[0.055] px-3 py-1.5 text-center text-[10px] font-bold leading-none text-gray-300" data-translate="contractorBenefits.visual.invoices">Invoices</span>
                                            <span class="min-w-[54px] rounded-full bg-white/[0.055] px-3 py-1.5 text-center text-[10px] font-bold leading-none text-gray-300" data-translate="contractorBenefits.visual.docs">Docs</span>
                                        </div>
                                        <span class="min-w-[76px] rounded-full bg-white/[0.055] px-3 py-1.5 text-center text-[10px] font-bold leading-none text-gray-300" data-translate="contractorBenefits.visual.agreements">Agreements</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 1: Early Payout (Moved to Last) -->
                <div
                    class="glass-card flex flex-col overflow-hidden border border-white/[0.08] bg-[#0c0c0c]/[0.72] group md:items-center md:text-center md:pt-10 md:pr-10 md:pb-10 md:pl-10 lg:min-h-[520px] lg:items-stretch lg:text-left lg:pl-8 lg:pr-8 lg:pt-8 lg:pb-8 rounded-3xl pt-6 pr-6 pb-6 pl-6 relative">
                    <h3 class="mx-auto max-w-md text-[26px] font-medium leading-tight text-center text-white tracking-tight font-manrope"
                        data-translate="contractorBenefits.earlyPayout.title">Direct Intellectual Property transition</h3>
                    <p class="mx-auto mt-4 max-w-md leading-relaxed md:mb-3 text-base font-semibold text-center text-gray-400 font-manrope"
                        data-translate="contractorBenefits.earlyPayout.description">We make sure that all IPs created by contractors are transferred directly and carefully to you</p>

                    <div class="contractor-benefits-visual-shell lg:mt-auto lg:max-w-full md:mt-8 md:max-w-md md:ml-auto md:mr-auto w-full max-w-md mt-6 mr-auto ml-auto text-left">
                        <div class="relative mx-auto w-full max-w-[292px]">
                            <article class="relative flex h-[268px] flex-col justify-between overflow-hidden rounded-[1.2rem] border border-white/10 bg-[#050505] p-4 shadow-2xl">
                                <div class="flex items-center justify-between gap-3">
                                    <span class="text-[10px] font-bold uppercase tracking-[0.13em] text-gray-500" data-translate="contractorBenefits.visual.ipAssignment">IP assignment</span>
                                    <span class="min-w-[48px] rounded-full bg-[#CBF300]/10 px-2.5 py-1 text-center text-[9px] font-bold leading-none text-[#CBF300]" data-translate="contractorBenefits.visual.filed">Filed</span>
                                </div>
                                <strong class="block text-base font-semibold leading-tight text-white font-manrope" data-translate="contractorBenefits.visual.rightsTransfer">Rights transfer</strong>

                                <div class="rounded-xl bg-white/[0.04] p-2.5">
                                    <div class="grid gap-1.5">
                                        <div class="flex items-center justify-between gap-3">
                                            <span class="text-[11px] font-medium text-gray-500" data-translate="contractorBenefits.visual.contractor">Contractor</span>
                                            <strong class="flex min-w-0 items-center gap-1.5 truncate text-[11px] font-semibold text-white">
                                                <img src="/pages/payroll-solution-new/assets/contractor-avatar-sarah-v1.webp" alt="" loading="lazy" aria-hidden="true"
                                                    class="h-4 w-4 rounded-full object-cover" />
                                                Sarah Lewis
                                            </strong>
                                        </div>
                                        <div class="flex items-center justify-between gap-3">
                                            <span class="text-[11px] font-medium text-gray-500" data-translate="contractorBenefits.visual.recipient">Recipient</span>
                                            <strong class="truncate text-[11px] font-semibold text-white">Northstar Labs</strong>
                                        </div>
                                        <div class="flex items-center justify-between gap-3">
                                            <span class="text-[11px] font-medium text-gray-500" data-translate="contractorBenefits.visual.works">Works</span>
                                            <strong class="truncate text-[11px] font-semibold text-white" data-translate="contractorBenefits.visual.designFiles">Design files</strong>
                                        </div>
                                    </div>
                                </div>

                                <div class="grid grid-cols-2 gap-2">
                                    <div class="rounded-xl bg-white/[0.032] px-2.5 py-2.5">
                                        <span class="text-[12px] font-semibold text-gray-500" data-translate="contractorBenefits.visual.contractor">Contractor</span>
                                        <span class="mt-1.5 block h-6 overflow-hidden text-[23px] font-normal leading-none text-white" style="font-family: 'Brush Script MT', 'Segoe Script', cursive;">S. Lewis</span>
                                        <strong class="mt-1 block truncate text-[12px] font-semibold text-[#CBF300]">Sarah Lewis</strong>
                                    </div>
                                    <div class="rounded-xl bg-white/[0.032] px-2.5 py-2.5">
                                        <span class="text-[12px] font-semibold text-gray-500" data-translate="contractorBenefits.visual.client">Client</span>
                                        <span class="mt-1.5 block h-6 overflow-hidden text-[23px] font-normal leading-none text-white" style="font-family: 'Brush Script MT', 'Segoe Script', cursive;">N. Labs</span>
                                        <strong class="mt-1 block truncate text-[12px] font-semibold text-[#CBF300]">Northstar Labs</strong>
                                    </div>
                                </div>
                            </article>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Section>

<style is:global>
    .contractor-savings-ring {
        margin-inline: auto;
        justify-self: center;
        box-shadow: 0 22px 64px -54px rgba(203, 243, 0, 0.6);
    }

    .contractor-savings-card .contractor-savings-visual {
        width: min(100%, 292px);
        margin-inline: auto;
        justify-items: center;
    }

    .savings-ring-content {
        box-shadow: inset 0 0 34px rgba(203, 243, 0, 0.025);
    }
</style>
