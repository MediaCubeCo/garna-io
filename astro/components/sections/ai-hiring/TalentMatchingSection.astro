---
import Section from '../../layout/Section.astro';
---

<Section contained={false} spacing="none" class="lg:pt-32 lg:pb-32 border-white/0 border-t pt-16 pb-16">
        <div class="max-w-7xl mr-auto ml-auto pr-6 pl-6">
            <div class="lg:mb-20 text-center mb-16">
                <h2
                    class="md:text-4xl lg:text-5xl text-4xl font-normal text-white tracking-tight font-manrope max-w-4xl mr-auto mb-6 ml-auto"
                    data-translate="comparison.title">
                    Connect with the right talent</h2>
                <p data-garna-subtitle class="text-xl font-light text-gray-400 font-manrope max-w-3xl mx-auto" data-translate="comparison.description">Our AI provides unbiased,
                    independent candidate evaluations, ensuring a fair process and clear insights into every
                    professional's true potential</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-6 gap-y-6">
                <!-- Traditional -->
                <div class="flex flex-col bg-[#0a0a0a] h-full border-white/5 border rounded-2xl pt-8 pr-8 pb-8 pl-8">
                    <div class="flex items-center gap-3 mb-8">
                        <div
                            class="text-red-500 bg-red-500/10 w-10 h-10 border-red-500/20 border rounded-lg pt-2 pr-2 pb-2 pl-2">
                            <iconify-icon icon="solar:clock-circle-linear" width="24" class=""></iconify-icon>
                        </div>
                        <h3 class="text-xl font-normal text-white tracking-tight font-manrope" data-translate="comparison.traditionalHiring">Traditional Hiring</h3>
                    </div>

                    <div class="space-y-4 mb-10 flex-1">
                        <div class="flex gap-3 gap-x-3 gap-y-3 items-start">
                            <iconify-icon icon="solar:phone-calling-linear" class="flex-shrink-0 text-gray-500 mt-0.5"
                                width="18" height="18" style="color: rgb(107, 114, 128)"></iconify-icon>
                            <span class="text-sm text-gray-400 font-manrope" data-translate="comparison.tradBullet1">80% of recruiter time wasted on first-round
                                calls</span>
                        </div>
                        <div class="flex gap-3 gap-x-3 gap-y-3 items-start">
                            <iconify-icon icon="lucide:pie-chart" class="text-gray-500 mt-0.5 flex-shrink-0"
                                width="18"></iconify-icon>
                            <span class="text-sm text-gray-400 font-manrope" data-translate="comparison.tradBullet2">Speaking only with 40% of candidates with
                                potential fit</span>
                        </div>
                        <div class="flex gap-3 gap-x-3 gap-y-3 items-start">
                            <iconify-icon icon="solar:user-id-linear" class="text-gray-500 mt-0.5 flex-shrink-0"
                                width="18"></iconify-icon>
                            <span class="text-sm text-gray-400 font-manrope" data-translate="comparison.tradBullet3">Endless manual resume screening and human
                                bias</span>
                        </div>
                        <div class="flex gap-3 gap-x-3 gap-y-3 items-start">
                            <iconify-icon icon="solar:calendar-linear" class="flex-shrink-0 text-gray-500 mt-0.5"
                                width="18" height="18" style="color: rgb(107, 114, 128);"></iconify-icon>
                            <span class="text-sm text-gray-400 font-manrope" data-translate="comparison.tradBullet4">Long, drawn-out hiring cycles (average 7-10
                                screenings per position)</span>
                        </div>
                    </div>

                    <!-- Visual UI -->
                    <div
                        class="overflow-hidden bg-[#0A0A0A] w-full border-white/5 border rounded-xl mr-auto ml-auto pt-5 pr-5 pb-5 pl-5 relative shadow-inner">
                        <div class="flex z-10 mb-6 relative items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div
                                    class="w-8 h-8 rounded-full bg-gray-700 overflow-hidden grayscale opacity-70 border border-white/5">
                                    <img src="https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/6d6c3d87-38bf-48b7-af46-5f588f27574f_320w.webp"
                                        alt="" class="w-full h-full object-cover">
                                </div>
                                <span class="text-sm font-medium text-gray-300" data-translate="comparison.lenaCarter">Lena Carter</span>
                            </div>
                            <div
                                class="text-[10px] font-semibold text-gray-600 flex items-center gap-1.5 uppercase tracking-wider">
                                <div class="w-1 h-1 rounded-full bg-gray-600"></div>
                                <span data-translate="comparison.manualReview">Manual Review</span>
                            </div>
                        </div>

                        <!-- Timeline -->
                        <div class="z-10 border-white/5 border rounded-lg mb-6 pt-3 pr-3 pb-3 pl-3 relative space-y-3">
                            <div class="flex border-white/5 border-b mb-2 pb-2 items-center justify-between">
                                <span
                                    class="text-[10px] font-semibold text-gray-500 uppercase tracking-wide" data-translate="comparison.applicationTimeline">Application
                                    Timeline</span>
                                <span class="text-[10px] italic text-gray-600 text-right" data-translate="comparison.noUpdatesReceived">No updates received</span>
                            </div>
                            <div class="flex text-xs items-center justify-between">
                                <span class="text-gray-500" data-translate="comparison.applicationSubmitted">Application submitted</span>
                                <span class="text-gray-300" data-translate="comparison.daysAgo">14 days ago</span>
                            </div>
                            <div class="flex justify-between items-center text-xs">
                                <span class="text-gray-500" data-translate="comparison.reviewStarted">Review started</span>
                                <span class="text-yellow-600/70 font-medium" data-translate="comparison.pending">Pending</span>
                            </div>
                            <div class="flex justify-between items-center text-xs">
                                <span class="text-gray-500" data-translate="comparison.nextStep">Next step</span>
                                <span class="text-gray-600" data-translate="comparison.notScheduled">Not scheduled</span>
                            </div>

                        </div>

                        <!-- Actions -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 z-10 relative gap-x-3 gap-y-3">
                            <div
                                class="bg-[#151515] text-gray-500 text-[11px] font-medium py-2.5 px-3 rounded-lg text-center border border-white/5 truncate shadow-sm"
                                data-translate="comparison.waitingForResponse">
                                Waiting for response...</div>
                            <div
                                class="text-[11px] truncate font-medium text-gray-600 text-center bg-[#151515] border-white/5 border rounded-lg pt-2.5 pr-3 pb-2.5 pl-3 shadow-sm"
                                data-translate="comparison.noFeedbackReceived">
                                No feedback received</div>
                        </div>
                    </div>
                </div>

                <!-- AI Advantage -->
                <div
                    class="overflow-hidden flex flex-col bg-[#0a0a0a] h-full border-[#CBF300]/20 border rounded-2xl pt-8 pr-8 pb-8 pl-8 relative">
                    <div
                        class="absolute top-0 right-0 w-64 h-64 bg-[#CBF300]/10 blur-[80px] rounded-full pointer-events-none">
                    </div>

                    <div class="flex items-center gap-3 mb-8 relative z-10">
                        <div
                            class="text-[#CBF300] bg-[#CBF300]/10 w-10 h-10 border-[#CBF300]/20 border rounded-lg flex items-center justify-center">
                            <iconify-icon icon="solar:stars-minimalistic-bold" width="24" class="" height="24"
                                style="color: #CBF300"></iconify-icon>
                        </div>
                        <h3 class="text-xl font-normal text-white tracking-tight" data-translate="comparison.aiAdvantageTitle">AI-Powered Advantage</h3>
                    </div>

                    <div class="space-y-4 mb-10 relative z-10 flex-1">
                        <div class="flex items-start gap-3">
                            <div
                                class="w-4 h-4 rounded-full bg-[#CBF300] flex items-center justify-center mt-0.5 flex-shrink-0 shadow-[0_0_8px_rgba(203, 243, 0,0.4)]">
                                <iconify-icon icon="solar:check-read-bold"
                                    class="text-black text-[10px]"></iconify-icon>
                            </div>
                            <span class="text-sm font-medium text-gray-300 font-manrope" data-translate="comparison.aiBullet1">Unbiased, independent
                                evaluation of every candidate</span>
                        </div>
                        <div class="flex items-start gap-3">
                            <div
                                class="w-4 h-4 rounded-full bg-[#CBF300] flex items-center justify-center mt-0.5 flex-shrink-0 shadow-[0_0_8px_rgba(203, 243, 0,0.4)]">
                                <iconify-icon icon="solar:check-read-bold"
                                    class="text-black text-[10px]"></iconify-icon>
                            </div>
                            <span class="text-sm font-medium text-gray-300 font-manrope" data-translate="comparison.aiBullet2">Honest identification of red
                                flags and technical gaps</span>
                        </div>
                        <div class="flex items-start gap-3">
                            <div
                                class="w-4 h-4 rounded-full bg-[#CBF300] flex items-center justify-center mt-0.5 flex-shrink-0 shadow-[0_0_8px_rgba(203, 243, 0,0.4)]">
                                <iconify-icon icon="solar:check-read-bold"
                                    class="text-black text-[10px]"></iconify-icon>
                            </div>
                            <span class="text-sm font-medium text-gray-300 font-manrope" data-translate="comparison.aiBullet3">Deep, data-driven analysis free
                                from human bias</span>
                        </div>
                        <div class="flex items-start gap-3">
                            <div
                                class="w-4 h-4 rounded-full bg-[#CBF300] flex items-center justify-center mt-0.5 flex-shrink-0 shadow-[0_0_8px_rgba(203, 243, 0,0.4)]">
                                <iconify-icon icon="solar:check-read-bold"
                                    class="text-black text-[10px]"></iconify-icon>
                            </div>
                            <span class="text-sm font-medium text-gray-300 font-manrope" data-translate="comparison.aiBullet4">Transparent scoring based on
                                proven domain skills</span>
                        </div>
                    </div>

                    <!-- Visual UI -->
                    <div
                        class="overflow-hidden bg-[#0A0A0A] w-full z-10 border-white/10 border rounded-xl mr-auto ml-auto pt-5 pr-5 pb-5 pl-5 relative shadow-2xl">
                        <div class="absolute inset-0 bg-[#CBF300]/5 pointer-events-none mix-blend-overlay"></div>
                        <div class="flex z-10 mb-6 relative items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div
                                    class="w-8 h-8 rounded-full bg-gray-700 overflow-hidden border border-[#CBF300]/30">
                                    <img src="https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/83a1ae5f-c842-4ee9-a912-505fc66a1ee0_320w.webp"
                                        alt="" class="w-full h-full object-cover">
                                </div>
                                <span class="text-sm font-medium text-white" data-translate="comparison.avaMitchell">Ava Mitchell</span>
                            </div>
                            <div
                                class="text-[10px] font-bold text-[#CBF300] flex items-center gap-1.5 uppercase tracking-wide">
                                <div
                                    class="w-1.5 h-1.5 rounded-full bg-[#CBF300] animate-pulse shadow-[0_0_8px_rgba(203, 243, 0,0.6)]">
                                </div>
                                <span data-translate="comparison.liveAnalysis">Live Analysis</span>
                            </div>
                        </div>

                        <!-- Skills -->
                        <div class="z-10 border-white/5 border rounded-lg mb-6 pt-3 pr-3 pb-3 pl-3 relative space-y-4">
                            <div class="">
                                <div class="flex mb-1 justify-between">
                                    <span
                                        class="text-[10px] uppercase font-semibold text-gray-500 tracking-wide" data-translate="comparison.technicalProficiency">Technical
                                        Proficiency</span>
                                </div>
                                <div class="h-1.5 w-full bg-[#1A1A1A] rounded-full overflow-hidden">
                                    <div class="h-full w-[84%] rounded-full bg-[#CBF300] shadow-[0_0_12px_rgba(203,243,0,0.4)]"></div>
                                </div>
                            </div>
                            <div class="">
                                <div class="flex mb-1 justify-between">
                                    <span
                                        class="text-[10px] text-gray-500 font-semibold uppercase tracking-wide" data-translate="comparison.problemSolving">Problem
                                        Solving</span>
                                </div>
                                <div class="h-1.5 w-full bg-[#1A1A1A] rounded-full overflow-hidden">
                                    <div
                                        class="h-full bg-[#CBF300] w-[72%] rounded-full shadow-[0_0_12px_rgba(203, 243, 0,0.4)]">
                                    </div>
                                </div>
                            </div>
                            <div class="">
                                <div class="flex mb-1 justify-between">
                                    <span
                                        class="text-[10px] text-gray-500 font-semibold uppercase tracking-wide" data-translate="matching.communication">Communication</span>
                                </div>
                                <div class="h-1.5 w-full bg-[#1A1A1A] rounded-full overflow-hidden">
                                    <div
                                        class="h-full bg-[#CBF300] w-[94%] rounded-full shadow-[0_0_12px_rgba(203, 243, 0,0.4)]">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="flex flex-col md:flex-row gap-3 z-10 relative gap-x-3 gap-y-3">
                            <div
                                class="bg-[#CBF300]/10 border border-[#CBF300]/20 text-[#CBF300] text-xs font-bold py-2.5 px-4 rounded-lg shadow-[0_2px_10px_rgba(203, 243, 0,0.2)] whitespace-nowrap text-center">
                                <span data-translate="comparison.ninetyEightMatch">98% Match</span></div>
                            <div
                                class="text-[10px] flex flex-1 font-medium text-gray-400 text-center bg-[#151515] border-white/5 border rounded-lg pt-2.5 pr-3 pb-2.5 pl-3 shadow-sm items-center justify-center"
                                data-translate="comparison.aiVerifiedComplete">
                                AI verified skill assessment completed</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Section>
