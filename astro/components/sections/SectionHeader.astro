---
import type { LocalizedText } from '../../types/localized-text';

interface Props {
	kicker?: LocalizedText;
	title: LocalizedText;
	description?: LocalizedText;
	align?: 'left' | 'center';
	class?: string;
}

const { kicker, title, description, align = 'center', class: className = '' } = Astro.props;
---

<header class:list={[
	align === 'center' ? 'mx-auto max-w-3xl text-center' : 'max-w-2xl text-left',
	className,
]}>
	{kicker && <div class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-[#5EA500]" data-translate={kicker.translateKey}>{kicker.text}</div>}
	<h2 class="garna-hero-title-gradient text-4xl font-normal leading-tight tracking-tight md:text-5xl lg:text-6xl" data-translate={title.translateKey}>{title.text}</h2>
	{description && <p class="mt-6 text-lg font-light leading-relaxed text-gray-400 md:text-xl" data-translate={description.translateKey}>{description.text}</p>}
</header>
