---
import Section from '../../layout/Section.astro';
---

<Section contained={false} spacing="none" class="lg:pt-32 lg:pb-32 border-white/0 border-t pt-16 pb-16">
    <div class="max-w-7xl mr-auto ml-auto pr-6 pl-6">
        <!-- Section Header -->
        <div class="text-center mb-16 lg:mb-16">
    <h2 class="md:text-4xl lg:text-5xl text-4xl font-normal text-white tracking-tight font-manrope max-w-4xl mr-auto ml-auto mb-6"><span data-translate="advantage.title">The Garna advantage: fast, legal, global</span></h2>
    <p class="text-xl font-light text-gray-400 font-manrope max-w-3xl mr-auto ml-auto"><span data-translate="advantage.description">Streamline your international hiring with automated compliance, instant payouts, and zero operational headaches</span></p>
</div>

        <!-- Part 1: Benefits Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 w-full mr-auto ml-auto gap-x-6 gap-y-6">

    <!-- Fast -->
    <div class="reveal-card group flex flex-col hover:border-[#3b82f6]/30 transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_0_30px_rgba(59,130,246,0.15)] bg-[#0a0a0a] w-full h-full border-[#ffffff]/5 border rounded-2xl pt-6 pr-6 pb-6 pl-6 shadow-sm gap-x-4 gap-y-4 items-start" style="animation-delay: 100ms;">
        <div class="w-12 h-12 shrink-0 rounded-xl bg-[#3b82f6]/5 flex items-center justify-center border border-[#3b82f6]/20 text-[#3b82f6] text-xl font-medium font-manrope group-hover:scale-110 group-hover:bg-[#3b82f6]/10 transition-all duration-500">
            1
        </div>
        <div class="flex flex-col gap-2 w-full flex-1">
            <h3 class="text-xl font-normal text-white tracking-tight font-manrope m-0"><span data-translate="advantage.fast.title">Fast</span></h3>
            <p class="leading-relaxed text-sm font-light text-gray-400 font-manrope mt-0 mr-0 mb-0 ml-0"><span data-translate="advantage.fast.description">Launch white label on the web in 2 days instead of 6-12 months. Get app experience in 6 weeks</span></p>

            <div class="w-full h-40 mt-auto">
                <div class="overflow-hidden flex flex-col transition-colors w-full h-full pr-4 pl-4 relative justify-center">
                    <div class="absolute top-0 right-0 bottom-0 left-0"></div>

                    <div class="flex flex-col gap-2 mb-8 relative z-10">
                        <div class="flex justify-between items-center">
                            <span class="text-[8px] text-gray-500 uppercase tracking-widest font-medium"><span data-translate="advantage.fast.marketStandard">Market Standard</span></span>
                            <span class="text-[8px] text-gray-500 font-mono"><span data-translate="advantage.fast.thirtyDays">30 Days</span></span>
                        </div>
                        <div class="w-full h-[1px] bg-white/5 relative">
                            <div class="bg-gray-600 group-hover:bg-gray-400 transition-colors duration-300 w-full h-[1px] absolute top-0 left-0"></div>
                        </div>
                    </div>

                    <div class="flex flex-col gap-2 z-10 relative gap-x-2 gap-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-[8px] text-[#3b82f6] uppercase tracking-widest font-semibold">Garna</span>
                            <span class="text-[8px] text-[#3b82f6] font-mono"><span data-translate="advantage.fast.fourteenDays">14 Days</span></span>
                        </div>
                        <div class="bg-white/5 w-full h-[1px] relative">
                            <div class="transition-all duration-1000 ease-out bg-gradient-to-r from-transparent via-[#3b82f6] to-[#3b82f6] w-[47%] h-[1px] absolute top-0 left-0 shadow-[0_0_10px_#3b82f6]">
                                <div class="-translate-y-1/2 bg-white w-[3px] h-[3px] rounded-full absolute top-1/2 right-0 shadow-[0_0_12px_3px_#3b82f6] group-hover:scale-[2] transition-transform duration-500">
                                    <span class="absolute inset-0 inline-flex h-full w-full animate-ping rounded-full bg-[#3b82f6] opacity-75"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Legal Assistance -->
    <div class="reveal-card group flex flex-col hover:border-[#eab308]/30 transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_0_30px_rgba(234,179,8,0.15)] bg-[#0a0a0a] w-full h-full border-[#ffffff]/5 border rounded-2xl px-6 py-6 shadow-sm gap-x-4 gap-y-4 items-start" style="animation-delay: 200ms;">
        <div class="w-12 h-12 shrink-0 rounded-xl bg-[#eab308]/5 flex items-center justify-center border border-[#eab308]/20 text-[#eab308] text-xl font-medium font-manrope group-hover:scale-110 group-hover:bg-[#eab308]/10 transition-all duration-500">
            2
        </div>
        <div class="flex flex-col gap-2 w-full flex-1">
            <h3 class="text-xl font-normal text-white tracking-tight font-manrope m-0"><span data-translate="advantage.legal.title">Legal Assistance</span></h3>
            <p class="leading-relaxed text-sm font-light text-gray-400 font-manrope m-0"><span data-translate="advantage.legal.description">We handle operational risks and compliance</span></p>

            <div class="w-full h-40 mt-auto">
                <div class="overflow-hidden flex flex-col group-hover:bg-[#050505] transition-colors w-full h-full relative items-center justify-end">
                    <div class="flex flex-col w-full h-full relative items-center justify-center bg-[#0a0a0a]">
                        <div class="group-hover:-translate-y-3 transition-transform duration-500 flex flex-col z-10 w-[90%] h-[85%] border-white/10 border rounded-lg pt-4 pr-4 pb-4 pl-4 relative shadow-2xl">
                            <div class="flex w-full mb-3 items-start justify-between">
                                <span class="text-[8px] font-semibold tracking-widest text-white uppercase mt-0.5"><span data-translate="advantage.legal.framework">Legal Framework</span></span>
                                <div class="flex flex-col items-center justify-center border border-[#eab308] rounded-sm px-1.5 py-1 gap-[2px] bg-[#eab308]/5 shrink-0 group-hover:bg-[#eab308]/20 transition-colors duration-500">
                                    <span class="text-[5px] text-[#eab308] font-semibold tracking-widest uppercase"><span data-translate="advantage.legal.compliance">Compliance</span></span>
                                    <span class="text-[5px] text-[#eab308] font-semibold tracking-widest uppercase"><span data-translate="advantage.legal.passed">Passed</span></span>
                                </div>
                            </div>
                            <div class="flex flex-col gap-3 w-full mt-auto">
                                <div class="flex items-center gap-2">
                                    <div class="w-[3px] h-[3px] rounded-full bg-[#eab308] shrink-0 group-hover:shadow-[0_0_5px_#eab308] transition-shadow duration-500"></div>
                                    <div class="h-[2px] w-full bg-white/30 rounded-sm"></div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <div class="w-[3px] h-[3px] rounded-full bg-[#eab308] shrink-0 group-hover:shadow-[0_0_5px_#eab308] transition-shadow duration-500"></div>
                                    <div class="h-[2px] w-[85%] bg-white/30 rounded-sm"></div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <div class="w-[3px] h-[3px] rounded-full bg-[#eab308] shrink-0 group-hover:shadow-[0_0_5px_#eab308] transition-shadow duration-500"></div>
                                    <div class="h-[2px] w-[70%] bg-white/30 rounded-sm"></div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <div class="w-[3px] h-[3px] rounded-full bg-[#eab308] shrink-0 group-hover:shadow-[0_0_5px_#eab308] transition-shadow duration-500"></div>
                                    <div class="h-[2px] w-[90%] bg-white/30 rounded-sm"></div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <div class="w-[3px] h-[3px] rounded-full bg-[#eab308] shrink-0 group-hover:shadow-[0_0_5px_#eab308] transition-shadow duration-500"></div>
                                    <div class="h-[2px] w-[45%] bg-white/30 rounded-sm"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Global Payments -->
    <div class="reveal-card group flex flex-col hover:border-[#5EA500]/30 transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_0_30px_rgba(94,165,0,0.15)] bg-[#0a0a0a] w-full h-full border-[#ffffff]/5 border rounded-2xl pt-6 pr-6 pb-6 pl-6 shadow-sm gap-x-4 gap-y-4 items-start" style="animation-delay: 300ms;">
        <div class="w-12 h-12 shrink-0 rounded-xl bg-[#5EA500]/5 flex items-center justify-center border border-[#5EA500]/20 text-[#5EA500] text-xl font-medium font-manrope group-hover:scale-110 group-hover:bg-[#5EA500]/10 transition-all duration-500">
            3
        </div>
        <div class="flex flex-col gap-2 w-full flex-1">
            <h3 class="text-xl font-normal text-white tracking-tight font-manrope m-0"><span data-translate="advantage.payments.title">Global Payments</span></h3>
            <p class="leading-relaxed text-sm font-light text-gray-400 font-manrope m-0"><span data-translate="advantage.payments.description">Expand into different countries without local legal entities</span></p>

            <div class="w-full h-40 mt-auto pt-0">
                <div class="overflow-hidden flex flex-col transition-colors w-full h-full pt-3 pr-3 pb-3 pl-3 relative gap-x-2 gap-y-2 justify-center">

                    <div class="text-[8px] text-gray-500 tracking-widest uppercase mb-1 text-center font-medium group-hover:text-gray-300 transition-colors duration-500"><span data-translate="advantage.payments.localCurrencies">+80 Local Currencies</span></div>

                    <div class="flex z-10 w-full border-white/5 border-b pt-1.5 pr-2 pb-1.5 pl-2 relative items-center justify-between transition-transform duration-500">
                        <div class="flex items-center gap-2">
                            <div class="w-4 h-4 rounded-full bg-[#0A0A0A] border border-white/20 flex items-center justify-center text-[6px] font-medium text-gray-300">US</div>
                            <span class="text-[9px] font-medium text-white tracking-widest">USD</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <div class="w-10 h-3 opacity-80 group-hover:opacity-100 transition-opacity">
                                <svg viewBox="0 0 60 16" class="w-full h-full overflow-visible" preserveAspectRatio="none">
                                    <path d="M0,12 C10,12 15,4 25,6 C35,8 40,14 50,8 C55,5 58,4 60,6" fill="none" stroke="#5EA500" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"></path>
                                </svg>
                            </div>
                            <span class="text-[7px] font-medium text-[#5EA500] tracking-wide">+14%</span>
                        </div>
                    </div>

                    <div class="flex items-center justify-between w-full py-1.5 px-2 relative z-10 border-b border-white/5 transition-transform duration-500 delay-[75ms]">
                        <div class="flex items-center gap-2">
                            <div class="w-4 h-4 rounded-full bg-[#0A0A0A] border border-white/20 flex items-center justify-center text-[6px] font-medium text-gray-300">EU</div>
                            <span class="text-[9px] font-medium text-white tracking-widest">EUR</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <div class="w-10 h-3 opacity-70 group-hover:opacity-100 transition-opacity">
                                <svg viewBox="0 0 60 16" class="w-full h-full overflow-visible" preserveAspectRatio="none">
                                    <path d="M0,8 C10,8 15,12 25,10 C35,8 40,4 50,6 C55,7 58,10 60,8" fill="none" stroke="#3b82f6" stroke-opacity="0.5" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class=""></path>
                                </svg>
                            </div>
                            <span class="text-[7px] font-medium text-[#3b82f6] tracking-wide opacity-80">+8%</span>
                        </div>
                    </div>

                    <div class="flex items-center justify-between w-full py-1.5 px-2 relative z-10 transition-transform duration-500 delay-[150ms]">
                        <div class="flex items-center gap-2">
                            <div class="w-4 h-4 rounded-full bg-[#0A0A0A] border border-white/20 flex items-center justify-center text-[6px] font-medium text-gray-300">GB</div>
                            <span class="text-[9px] font-medium text-white tracking-widest">GBP</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <div class="w-10 h-3 opacity-60 group-hover:opacity-100 transition-opacity">
                                <svg viewBox="0 0 60 16" class="w-full h-full overflow-visible" preserveAspectRatio="none">
                                    <path d="M0,10 C10,14 15,8 25,12 C35,16 40,6 50,4 C55,3 58,5 60,4" fill="none" stroke="#eab308" stroke-opacity="0.3" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"></path>
                                </svg>
                            </div>
                            <span class="text-[7px] font-medium text-[#eab308] tracking-wide opacity-60">+5%</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Brand Ownership -->
    <div class="reveal-card group flex flex-col hover:border-[#a855f7]/30 transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_0_30px_rgba(168,85,247,0.15)] bg-[#0a0a0a] w-full h-full border-[#ffffff]/5 border rounded-2xl pt-6 pr-6 pb-6 pl-6 shadow-sm gap-x-4 gap-y-4 items-start" style="animation-delay: 400ms;">
        <div class="w-12 h-12 shrink-0 rounded-xl bg-[#a855f7]/5 flex items-center justify-center border border-[#a855f7]/20 text-[#a855f7] text-xl font-medium font-manrope group-hover:scale-110 group-hover:bg-[#a855f7]/10 transition-all duration-500">
            4
        </div>
        <div class="flex flex-col flex-1 w-full gap-x-2 gap-y-2">
            <h3 class="text-xl font-normal text-white tracking-tight font-manrope m-0"><span data-translate="advantage.brand.title">Brand Ownership</span></h3>
            <p class="leading-relaxed text-sm font-light text-gray-400 font-manrope mt-0 mr-0 mb-0 ml-0"><span data-translate="advantage.brand.description">You remain the sole owner of the brand and keep your database</span></p>

            <div class="w-full h-40 mt-auto pt-0">
                <div class="overflow-hidden flex transition-colors w-full h-full relative items-center justify-center">
                    <div class="group-hover:-translate-y-2 transition-transform duration-500 flex flex-col w-[90%] h-[85%] border-[#ffffff]/10 border rounded-lg pt-5 pr-5 pb-5 pl-5 relative shadow-2xl items-center justify-end">
                        <div class="absolute top-2.5 left-2.5 flex gap-1"></div>
                        <div class="text-[8px] uppercase text-gray-500 tracking-widest font-mono mt-1 mb-3"><span data-translate="advantage.brand.passport">Digital Asset Passport</span></div>
                        <div class="leading-none text-4xl font-normal text-white tracking-tight font-manrope mb-1">100%</div>
                        <div class="text-[8px] text-[#a855f7] tracking-widest uppercase font-bold mb-4"><span data-translate="advantage.brand.dataOwnership">Data Ownership</span></div>
                        <div class="bg-white/10 w-full h-[1px] relative">
                            <div class="-translate-x-1/2 -translate-y-1/2 text-[6px] text-gray-500 tracking-widest font-mono border-white/5 border rounded-sm pr-2 pl-2 absolute top-1/2 left-1/2 group-hover:bg-[#a855f7]/20 group-hover:text-white group-hover:border-[#a855f7]/50 transition-colors duration-500"><span data-translate="advantage.brand.verified">VERIFIED</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

        <!-- Part 2: Comparison Widget -->

    </div>
</Section>
