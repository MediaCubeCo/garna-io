---
import Section from '../../layout/Section.astro';
---

<Section contained={false} spacing="none" class="lg:pt-32 lg:pb-32 pt-16 pb-16">
        <div class="max-w-7xl mr-auto ml-auto pr-6 pl-6 flex flex-col items-center">
    <!-- Tag -->
    <div class="inline-flex gap-2 bg-[#5EA500]/10 border-[#5EA500]/20 border rounded-full pt-1.5 pr-3 pb-1.5 pl-3 shadow-sm backdrop-blur-sm items-center mb-8 mx-auto">
        <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#5EA500] opacity-75"></span>
            <span class="inline-flex bg-[#5EA500] w-2 h-2 rounded-full relative"></span>
        </span>
        <span class="uppercase text-xs font-medium text-[#5EA500] tracking-wide font-manrope"><span data-translate="infrastructure.badge">Garna White Label Infrastructure</span></span>
    </div>

    <!-- Text Content -->
    <div class="flex flex-col items-center text-center w-full mb-12">
        <h2 class="md:text-4xl lg:text-5xl text-4xl font-normal text-white tracking-tight font-manrope max-w-4xl mr-auto mb-6 ml-auto"><span data-translate="infrastructure.title">Your logo on the front. Our powerful engine under the hood.</span></h2>
        <p class="text-xl font-light text-gray-400 font-manrope text-center max-w-5xl mr-auto mb-4 ml-auto"><span data-translate="infrastructure.description">Garna lets you launch white-label contractor payroll solutions in 2 days without investments and months of development. No need to connect payment systems and worry about compliance. We've already done it for you</span></p>
    </div>

    <!-- Cards Layout -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full text-left max-w-5xl">
        <!-- Card 1 -->
        <div class="lg:p-8 hover:border-[#5EA500]/30 transition-all duration-300 group overflow-hidden hover:shadow-[0_0_30px_rgba(94,165,0,0.15)] hover:-translate-y-1 bg-[#0A0A0A] border-white/5 border rounded-2xl pt-6 pr-6 pb-6 pl-6 relative shadow-[0_0_15px_rgba(0,0,0,0.5)]">
            <div class="absolute -right-10 -top-10 w-40 h-40 bg-[#5EA500]/5 rounded-full blur-3xl group-hover:bg-[#5EA500]/10 transition-colors duration-500"></div>

            <div class="flex items-center gap-4 mb-4 relative z-10">
                <div class="w-12 h-12 rounded-xl bg-[#5EA500]/10 border border-[#5EA500]/20 flex items-center justify-center text-[#5EA500] shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                </div>
                <h3 class="text-xl lg:text-2xl font-medium text-white tracking-tight font-manrope m-0"><span data-translate="products.contractorManagement.title">Contractor Management</span></h3>
            </div>

            <p class="lg:text-base leading-relaxed z-10 group-hover:text-gray-300 transition-colors text-sm font-light text-gray-400 font-manrope mt-0 mr-0 mb-0 ml-0 relative"><span data-translate="products.contractorManagement.description">A comprehensive ecosystem for working with freelancers: onboard, manage, and pay international contractors</span></p>
        </div>

        <!-- Card 2 -->
        <div class="bg-[#0A0A0A] rounded-2xl p-6 lg:p-8 border border-white/5 hover:border-[#5EA500]/30 transition-all duration-300 group relative overflow-hidden shadow-[0_0_15px_rgba(0,0,0,0.5)] hover:shadow-[0_0_30px_rgba(94,165,0,0.15)] hover:-translate-y-1">
            <div class="absolute -right-10 -top-10 w-40 h-40 bg-[#5EA500]/5 rounded-full blur-3xl group-hover:bg-[#5EA500]/10 transition-colors duration-500"></div>

            <div class="flex items-center gap-4 mb-4 relative z-10">
                <div class="w-12 h-12 rounded-xl bg-[#5EA500]/10 border border-[#5EA500]/20 flex items-center justify-center text-[#5EA500] shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="" data-lucide="shield-check" data-icon-set="lucide" data-icon-replaced="true" style="color: rgb(94, 165, 0);"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg>
                </div>
                <h3 class="text-xl lg:text-2xl font-medium text-white tracking-tight font-manrope m-0"><span data-translate="products.contractorOfRecord.title">Contractor of Record</span></h3>
            </div>

            <p class="lg:text-base leading-relaxed group-hover:text-gray-300 transition-colors text-sm font-light text-gray-400 font-manrope z-10 mt-0 mr-0 mb-0 ml-0 relative"><span data-translate="products.contractorOfRecord.description">Assuming legal liability and protecting business from misclassification risk while you are managing your contractors</span></p>
        </div>
    </div>
</div>
    </Section>
