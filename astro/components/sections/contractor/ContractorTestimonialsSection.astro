---
import Section from '../../layout/Section.astro';
---

<Section contained={false} spacing="none" class="overflow-hidden md:pt-16 md:pb-16 lg:pt-32 lg:pb-32 border-white/0 border-t pt-16 pb-16 relative">
        <div class="z-10 max-w-7xl mr-auto ml-auto pr-6 pl-6 relative">
            <div class="text-center mb-16">
                <p class="uppercase text-sm font-medium text-[#5EA500] tracking-wider font-manrope mb-4">
                    <span data-translate="testimonials.badgeBefore">JOIN</span>
                    <span id="cnt-offer-freelancers" class="tabular-nums">0</span>
                    <span data-translate="testimonials.badgeAfter">+ FREELANCERS</span>
                </p>

                <h2 class="lg:text-5xl text-4xl font-normal text-white tracking-tight font-manrope mb-6"
                    data-translate="testimonials.title">
                    Trusted by talent worldwide
                </h2>
                <p class="text-xl font-light text-gray-400 font-manrope max-w-2xl mr-auto ml-auto"
                    data-translate="testimonials.description">
                    See why independent professionals are switching to Garna
                </p>
            </div>

            <div class="grid grid-cols-1 min-[961px]:grid-cols-3 gap-8">
                <!-- Review 1 -->
                <div class="glass-card p-8 rounded-2xl flex flex-col h-full">
                    <div class="mb-6 text-[#5EA500]">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                            class="w-7 h-7">
                            <polygon
                                points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2">
                            </polygon>
                        </svg>
                    </div>
                    <p class="leading-relaxed flex-grow text-gray-300 font-manrope mb-8"
                        data-translate="testimonials.items.first.quote">
                        "Finally, a platform that doesn't make me feel like a second-class citizen. Getting paid is
                        instant, and I
                        can withdraw to my local bank without the usual headache."
                    </p>
                    <div class="flex items-center gap-3 pt-6 border-t border-white/5">
                        <div class="h-10 w-10 rounded-full bg-white/10 border border-white/5 overflow-hidden">
                            <img src="https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/83a1ae5f-c842-4ee9-a912-505fc66a1ee0_320w.webp"
                                alt="Avatar" class="opacity-80 w-full h-full object-cover" />
                        </div>
                        <div class="">
                            <div class="text-sm font-medium text-white font-manrope"
                                data-translate="testimonials.items.first.name">
                                Sarah J.
                            </div>
                            <div class="text-xs text-gray-500 font-manrope"
                                data-translate="testimonials.items.first.role">
                                Senior UX Designer
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Review 2 -->
                <div class="glass-card p-8 rounded-2xl flex flex-col h-full bg-white/[0.02]">
                    <div class="mb-6 text-[#5EA500]">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                            class="w-7 h-7">
                            <path
                                d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z">
                            </path>
                            <path d="m9 12 2 2 4-4"></path>
                        </svg>
                    </div>
                    <p class="leading-relaxed flex-grow text-gray-300 font-manrope mb-8"
                        data-translate="testimonials.items.second.quote">
                        "Garna opened the US market for me. I can now accept payments from clients who only work with US
                        entities
                        and withdraw straight to my bank. Absolute game changer."
                    </p>
                    <div class="flex items-center gap-3 pt-6 border-t border-white/5">
                        <div class="h-10 w-10 rounded-full bg-white/10 border border-white/5 overflow-hidden">
                            <img src="https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/152b527e-f3bb-44db-98a8-e224a84a1318_320w.webp"
                                alt="Avatar" class="opacity-80 w-full h-full object-cover" />
                        </div>
                        <div class="">
                            <div class="text-sm font-medium text-white font-manrope"
                                data-translate="testimonials.items.second.name">
                                Marcus C.
                            </div>
                            <div class="text-xs text-gray-500 font-manrope"
                                data-translate="testimonials.items.second.role">
                                Full Stack Developer
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Review 3 -->
                <div class="glass-card p-8 rounded-2xl flex flex-col h-full">
                    <div class="mb-6 text-[#5EA500]">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                            class="w-7 h-7">
                            <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
                            <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
                            <path d="m9 15 2 2 4-4"></path>
                        </svg>
                    </div>
                    <p class="leading-relaxed flex-grow text-gray-300 font-manrope mb-8"
                        data-translate="testimonials.items.third.quote">
                        "Had an issue with my local tax authorities before started using Garna. Now I have all the tax
                        documents
                        in place."
                    </p>
                    <div class="flex items-center gap-3 pt-6 border-t border-white/5">
                        <div class="h-10 w-10 rounded-full bg-white/10 border border-white/5 overflow-hidden">
                            <img src="https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/f8322831-e2ba-4007-9960-8e7e82b00480_320w.webp"
                                alt="Avatar" class="opacity-80 w-full h-full object-cover" />
                        </div>
                        <div class="">
                            <div class="text-sm font-medium text-white font-manrope"
                                data-translate="testimonials.items.third.name">
                                Elena V.
                            </div>
                            <div class="text-xs text-gray-500 font-manrope"
                                data-translate="testimonials.items.third.role">
                                Marketing Consultant
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex justify-center mt-12">
                <a href="https://app.garna.io/en/auth/sign-up" data-garna-signup
                    class="group inline-flex items-center justify-center gap-2 transition-all hover:scale-105 accent-glow text-base font-medium text-white font-manrope bg-[#5EA500] rounded-xl pt-3 pr-8 pb-3 pl-8 shadow-[0_0_30px_-5px_rgba(94,165,0,0.4)]">
                    <span data-translate="testimonials.joinCta">Join Garna</span>
                </a>
            </div>
        </div>
    </Section>
