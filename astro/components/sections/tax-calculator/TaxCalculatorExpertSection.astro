---
import Section from '../../layout/Section.astro';
---

<Section contained={false} spacing="none" class="tax-expert">
	<div class="garna-container">
		<div class="tax-expert__inner">
			<div class="tax-expert__visual" aria-hidden="true">
				<img src="/pages/home/assets/contractor-cost-human-upscaled.jpg" alt="" loading="lazy" />
				<div class="tax-expert__shade"></div>
			</div>
			<div class="tax-expert__copy">
				<span class="tax-section-kicker" data-translate="expert.kicker">Questions about your report?</span>
				<h2 data-translate="expert.title">Our global hiring experts can help</h2>
				<p data-garna-subtitle data-translate="expert.text">Understand your costs and explore the best hiring options for your international team</p>
				<a class="garna-button tax-primary-link" href="https://garna.io/en/form" data-localized-path="form" data-translate="expert.cta">Talk to an Expert</a>
			</div>
		</div>
	</div>
</Section>
