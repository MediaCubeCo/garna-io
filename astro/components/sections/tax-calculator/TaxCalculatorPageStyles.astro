<style is:global>
	.tax-card__header {
		display: block;
	}

	.tax-card__meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
	}

	.tax-location-grid,
	.tax-compensation-grid {
		display: grid;
		gap: 14px;
	}

	.tax-location-grid {
		grid-template-columns: 1fr;
	}

	.tax-location-grid:has(#tax-state-field:not([hidden])) {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.tax-compensation-grid {
		grid-template-columns: minmax(0, 1fr) minmax(132px, 170px);
	}

	.tax-currency-select {
		position: absolute;
		top: 1px;
		right: 1px;
		width: 92px !important;
		height: 50px !important;
		padding: 0 30px 0 12px !important;
		border: 0 !important;
		border-left: 1px solid rgba(255, 255, 255, 0.09) !important;
		border-radius: 0 10px 10px 0 !important;
		background-color: #0d0d0d !important;
		appearance: none;
		font-size: 12px !important;
		color: transparent !important;
		cursor: pointer;
	}

	.tax-currency-select option {
		color: #fff;
	}

	.tax-currency-value {
		position: absolute;
		right: 34px;
		top: 50%;
		z-index: 1;
		transform: translateY(-50%);
		color: #fff;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.02em;
		pointer-events: none;
	}

	.tax-currency-chevron {
		position: absolute;
		right: 12px;
		top: 50%;
		z-index: 1;
		display: grid;
		place-items: center;
		transform: translateY(-50%);
		color: #a1a1aa;
		pointer-events: none;
	}

	.tax-currency-chevron[hidden] {
		display: none;
	}

	.has-single-currency .tax-currency-value {
		right: 16px;
	}

	.has-single-currency .tax-currency-select {
		cursor: default;
		pointer-events: none;
	}

	.tax-input-wrap input {
		padding-right: 106px;
	}

	.tax-currency-select:focus {
		box-shadow: inset 0 0 0 1px rgba(94, 165, 0, 0.8) !important;
	}

	@media (max-width: 640px) {
		.tax-location-grid:has(#tax-state-field:not([hidden])),
		.tax-compensation-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
