<style is:global>
	.tax-card__header {
		display: block;
	}

	.tax-card__meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
	}

	.tax-location-grid,
	.tax-compensation-grid {
		display: grid;
		gap: 14px;
	}

	.tax-location-grid {
		grid-template-columns: 1fr;
	}

	.tax-location-grid:has(#tax-state-field:not([hidden])) {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.tax-compensation-grid {
		grid-template-columns: minmax(0, 1fr);
	}

	.tax-currency-select {
		position: absolute;
		top: 1px;
		right: 1px;
		width: 92px !important;
		height: 50px !important;
		padding: 0 30px 0 12px !important;
		border: 0 !important;
		border-left: 1px solid rgba(255, 255, 255, 0.09) !important;
		border-radius: 0 10px 10px 0 !important;
		background-color: #0d0d0d !important;
		appearance: none;
		font-size: 12px !important;
		color: transparent !important;
		cursor: pointer;
	}

	.tax-currency-select option {
		color: #fff;
	}

	.tax-currency-value {
		position: absolute;
		right: 34px;
		top: 50%;
		z-index: 1;
		transform: translateY(-50%);
		color: #fff;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.02em;
		pointer-events: none;
	}

	.tax-currency-chevron {
		position: absolute;
		right: 12px;
		top: 50%;
		z-index: 1;
		display: grid;
		place-items: center;
		transform: translateY(-50%);
		color: #a1a1aa;
		pointer-events: none;
	}

	.tax-currency-chevron[hidden] {
		display: none;
	}

	.has-single-currency .tax-currency-value {
		right: 16px;
	}

	.has-single-currency .tax-currency-select {
		cursor: default;
		pointer-events: none;
	}

	.tax-input-wrap input {
		padding-right: 86px;
	}

	.tax-currency-select:focus {
		box-shadow: inset 0 0 0 1px rgba(203, 243, 0, 0.8) !important;
	}

	.tax-card select.tax-native-select {
		position: absolute !important;
		width: 1px !important;
		height: 1px !important;
		margin: -1px !important;
		overflow: hidden !important;
		clip: rect(0 0 0 0) !important;
		clip-path: inset(50%) !important;
		opacity: 0 !important;
		pointer-events: none !important;
	}

	.tax-custom-select {
		position: relative;
		min-width: 0;
	}

	.tax-select-trigger {
		display: flex;
		width: 100%;
		min-height: 52px;
		align-items: center;
		gap: 12px;
		border: 1px solid rgba(255, 255, 255, 0.09);
		border-radius: 11px;
		background: #0d0d0d;
		padding: 0 15px;
		color: #fff;
		cursor: pointer;
		font: 500 14px Manrope, sans-serif;
		text-align: left;
		transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
	}

	.tax-select-trigger:hover {
		border-color: rgba(255, 255, 255, 0.22);
		background: #111;
	}

	.tax-select-trigger:focus-visible,
	.tax-custom-select[data-open='true'] .tax-select-trigger {
		border-color: #cbf300;
		box-shadow: 0 0 0 2px rgba(203, 243, 0, 0.16);
		outline: none;
	}

	.tax-select-trigger:disabled {
		cursor: default;
		opacity: 0.45;
	}

	.tax-select-value {
		min-width: 0;
		flex: 1;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.tax-select-value[data-placeholder='true'] {
		color: #777780;
	}

	.tax-select-trigger svg {
		width: 16px;
		height: 16px;
		flex: 0 0 auto;
		fill: none;
		stroke: #8b8b91;
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: stroke 0.16s, transform 0.16s;
	}

	.tax-select-value[data-placeholder='true'] + svg {
		stroke: #777780;
	}

	.tax-custom-select:has(.tax-select-clear) .tax-select-value {
		padding-right: 34px;
	}

	.tax-select-clear {
		position: absolute;
		z-index: 2;
		top: 50%;
		right: 2.65rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		padding: 0;
		border: 0;
		background: transparent;
		color: rgb(255 255 255 / 0.48);
		opacity: 0;
		pointer-events: none;
		transform: translateY(-50%);
		transition: color 140ms ease, opacity 140ms ease;
	}

	.tax-custom-select[data-has-value='true']:hover > .tax-select-clear,
	.tax-custom-select[data-has-value='true']:focus-within > .tax-select-clear {
		opacity: 1;
		pointer-events: auto;
	}

	.tax-select-clear:hover,
	.tax-select-clear:focus-visible {
		color: #fff;
		outline: none;
	}

	.tax-select-clear svg {
		width: 0.95rem;
		height: 0.95rem;
	}

	.tax-select-clear svg path {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
	}

	.tax-custom-select[data-open='true'] .tax-select-trigger svg {
		stroke: #cbf300;
		transform: rotate(180deg);
	}

	.tax-select-menu {
		position: absolute;
		z-index: 45;
		top: calc(100% + 8px);
		right: 0;
		left: 0;
		max-height: 240px;
		overflow-y: auto;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 12px;
		background: #101010;
		padding: 6px;
		box-shadow: 0 18px 42px rgba(0, 0, 0, 0.42);
	}

	.tax-select-menu[hidden] {
		display: none;
	}

	.tax-select-menu[data-placement='top'] {
		top: auto;
		bottom: calc(100% + 8px);
	}

	.tax-country-row:has(.tax-custom-select[data-open='true']) {
		z-index: 50;
	}

	.tax-select-menu button {
		display: flex;
		width: 100%;
		min-height: 42px;
		align-items: center;
		border: 1px solid transparent;
		border-radius: 9px;
		background: transparent;
		padding: 9px 11px;
		color: #d5d5d8;
		cursor: pointer;
		font: 500 14px/1.4 Manrope, sans-serif;
		text-align: left;
	}

	.tax-select-menu button:hover,
	.tax-select-menu button:focus-visible {
		background: rgba(255, 255, 255, 0.055);
		color: #fff;
		outline: none;
	}

	.tax-select-menu button[aria-selected='true'] {
		border-color: rgba(203, 243, 0, 0.35);
		background: rgba(203, 243, 0, 0.055);
		color: #fff;
	}

	.tax-input-wrap > .tax-custom-select {
		position: absolute;
		top: 1px;
		right: 1px;
		width: 84px;
	}

	.tax-input-wrap > .tax-custom-select .tax-select-trigger {
		min-height: 50px;
		border: 0;
		border-left: 1px solid rgba(255, 255, 255, 0.09);
		border-radius: 0 10px 10px 0;
		gap: 5px;
		padding: 0 15px;
		font-size: 12px;
		font-weight: 600;
	}

	.tax-input-wrap > .tax-custom-select .tax-select-menu {
		left: auto;
		width: min(280px, calc(100vw - 48px));
	}

	.tax-input-wrap:has(.tax-custom-select) .tax-currency-value,
	.tax-input-wrap:has(.tax-custom-select) .tax-currency-chevron {
		display: none;
	}

	@media (max-width: 640px) {
		.tax-location-grid:has(#tax-state-field:not([hidden])),
		.tax-compensation-grid {
			grid-template-columns: 1fr;
		}
	}

</style>
