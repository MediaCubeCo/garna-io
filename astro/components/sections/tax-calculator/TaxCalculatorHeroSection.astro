---
import Section from '../../layout/Section.astro';
import Button from '../../ui/Button.astro';
import Card from '../../ui/Card.astro';
import { calculatorCountries, calculatorCurrencies } from '../../../../src/data/calculator-countries';
---

<Section contained={false} spacing="none" class="tax-hero">
		<div class="garna-container tax-hero__inner">
			<div class="tax-copy">
				<div class="garna-hero-badge"><span class="garna-hero-badge-dot-shell"><span class="garna-hero-badge-dot-ping"></span><span class="garna-hero-badge-dot"></span></span><span data-translate="hero.badge">Global hiring intelligence</span></div>
				<h1 data-translate="hero.title">Employee Cost Calculator</h1>
				<p data-garna-subtitle data-translate="hero.description">Compare the true annual cost of hiring across countries, including gross salary and local employer contributions.</p>
				<div class="tax-trust"><span>150+</span><span data-translate="hero.countries">supported countries</span><i></i><span data-translate="hero.updated">Current employment cost data</span></div>
			</div>
			<div class="tax-card-shell" id="calculator" data-calculator-state="idle">
				<Card variant="feature" class="tax-card" ariaBusy={false}>
				<div class="tax-form-view">
				<div class="tax-card__header"><div class="tax-card__meta"><span data-translate="calculator.eyebrow">Employer cost comparison</span><span class="tax-live"><i></i><span data-translate="calculator.live">Live estimate</span></span></div><h2 data-translate="calculator.title">Compare the cost of hiring across countries</h2></div>
				<form id="tax-form">
					<div class="tax-country-builder" id="tax-country-rows">
						<div class="tax-country-row" data-country-row="0">
							<label><span data-translate="calculator.country">Country</span><select class="tax-country-select" aria-label="Country 1" required><option value="" data-translate="calculator.selectCountry">Select a country</option>{calculatorCountries.map(([code,name]) => <option value={code} data-country-name={name}>{name}</option>)}</select></label>
							<label class="tax-region-field" hidden><span data-translate="calculator.state">State or region</span><select class="tax-region-select" aria-label="State or region"></select></label>
						</div>
					</div>
					<button id="tax-add-comparison-country" class="tax-add-comparison" type="button"><span aria-hidden="true">＋</span><span data-translate="calculator.addCountry">Add a second country for comparison</span></button>
					<div class="tax-compensation-grid">
						<label><span data-translate="calculator.salary">Gross annual salary</span><input id="tax-salary-value" name="salary" type="hidden"/><div class="tax-input-wrap"><input id="tax-salary-display" type="text" inputmode="numeric" pattern="[0-9,]*" autocomplete="off" placeholder="60,000" aria-label="Gross annual salary" required/><span class="tax-currency-value" id="tax-currency-value" aria-hidden="true">USD</span><select class="tax-currency-select" name="currency" aria-label="Currency" title="Currency"><optgroup label="All currencies">{calculatorCurrencies.map(([code,name]) => <option value={code}>{code} — {name}</option>)}</optgroup></select><span class="tax-currency-chevron" id="tax-currency-chevron" aria-hidden="true"><svg width="12" height="8" viewBox="0 0 12 8" fill="none"><path d="M1 1.25 6 6.25l5-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div></label>
					</div>
					<Button type="submit" class="tax-submit"><span data-translate="calculator.calculate">Compare hiring costs</span><span aria-hidden="true">→</span></Button>
					</form>
					<div id="tax-status" class="tax-status" aria-live="polite"></div>
					</div>
					<div class="tax-loading-view" role="status" aria-live="polite" aria-hidden="true">
						<div class="tax-loader" aria-hidden="true"><i></i><i></i><i></i><span></span></div>
						<strong data-translate="messages.loading">Comparing hiring markets…</strong>
						<p data-translate="messages.loadingHint">Calculating local employer costs and contributions</p>
					</div>
					<div id="tax-results" class="tax-results" hidden></div>
				</Card>
			</div>
		</div>
	</Section>
