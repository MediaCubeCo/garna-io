---
import Section from '../layout/Section.astro';
import Button from '../ui/Button.astro';
import type { LocalizedText } from '../../types/localized-text';

interface TabbedImageFeaturePanel {
	key: string;
	tab: LocalizedText;
	image: string;
	imageAlt?: string;
	imagePosition?: string;
	imagePositionMobile?: string;
	copyWidthTablet?: string;
	tag: LocalizedText;
	title: LocalizedText;
	description: LocalizedText;
	cta?: LocalizedText & {
		href?: string;
	};
}

interface Props {
	id?: string;
	title: LocalizedText;
	description: LocalizedText;
	panels: TabbedImageFeaturePanel[];
	tabsAriaLabel: LocalizedText;
	class?: string;
	headerClass?: string;
	titleClass?: string;
	duration?: number;
}

const {
	id,
	title,
	description,
	panels,
	tabsAriaLabel,
	class: className = '',
	headerClass = 'mb-12 max-w-5xl lg:mb-16',
	titleClass = 'lg:text-5xl',
	duration = 14000,
} = Astro.props;

const featureId = id || `tabbed-image-feature-${panels.map((panel) => panel.key).join('-')}`;
---

<Section
	spacing="default"
	title={title}
	description={description}
	class={className}
	headerClass={headerClass}
	titleClass={titleClass}
>
	<div class="tabbed-image-feature" data-tabbed-image-feature={featureId} style={`--tabbed-tabs-count:${panels.length};`}>
		<div class="tabbed-image-feature__stage">
			{panels.map((panel, index) => (
				<article
					class="tabbed-image-feature__panel"
					id={`${featureId}-panel-${panel.key}`}
					role="tabpanel"
					aria-labelledby={`${featureId}-tab-${panel.key}`}
					data-tabbed-image-panel={panel.key}
					style={`--tabbed-image-position:${panel.imagePosition || 'center'};--tabbed-image-mobile-position:${panel.imagePositionMobile || panel.imagePosition || 'center'};--tabbed-copy-tablet-width:${panel.copyWidthTablet || '460px'};`}
					hidden={index > 0}
				>
					<img class="tabbed-image-feature__image" src={panel.image} alt={panel.imageAlt || ''} loading="lazy" decoding="async" />
					<div class="tabbed-image-feature__shade" aria-hidden="true"></div>
					<div class="tabbed-image-feature__copy">
						<span class="tabbed-image-feature__tag" data-translate={panel.tag.translateKey}>{panel.tag.text}</span>
						<h3 data-translate={panel.title.translateKey}>{panel.title.text}</h3>
						<p data-translate={panel.description.translateKey}>{panel.description.text}</p>
						{panel.cta && (
							<Button href={panel.cta.href || '#'} variant="inline-accent" size="inline" class="mt-6">
								<span data-translate={panel.cta.translateKey}>{panel.cta.text}</span>
								<span class="garna-button-arrow-glyph" aria-hidden="true">→</span>
							</Button>
						)}
					</div>
				</article>
			))}
		</div>
		<div class="tabbed-image-feature__tabs" role="tablist" aria-label={tabsAriaLabel.text} data-translate-aria-label={tabsAriaLabel.translateKey}>
			{panels.map((panel, index) => (
				<button
					class:list={['tabbed-image-feature__tab', index === 0 && 'active']}
					id={`${featureId}-tab-${panel.key}`}
					type="button"
					role="tab"
					aria-selected={index === 0 ? 'true' : 'false'}
					aria-controls={`${featureId}-panel-${panel.key}`}
					data-tabbed-image-tab={panel.key}
				>
					<span data-translate={panel.tab.translateKey}>{panel.tab.text}</span>
				</button>
			))}
		</div>
	</div>
</Section>

<script define:vars={{ featureId, duration }}>
	for (const root of document.querySelectorAll(`[data-tabbed-image-feature="${featureId}"]`)) {
		if (!(root instanceof HTMLElement) || root.dataset.ready === 'true') continue;
		root.dataset.ready = 'true';

		const tabs = Array.from(root.querySelectorAll('[data-tabbed-image-tab]'));
		const panels = root.querySelectorAll('[data-tabbed-image-panel]');
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let activeIndex = 0;
		let startedAt = 0;
		let elapsed = 0;
		let frame = 0;
		let inViewport = false;

		const show = (index, restart = true) => {
			activeIndex = index;
			tabs.forEach((item, itemIndex) => {
				const active = itemIndex === index;
				item.classList.toggle('active', active);
				item.setAttribute('aria-selected', String(active));
				if (item instanceof HTMLElement) item.style.setProperty('--progress', active && reduceMotion ? '1' : '0');
			});
			const key = tabs[index]?.getAttribute('data-tabbed-image-tab');
			panels.forEach((panel) => {
				if (panel instanceof HTMLElement) panel.hidden = panel.getAttribute('data-tabbed-image-panel') !== key;
			});
			if (restart) {
				elapsed = 0;
				startedAt = performance.now();
			}
		};

		const tick = (now) => {
			if (!inViewport || document.hidden || reduceMotion) return;
			const progress = Math.min((elapsed + now - startedAt) / duration, 1);
			const activeTab = tabs[activeIndex];
			if (activeTab instanceof HTMLElement) activeTab.style.setProperty('--progress', String(progress));
			if (progress >= 1) show((activeIndex + 1) % tabs.length);
			frame = requestAnimationFrame(tick);
		};

		const start = () => {
			if (!inViewport || document.hidden || reduceMotion || frame) return;
			startedAt = performance.now();
			frame = requestAnimationFrame(tick);
		};

		const pause = () => {
			if (frame) cancelAnimationFrame(frame);
			frame = 0;
			if (startedAt) elapsed = Math.min(elapsed + performance.now() - startedAt, duration);
			startedAt = 0;
		};

		tabs.forEach((tab, index) => tab.addEventListener('click', () => {
			pause();
			show(index);
			start();
		}));

		const observer = new IntersectionObserver(([entry]) => {
			const nextInViewport = Boolean(entry?.isIntersecting);
			if (nextInViewport && !inViewport) {
				inViewport = true;
				pause();
				show(0);
				start();
				return;
			}
			inViewport = nextInViewport;
			if (!inViewport) pause();
		}, { threshold: 0.25 });

		observer.observe(root);
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) pause();
			else start();
		});
		window.addEventListener('garna:page-will-unmount', () => {
			pause();
			observer.disconnect();
		}, { once: true });
		show(0);
	}
</script>

<style is:global>
	.tabbed-image-feature {
		width: 100%;
	}

	.tabbed-image-feature__stage {
		overflow: hidden;
		border: 1px solid #ffffff1f;
		border-radius: 28px;
		background: #0d1014;
		box-shadow: 0 34px 90px #0005;
	}

	.tabbed-image-feature__panel {
		position: relative;
		min-height: clamp(420px, 42vw, 540px);
		overflow: hidden;
		background: #090b0d;
	}

	.tabbed-image-feature__panel[hidden] {
		display: none;
	}

	.tabbed-image-feature__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--tabbed-image-position, center);
	}

	.tabbed-image-feature__shade {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, #0506068f 0%, #05060630 48%, transparent 76%),
			linear-gradient(0deg, #05060645 0%, transparent 55%);
	}

	.tabbed-image-feature__copy {
		position: absolute;
		z-index: 2;
		left: clamp(18px, 3vw, 40px);
		bottom: clamp(18px, 3vw, 40px);
		width: min(520px, calc(100% - 36px));
		padding: clamp(22px, 3vw, 34px);
		border: 1px solid rgb(255 255 255 / 0.1);
		border-radius: 22px;
		background: rgb(7 8 10 / 0.72);
		box-shadow: 0 22px 60px #0008;
		backdrop-filter: blur(12px);
	}

	.tabbed-image-feature__tag {
		display: block;
		margin-bottom: 12px;
		color: #cbf300;
		font: 600 12px/1.2 Manrope, sans-serif;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.tabbed-image-feature__copy h3 {
		max-width: 460px;
		margin: 0 0 14px;
		color: #fff;
		font: 400 clamp(24px, 2.2vw, 32px)/1.12 Manrope, sans-serif;
		letter-spacing: -0.035em;
	}

	.tabbed-image-feature__copy p {
		max-width: 460px;
		color: #bdc3ca;
		font: 400 16px/1.55 Manrope, sans-serif;
	}

	.tabbed-image-feature__tabs {
		display: flex;
		width: max-content;
		justify-content: center;
		gap: 4px;
		margin: 28px auto 0;
		border: 1px solid rgb(255 255 255 / 0.1);
		border-radius: 999px;
		background: rgb(255 255 255 / 0.035);
		padding: 4px;
	}

	.tabbed-image-feature__tab {
		--progress: 0;
		position: relative;
		min-width: 160px;
		overflow: hidden;
		padding: 10px 22px;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: rgb(255 255 255 / 0.6);
		font: 600 15px/1.2 Manrope, sans-serif;
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	.tabbed-image-feature__tab::before {
		position: absolute;
		z-index: 0;
		inset: 0;
		content: "";
		border-radius: 0;
		background: #cbf300;
		opacity: 0;
		transform: scaleX(var(--progress));
		transform-origin: left center;
		will-change: transform;
	}

	.tabbed-image-feature__tab span {
		position: relative;
		z-index: 1;
	}

	.tabbed-image-feature__tab:hover {
		color: rgb(255 255 255 / 0.88);
	}

	.tabbed-image-feature__tab:focus-visible {
		outline: 2px solid rgb(255 255 255 / 0.35);
		outline-offset: 3px;
	}

	.tabbed-image-feature__tab.active {
		background: rgb(203 243 0 / 0.78);
		color: #080a08;
	}

	.tabbed-image-feature__tab.active::before {
		opacity: 1;
	}

	@media (min-width: 801px) and (max-width: 1079px) {
		.tabbed-image-feature {
			width: calc(100vw - 32px);
			margin-inline: calc(50% - 50vw + 16px);
		}

		.tabbed-image-feature__copy {
			width: min(var(--tabbed-copy-tablet-width, 460px), calc(100% - 36px));
			padding: 24px;
		}
	}

	@media (max-width: 800px) {
		.tabbed-image-feature__tabs {
			margin: 20px auto 0;
		}

		.tabbed-image-feature__panel {
			min-height: 620px;
		}

		.tabbed-image-feature__image {
			object-position: var(--tabbed-image-mobile-position, center);
		}

		.tabbed-image-feature__shade {
			background: linear-gradient(0deg, #050606c2 0%, #05060626 72%, transparent 100%);
		}

		.tabbed-image-feature__copy {
			bottom: 24px;
		}
	}

	@media (max-width: 520px) {
		.tabbed-image-feature__tabs {
			display: grid;
			width: 100%;
			grid-template-columns: repeat(var(--tabbed-tabs-count, 2), minmax(0, 1fr));
		}

		.tabbed-image-feature__tab {
			min-width: 0;
			padding: 10px 12px;
		}

		.tabbed-image-feature__stage {
			border-radius: 20px;
		}

		.tabbed-image-feature__panel {
			min-height: 610px;
		}

		.tabbed-image-feature__copy {
			left: 14px;
			bottom: 14px;
			width: calc(100% - 28px);
			padding: 20px;
		}

		.tabbed-image-feature__copy h3 {
			font-size: 23px;
		}
	}
</style>
