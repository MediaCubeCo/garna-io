---
interface Props {
	text: string;
	translateKey?: string;
	tone?: 'positive' | 'neutral';
}

const { text, translateKey, tone = 'positive' } = Astro.props;
---

<span class:list={[
	'inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.14em]',
	tone === 'positive' ? 'border-[#A8FF2C]/25 bg-[#A8FF2C]/10 text-[#A8FF2C]' : 'border-white/10 bg-white/5 text-gray-400',
]} data-translate={translateKey}>{text}</span>
