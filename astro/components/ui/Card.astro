---
interface CardText {
	text: string;
	translateKey?: string;
}

interface Props {
	title?: string | CardText;
	description?: string | CardText;
	variant?: 'feature' | 'visual' | 'tab' | 'testimonial';
	visualPosition?: 'before' | 'after';
	class?: string;
	bodyClass?: string;
	visualClass?: string;
	titleClass?: string;
	descriptionClass?: string;
	interactive?: boolean;
}

const {
	title,
	description,
	variant = 'feature',
	visualPosition = 'before',
	class: className = '',
	bodyClass = '',
	visualClass = '',
	titleClass = '',
	descriptionClass = '',
	interactive = true,
} = Astro.props;
const titleValue = typeof title === 'string' ? { text: title } : title;
const descriptionValue = typeof description === 'string' ? { text: description } : description;
const variantClasses = {
	feature: 'garna-glass-card rounded-2xl p-8',
	visual: 'garna-glass-card overflow-hidden rounded-3xl',
	tab: 'rounded-2xl border border-white/5 bg-[#0A0A0A]/80 p-8 backdrop-blur-sm',
	testimonial: 'garna-glass-card flex h-full flex-col rounded-2xl p-8',
};
const defaultTitleClasses = {
	feature: 'mb-3 text-xl font-normal tracking-tight text-white',
	visual: 'mb-3 text-lg font-medium tracking-tight text-white',
	tab: 'mb-4 text-xl font-extralight tracking-tight text-white',
	testimonial: 'sr-only',
};
const defaultDescriptionClasses = {
	feature: '',
	visual: '',
	tab: '',
	testimonial: 'mb-8 flex-grow',
};
---

<article data-card-variant={variant} data-interactive={interactive ? 'true' : 'false'} data-card-glow={interactive ? 'true' : undefined} class:list={[
	'garna-card group font-manrope',
	variantClasses[variant],
	interactive && 'transition duration-300 hover:-translate-y-1 motion-reduce:transform-none motion-reduce:transition-colors',
	className,
]}>
	{visualPosition === 'before' && <div class={visualClass}><slot name="visual" /></div>}
	{(titleValue || descriptionValue) && (
		<div class={bodyClass}>
			{titleValue && <h3 class:list={[defaultTitleClasses[variant], titleClass]} data-translate={titleValue.translateKey}>{titleValue.text}</h3>}
			{descriptionValue && <p data-card-description class:list={['text-base font-semibold leading-relaxed text-[#B0B0B0]', defaultDescriptionClasses[variant], descriptionClass]} data-translate={descriptionValue.translateKey}>{descriptionValue.text}</p>}
		</div>
	)}
	<slot />
	{visualPosition === 'after' && <div class={visualClass}><slot name="visual" /></div>}
</article>

<style>
	.garna-card {
		--garna-card-glow-x: 50%;
		--garna-card-glow-y: 50%;
		--garna-card-glow-radius: 60vw;
		--garna-card-border-glow-radius: 14rem;
		position: relative;
		isolation: isolate;
	}

	.garna-card::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
		border-radius: inherit;
		background: radial-gradient(
			circle var(--garna-card-glow-radius) at var(--garna-card-glow-x) var(--garna-card-glow-y),
			rgba(255, 255, 255, 0.12) 0%,
			rgba(255, 255, 255, 0.075) 18%,
			rgba(255, 255, 255, 0.035) 40%,
			transparent 70%
		);
		opacity: 0;
		pointer-events: none;
		transition: opacity 300ms ease;
	}

	.garna-card > * {
		position: relative;
		z-index: 1;
	}

	@supports ((-webkit-mask-composite: xor) or (mask-composite: exclude)) {
		.garna-card::after {
			content: '';
			position: absolute;
			inset: 0;
			z-index: 2;
			padding: 1px;
			border-radius: inherit;
			background: radial-gradient(
				circle var(--garna-card-border-glow-radius) at var(--garna-card-glow-x) var(--garna-card-glow-y),
				rgba(255, 255, 255, 0.9) 0%,
				rgba(255, 255, 255, 0.52) 24%,
				rgba(255, 255, 255, 0.2) 50%,
				transparent 76%
			);
			opacity: 0;
			pointer-events: none;
			transition: opacity 300ms ease;
			-webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
			-webkit-mask-composite: xor;
			mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
			mask-composite: exclude;
		}
	}

	.garna-card[data-interactive='true']:hover {
		border-color: rgba(255, 255, 255, 0.15);
	}

	@media (hover: hover) and (pointer: fine) {
		.garna-card[data-card-glow='true']:hover::before {
			opacity: 1;
		}

		@supports ((-webkit-mask-composite: xor) or (mask-composite: exclude)) {
			.garna-card[data-card-glow='true']:hover::after {
				opacity: 1;
			}
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.garna-card {
			--garna-card-glow-x: 50% !important;
			--garna-card-glow-y: 50% !important;
		}

		.garna-card::before,
		.garna-card::after {
			transition: none;
		}
	}
</style>

<script>
	const cardGlowWindow = window as typeof window & { __garnaCardGlowInitialized?: boolean };

	if (!cardGlowWindow.__garnaCardGlowInitialized) {
		cardGlowWindow.__garnaCardGlowInitialized = true;
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		document.addEventListener('pointermove', (event) => {
			if (reducedMotion.matches || !(event.target instanceof Element)) return;

			const card = event.target.closest('[data-card-glow="true"]');
			if (!(card instanceof HTMLElement)) return;

			const bounds = card.getBoundingClientRect();
			card.style.setProperty('--garna-card-glow-x', `${event.clientX - bounds.left}px`);
			card.style.setProperty('--garna-card-glow-y', `${event.clientY - bounds.top}px`);
		}, { passive: true });
	}
</script>
