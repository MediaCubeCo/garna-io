---
interface Props {
	class?: string;
	interactive?: boolean;
}

const { class: className = '', interactive = false } = Astro.props;
---

<div class:list={[
	'garna-glass-card rounded-[var(--garna-radius-md)] p-6',
	interactive && 'transition duration-300 hover:-translate-y-1 hover:border-white/15 hover:bg-white/[0.045]',
	className,
]}><slot /></div>
