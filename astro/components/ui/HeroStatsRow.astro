---
interface HeroStat {
	value: string;
	valueKey?: string;
	label: string;
	labelKey?: string;
}

interface Props {
	stats: HeroStat[];
	ariaLabel: string;
	ariaLabelKey?: string;
	class?: string;
}

const { stats, ariaLabel, ariaLabelKey, class: className = '' } = Astro.props;
---

<div
	class:list={['garna-hero-stats-row', className]}
	aria-label={ariaLabel}
	data-translate-aria-label={ariaLabelKey}
>
	{stats.map((stat) => (
		<article>
			<strong data-translate={stat.valueKey}>{stat.value}</strong>
			<span data-translate={stat.labelKey}>{stat.label}</span>
		</article>
	))}
</div>

<style>
	.garna-hero-stats-row {
		--garna-hero-stat-gap: clamp(1.35rem, 3vw, 2.15rem);
		display: flex;
		width: 100%;
		max-width: none;
		align-items: flex-start;
		gap: var(--garna-hero-stat-gap);
		margin-top: auto;
	}

	.garna-hero-stats-row article {
		position: relative;
		display: grid;
		gap: 0.32rem;
	}

	.garna-hero-stats-row article + article {
		padding-left: var(--garna-hero-stat-gap);
	}

	.garna-hero-stats-row article + article::before {
		content: "";
		position: absolute;
		top: 0.12rem;
		left: 0;
		width: 1px;
		height: 2.4rem;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.14);
	}

	.garna-hero-stats-row strong {
		color: #ffffff;
		font-family: Manrope, sans-serif;
		font-size: clamp(1.35rem, 2.1vw, 1.95rem);
		font-weight: 400;
		line-height: 1;
	}

	.garna-hero-stats-row span {
		color: rgb(255 255 255 / 0.56);
		font-family: Manrope, sans-serif;
		font-size: 0.74rem;
		font-weight: 500;
		line-height: 1.35;
		white-space: nowrap;
	}

	@media (max-width: 1023px) {
		.garna-hero-stats-row {
			margin-top: clamp(2.65rem, 5vw, 3.35rem);
		}

		.garna-hero-stats-row strong {
			font-size: clamp(1.65rem, 3.25vw, 2rem);
		}

		.garna-hero-stats-row span {
			font-size: clamp(0.8rem, 1.45vw, 0.88rem);
		}
	}

	@media (max-width: 640px) {
		.garna-hero-stats-row {
			--garna-hero-stat-gap: clamp(1rem, 4.5vw, 1.5rem);
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			column-gap: var(--garna-hero-stat-gap);
			row-gap: 0;
		}

		.garna-hero-stats-row article + article {
			padding-left: 0;
		}

		.garna-hero-stats-row article + article::before {
			height: 2.15rem;
			left: calc(var(--garna-hero-stat-gap) / -2);
		}

		.garna-hero-stats-row strong {
			font-size: clamp(1.2rem, 6vw, 1.55rem);
		}

		.garna-hero-stats-row span {
			font-size: clamp(0.62rem, 2.8vw, 0.74rem);
			white-space: normal;
		}
	}
</style>
