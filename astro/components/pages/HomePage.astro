---
import FAQSection from "../FAQSection.astro";
import FinalCTASection from "../FinalCTASection.astro";
import GarnaBookingWidget from "../GarnaBookingWidget.astro";
import HeroSection from "../HeroSection.astro";
import EnterprisePayrollHeroVisual from "../EnterprisePayrollHeroVisual.astro";
import ContractorDashboardVisual from "../visuals/ContractorDashboardVisual.astro";
import ContractorOfRecordSections from "./payroll/ContractorOfRecordSections.astro";
import EnterprisePayrollSections from "./payroll/EnterprisePayrollSections.astro";
import ContractorOfRecordInteractions from "./payroll/ContractorOfRecordInteractions.astro";
import EnterprisePayrollInteractions from "./payroll/EnterprisePayrollInteractions.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pageFinalCtas } from "../../content/page-final-ctas";
import { pageHeroes } from "../../content/page-heroes";
import { pageShells } from "../../content/page-shells";
import type { FAQItem } from "../../types/faq-section";

interface Props { variant?: "contractorOfRecord" | "enterprisePayroll"; }
const { variant = "contractorOfRecord" } = Astro.props;
const isEnterprisePayroll = variant === "enterprisePayroll";
const heroConfig = isEnterprisePayroll ? pageHeroes.enterprisePayroll : pageHeroes.contractorOfRecord;
const finalCtaConfig = isEnterprisePayroll ? pageFinalCtas.enterprisePayroll : pageFinalCtas.contractorOfRecord;

const homeFaqItems = [
	{
		question: 'How do I get started with Garna?',
		answer: 'Sign up on our platform, contact our sales team, and start processing payroll in just a few steps.',
		questionTranslateKey: 'faqHome.items.q1.question',
		answerTranslateKey: 'faqHome.items.q1.answer',
	},
	{
		question: 'What payment methods does Garna support?',
		answer: 'We offer bank transfers in USD, local currencies, e-wallets and crypto.',
		questionTranslateKey: 'faqHome.items.q2.question',
		answerTranslateKey: 'faqHome.items.q2.answer',
	},
	{
		question: 'Can I pay contractors in multiple countries?',
		answer: 'Yes, Garna supports payroll in over 150 countries worldwide.',
		questionTranslateKey: 'faqHome.items.q3.question',
		answerTranslateKey: 'faqHome.items.q3.answer',
	},
	{
		question: 'Are there any minimum payment limits?',
		answer: 'No, you can process payroll of any amount that fits your business needs.',
		questionTranslateKey: 'faqHome.items.q4.question',
		answerTranslateKey: 'faqHome.items.q4.answer',
	},
] satisfies FAQItem[];

const enterprisePayrollFaqItems = [
	{
		question: 'How does global payroll work?',
		answer:
			'Global payroll lets businesses control payouts for employees and contractors across multiple countries via a centralized system that handles everything from payments to tax compliance and reporting.',
		questionTranslateKey: 'enterprisePayrollFaq.items.q1.question',
		answerTranslateKey: 'enterprisePayrollFaq.items.q1.answer',
	},
	{
		question: 'Can I assign different levels of access to different team members?',
		answer:
			'Yes! You can give role-based permissions to the data your employees need to, and in addition to that, you can set payment limits for your contractors. For everything above those limits, such operations will require additional approvals.',
		questionTranslateKey: 'enterprisePayrollFaq.items.q2.question',
		answerTranslateKey: 'enterprisePayrollFaq.items.q2.answer',
	},
	{
		question: 'How do you ensure compliance in different countries?',
		answer:
			'Garna uses automated compliance workflows that use local tax rules, payroll regulations, and region-specific reporting requirements.',
		questionTranslateKey: 'enterprisePayrollFaq.items.q3.question',
		answerTranslateKey: 'enterprisePayrollFaq.items.q3.answer',
	},
	{
		question: 'Can I pay contractors and employees in one platform?',
		answer:
			'Yes! Garna functions as a unified global payroll platform for managing employees, contractors, freelancers, and distributed teams all from one system.',
		questionTranslateKey: 'enterprisePayrollFaq.items.q4.question',
		answerTranslateKey: 'enterprisePayrollFaq.items.q4.answer',
	},
	{
		question: 'How long does it take to launch in a new country?',
		answer:
			'Launch times depend on the country and set-up, but Garna helps companies expand internationally much faster than they could on their own by building out local payroll infrastructure.',
		questionTranslateKey: 'enterprisePayrollFaq.items.q5.question',
		answerTranslateKey: 'enterprisePayrollFaq.items.q5.answer',
	},
	{
		question: 'Do you support multi-currency payments?',
		answer:
			'Yes, we do! Garna lets you make global payroll payments in multiple currencies using flexible payment methods such as SWIFT, SEPA, bank transfers, PayPal, Payoneer, and crypto.',
		questionTranslateKey: 'enterprisePayrollFaq.items.q6.question',
		answerTranslateKey: 'enterprisePayrollFaq.items.q6.answer',
	},
	{
		question: 'Can Garna integrate with our existing systems?',
		answer: 'Yes. We support payroll API integration with HR systems, accounting platforms, ERP tools, SaaS products.',
		questionTranslateKey: 'enterprisePayrollFaq.items.q7.question',
		answerTranslateKey: 'enterprisePayrollFaq.items.q7.answer',
	},
	{
		question: 'Can Garna replace multiple payroll providers?',
		answer:
			"Yes, and to own the truth, it's more efficient that way. Many of our enterprise customers use Garna to consolidate their payroll vendors, get their payroll operations centralized and be free from the complications of working with disconnected regional providers.",
		questionTranslateKey: 'enterprisePayrollFaq.items.q8.question',
		answerTranslateKey: 'enterprisePayrollFaq.items.q8.answer',
	},
	{
		question: 'Is Garna suitable for embedded payroll use cases?',
		answer:
			'Yes, it is. We support embedded payroll infrastructure, white-label payroll solutions, and payroll-as-a-service models for platforms, marketplaces, and enterprise ecosystems.',
		questionTranslateKey: 'enterprisePayrollFaq.items.q9.question',
		answerTranslateKey: 'enterprisePayrollFaq.items.q9.answer',
	},
	{
		question: 'How secure is the platform?',
		answer:
			"Garna uses the kind of security you'd expect from an enterprise-class payroll platform: enterprise-grade encryption, role-based access controls, and secure payroll data protection that is created to handle large-scale global operations.",
		questionTranslateKey: 'enterprisePayrollFaq.items.q10.question',
		answerTranslateKey: 'enterprisePayrollFaq.items.q10.answer',
	},
] satisfies FAQItem[];

const faqItems = isEnterprisePayroll ? enterprisePayrollFaqItems : homeFaqItems;
const faqTitle = isEnterprisePayroll
	? { text: 'Payroll FAQs for Global Businesses', translateKey: 'enterprisePayrollFaq.title' }
	: { text: 'Frequently asked questions', translateKey: 'faqHome.title' };
---

<BaseLayout shell={pageShells.contractorOfRecord}>
	<HeroSection {...heroConfig}>
		{isEnterprisePayroll ? <EnterprisePayrollHeroVisual /> : <ContractorDashboardVisual />}
	</HeroSection>
	{isEnterprisePayroll ? <EnterprisePayrollSections /> : <ContractorOfRecordSections />}
	<FAQSection
		title={faqTitle}
		subtitle={{ text: "Got Questions? We've Got Answers", translateKey: 'faqHome.subtitle' }}
		items={faqItems}
		class="pt-16 pb-16 lg:pt-32 lg:pb-32"
		containerClass="garna-container"
	/>
	<FinalCTASection {...finalCtaConfig} />
	<script is:inline>
		(function () {
			function formatValue(value, decimals) {
				return value.toLocaleString('en-US', {
					minimumFractionDigits: decimals,
					maximumFractionDigits: decimals,
				});
			}

			function initCounterAnimation() {
				const elements = document.querySelectorAll('.counter-anim');
				const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

				elements.forEach((el) => {
					const target = parseFloat(el.getAttribute('data-target'));
					const prefix = el.getAttribute('data-prefix') || '';
					const suffix = el.getAttribute('data-suffix') || '';
					const decimals = parseInt(el.getAttribute('data-decimals') || 0);
					const finalValue = prefix + formatValue(target, decimals) + suffix;

					if (prefersReducedMotion) {
						el.innerText = finalValue;
						return;
					}

					function animate() {
						if (el.dataset.counterAnimated === 'true') return;
						el.dataset.counterAnimated = 'true';
						const start = 0;
						const duration = 2000;
						const startTime = performance.now();

						function update(currentTime) {
							const elapsed = currentTime - startTime;
							const progress = Math.min(elapsed / duration, 1);
							const ease = 1 - Math.pow(1 - progress, 4);
							const current = start + (target - start) * ease;

							el.innerText = prefix + formatValue(current, decimals) + suffix;

							if (progress < 1) {
								requestAnimationFrame(update);
							} else {
								el.innerText = finalValue;
							}
						}

						requestAnimationFrame(update);
					}

					if ('IntersectionObserver' in window) {
						const observer = new IntersectionObserver((entries) => {
							entries.forEach((entry) => {
								if (entry.isIntersecting) {
									animate();
									observer.disconnect();
								}
							});
						}, { threshold: 0.1 });

						observer.observe(el);
					} else {
						animate();
					}
				});
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initCounterAnimation, { once: true });
			} else {
				initCounterAnimation();
			}
		})();
	</script>
	<Fragment slot="widgets">
		{isEnterprisePayroll ? <EnterprisePayrollInteractions /> : <ContractorOfRecordInteractions />}
		<GarnaBookingWidget
			trackingSource="contractor-of-record"
			trackingPage="contractor-of-record"
			titleFallback="Start your journey with Garna"
			subtitleFallback="Fill in your details to book a demo"
		/>
	</Fragment>
</BaseLayout>

<style is:global>
	.home-hero h1 {
		margin-left: auto;
		margin-right: auto;
		padding-bottom: 0.12em;
	}

	html[lang='en'] .home-hero h1 {
		max-width: 50rem;
	}

	html[lang='es'] .home-hero h1,
	html[lang='pt'] .home-hero h1 {
		max-width: 64rem;
		line-height: 1.14;
	}

	html[lang='es'] .home-hero h1 {
		max-width: 58rem;
	}

	@media (min-width: 1024px) {
		html[lang='pt'] .home-hero h1 {
			font-size: 4rem;
		}
	}
</style>
