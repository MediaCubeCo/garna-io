	.creator-platform-destination-options button.creator-platform-destination-bank i {
		background: var(--creator-platform-accent);
	}

	.creator-platform-destination-options button.creator-platform-destination-paypal i::before {
		content: '';
		display: block;
		width: 14px;
		height: 17px;
		background: url('/images/paypal-logo-icon-2014.svg') center / contain no-repeat;
	}

	.creator-platform-destination-options button.creator-platform-destination-paypal i {
		background: #f5f5f5;
	}

	.creator-platform-destination-options button.creator-platform-destination-garna i::before {
		content: '';
		display: block;
		width: 19px;
		height: 19px;
