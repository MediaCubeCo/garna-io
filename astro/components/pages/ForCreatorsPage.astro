			opacity: 0;
			padding-bottom: 0;
			padding-top: 0;
			transform: translateY(-3px);
		}
	}

	@keyframes creator-chat-typing-second-cycle {
		0%,
		51% {
			max-height: 0;
			opacity: 0;
			padding-bottom: 0;
			padding-top: 0;
			transform: translateY(4px);
