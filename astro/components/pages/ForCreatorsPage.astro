			Create Garna Account
		</Button>
	</Section>
	<script is:inline>
		const creatorProcess = document.querySelector('[data-creator-process]');
		const creatorProcessSteps = Array.from(document.querySelectorAll('[data-process-step]'));
		const creatorProcessVisuals = Array.from(document.querySelectorAll('[data-process-visual]'));
		const creatorProcessProgress = Array.from(document.querySelectorAll('.creator-process-progress span'));
		const creatorProcessFallback = document.querySelector('[data-process-fallback]');
		const creatorBalanceDuration = 5800;
		let creatorBalanceActiveStartedAt = null;
		const creatorWalletVisual = document.querySelector('.creator-wallet-visual');
		const reduceCreatorProcessMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const targetCreatorBalance = 2840;
		const formatCreatorBalance = (value) =>
			new Intl.NumberFormat('en-US', {
				style: 'currency',
				currency: 'USD',
				minimumFractionDigits: 2,
				maximumFractionDigits: 2,
			}).format(value);

		const updateCreatorWalletScale = () => {
			if (!(creatorWalletVisual instanceof HTMLElement)) return;

			if (!window.matchMedia('(max-width: 760px)').matches) {
				creatorWalletVisual.style.removeProperty('--creator-wallet-visual-scale');
				creatorWalletVisual.style.removeProperty('min-height');
				return;
			}

			const visualWidth = Math.max(280, creatorWalletVisual.clientWidth || window.innerWidth);
			const scale = Math.min(1, visualWidth / 760);
			creatorWalletVisual.style.setProperty('--creator-wallet-visual-scale', String(scale));
			creatorWalletVisual.style.minHeight = `${Math.ceil(620 * scale)}px`;
		};

		updateCreatorWalletScale();
		window.addEventListener('resize', updateCreatorWalletScale);

		if (creatorProcess && creatorProcessSteps.length && creatorProcessVisuals.length) {
			const creatorProcessScroll = creatorProcess.closest('.creator-process-scroll');
			let creatorProcessFrame = null;
			let creatorProcessCurrentIndex = -1;

			const setCreatorProcessStep = (index, stepProgress = 1) => {
				if (index !== creatorProcessCurrentIndex) {
					creatorBalanceActiveStartedAt = index === 5 ? performance.now() : null;
					creatorProcessCurrentIndex = index;
				}

				const clampedStepProgress = Math.min(1, Math.max(0, stepProgress));
				const progressTrack = creatorProcessProgress[0]?.parentElement;
				if (progressTrack instanceof HTMLElement) {
					progressTrack.style.setProperty('--creator-process-step-progress', `${clampedStepProgress * 100}%`);
				}

				creatorProcessSteps.forEach((step) => {
					step.classList.toggle('is-active', step.getAttribute('data-process-step') === String(index));
				});
				creatorProcessVisuals.forEach((visual, visualIndex) => {
					const isActiveVisual = visual.getAttribute('data-process-visual') === String(index);
					const stackDistance = (visualIndex - index + creatorProcessVisuals.length) % creatorProcessVisuals.length;

					visual.classList.toggle('is-active', isActiveVisual);
					visual.classList.toggle('is-stack-one', !isActiveVisual && stackDistance === 1);
					visual.classList.toggle('is-stack-two', !isActiveVisual && stackDistance === 2);
					visual.classList.toggle('is-stack-three', !isActiveVisual && stackDistance === 3);
					visual.classList.toggle('is-stack-four', !isActiveVisual && stackDistance === 4);
					visual.classList.toggle('is-stack-five', !isActiveVisual && stackDistance === 5);
				});
				creatorProcessProgress.forEach((dot, dotIndex) => {
					dot.classList.toggle('is-active', dotIndex === index);
				});
			};

			const updateCreatorProcessStep = () => {
				creatorProcessFrame = null;
				if (!creatorProcessScroll) return;

				const rect = creatorProcessScroll.getBoundingClientRect();
				const scrollDistance = Math.max(1, rect.height - window.innerHeight);
				const processStyles = window.getComputedStyle(creatorProcessScroll);
				const cssStickyOffset = Number.parseFloat(processStyles.getPropertyValue('--creator-process-top-offset'));
				const stickyOffset = window.innerWidth > 980 && Number.isFinite(cssStickyOffset) ? cssStickyOffset : 0;
				const progress = Math.min(1, Math.max(0, (stickyOffset - rect.top) / scrollDistance));
				const rawStepProgress = progress * creatorProcessSteps.length;
				const index = Math.min(creatorProcessSteps.length - 1, Math.floor(rawStepProgress));
				const stepProgress = Math.min(1, rawStepProgress - index);

				setCreatorProcessStep(index, stepProgress);
			};

			const requestCreatorProcessUpdate = () => {
				if (creatorProcessFrame !== null) return;
				creatorProcessFrame = window.requestAnimationFrame(updateCreatorProcessStep);
			};

			updateCreatorProcessStep();
			window.addEventListener('scroll', requestCreatorProcessUpdate, { passive: true });
			window.addEventListener('resize', requestCreatorProcessUpdate);
		}

		if (creatorProcessFallback && creatorProcessSteps.length && creatorProcessVisuals.length) {
			creatorProcessSteps.forEach((step, index) => {
				const visual = creatorProcessVisuals[index];
				const visualContent = visual?.firstElementChild?.cloneNode(true);
				const stepContent = step.cloneNode(true);
				const fallbackItem = document.createElement('article');
				const visualShell = document.createElement('div');

				fallbackItem.className = 'creator-process-fallback-item';
				visualShell.className = 'creator-process-fallback-visual';
				visualShell.setAttribute('data-process-fallback-visual', String(index));
				stepContent.className = 'creator-process-fallback-copy';
				stepContent.removeAttribute('data-process-step');

				if (visualContent) {
					visualShell.appendChild(visualContent);
				}

				fallbackItem.append(visualShell, stepContent);
				creatorProcessFallback.appendChild(fallbackItem);
			});

			const animateCreatorFallbackBalance = (visual) => {
				if (!(visual instanceof HTMLElement) || visual.dataset.creatorBalanceAnimated === 'true') return;

				const counter = visual.querySelector('[data-process-balance-counter]');
				const bar = visual.querySelector('.creator-balance-bar');
				if (!(counter instanceof HTMLElement)) return;

				visual.dataset.creatorBalanceAnimated = 'true';
				if (reduceCreatorProcessMotion.matches) {
					counter.textContent = formatCreatorBalance(targetCreatorBalance);
					if (bar instanceof HTMLElement) {
						bar.style.setProperty('--creator-balance-progress', '1');
					}
					return;
				}

				let startedAt = null;
				const delay = 720;
				const duration = 1300;
				const animate = (timestamp) => {
					startedAt ??= timestamp;
					const elapsed = Math.max(0, timestamp - startedAt - delay);
					const rawProgress = Math.min(1, elapsed / duration);
					const easedProgress = 1 - Math.pow(1 - rawProgress, 3);
					counter.textContent = formatCreatorBalance(targetCreatorBalance * easedProgress);
					if (bar instanceof HTMLElement) {
						bar.style.setProperty('--creator-balance-progress', String(easedProgress));
					}
					if (rawProgress < 1) {
						window.requestAnimationFrame(animate);
					}
				};

				counter.textContent = formatCreatorBalance(0);
				if (bar instanceof HTMLElement) {
					bar.style.setProperty('--creator-balance-progress', '0');
				}
				window.requestAnimationFrame(animate);
			};

			const activateCreatorFallbackVisual = (visual) => {
				visual.classList.add('is-active');
				animateCreatorFallbackBalance(visual);
			};

			const creatorFallbackVisuals = Array.from(
				creatorProcessFallback.querySelectorAll('.creator-process-fallback-visual'),
			);

			if (reduceCreatorProcessMotion.matches || !('IntersectionObserver' in window)) {
				creatorFallbackVisuals.forEach(activateCreatorFallbackVisual);
			} else {
				const creatorFallbackObserver = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							activateCreatorFallbackVisual(entry.target);
							creatorFallbackObserver.unobserve(entry.target);
						});
					},
					{ threshold: 0.28, rootMargin: '0px 0px -12% 0px' },
				);

				creatorFallbackVisuals.forEach((visual) => creatorFallbackObserver.observe(visual));
			}
		}

		const creatorBalanceCounter = document.querySelector('[data-process-balance-counter]');
		const creatorBalanceBar = document.querySelector('.creator-balance-bar');

		if (creatorBalanceCounter) {
			if (reduceCreatorProcessMotion.matches) {
				creatorBalanceCounter.textContent = formatCreatorBalance(targetCreatorBalance);
				if (creatorBalanceBar instanceof HTMLElement) {
					creatorBalanceBar.style.setProperty('--creator-balance-progress', '1');
				}
			} else {
				const balanceBarAppearDelay = 0.72;
				const balanceBarFullyVisibleAt = 0.24;
				const fillStart = (balanceBarAppearDelay + creatorBalanceDuration * balanceBarFullyVisibleAt) / creatorBalanceDuration;
				const fillEnd = 0.68;

				const animateCreatorBalance = (timestamp) => {
					const cycle =
						creatorBalanceActiveStartedAt === null
							? 0
							: Math.min(1, (timestamp - creatorBalanceActiveStartedAt) / creatorBalanceDuration);
					const rawProgress = Math.min(1, Math.max(0, (cycle - fillStart) / (fillEnd - fillStart)));
					const easedProgress = 1 - Math.pow(1 - rawProgress, 3);
					creatorBalanceCounter.textContent = formatCreatorBalance(targetCreatorBalance * easedProgress);
					if (creatorBalanceBar instanceof HTMLElement) {
						creatorBalanceBar.style.setProperty('--creator-balance-progress', String(easedProgress));
					}
					window.requestAnimationFrame(animateCreatorBalance);
				};

				window.requestAnimationFrame(animateCreatorBalance);
			}
		}

		const platformLogoShowcase = document.querySelector('[data-random-platform-logos]');
		const reducePlatformLogoMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		if (platformLogoShowcase && !reducePlatformLogoMotion.matches) {
			const platformLogoCells = Array.from(platformLogoShowcase.querySelectorAll('.creator-platform-logo'));
			let platformLogoQueue = [];

			const shufflePlatformLogoQueue = () => {
				platformLogoQueue = platformLogoCells.map((_, index) => index);

				for (let index = platformLogoQueue.length - 1; index > 0; index -= 1) {
					const swapIndex = Math.floor(Math.random() * (index + 1));
					[platformLogoQueue[index], platformLogoQueue[swapIndex]] = [platformLogoQueue[swapIndex], platformLogoQueue[index]];
				}
			};

			shufflePlatformLogoQueue();

			const switchRandomPlatformLogo = () => {
				if (platformLogoCells.length < 2) return;
				if (!platformLogoQueue.length) shufflePlatformLogoQueue();

				const nextIndex = platformLogoQueue.shift();
				platformLogoCells[nextIndex].classList.toggle('is-alt-visible');
			};

			window.setInterval(switchRandomPlatformLogo, 1000);
		}

		document.addEventListener('click', (event) => {
			const link = event.target instanceof Element ? event.target.closest('a') : null;
			if (!link || link.getAttribute('href') !== '#') return;
			if (!link.textContent || !link.textContent.toLowerCase().includes('book a demo')) return;

			event.preventDefault();
			if (window.GarnaWidget) {
				window.GarnaWidget.open({ trackingCta: 'for_creators_demo' });
			}
		});
	</script>
	<Fragment slot="widgets">
		<PayrollSolutionInteractions />
		<GarnaBookingWidget
			trackingSource="for-creators"
			trackingPage="for-creators"
			titleFallback="Start your journey with Garna"
			subtitleFallback="Fill in your details to book a demo"
		/>
	</Fragment>
</BaseLayout>

