		overflow: visible;
		border: 0;
		border-radius: 22px;
		background:
			radial-gradient(circle at 88% 24%, rgba(107, 174, 214, 0.08), transparent 32%),
			linear-gradient(180deg, rgba(14, 15, 14, 0.94), rgba(5, 5, 5, 0.98));
