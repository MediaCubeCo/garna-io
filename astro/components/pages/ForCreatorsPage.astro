		description={{ text: "Contact your payout manager to check your platform and get guided setup, or create your Garna account when you're ready to continue", translateKey: 'creatorFinalCta.description' }}
		class="overflow-hidden border-white/0 border-t"
		headerClass="mb-0 max-w-4xl"
		titleClass="mx-auto max-w-4xl lg:text-6xl"
		descriptionClass="mx-auto max-w-2xl"
		contentClass="creator-final-actions mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row"
	>
		<Button href="https://t.me/likelyiam" variant="primary" size="hero" icon="arrow-up-right" data-translate="creatorFinalCta.contact">
			Contact Payout Manager
		</Button>
