	@keyframes creator-chat-bubble-one-cycle {
		0%,
		2% {
			max-height: 0;
			opacity: 0;
			padding-bottom: 0;
			padding-top: 0;
			transform: translateY(8px) scale(0.98);
		}

		7%,
		88% {
			max-height: 86px;
			opacity: 1;
			padding-bottom: 10px;
			padding-top: 10px;
			transform: translateY(0) scale(1);
		}

		94%,
		100% {
			max-height: 0;
			opacity: 0;
			padding-bottom: 0;
			padding-top: 0;
			transform: translateY(-4px) scale(0.99);
		}
	}

	@keyframes creator-chat-bubble-two-cycle {
		0%,
		25% {
			max-height: 0;
			opacity: 0;
			padding-bottom: 0;
			padding-top: 0;
			transform: translateY(8px) scale(0.98);
		}

		31%,
		88% {
			max-height: 86px;
			opacity: 1;
			padding-bottom: 10px;
			padding-top: 10px;
			transform: translateY(0) scale(1);
		}

		94%,
		100% {
			max-height: 0;
			opacity: 0;
			padding-bottom: 0;
			padding-top: 0;
			transform: translateY(-4px) scale(0.99);
		}
	}

	@keyframes creator-chat-bubble-three-cycle {
		0%,
		39% {
			max-height: 0;
			opacity: 0;
			padding-bottom: 0;
			padding-top: 0;
			transform: translateY(8px) scale(0.98);
		}

		45%,
		88% {
			max-height: 86px;
			opacity: 1;
			padding-bottom: 10px;
			padding-top: 10px;
			transform: translateY(0) scale(1);
		}

		94%,
		100% {
			max-height: 0;
			opacity: 0;
			padding-bottom: 0;
			padding-top: 0;
			transform: translateY(-4px) scale(0.99);
		}
	}

	@keyframes creator-chat-bubble-four-cycle {
		0%,
		63% {
			max-height: 0;
			opacity: 0;
			padding-bottom: 0;
			padding-top: 0;
			transform: translateY(8px) scale(0.98);
		}

		69%,
		88% {
