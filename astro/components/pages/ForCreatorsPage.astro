	}

	.creator-platform-destination-options button.creator-platform-destination-garna i {
		background: #171717;
	}

	.creator-platform-destination-options button.creator-platform-destination-bank small,
	.creator-platform-destination-options button.creator-platform-destination-paypal small,
	.creator-platform-destination-options button.creator-platform-destination-garna small {
		grid-column: 2;
	}

	.creator-platform-destination-options button.is-selected {
		border-width: 1.5px;
		border-color: var(--creator-platform-accent);
		background: #ffffff;
		color: var(--creator-platform-accent);
	}

	.creator-payout-window--platform.is-platform-flow .creator-platform-destination-options button.creator-platform-destination-garna {
		animation: creator-platform-route-select 10500ms ease-in-out both;
	}

	.creator-payout-window--platform.is-platform-flow .creator-platform-destination-options button.creator-platform-destination-garna small {
		animation: none;
	}

	.creator-platform-destination-options button.is-selected i {
		display: inline-flex;
	}

	.creator-platform-destination-options button.is-selected small {
		grid-column: 2;
		color: var(--creator-platform-muted);
	}

	.creator-platform-finance-balance {
		border-color: rgba(23, 23, 23, 0.92) !important;
		background: #171717 !important;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.08),
			0 18px 38px -30px rgba(23, 23, 23, 0.72);
	}

	.creator-platform-finance-balance span {
		color: rgba(255, 255, 255, 0.68);
	}

	.creator-platform-finance-balance strong {
		color: #ffffff;
		font-size: clamp(28px, 3vw, 38px);
		font-weight: 720;
	}

	.creator-platform-finance-balance small {
		color: rgba(255, 255, 255, 0.62);
	}

	.creator-platform-finance-table {
		display: grid;
		grid-template-rows: repeat(3, minmax(0, 1fr));
		align-content: stretch;
		overflow: hidden;
		border: 0;
		border-radius: 0;
		background: transparent;
	}

	.creator-platform-finance-table div {
		display: grid;
		grid-template-columns: 52px minmax(178px, 0.48fr) minmax(190px, 1.02fr) 104px;
		grid-template-rows: 1fr;
		min-height: 0;
		column-gap: 18px;
		align-items: center;
		border-bottom: 1px solid var(--creator-platform-line);
		padding: 8px 12px;
	}

	.creator-platform-finance-table div:last-child {
		border-bottom: 0;
	}

	.creator-platform-finance-table span {
		grid-column: 2;
		min-width: 0;
		overflow: hidden;
		color: var(--creator-platform-text) !important;
		font-family: Manrope, sans-serif;
		font-size: 14px;
		font-weight: 820;
		line-height: 1.1;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.creator-platform-finance-table small {
		grid-column: 3;
		justify-self: center;
		transform: translateX(-50px);
		color: var(--creator-platform-muted);
		font-size: 12.5px;
		font-weight: 740;
		text-align: center;
		white-space: nowrap;
	}

	.creator-payout-window--platform .creator-platform-finance-table img {
		grid-column: 1;
		width: 50px;
		height: 46px;
		max-width: none;
		border-radius: 10px;
		filter: none;
		object-fit: cover;
	}

	.creator-platform-finance-table strong {
		grid-column: 4;
		justify-self: end;
		color: var(--creator-platform-text);
		font-family: Manrope, sans-serif;
		font-size: 15px;
		font-weight: 820;
		line-height: 1;
		font-variant-numeric: tabular-nums;
		text-align: right;
	}

	.creator-platform-send-button {
		display: inline-flex;
		height: 40px;
		align-items: center;
		justify-content: center;
		border: 1px solid transparent;
		border-radius: 10px;
		background: var(--creator-platform-accent);
		padding: 0 18px;
		color: #10210c;
		font-family: Manrope, sans-serif;
		font-size: 13px;
		font-weight: 850;
		line-height: 1;
		white-space: nowrap;
	}

	.creator-platform-send-button:disabled {
		border-color: #d7d2cc;
		background: #f5f5f5;
		color: #8a837b;
		cursor: default;
	}

	.creator-payout-window--platform.is-platform-flow .creator-platform-send-button:disabled {
		animation: creator-platform-send-enable 10500ms ease-in-out both;
	}

	.creator-platform-destination-action {
		grid-column: 1 / -1;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		border-top: 1px solid var(--creator-platform-line);
		padding-top: 5px;
	}

	.creator-platform-destination-action small {
		position: relative;
		display: block;
		min-width: 190px;
		color: var(--creator-platform-muted);
		font-family: Manrope, sans-serif;
		font-size: 11px;
		font-weight: 720;
		line-height: 1;
		white-space: nowrap;
	}

	.creator-platform-destination-status span {
		display: block;
		transition: opacity 180ms ease;
	}

	.creator-platform-destination-status span + span {
		position: absolute;
		inset: 0 auto auto 0;
		opacity: 0;
	}

	.creator-payout-window--platform.is-platform-flow .creator-platform-destination-status span:first-child {
		animation: creator-platform-status-hide 10500ms ease-in-out both;
	}

	.creator-payout-window--platform.is-platform-flow .creator-platform-destination-status span:last-child {
		animation: creator-platform-status-show 10500ms ease-in-out both;
	}

	.creator-platform-live-cursor {
		position: absolute;
		z-index: 10;
		top: 52%;
		left: 46%;
		display: flex;
		align-items: center;
		gap: 8px;
		pointer-events: none;
		visibility: hidden;
		opacity: 1;
		filter: drop-shadow(0 12px 18px rgba(0, 0, 0, 0.38));
		animation: creator-platform-cursor-path 10500ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.creator-platform-live-cursor::before {
