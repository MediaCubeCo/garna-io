	.creator-platform-row {
		position: relative;
		display: grid;
		grid-template-columns: 40px minmax(0, 1fr) auto;
		align-items: center;
		gap: 12px;
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 16px;
		background: rgba(255, 255, 255, 0.035);
		padding: 10px 12px;
		overflow: hidden;
		animation: creator-platform-focus 9s ease-in-out infinite;
	}

	.creator-platform-row:nth-child(2) {
		animation-delay: 1.8s;
	}

	.creator-platform-row:nth-child(3) {
		animation-delay: 3.6s;
	}

	.creator-platform-row:nth-child(4) {
		animation-delay: 5.4s;
	}

	.creator-platform-row:nth-child(5) {
		animation-delay: 7.2s;
	}

	.creator-platform-row::before,
	.creator-withdraw-row::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: linear-gradient(90deg, rgba(203, 243, 0, 0.12), transparent 68%);
		opacity: 0;
		pointer-events: none;
		animation: creator-platform-glow 9s ease-in-out infinite;
	}

	.creator-platform-row:nth-child(2)::before {
