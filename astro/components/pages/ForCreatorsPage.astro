								<circle class="creator-wallet-simple-dot creator-wallet-flow-dot-one" r="5">
									<animateMotion dur="15s" repeatCount="indefinite" path="M166 102 V158 Q166 170 178 170 H488 Q500 170 500 182 V282" keyPoints="0;0;1;1" keyTimes="0;0.03;0.15;1" calcMode="linear" />
								</circle>
								<circle class="creator-wallet-simple-dot creator-wallet-flow-dot-two" r="5">
									<animateMotion dur="15s" repeatCount="indefinite" path="M500 102 V282" keyPoints="0;0;1;1" keyTimes="0;0.36;0.48;1" calcMode="linear" />
								</circle>
								<circle class="creator-wallet-simple-dot creator-wallet-flow-dot-three" r="5">
									<animateMotion dur="15s" repeatCount="indefinite" path="M834 102 V158 Q834 170 822 170 H512 Q500 170 500 182 V282" keyPoints="0;0;1;1" keyTimes="0;0.69;0.81;1" calcMode="linear" />
								</circle>
								<circle class="creator-wallet-simple-dot creator-wallet-flow-dot-six" r="5">
									<animateMotion dur="15s" repeatCount="indefinite" path="M500 338 V438 Q500 450 488 450 H178 Q166 450 166 462 V516" keyPoints="0;0;1;1" keyTimes="0;0.83;0.95;1" calcMode="linear" />
								</circle>
								<circle class="creator-wallet-simple-dot creator-wallet-flow-dot-five" r="5">
									<animateMotion dur="15s" repeatCount="indefinite" path="M500 338 V516" keyPoints="0;0;1;1" keyTimes="0;0.50;0.62;1" calcMode="linear" />
								</circle>
								<circle class="creator-wallet-simple-dot creator-wallet-flow-dot-four" r="5">
									<animateMotion dur="15s" repeatCount="indefinite" path="M500 338 V438 Q500 450 512 450 H822 Q834 450 834 462 V516" keyPoints="0;0;1;1" keyTimes="0;0.17;0.29;1" calcMode="linear" />
								</circle>
							</svg>
							<svg class="creator-wallet-flow-svg creator-wallet-flow-svg-phone" viewBox="0 0 1000 620" preserveAspectRatio="none">
								<path class="creator-wallet-flow-path creator-wallet-flow-source creator-wallet-flow-source-one" d="M166 102 V160 Q166 172 178 172 H488 Q500 172 500 184 V282" />
								<path class="creator-wallet-flow-path creator-wallet-flow-source creator-wallet-flow-source-two" d="M500 102 V282" />
								<path class="creator-wallet-flow-path creator-wallet-flow-source creator-wallet-flow-source-three" d="M834 102 V160 Q834 172 822 172 H512 Q500 172 500 184 V282" />
								<path class="creator-wallet-flow-path creator-wallet-flow-trunk-in" d="M500 206 V282" />
								<path class="creator-wallet-flow-path creator-wallet-flow-trunk-out" d="M500 338 V414" />
								<path class="creator-wallet-flow-path creator-wallet-flow-destination creator-wallet-flow-destination-one" d="M500 338 V432 Q500 444 488 444 H178 Q166 444 166 456 V516" />
								<path class="creator-wallet-flow-path creator-wallet-flow-destination creator-wallet-flow-destination-two" d="M500 338 V516" />
								<path class="creator-wallet-flow-path creator-wallet-flow-destination creator-wallet-flow-destination-three" d="M500 338 V432 Q500 444 512 444 H822 Q834 444 834 456 V516" />
								<circle class="creator-wallet-simple-dot creator-wallet-flow-dot-one" r="5">
