	.creator-payout-screen {
		position: relative;
		grid-area: 1 / 1;
		display: grid;
		height: 100%;
		min-height: 0;
		grid-template-columns: minmax(0, 1fr);
		gap: 0;
		align-items: stretch;
		align-self: stretch;
		opacity: 0;
		transform: translateY(18px) scale(0.986);
		transform-origin: center center;
		transition:
			opacity 360ms ease,
			transform 920ms cubic-bezier(0.16, 1, 0.3, 1);
		will-change: transform, opacity;
	}

	.creator-payout-screen.is-active {
		z-index: 3;
		opacity: 1;
		transform: none;
	}

	.creator-payout-screen.is-next {
		z-index: 1;
		opacity: 0.7;
		pointer-events: none;
		clip-path: inset(calc(100% - 46px) 24px 0 24px round 18px 18px 0 0);
		filter: saturate(0.78) brightness(0.86);
		transform: translateY(28px) scale(0.964);
	}

	.creator-payout-screen.is-entering {
		z-index: 4;
		animation: creator-payout-screen-tab-in 920ms cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	.creator-payout-screen.is-leaving {
		z-index: 2;
		opacity: 1;
		pointer-events: none;
		animation: creator-payout-screen-tab-out 760ms cubic-bezier(0.4, 0, 0.2, 1) both;
	}

	.creator-payout-screen::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 20;
		border-radius: 18px;
		pointer-events: none;
		opacity: 0;
		background: transparent;
	}

	.creator-payout-screen.is-entering::after {
		animation: none;
	}

	.creator-payout-screen.is-leaving::after {
		animation: none;
