								</circle>
							</svg>
							<svg class="creator-wallet-flow-svg creator-wallet-flow-svg-compact" viewBox="0 0 1000 620" preserveAspectRatio="none">
								<path class="creator-wallet-flow-path creator-wallet-flow-source creator-wallet-flow-source-one" d="M166 102 V158 Q166 170 178 170 H488 Q500 170 500 182 V282" />
								<path class="creator-wallet-flow-path creator-wallet-flow-source creator-wallet-flow-source-two" d="M500 102 V282" />
