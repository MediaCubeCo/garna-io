---
import FAQSection from '../sections/FAQSection.astro';
import GarnaBookingWidget from '../ui/GarnaBookingWidget.astro';
import HeroSection from '../sections/HeroSection.astro';
import Section from '../layout/Section.astro';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import CardIconVisual from '../visuals/CardIconVisual.astro';
import PayrollSolutionInteractions from '../sections/payroll/PayrollSolutionInteractions.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageHeroes } from '../../content/page-heroes';
import { pageShells } from '../../content/page-shells';
import type { FAQItem } from '../../types/faq-section';

const forCreatorsShell = {
	...pageShells.home,
	headExtra: `${pageShells.home.headExtra || ''}${pageShells.eor.headExtra || ''}`,
};
const forCreatorsHero = {
	...pageHeroes.eor,
	class: 'creator-payout-hero overflow-hidden pt-32 pb-20 md:pb-28 lg:pt-48 lg:pb-36 relative',
	badge: {
		text: 'Early Access for selected creators',
		translateKey: 'hero.badge',
	},
	titleClass:
		'garna-hero-title-gradient font-manrope text-5xl font-normal leading-[1.14] tracking-tight pb-[0.08em] md:text-[64px] md:leading-[1.12]',
	title: [{ text: 'Creator payouts from global platforms, guided by Garna', translateKey: 'hero.titleMain' }],
	description:
		'Receive payouts from creator platforms, stock marketplaces, freelance services and digital product platforms through one Garna account. We will guide you through the first setup, help you understand which payout method fits your platform, and support you during your first withdrawals',
	descriptionTranslateKey: 'hero.description',
	cta: {
		...pageHeroes.eor.cta,
		label: 'Create Garna Account',
		translateKey: 'hero.accountCta',
		href: 'https://app.garna.io/auth/sign-up',
		kind: 'signup',
		trackingCta: 'for_creators_hero_signup',
		wrapperClass: 'creator-hero-actions mt-9 mb-14 flex flex-col items-center justify-center gap-3 sm:flex-row',
	},
	ctaSecondary: undefined,
};
const forCreatorsFaqItems = [
	{
		question: 'Is Garna a creator platform?',
		questionTranslateKey: 'creatorFaq.items.creatorPlatform.question',
		answer:
			'No. Garna is not a marketplace and does not sell your content. Garna helps creators receive payouts from international platforms and withdraw funds using available payout methods',
		answerTranslateKey: 'creatorFaq.items.creatorPlatform.answer',
	},
	{
		question: 'Is this available for everyone?',
		questionTranslateKey: 'creatorFaq.items.availability.question',
		answer:
			'Creator payouts are currently available in Early Access. We start with selected creators and platforms to make sure each setup works correctly',
		answerTranslateKey: 'creatorFaq.items.availability.answer',
	},
	{
		question: 'Do I need to create a Garna account?',
		questionTranslateKey: 'creatorFaq.items.account.question',
		answer:
			'Yes. You need a Garna account to complete verification, create invoices, receive funds and withdraw your balance',
		answerTranslateKey: 'creatorFaq.items.account.answer',
	},
	{
		question: 'How long does verification take?',
		questionTranslateKey: 'creatorFaq.items.verification.question',
		answer: 'KYC usually takes 1-2 business days, depending on the documents and verification flow',
		answerTranslateKey: 'creatorFaq.items.verification.answer',
	},
	{
		question: 'How long does it take to receive funds from a platform?',
		questionTranslateKey: 'creatorFaq.items.platformFunds.question',
		answer:
			'It depends on the platform and payout method. In many cases, incoming funds may take 1-5 business days after the platform sends the payout',
		answerTranslateKey: 'creatorFaq.items.platformFunds.answer',
	},
	{
		question: 'How long does withdrawal from Garna take?',
		questionTranslateKey: 'creatorFaq.items.withdrawal.question',
		answer:
			'Withdrawal timing depends on the selected method and destination. As a general guideline, it may take 1-2 business days for many standard methods',
		answerTranslateKey: 'creatorFaq.items.withdrawal.answer',
	},
	{
		question: 'Can I use Garna with any platform?',
		questionTranslateKey: 'creatorFaq.items.anyPlatform.question',
		answer:
			'Not always. Each platform has its own payout rules and supported methods. During setup, we confirm whether your platform can be processed and which flow applies',
		answerTranslateKey: 'creatorFaq.items.anyPlatform.answer',
	},
	{
		question: 'What is the fee?',
		questionTranslateKey: 'creatorFaq.items.fee.question',
		answer:
			'The standard Garna service fee is 5.5%. Early Access creators can receive a reduced 1.5% Garna service fee for their first payouts, subject to final confirmation and setup details',
		answerTranslateKey: 'creatorFaq.items.fee.answer',
	},
] satisfies FAQItem[];
---

<BaseLayout shell={forCreatorsShell}>
	<HeroSection {...forCreatorsHero}>
		<div slot="cta-extra" class="creator-hero-contact-card" aria-label="Contact payout manager">
			<div class="creator-hero-contact-copy">
				<strong>Contact payout manager</strong>
			</div>
			<div class="creator-hero-contact-links">
				<a href="https://t.me/likelyiam" aria-label="Telegram">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 4.5 4.2 10.8c-.8.3-.8 1.2.1 1.5l4 1.2 1.5 4.8c.3.8 1.2.9 1.7.2l2.2-3 4.1 3c.7.5 1.5.1 1.7-.8l2.4-11.9c.2-.9-.6-1.6-1.4-1.3Z" /><path d="m8.4 13.4 8.5-5.3-6.8 7.6" /></svg>
				</a>
				<a href="https://wa.me/0000000000" aria-label="WhatsApp">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4.2a7.8 7.8 0 0 0-6.6 12l-1 3.4 3.5-.9A7.8 7.8 0 1 0 12 4.2Z" /><path d="M9 8.7c.2-.2.5-.2.7 0l1 1.3c.2.2.2.5 0 .7l-.5.6a5.5 5.5 0 0 0 2.5 2.5l.6-.5c.2-.2.5-.2.7 0l1.3 1c.2.2.2.5 0 .7-.5.6-1.3.9-2.1.7-2.5-.5-4.4-2.4-4.9-4.9-.2-.8.1-1.6.7-2.1Z" /></svg>
				</a>
				<a href="https://instagram.com/garna.io" aria-label="Instagram">
					<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="4" /><circle cx="12" cy="12" r="3.2" /></svg>
				</a>
			</div>
		</div>
		<div class="creator-hero-visual mx-auto w-full max-w-[1040px] overflow-visible px-0">
			<div class="creator-hero-panel relative overflow-hidden rounded-[28px] border border-white/10 bg-[#080908]/80 p-4 text-left shadow-[0_36px_120px_-72px_rgba(0,0,0,0.95)] backdrop-blur-xl sm:p-5 lg:p-6">
				<div class="absolute inset-x-10 top-0 h-px bg-gradient-to-r from-transparent via-[#CBF300]/80 to-transparent"></div>
				<div class="absolute -left-20 top-8 h-56 w-56 rounded-full bg-[#CBF300]/10 blur-3xl"></div>
				<div class="absolute -right-24 bottom-0 h-64 w-64 rounded-full bg-white/5 blur-3xl"></div>

				<div class="creator-wallet-visual relative" aria-label="Creator payout flow preview" data-creator-payout-demo>
					<div class="creator-payout-demo">
						<div class="creator-payout-demo-tabs" role="tablist" aria-label="Creator payout flow stages">
							<button class="is-active" type="button" role="tab" aria-selected="true" data-demo-tab="0">
								<span class="creator-payout-tab-icon creator-payout-tab-icon--large" aria-hidden="true">
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path>
										<polyline points="22 12 16 12 14 15 10 15 8 12 2 12"></polyline>
									</svg>
								</span>
								<span class="creator-payout-tab-copy">
									<strong>Platform payout</strong>
									<small>Creator earnings are sent</small>
								</span>
								<i aria-hidden="true"></i>
							</button>
							<button type="button" role="tab" aria-selected="false" data-demo-tab="1">
								<span class="creator-payout-tab-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"></path>
										<path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"></path>
									</svg>
								</span>
								<span class="creator-payout-tab-copy">
									<strong>Garna balance</strong>
									<small>Funds arrive verified</small>
								</span>
								<i aria-hidden="true"></i>
							</button>
							<button type="button" role="tab" aria-selected="false" data-demo-tab="2">
								<span class="creator-payout-tab-icon creator-payout-tab-icon--large creator-payout-tab-icon--withdraw" aria-hidden="true">
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path d="M12 18H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5"></path>
										<path d="M18 12h.01"></path>
										<path d="M19 22v-6"></path>
										<path d="m16 19 3-3 3 3"></path>
										<path d="M6 12h.01"></path>
										<circle cx="12" cy="12" r="2"></circle>
									</svg>
								</span>
								<span class="creator-payout-tab-copy">
									<strong>Withdraw funds</strong>
									<small>Choose payout method</small>
								</span>
								<i aria-hidden="true"></i>
							</button>
						</div>

						<div class="creator-payout-demo-stage">
							<section class="creator-payout-screen creator-payout-screen--platform is-active" data-demo-screen="0" role="tabpanel">
								<div class="creator-payout-window creator-payout-window--platform is-platform-flow">
									<div class="creator-platform-browser-bar" aria-hidden="true">
										<div class="creator-platform-top-logo">
											<span class="creator-platform-top-mark">
												<svg viewBox="0 0 24 24" aria-hidden="true">
													<path d="m12 3.8 2.35 4.75 5.25.76-3.8 3.7.9 5.22L12 15.76l-4.7 2.47.9-5.22-3.8-3.7 5.25-.76L12 3.8Z"></path>
												</svg>
											</span>
											<strong>marketplace</strong>
										</div>
										<div class="creator-platform-search">
											<span class="creator-platform-search-filter">
												All items
												<svg viewBox="0 0 16 16" aria-hidden="true">
													<path d="m4 6 4 4 4-4"></path>
												</svg>
											</span>
											<i></i>
											<svg class="creator-platform-search-icon" viewBox="0 0 24 24" aria-hidden="true">
												<circle cx="11" cy="11" r="7"></circle>
												<path d="m20 20-3.5-3.5"></path>
											</svg>
											<strong>Search</strong>
										</div>
										<button type="button">Unlimited Access</button>
										<span class="creator-platform-avatar" aria-label="Account">
											<img src="/images/creator-avatar-headphones.jpg" alt="" loading="lazy" />
										</span>
									</div>
									<div class="creator-platform-content">
										<div class="creator-platform-marketplace">
											<div class="creator-platform-marketplace-head">
												<strong>Every type of asset, for any creator project</strong>
											</div>
											<div class="creator-platform-category-grid" aria-hidden="true">
												<article class="creator-platform-category-card creator-platform-category-card--wide">
													<div>
														<strong>Video Templates</strong>
														<span>150,000+</span>
													</div>
													<img src="/images/creator-video-templates-cover.jpg" alt="" loading="lazy" />
												</article>
												<article class="creator-platform-category-card creator-platform-category-card--first-stack">
													<div>
														<strong>Sound Effects</strong>
														<span>940,000+</span>
													</div>
													<img src="/images/creator-sound-effects-cover.jpg" alt="" loading="lazy" />
												</article>
												<article class="creator-platform-category-card">
													<div>
														<strong>Stock Photos</strong>
														<span>16.1M+</span>
													</div>
													<img src="/images/creator-stock-photos-cover.jpg" alt="" loading="lazy" />
												</article>
												<article class="creator-platform-category-card creator-platform-category-card--dark">
													<div>
														<strong>Royalty-Free Music</strong>
														<span>340,000+</span>
													</div>
													<img src="/images/creator-music-cover.jpg" alt="" loading="lazy" />
												</article>
												<article class="creator-platform-category-card">
													<div>
														<strong>Graphic Templates</strong>
														<span>430,000+</span>
													</div>
													<img src="/images/creator-graphic-templates-cover.jpg" alt="" loading="lazy" />
												</article>
												<article class="creator-platform-category-card">
													<div>
														<strong>Fonts</strong>
														<span>80,000+</span>
													</div>
													<img src="/images/creator-fonts-cover.avif" alt="" loading="lazy" />
												</article>
												<article class="creator-platform-category-card creator-platform-category-card--accent">
													<div>
														<strong>3D Assets</strong>
														<span>380,000+</span>
													</div>
													<img src="/images/creator-3d-assets-cover.jpg" alt="" loading="lazy" />
												</article>
												<article class="creator-platform-category-card">
													<div>
														<strong>Presentation Templates</strong>
														<span>220,000+</span>
													</div>
													<img src="/images/creator-presentation-templates-cover.jpg" alt="" loading="lazy" />
												</article>
											</div>
										</div>
										<div class="creator-platform-finance" aria-hidden="true">
											<div class="creator-platform-finance-head">
												<div>
													<span>Creator studio</span>
													<strong>Earnings workspace</strong>
												</div>
												<b>June cycle</b>
											</div>
											<div class="creator-platform-finance-grid">
												<article class="creator-platform-finance-balance">
													<span>Ready to transfer</span>
													<strong>$3,140.00</strong>
													<small>From 3 creator products</small>
												</article>
												<article>
													<span>Checked</span>
													<strong>3/3</strong>
													<small>Sources verified</small>
												</article>
												<article>
													<span>Avg rating</span>
													<strong>4.8</strong>
													<small>Across paid products</small>
												</article>
											</div>
											<div class="creator-platform-finance-table">
												<div>
													<img src="/images/creator-video-templates-cover.jpg" alt="" loading="lazy" />
													<span>Video template pack</span>
													<small>42 sales / 4.9 rating</small>
													<strong>$1,420.00</strong>
												</div>
												<div>
													<img src="/images/creator-music-cover.jpg" alt="" loading="lazy" />
													<span>Music creator bundle</span>
													<small>18 licenses / featured</small>
													<strong>$940.00</strong>
												</div>
												<div>
													<img src="/images/creator-graphic-templates-cover.jpg" alt="" loading="lazy" />
													<span>Graphic mockup set</span>
													<small>24 sales / trending</small>
													<strong>$780.00</strong>
												</div>
											</div>
											<div class="creator-platform-destination">
												<div>
													<strong>Choose how to receive earnings</strong>
													<small>Select a route, then continue payout</small>
												</div>
												<div class="creator-platform-destination-options" aria-label="Payout route options">
													<button class="creator-platform-destination-garna" type="button">
														<i aria-hidden="true"></i>
														<span>Garna</span>
														<small>Best route</small>
													</button>
													<button class="creator-platform-destination-paypal" type="button">
														<i aria-hidden="true"></i>
														<span>PayPal</span>
														<small>Extra fees</small>
													</button>
													<button class="creator-platform-destination-bank" type="button">
														<i aria-hidden="true"></i>
														<span>Bank</span>
														<small>3-5 days</small>
													</button>
												</div>
												<div class="creator-platform-destination-action">
													<small class="creator-platform-destination-status">
														<span>No destination selected yet</span>
														<span>Garna selected. Continue payout</span>
													</small>
													<button class="creator-platform-send-button" type="button" disabled>Continue payout</button>
												</div>
											</div>
										</div>
									</div>
									<div class="creator-platform-live-cursor" aria-hidden="true">
										<svg viewBox="0 0 28 28">
											<path d="M5 3.5 21.5 14 14 15.4l-3.4 7.1L5 3.5Z"></path>
										</svg>
										<span>Creator</span>
									</div>
								</div>
							</section>

							<section class="creator-payout-screen creator-payout-screen--garna" data-demo-screen="1" role="tabpanel" hidden>
								<div class="creator-payout-window creator-payout-window--garna">
									<header>
										<div>
											<img src="/garna_logo.svg" alt="Garna" loading="lazy" />
											<span>Creator balance</span>
										</div>
										<b>Verified</b>
									</header>
									<div class="creator-payout-balance">
										<span>Available now</span>
										<strong>$2,840.00</strong>
									</div>
									<div class="creator-payout-balance-card">
										<span>Account</span>
										<strong>4461 **** **** 9821</strong>
									</div>
									<div class="creator-payout-checklist">
										<span><i></i>Compliance checked</span>
										<span><i></i>Fee reduced to 1.5%</span>
										<span><i></i>Withdrawal methods ready</span>
									</div>
								</div>
							</section>

							<section class="creator-payout-screen creator-payout-screen--withdraw" data-demo-screen="2" role="tabpanel" hidden>
								<div class="creator-payout-window creator-payout-window--withdraw">
									<header>
										<div>
											<span class="creator-payout-window-icon">↗</span>
											<span>Withdraw funds</span>
										</div>
										<strong>$2,840.00</strong>
									</header>
									<div class="creator-payout-methods">
										<article class="is-selected">
											<span>Bank transfer</span>
											<strong>Alex Carter USD</strong>
											<small>•••• 9821</small>
										</article>
										<article>
											<span>Card payout</span>
											<strong>Visa / Mastercard</strong>
											<small>Card ending 4482</small>
										</article>
										<article>
											<span>Crypto wallet</span>
											<strong>USDT wallet</strong>
											<small>TRC20 verified</small>
										</article>
									</div>
								</div>
							</section>
						</div>
					</div>

				</div>
			</div>
		</div>
	</HeroSection>
	<Section
		title={{ text: 'Built for creators who earn globally', translateKey: 'creatorTypes.title' }}
		description={{ text: 'Garna can help creators, freelancers and digital sellers who receive income from international platforms', translateKey: 'creatorTypes.description' }}
		class="border-y border-[#020202]/0"
		headerClass="mb-14 max-w-5xl lg:mb-16"
		titleClass="mx-auto max-w-4xl lg:text-5xl"
		contentClass="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4"
	>
		<Card
			class="p-6"
			titleClass="text-lg"
			descriptionClass="text-sm"
			title={{ text: 'Designers & illustrators', translateKey: 'creatorTypes.cards.designers.title' }}
			description={{ text: 'For creators selling graphics, templates, fonts, digital assets and visual products', translateKey: 'creatorTypes.cards.designers.description' }}
		>
			<CardIconVisual slot="visual" icon="lucide:palette" />
		</Card>
		<Card
			class="p-6"
			titleClass="text-lg"
			descriptionClass="text-sm"
			title={{ text: 'Photographers & stock contributors', translateKey: 'creatorTypes.cards.photographers.title' }}
			description={{ text: 'For contributors receiving royalties or payouts from stock photo and media platforms', translateKey: 'creatorTypes.cards.photographers.description' }}
		>
			<CardIconVisual slot="visual" icon="lucide:camera" />
		</Card>
		<Card
			class="p-6"
			titleClass="text-lg"
			descriptionClass="text-sm"
			title={{ text: '3D artists & game asset creators', translateKey: 'creatorTypes.cards.gameAssets.title' }}
			description={{ text: 'For creators selling 3D models, plugins, textures, game assets and marketplace products', translateKey: 'creatorTypes.cards.gameAssets.description' }}
		>
			<CardIconVisual slot="visual" icon="lucide:box" />
		</Card>
		<Card
			class="p-6"
			titleClass="text-lg"
			descriptionClass="text-sm"
			title={{ text: 'Freelancers & digital sellers', translateKey: 'creatorTypes.cards.freelancers.title' }}
			description={{ text: 'For people earning from freelance platforms, subscriptions, courses, music, content or digital products', translateKey: 'creatorTypes.cards.freelancers.description' }}
		>
			<CardIconVisual slot="visual" icon="lucide:store" />
		</Card>
	</Section>
	<Section
		layout="split"
		spacing="none"
		width="content"
		class="creator-account-flow-section pt-16 pb-8 lg:pt-32 lg:pb-0"
		containerClass="creator-account-flow-container"
		splitClass="creator-account-flow-grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start"
		copyClass="creator-account-flow-copy max-w-xl text-left lg:sticky lg:top-28 lg:self-start"
		align="left"
		title={{ text: 'One account for creator payouts', translateKey: 'accountFlow.title' }}
		description={{ text: 'A guided way to connect platform payouts, receive funds to your Garna balance and withdraw using available payout methods', translateKey: 'accountFlow.description' }}
		titleClass="lg:text-5xl"
		descriptionClass="text-lg"
		contentClass="creator-account-stack"
	>
		<Card
			variant="compact"
			class="creator-account-stack-card"
			interactive={false}
		>
			<div class="creator-step-copy">
				<h3 data-translate="accountFlow.steps.receive.title">Receive platform payouts</h3>
