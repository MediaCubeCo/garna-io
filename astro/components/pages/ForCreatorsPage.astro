	.creator-process-scroll {
		--creator-process-top-offset: 104px;
		--creator-process-bottom-offset: 64px;
		display: grid;
		min-height: 360vh;
		grid-template-columns: minmax(0, 1.06fr) minmax(320px, 0.94fr);
		align-items: start;
		gap: clamp(28px, 5vw, 72px);
	}

	.creator-process-pin {
		position: sticky;
		top: var(--creator-process-top-offset);
		display: grid;
		min-width: 0;
		gap: 16px;
	}

	.creator-process-visual-stage {
		position: relative;
		width: 100%;
		height: calc(100vh - var(--creator-process-top-offset) - var(--creator-process-bottom-offset));
		min-height: 420px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 28px;
		background: rgba(255, 255, 255, 0.02);
		box-shadow: none;
	}

	.creator-process-visual-stage::before {
		content: none;
	}

	.creator-process-visual {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		padding: clamp(34px, 5vw, 74px);
		opacity: 0;
		transform: translateY(18px) scale(0.98);
		transition:
			opacity 360ms ease,
			transform 360ms ease;
	}

	.creator-process-visual.is-active {
		opacity: 1;
		transform: translateY(0) scale(1);
	}

	.creator-process-progress {
		display: flex;
		justify-content: center;
		gap: 8px;
	}

	.creator-process-progress span {
		width: 8px;
		height: 8px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.16);
		transition:
			width 220ms ease,
			background 220ms ease;
	}

	.creator-process-progress span.is-active {
		width: 28px;
		background: #CBF300;
	}

	.creator-process-copy {
		position: sticky;
		top: var(--creator-process-top-offset);
		min-width: 0;
		height: calc(100vh - var(--creator-process-top-offset) - var(--creator-process-bottom-offset));
		min-height: 420px;
	}

	.creator-process-step {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		border: 0;
		padding: clamp(150px, 22vh, 210px) 0 42px;
		opacity: 0;
		pointer-events: none;
		transform: none;
		transition: opacity 280ms ease;
	}

	.creator-process-step.is-active {
		opacity: 1;
		pointer-events: auto;
		transform: none;
	}

	.creator-process-step > span {
		display: inline-flex;
		width: fit-content;
		margin-bottom: 22px;
		border: 1px solid rgba(203, 243, 0, 0.16);
		border-radius: 999px;
		background: rgba(203, 243, 0, 0.07);
		padding: 7px 10px;
		color: #CBF300;
		font-family: "Geist Mono", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.creator-process-step h3 {
		margin: 0;
		color: #ffffff;
		font-family: Manrope, sans-serif;
		font-size: clamp(2rem, 3.8vw, 3.8rem);
		font-weight: 400;
		line-height: 1.04;
		letter-spacing: 0;
		clip-path: inset(0 100% 0 0);
		filter: blur(8px);
		opacity: 0;
		transform: translateY(12px);
	}

	.creator-process-step.is-active h3 {
		animation: creator-process-title-reveal 560ms cubic-bezier(0.2, 0.8, 0.2, 1) 40ms both;
	}

	.creator-process-step p {
		max-width: 520px;
		margin: 22px 0 0;
		color: #a1a1aa;
		font-family: Manrope, sans-serif;
		font-size: clamp(1rem, 1.4vw, 1.2rem);
		line-height: 1.55;
	}

	@keyframes creator-process-title-reveal {
		0% {
			clip-path: inset(0 100% 0 0);
			filter: blur(8px);
			opacity: 0;
			transform: translateY(12px);
		}

		58% {
			filter: blur(0);
			opacity: 1;
		}

		100% {
			clip-path: inset(0 0 0 0);
			filter: blur(0);
			opacity: 1;
			transform: translateY(0);
		}
	}

