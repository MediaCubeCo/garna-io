	<script is:inline>
		const creatorProcess = document.querySelector('[data-creator-process]');
		const creatorProcessSteps = Array.from(document.querySelectorAll('[data-process-step]'));
		const creatorProcessVisuals = Array.from(document.querySelectorAll('[data-process-visual]'));
		const creatorProcessProgress = Array.from(document.querySelectorAll('.creator-process-progress span'));
		const creatorBalanceDuration = 5800;
		let creatorBalanceActiveStartedAt = null;

		if (creatorProcess && creatorProcessSteps.length && creatorProcessVisuals.length) {
			const creatorProcessScroll = creatorProcess.closest('.creator-process-scroll');
			let creatorProcessFrame = null;
			let creatorProcessCurrentIndex = -1;

			const setCreatorProcessStep = (index) => {
				if (index !== creatorProcessCurrentIndex) {
					creatorBalanceActiveStartedAt = index === 5 ? performance.now() : null;
					creatorProcessCurrentIndex = index;
				}

				creatorProcessSteps.forEach((step) => {
					step.classList.toggle('is-active', step.getAttribute('data-process-step') === String(index));
				});
				creatorProcessVisuals.forEach((visual) => {
					visual.classList.toggle('is-active', visual.getAttribute('data-process-visual') === String(index));
				});
				creatorProcessProgress.forEach((dot, dotIndex) => {
					dot.classList.toggle('is-active', dotIndex === index);
				});
			};

			const updateCreatorProcessStep = () => {
				creatorProcessFrame = null;
				if (!creatorProcessScroll) return;

				const rect = creatorProcessScroll.getBoundingClientRect();
				const scrollDistance = Math.max(1, rect.height - window.innerHeight);
				const stickyOffset = window.innerWidth > 980 ? 104 : 0;
				const progress = Math.min(1, Math.max(0, (stickyOffset - rect.top) / scrollDistance));
				const index = Math.min(creatorProcessSteps.length - 1, Math.floor(progress * creatorProcessSteps.length));

				setCreatorProcessStep(index);
			};

			const requestCreatorProcessUpdate = () => {
				if (creatorProcessFrame !== null) return;
				creatorProcessFrame = window.requestAnimationFrame(updateCreatorProcessStep);
			};

			updateCreatorProcessStep();
			window.addEventListener('scroll', requestCreatorProcessUpdate, { passive: true });
			window.addEventListener('resize', requestCreatorProcessUpdate);
		}

		const creatorBalanceCounter = document.querySelector('[data-process-balance-counter]');
		const creatorBalanceBar = document.querySelector('.creator-balance-bar');
		const reduceCreatorProcessMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		if (creatorBalanceCounter) {
			const targetBalance = 2840;
			const formatCreatorBalance = (value) =>
				new Intl.NumberFormat('en-US', {
					style: 'currency',
					currency: 'USD',
					minimumFractionDigits: 2,
					maximumFractionDigits: 2,
				}).format(value);

			if (reduceCreatorProcessMotion.matches) {
				creatorBalanceCounter.textContent = formatCreatorBalance(targetBalance);
				if (creatorBalanceBar instanceof HTMLElement) {
					creatorBalanceBar.style.setProperty('--creator-balance-progress', '1');
				}
			} else {
				const balanceBarAppearDelay = 0.72;
				const balanceBarFullyVisibleAt = 0.24;
				const fillStart = (balanceBarAppearDelay + creatorBalanceDuration * balanceBarFullyVisibleAt) / creatorBalanceDuration;
				const fillEnd = 0.68;

				const animateCreatorBalance = (timestamp) => {
					const cycle =
						creatorBalanceActiveStartedAt === null
							? 0
							: ((timestamp - creatorBalanceActiveStartedAt) % creatorBalanceDuration) / creatorBalanceDuration;
					const rawProgress = Math.min(1, Math.max(0, (cycle - fillStart) / (fillEnd - fillStart)));
					const easedProgress = 1 - Math.pow(1 - rawProgress, 3);
					creatorBalanceCounter.textContent = formatCreatorBalance(targetBalance * easedProgress);
					if (creatorBalanceBar instanceof HTMLElement) {
						creatorBalanceBar.style.setProperty('--creator-balance-progress', String(easedProgress));
					}
					window.requestAnimationFrame(animateCreatorBalance);
				};

				window.requestAnimationFrame(animateCreatorBalance);
			}
		}

		const platformLogoShowcase = document.querySelector('[data-random-platform-logos]');
		const reducePlatformLogoMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		if (platformLogoShowcase && !reducePlatformLogoMotion.matches) {
			const platformLogoCells = Array.from(platformLogoShowcase.querySelectorAll('.creator-platform-logo'));
			let platformLogoQueue = [];

			const shufflePlatformLogoQueue = () => {
				platformLogoQueue = platformLogoCells.map((_, index) => index);

				for (let index = platformLogoQueue.length - 1; index > 0; index -= 1) {
					const swapIndex = Math.floor(Math.random() * (index + 1));
					[platformLogoQueue[index], platformLogoQueue[swapIndex]] = [platformLogoQueue[swapIndex], platformLogoQueue[index]];
				}
			};

			shufflePlatformLogoQueue();

			const switchRandomPlatformLogo = () => {
				if (platformLogoCells.length < 2) return;
				if (!platformLogoQueue.length) shufflePlatformLogoQueue();

				const nextIndex = platformLogoQueue.shift();
				platformLogoCells[nextIndex].classList.toggle('is-alt-visible');
			};

			window.setInterval(switchRandomPlatformLogo, 1000);
		}

		document.addEventListener('click', (event) => {
			const link = event.target instanceof Element ? event.target.closest('a') : null;
			if (!link || link.getAttribute('href') !== '#') return;
			if (!link.textContent || !link.textContent.toLowerCase().includes('book a demo')) return;

			event.preventDefault();
			if (window.GarnaWidget) {
				window.GarnaWidget.open({ trackingCta: 'for_creators_demo' });
			}
		});
	</script>
