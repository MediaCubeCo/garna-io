			opacity: 0;
			padding-bottom: 0;
			padding-top: 0;
			transform: translateY(-4px) scale(0.99);
		}
	}

	@keyframes creator-chat-typing-first-cycle {
		0% {
			max-height: 0;
			opacity: 0;
			padding-bottom: 0;
			padding-top: 0;
			transform: translateY(4px);
		}

		13%,
		23% {
			max-height: 28px;
			opacity: 1;
			padding-bottom: 8px;
			padding-top: 8px;
			transform: translateY(0);
		}

		29%,
