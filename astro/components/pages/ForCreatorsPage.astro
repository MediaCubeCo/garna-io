---
import FAQSection from '../sections/FAQSection.astro';
import GarnaBookingWidget from '../ui/GarnaBookingWidget.astro';
import HeroSection from '../sections/HeroSection.astro';
import Section from '../layout/Section.astro';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import CardIconVisual from '../visuals/CardIconVisual.astro';
import PayrollSolutionInteractions from '../sections/payroll/PayrollSolutionInteractions.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageHeroes } from '../../content/page-heroes';
import { pageShells } from '../../content/page-shells';
import type { FAQItem } from '../../types/faq-section';

const forCreatorsShell = {
	...pageShells.home,
	headExtra: `${pageShells.home.headExtra || ''}${pageShells.eor.headExtra || ''}`,
};
const forCreatorsHero = {
	...pageHeroes.eor,
	badge: {
		text: 'Early Access for selected creators',
		translateKey: 'hero.badge',
	},
	titleClass:
		'garna-hero-title-gradient font-manrope text-5xl font-normal leading-[1.14] tracking-tight pb-[0.08em] md:text-[64px] md:leading-[1.12]',
	title: [{ text: 'Creator payouts from global platforms, guided by Garna', translateKey: 'hero.titleMain' }],
	description:
		'Receive payouts from creator platforms, stock marketplaces, freelance services and digital product platforms through one Garna account. We will guide you through the first setup, help you understand which payout method fits your platform, and support you during your first withdrawals',
	descriptionTranslateKey: 'hero.description',
	cta: {
		...pageHeroes.eor.cta,
		label: 'Contact Payout Manager',
		translateKey: 'hero.cta',
		href: 'https://t.me/likelyiam',
		kind: 'external',
		trackingCta: 'for_creators_hero_contact_manager',
		wrapperClass: 'creator-hero-actions mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row',
	},
	ctaSecondary: {
		label: 'Create Garna Account',
		translateKey: 'hero.accountCta',
		href: 'https://app.garna.io/auth/sign-up',
		kind: 'signup',
		variant: 'secondary',
		effect: 'none',
		icon: 'none',
	},
};
const forCreatorsFaqItems = [
	{
		question: 'Is Garna a creator platform?',
		answer:
			'No. Garna is not a marketplace and does not sell your content. Garna helps creators receive payouts from international platforms and withdraw funds using available payout methods',
	},
	{
		question: 'Is this available for everyone?',
		answer:
			'Creator payouts are currently available in Early Access. We start with selected creators and platforms to make sure each setup works correctly',
	},
	{
		question: 'Do I need to create a Garna account?',
		answer:
			'Yes. You need a Garna account to complete verification, create invoices, receive funds and withdraw your balance',
	},
	{
		question: 'How long does verification take?',
		answer: 'KYC usually takes 1-2 business days, depending on the documents and verification flow',
	},
	{
		question: 'How long does it take to receive funds from a platform?',
		answer:
			'It depends on the platform and payout method. In many cases, incoming funds may take 1-5 business days after the platform sends the payout',
	},
	{
		question: 'How long does withdrawal from Garna take?',
		answer:
			'Withdrawal timing depends on the selected method and destination. As a general guideline, it may take 1-2 business days for many standard methods',
	},
	{
		question: 'Can I use Garna with any platform?',
		answer:
			'Not always. Each platform has its own payout rules and supported methods. During setup, we confirm whether your platform can be processed and which flow applies',
	},
	{
		question: 'What is the fee?',
		answer:
			'The standard Garna service fee is 5.5%. Early Access creators can receive a reduced 1.5% Garna service fee for their first payouts, subject to final confirmation and setup details',
	},
] satisfies FAQItem[];
---

<BaseLayout shell={forCreatorsShell}>
	<HeroSection {...forCreatorsHero}>
		<div class="creator-hero-visual mx-auto mt-16 w-full max-w-5xl overflow-visible px-0 sm:mt-20">
			<div class="creator-hero-panel relative overflow-hidden rounded-[28px] border border-white/10 bg-[#080908]/80 p-4 text-left shadow-[0_36px_120px_-72px_rgba(0,0,0,0.95)] backdrop-blur-xl sm:p-5 lg:p-6">
				<div class="absolute inset-x-10 top-0 h-px bg-gradient-to-r from-transparent via-[#CBF300]/80 to-transparent"></div>
				<div class="absolute -left-20 top-8 h-56 w-56 rounded-full bg-[#CBF300]/10 blur-3xl"></div>
				<div class="absolute -right-24 bottom-0 h-64 w-64 rounded-full bg-white/5 blur-3xl"></div>

				<div class="creator-wallet-visual relative" aria-label="Creator sees a platform payout move into a Garna account">
					<div class="creator-wallet-browser">
						<div class="creator-wallet-stage">
							<div class="creator-wallet-notification">
								<div class="creator-wallet-window-head">
									<img class="creator-wallet-platform-logo" src="/images/envato-logo.svg" alt="Envato" loading="lazy" />
									<span>Creator platform</span>
								</div>
								<div>
									<span>Envato balance</span>
									<strong class="creator-wallet-platform-amount" aria-label="$2,840.00 available on Envato">
										<span>$2,840.00</span>
										<span>$0.00</span>
									</strong>
									<p>Marketplace payout transfer</p>
								</div>
								<div class="creator-wallet-platform-list">
									<div><span>Status</span><strong>Available payout</strong></div>
									<div><span>Period</span><strong>June earnings</strong></div>
									<div><span>Destination</span><strong>Garna account</strong></div>
								</div>
								<div class="creator-wallet-platform-action">Request withdrawal</div>
							</div>

							<div class="creator-wallet-garna-card" aria-label="Garna payout routing">
								<div class="creator-wallet-flow-status" aria-hidden="true">
									<span>Platform matched</span>
									<span>Invoice checked</span>
									<span>Route prepared</span>
								</div>
								<span class="creator-wallet-flow-dot creator-wallet-flow-dot-in" aria-hidden="true"></span>
								<span class="creator-wallet-flow-dot creator-wallet-flow-dot-out" aria-hidden="true"></span>
								<span class="creator-wallet-garna-mark" aria-hidden="true">
									<img src="/images/garna-g-logo.svg" alt="" loading="lazy" />
								</span>
								<span class="creator-wallet-garna-caption">Garna check</span>
							</div>

							<div class="creator-wallet-account">
								<div class="creator-wallet-account-head">
									<div>
										<img src="/garna_logo.svg" alt="Garna" loading="lazy" />
										<span>Balance</span>
									</div>
									<img
										class="creator-wallet-account-avatar"
										src="/pages/payroll-solution-new/assets/07-photo-1487412720507-e7ab37603c6f.jpg"
										alt="Logged in creator"
										loading="lazy"
										decoding="async"
									/>
								</div>
								<div class="creator-wallet-balance">
									<span>Internal account USD</span>
									<strong class="creator-wallet-account-amount" aria-label="Garna balance credited with $2,840.00">
										<span>$0.00</span>
										<span>$2,840.00</span>
									</strong>
									<p>Account number 4461 9571 3840 9821</p>
								</div>
								<span class="creator-wallet-section-label">Actions</span>
								<div class="creator-wallet-actions">
									<span>Send</span>
									<span>Withdraw</span>
									<span>Add funds</span>
									<span>Details</span>
								</div>
								<span class="creator-wallet-section-label">Templates</span>
								<div class="creator-wallet-templates">
									<div><span>CSV payment</span><i></i></div>
									<div><span>Top up with USDT</span><i></i></div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</HeroSection>
	<Section
		title={{ text: 'Built for creators who earn globally' }}
		description={{ text: 'Garna can help creators, freelancers and digital sellers who receive income from international platforms' }}
		class="border-y border-[#020202]/0"
		headerClass="mb-14 max-w-5xl lg:mb-16"
		titleClass="mx-auto max-w-4xl lg:text-5xl"
		contentClass="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4"
	>
		<Card
			class="p-6"
			titleClass="text-lg"
			descriptionClass="text-sm"
			title="Designers & illustrators"
			description="For creators selling graphics, templates, fonts, digital assets and visual products"
		>
			<CardIconVisual slot="visual" icon="lucide:palette" />
		</Card>
		<Card
			class="p-6"
			titleClass="text-lg"
			descriptionClass="text-sm"
			title="Photographers & stock contributors"
			description="For contributors receiving royalties or payouts from stock photo and media platforms"
		>
			<CardIconVisual slot="visual" icon="lucide:camera" />
		</Card>
		<Card
			class="p-6"
			titleClass="text-lg"
			descriptionClass="text-sm"
			title="3D artists & game asset creators"
			description="For creators selling 3D models, plugins, textures, game assets and marketplace products"
		>
			<CardIconVisual slot="visual" icon="lucide:box" />
		</Card>
		<Card
			class="p-6"
			titleClass="text-lg"
			descriptionClass="text-sm"
			title="Freelancers & digital sellers"
			description="For people earning from freelance platforms, subscriptions, courses, music, content or digital products"
		>
			<CardIconVisual slot="visual" icon="lucide:store" />
		</Card>
	</Section>
	<Section
		layout="split"
		spacing="none"
		width="wide"
		class="py-16 lg:py-32"
		splitClass="gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start"
		copyClass="max-w-xl text-left lg:sticky lg:top-28 lg:self-start"
		align="left"
		title={{ text: 'One account for creator payouts' }}
		description={{ text: 'A guided way to connect platform payouts, receive funds to your Garna balance and withdraw using available payout methods' }}
		titleClass="lg:text-5xl"
		descriptionClass="text-lg"
		contentClass="grid gap-4"
	>
		<Card
			variant="compact"
			visualClass="creator-step-number shrink-0"
		>
			<span slot="visual">01</span>
			<div class="creator-step-copy">
				<h3>Receive platform payouts</h3>
				<p>Use Garna details where supported to receive payments from international creator platforms</p>
			</div>
		</Card>
		<Card
			variant="compact"
			visualClass="creator-step-number shrink-0"
		>
			<span slot="visual">02</span>
			<div class="creator-step-copy">
				<h3>Get guided setup</h3>
				<p>Tell us which platform you use. We will check the available payout method and guide you through setup</p>
			</div>
		</Card>
		<Card
			variant="compact"
			visualClass="creator-step-number shrink-0"
		>
			<span slot="visual">03</span>
			<div class="creator-step-copy">
				<h3>Manage your balance</h3>
				<p>Once funds arrive, they are credited to your Garna balance after verification and invoice matching</p>
			</div>
		</Card>
		<Card
			variant="compact"
			visualClass="creator-step-number shrink-0"
		>
			<span slot="visual">04</span>
			<div class="creator-step-copy">
				<h3>Withdraw globally</h3>
				<p>Withdraw your money using bank transfer, card, PayPal, Payoneer, crypto and other supported options</p>
			</div>
		</Card>
	</Section>
	<Section
		title={{ text: 'From platform payout to your Garna balance' }}
		description={{ text: 'The flow is simple, but setup may differ by platform. During Early Access, we guide you through the important details' }}
		headerClass="mb-14 max-w-4xl lg:mb-16"
		titleClass="mx-auto max-w-4xl lg:text-5xl"
		contentClass="creator-process-scroll"
	>
		<div class="creator-process-pin" data-creator-process>
			<div class="creator-process-visual-stage" aria-label="Creator payout setup visual">
				<div class="creator-process-visual is-active" data-process-visual="0">
				<div class="creator-mini-window">
					<div class="creator-mini-row"><span>Profile</span><strong>Setup</strong></div>
					<div class="creator-mini-amount">
						<span>Account status</span>
						<strong>Opening</strong>
					</div>
					<div class="creator-mini-skeleton w-4/5"></div>
					<div class="creator-mini-skeleton w-3/5"></div>
					<div class="creator-mini-verification">
						<span><i></i>Email confirmed</span>
						<span><i></i>KYC in review</span>
						<span><i></i>Account opening</span>
					</div>
					<div class="creator-visual-list">
						<div><span>Legal name</span><strong>Alex Carter</strong></div>
						<div><span>Country</span><strong>Portugal</strong></div>
						<div><span>Currency</span><strong>USD</strong></div>
					</div>
					<div class="creator-visual-action">Continue verification</div>
				</div>
			</div>
				<div class="creator-process-visual" data-process-visual="1">
				<div class="creator-chat-card">
					<div class="creator-chat-meta">
						<span>Manager online</span>
						<strong>2 min</strong>
					</div>
					<div class="creator-chat-bubble user">Income from Envato</div>
					<div class="creator-chat-bubble manager">Send country and payout currency</div>
					<div class="creator-chat-bubble user">Portugal, USD. I also use Adobe Stock</div>
					<div class="creator-chat-bubble manager">Got it. I will check supported route and invoice rules</div>
					<div class="creator-chat-bubble user">Please include the first withdrawal steps too</div>
					<div class="creator-visual-list">
						<div><span>Platforms</span><strong>2 added</strong></div>
						<div><span>Route check</span><strong>In progress</strong></div>
					</div>
				</div>
			</div>
				<div class="creator-process-visual" data-process-visual="2">
				<div class="creator-details-sheet">
					<div class="creator-details-header">
						<span>Garna details</span>
						<strong>USD</strong>
					</div>
					<div class="creator-details-grid">
						<span>Routing</span>
						<strong>021000021</strong>
						<span>Account</span>
						<strong>4461 9571</strong>
						<span>Method</span>
						<strong>SWIFT</strong>
						<span>Beneficiary</span>
						<strong>Garna LLC</strong>
						<span>Reference</span>
						<strong>ENV-2048</strong>
					</div>
					<div class="creator-detail-tags">
						<span>Envato ready</span>
						<span>Adobe Stock manual</span>
						<span>Invoice required</span>
					</div>
					<div class="creator-details-status">
						<div><span>Route status</span><strong>Checked</strong></div>
						<div><span>Use in platform</span><strong>Ready to paste</strong></div>
					</div>
					<div class="creator-visual-action">Copy payout details</div>
				</div>
			</div>
				<div class="creator-process-visual" data-process-visual="3">
				<div class="creator-withdraw-panel">
					<div class="creator-withdraw-header">
						<span>Envato withdrawal</span>
						<strong>$2,840</strong>
					</div>
					<div class="creator-visual-list">
						<div><span>Available now</span><strong>$2,840.00</strong></div>
						<div><span>Marketplace fee</span><strong>Paid</strong></div>
					</div>
					<div class="creator-withdraw-select">
						<span>Destination</span>
						<strong>Garna USD</strong>
					</div>
					<div class="creator-withdraw-note">
						<span>Request</span>
						<strong>Prepared</strong>
					</div>
					<div class="creator-visual-action">Request payout</div>
				</div>
			</div>
				<div class="creator-process-visual" data-process-visual="4">
				<div class="creator-invoice-doc">
					<div class="creator-doc-header">
						<div class="creator-doc-title">Invoice #2048</div>
						<div class="creator-doc-corner">PDF</div>
					</div>
					<div class="creator-visual-list">
						<div><span>Client</span><strong>Envato Pty Ltd</strong></div>
						<div><span>Amount</span><strong>$2,840.00</strong></div>
						<div><span>Status</span><strong>Matching</strong></div>
					</div>
					<div class="creator-doc-lines">
						<span></span>
						<span></span>
						<span></span>
					</div>
					<div class="creator-doc-attach">Payout proof attached</div>
					<div class="creator-detail-tags">
						<span>Screenshot</span>
						<span>Platform report</span>
					</div>
				</div>
			</div>
				<div class="creator-process-visual" data-process-visual="5">
				<div class="creator-balance-card">
					<div class="creator-balance-top">
						<span>Garna balance</span>
						<em>Credited</em>
					</div>
					<strong data-process-balance-counter>$0.00</strong>
					<div class="creator-visual-list">
						<div><span>Incoming payout</span><strong>Envato</strong></div>
						<div><span>Available now</span><strong>$2,840.00</strong></div>
					</div>
					<div class="creator-balance-bar"></div>
					<div class="creator-balance-methods">
						<span>Bank</span>
						<span>Card</span>
						<span>Crypto</span>
					</div>
					<div class="creator-visual-action">Withdraw funds</div>
				</div>
			</div>
			</div>
			<div class="creator-process-progress" aria-hidden="true">
				<span class="is-active"></span>
				<span></span>
				<span></span>
				<span></span>
				<span></span>
				<span></span>
			</div>
		</div>
		<div class="creator-process-copy">
			<article class="creator-process-step is-active" data-process-step="0">
				<span>01</span>
				<h3>Create your Garna account</h3>
				<p>Register in Garna and complete verification. KYC usually takes 1-2 business days</p>
			</article>
			<article class="creator-process-step" data-process-step="1">
				<span>02</span>
				<h3>Tell us your platform</h3>
				<p>Contact your payout manager and tell us where you receive income</p>
			</article>
			<article class="creator-process-step" data-process-step="2">
				<span>03</span>
				<h3>Get setup instructions</h3>
				<p>We will check the available payout method and provide the correct Garna details or next steps</p>
			</article>
			<article class="creator-process-step" data-process-step="3">
				<span>04</span>
				<h3>Request payout on the platform</h3>
				<p>Add the provided details where supported and request a withdrawal from your platform</p>
			</article>
			<article class="creator-process-step" data-process-step="4">
				<span>05</span>
				<h3>Create an invoice in Garna</h3>
				<p>Create an invoice and attach the required confirmation, such as a payout screenshot or platform document</p>
			</article>
			<article class="creator-process-step" data-process-step="5">
				<span>06</span>
				<h3>Receive and withdraw funds</h3>
				<p>Garna matches the payment with your invoice, credits your balance, and you withdraw using your preferred available method</p>
			</article>
		</div>
	</Section>
	<Section
		title={{ text: 'Reduced fee for\nEarly Access creators' }}
		description={{ text: "We're opening creator payouts in Early Access and manually helping selected users configure their first platform setups" }}
		headerClass="mb-10 max-w-4xl"
		titleClass="creator-fee-title mx-auto max-w-4xl lg:text-5xl"
		descriptionClass="mx-auto max-w-3xl"
		contentClass="creator-fee-layout"
		action={{
			label: { text: 'Contact Payout Manager' },
			href: 'https://t.me/likelyiam',
			variant: 'primary',
			icon: 'arrow-up-right',
			effect: 'none',
		}}
	>
		<div class="creator-fee-comparison">
			<div class="creator-fee-rate creator-fee-rate-standard" data-card-glow="true" data-interactive="true">
				<span>Standard fee</span>
				<div class="creator-fee-copy">
					<p class="creator-fee-caption">
						The regular Garna service fee applies after Early Access or for creator payout setups outside the selected launch group.
					</p>
				</div>
				<strong>5.5%</strong>
			</div>
			<div class="creator-fee-rate creator-fee-rate-access" data-card-glow="true" data-interactive="true">
				<span>Early Access fee</span>
				<div class="creator-fee-copy">
					<p class="creator-fee-caption">
						Early Access creators can receive a reduced 1.5% Garna service fee for their first payouts while we help validate and fine-tune the setup flow.
					</p>
					<p class="creator-fee-disclaimer">
						The percentages above refer only to Garna's service fee. Platform withdrawal fees, payment method charges, FX costs or other third-party fees may vary and are not included.
					</p>
				</div>
				<strong>1.5%</strong>
			</div>
		</div>
	</Section>
	<Section
		title={{ text: 'Popular platforms\nwe can help with' }}
		description={{ text: "We're starting with popular creator platforms, stock marketplaces and digital product services. Some platforms can be configured directly, while others may require manual guidance from Garna or the platform's own support team" }}
		headerClass="mb-14 max-w-4xl"
		titleClass="creator-platforms-title mx-auto max-w-4xl lg:text-5xl"
		contentClass="creator-platforms-block"
	>
		<div class="creator-platform-showcase" data-random-platform-logos aria-label="Popular platforms">
			<span class="creator-platform-logo" aria-label="Shutterstock and Upwork">
				<img src="/images/shutterstock-logo.svg" alt="" loading="lazy" />
				<img class="creator-platform-logo-alt creator-platform-logo-accent" src="/images/upwork-logo.svg" alt="" loading="lazy" />
			</span>
			<span class="creator-platform-logo" aria-label="Adobe Stock and iStock">
				<img src="/images/adobe-stock-logo-white.png" alt="" loading="lazy" />
				<img class="creator-platform-logo-alt" src="/images/istock-logo.svg" alt="" loading="lazy" />
			</span>
			<span class="creator-platform-logo" aria-label="Magnific and ArtStation">
				<img class="creator-platform-logo-accent" src="/images/magnific-logo.svg" alt="" loading="lazy" />
				<img class="creator-platform-logo-alt" src="/images/artstation-logo.svg" alt="" loading="lazy" />
			</span>
			<span class="creator-platform-logo" aria-label="Canva and Buy Me a Coffee">
				<img class="creator-platform-logo-compact" src="/images/canva-logo.svg" alt="" loading="lazy" />
				<img class="creator-platform-logo-alt creator-platform-logo-wide" src="/images/buy-me-a-coffee-logo.svg" alt="" loading="lazy" />
			</span>
			<span class="creator-platform-logo" aria-label="Envato and Creative Fabrica">
				<img src="/images/envato-logo.svg" alt="" loading="lazy" />
				<img class="creator-platform-logo-alt creator-platform-logo-accent" src="/images/creative-fabrica-logo.png" alt="" loading="lazy" />
			</span>
