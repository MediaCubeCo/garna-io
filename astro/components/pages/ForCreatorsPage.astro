		border-radius: 999px;
		background: var(--creator-platform-surface-soft);
		padding: 0 12px 0 16px;
	}

	.creator-platform-search span,
	.creator-platform-search strong {
		font-family: Manrope, sans-serif;
		font-size: 12px;
		line-height: 1;
	}

	.creator-platform-search span {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		color: #111827;
		font-weight: 700;
		white-space: nowrap;
	}

	.creator-platform-search-filter svg {
		width: 13px;
		height: 13px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0.86;
	}

	.creator-platform-search strong {
		overflow: hidden;
		color: var(--creator-platform-text);
		font-weight: 560;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.creator-platform-search i {
		display: block;
		width: 1px;
		height: 24px;
		background: #d7d2cc;
	}

	.creator-platform-search-icon {
		width: 19px;
		height: 19px;
		color: var(--creator-platform-text);
		fill: none;
		stroke: currentColor;
		stroke-width: 2.1;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.creator-platform-browser-bar button {
		display: inline-block;
		width: max-content;
		max-width: 100%;
		min-width: max-content;
		border: 1px solid transparent;
		border-radius: 10px;
		background: var(--creator-platform-accent);
		padding: 12px 20px;
		color: #10210c;
		font-family: Manrope, sans-serif;
		font-size: 13px;
		font-weight: 850;
		line-height: 1.18;
		white-space: nowrap;
	}

	.creator-payout-window--platform button:focus,
	.creator-payout-window--platform button:focus-visible {
		outline: none;
	}

	.creator-platform-avatar {
		display: inline-grid;
		width: 32px;
		height: 32px;
		place-items: center;
		overflow: hidden;
		border-radius: 999px;
		border: 1px solid #d7d2cc;
		background: transparent;
		box-shadow: none;
		transform-origin: center;
	}

	.creator-payout-window--platform.is-platform-flow .creator-platform-avatar {
		animation: creator-platform-avatar-cursor-hover 10500ms ease-in-out both;
	}

	.creator-platform-avatar img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 46% 45%;
		border-radius: inherit;
	}

	.creator-platform-content {
		position: relative;
		display: grid;
		min-height: 0;
		flex: 1 1 auto;
	}

	.creator-platform-marketplace {
		grid-area: 1 / 1;
		display: grid;
		min-height: 0;
		gap: 16px;
		overflow: hidden;
		border: 0;
		border-radius: 0;
		background: transparent;
		padding: 0;
		animation: creator-platform-marketplace-view 10500ms ease-in-out both;
	}

	.creator-platform-finance {
		grid-area: 1 / 1;
		display: grid;
		min-height: 0;
		grid-template-rows: auto auto minmax(0, 1fr) auto;
		gap: 12px;
		overflow: hidden;
		border: 0;
		border-radius: 0;
		background: transparent;
		padding: 0;
		opacity: 0;
		pointer-events: none;
		transform: translateY(10px) scale(0.985);
		animation: creator-platform-finance-view 10500ms ease-in-out both;
	}

	.creator-payout-window--platform.is-platform-flow .creator-platform-live-cursor {
		display: flex;
		animation: creator-platform-cursor-path 10500ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.creator-payout-window--platform.is-platform-flow .creator-platform-live-cursor::before {
		animation: creator-platform-cursor-pulse 10500ms ease-in-out both;
	}

	.creator-payout-window--platform.is-platform-flow .creator-platform-live-cursor svg {
		animation: creator-platform-cursor-click 10500ms ease-in-out both;
	}

	.creator-platform-finance-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 2px;
	}

	.creator-platform-finance-head div {
		display: grid;
		gap: 5px;
	}

	.creator-platform-finance-head span {
		color: var(--creator-platform-subtle);
		font-family: "Geist Mono", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.creator-platform-finance-head strong {
		color: var(--creator-platform-text);
		font-family: Manrope, sans-serif;
		font-size: clamp(22px, 2vw, 28px);
		font-weight: 820;
		line-height: 1.12;
		letter-spacing: -0.04em;
		padding-bottom: 2px;
	}

	.creator-platform-finance-head b {
		display: inline-flex;
		width: max-content;
		max-width: none;
		min-width: max-content;
		align-items: center;
		justify-content: center;
		border: 1px solid #d7d2cc;
		border-radius: 999px;
		background: var(--creator-platform-surface-soft);
		padding: 8px 12px;
		color: var(--creator-platform-muted);
		font-family: Manrope, sans-serif;
		font-size: 11px;
		font-weight: 850;
		line-height: 1;
		overflow: visible;
		text-overflow: clip;
		white-space: nowrap;
	}

	.creator-platform-finance-head b[data-translate] {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		line-height: 1;
		padding-bottom: 8px;
	}

	.creator-platform-finance-grid {
		display: grid;
		grid-template-columns: 1.24fr repeat(2, minmax(0, 0.88fr));
		gap: 12px;
	}

	.creator-platform-finance-grid article,
	.creator-platform-finance-table {
		border: 1px solid var(--creator-platform-line);
		border-radius: 14px;
		background: var(--creator-platform-surface-soft);
	}

	.creator-platform-finance-grid article {
		display: grid;
		gap: 6px;
		padding: 16px;
	}

	.creator-platform-finance-grid span,
	.creator-platform-finance-table small {
		color: var(--creator-platform-subtle);
		font-family: Manrope, sans-serif;
		font-size: 11px;
		font-weight: 700;
		line-height: 1.2;
	}

	.creator-platform-finance-grid strong {
		color: var(--creator-platform-text);
		font-family: Manrope, sans-serif;
		font-size: clamp(19px, 2vw, 28px);
		font-weight: 780;
		line-height: 1;
		letter-spacing: -0.035em;
	}

	.creator-platform-route-brand {
		display: inline-flex;
		align-items: center;
		gap: 9px;
	}

	.creator-platform-route-brand i {
		display: inline-flex;
		width: 30px;
		height: 30px;
		align-items: center;
		justify-content: center;
		border: 1px solid #d7d2cc;
		border-radius: 9px;
		background: #f6f2ee;
	}

	.creator-platform-route-brand i::before {
		content: '';
		display: block;
		width: 13px;
		height: 21px;
		background: var(--creator-platform-accent);
		mask: url('/images/garna-g-mark.svg') center / contain no-repeat;
		-webkit-mask: url('/images/garna-g-mark.svg') center / contain no-repeat;
	}

	.creator-platform-finance-grid small {
		color: var(--creator-platform-subtle);
		font-family: Manrope, sans-serif;
		font-size: 11px;
		font-weight: 650;
	}

	.creator-platform-destination {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: stretch;
		gap: 10px;
		border: 0;
		border-radius: 0;
		background: transparent;
		padding: 0;
	}

	.creator-platform-destination > div:first-child {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 16px;
	}

	.creator-platform-destination > div:first-child span {
		grid-column: 1;
		color: var(--creator-platform-subtle);
		font-family: "Geist Mono", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.creator-platform-destination > div:first-child strong {
		grid-column: 1;
		color: var(--creator-platform-text);
		font-family: Manrope, sans-serif;
		font-size: 16px;
		font-weight: 820;
		line-height: 1.1;
	}

	.creator-platform-destination > div:first-child small {
		grid-column: 2;
		align-self: center;
		color: var(--creator-platform-muted);
		font-family: Manrope, sans-serif;
		font-size: 11px;
		font-weight: 720;
		line-height: 1.2;
		white-space: nowrap;
	}

	.creator-platform-destination-options {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		align-items: center;
		gap: 10px;
	}

	.creator-platform-destination-options button {
		display: grid;
		min-height: 58px;
		min-width: 0;
		grid-template-columns: auto minmax(0, 1fr);
