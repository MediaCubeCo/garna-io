								<path class="creator-wallet-flow-path creator-wallet-flow-destination creator-wallet-flow-destination-one" d="M500 338 V438 Q500 450 488 450 H178 Q166 450 166 462 V516" />
								<path class="creator-wallet-flow-path creator-wallet-flow-destination creator-wallet-flow-destination-two" d="M500 338 V516" />
