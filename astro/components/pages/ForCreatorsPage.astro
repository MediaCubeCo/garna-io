	<script is:inline>
		const creatorProcess = document.querySelector('[data-creator-process]');
		const creatorProcessSteps = Array.from(document.querySelectorAll('[data-process-step]'));
		const creatorProcessVisuals = Array.from(document.querySelectorAll('[data-process-visual]'));
		const creatorProcessProgress = Array.from(document.querySelectorAll('.creator-process-progress span'));
		const creatorProcessFallback = document.querySelector('[data-process-fallback]');
		const creatorAccountFlowSection = document.querySelector('.creator-account-flow-section');
		const creatorBalanceDuration = 5800;
		let creatorBalanceActiveStartedAt = null;
		const creatorWalletVisual = document.querySelector('.creator-wallet-visual');
		const reduceCreatorProcessMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const creatorAccountFlowDesktop = window.matchMedia('(min-width: 1024px)');
		const targetCreatorBalance = 2840;
		const formatCreatorBalance = (value) =>
			new Intl.NumberFormat('en-US', {
				style: 'currency',
				currency: 'USD',
				minimumFractionDigits: 2,
				maximumFractionDigits: 2,
			}).format(value);

		const updateCreatorWalletScale = () => {
			if (!(creatorWalletVisual instanceof HTMLElement)) return;

			if (!window.matchMedia('(max-width: 760px)').matches) {
				creatorWalletVisual.style.removeProperty('--creator-wallet-visual-scale');
				creatorWalletVisual.style.removeProperty('min-height');
				return;
			}

			const visualWidth = Math.max(280, creatorWalletVisual.clientWidth || window.innerWidth);
			const scale = Math.min(1, visualWidth / 760);
			creatorWalletVisual.style.setProperty('--creator-wallet-visual-scale', String(scale));
			creatorWalletVisual.style.minHeight = `${Math.ceil(620 * scale)}px`;
		};

		updateCreatorWalletScale();
		window.addEventListener('resize', updateCreatorWalletScale);

		document.querySelectorAll('[data-creator-payout-demo]').forEach((demoRoot) => {
			if (!(demoRoot instanceof HTMLElement)) return;

			const tabs = Array.from(demoRoot.querySelectorAll('[data-demo-tab]'));
			const screens = Array.from(demoRoot.querySelectorAll('[data-demo-screen]'));
			const tabList = demoRoot.querySelector('.creator-payout-demo-tabs');
			const demoShell = demoRoot.querySelector('.creator-payout-demo');
			const demoDurations = [10500, 7500, 11500];
			const demoTransitionDuration = 920;
			const demoDesignWidth = 980;
			let demoTimer = null;
			let demoTransitionTimer = null;
			let isDemoInView = false;
			let activeIndex = 0;
			const getActiveDemoDuration = () => demoDurations[activeIndex] || demoDurations[0];
			const stopDemoTimer = () => {
				if (demoTimer !== null) {
					window.clearTimeout(demoTimer);
					demoTimer = null;
				}
			};
			const clearScreenTransitionTimer = (screen) => {
				const timer = screen.getAttribute('data-demo-transition-timer');
				if (timer) {
					window.clearTimeout(Number(timer));
					screen.removeAttribute('data-demo-transition-timer');
				}
			};

			const restartProgress = () => {
				if (!(tabList instanceof HTMLElement)) return;
				tabList.classList.remove('is-progress-running');
				void tabList.offsetWidth;
				window.requestAnimationFrame(() => {
					tabList.classList.add('is-progress-running');
				});
			};

			const syncDemoScale = () => {
				if (!(demoShell instanceof HTMLElement)) return;
				const availableWidth = demoRoot.getBoundingClientRect().width;
				const scale = Math.min(1, availableWidth / demoDesignWidth);
				const designHeight = demoShell.offsetHeight || 820;
				demoRoot.style.setProperty('--creator-payout-demo-scale', String(scale));
				demoRoot.style.setProperty('--creator-payout-demo-scaled-height', `${designHeight * scale}px`);
			};

			const scheduleNextDemoScreen = () => {
				stopDemoTimer();
				if (!isDemoInView) return;

				demoTimer = window.setTimeout(() => {
					setActiveDemoScreen(activeIndex + 1);
				}, getActiveDemoDuration());
			};

			const setActiveDemoScreen = (nextIndex) => {
				const previousIndex = activeIndex;
				activeIndex = ((nextIndex % tabs.length) + tabs.length) % tabs.length;
				const upcomingIndex = (activeIndex + 1) % screens.length;
				const isChangingScreen = previousIndex !== activeIndex;
				if (demoTransitionTimer !== null) {
					window.clearTimeout(demoTransitionTimer);
					demoTransitionTimer = null;
				}
				demoRoot.classList.toggle('is-switching-screen', isChangingScreen);
				if (isChangingScreen) {
					demoTransitionTimer = window.setTimeout(() => {
						demoRoot.classList.remove('is-switching-screen');
						demoTransitionTimer = null;
					}, demoTransitionDuration);
				}
				demoRoot.style.setProperty('--creator-payout-active-tab', String(activeIndex));

				if (tabList instanceof HTMLElement) {
					tabList.style.setProperty('--creator-payout-active-tab', String(activeIndex));
					tabList.style.setProperty('--demo-progress-duration', `${getActiveDemoDuration()}ms`);
				}

				tabs.forEach((tab, index) => {
					const isActive = index === activeIndex;
					tab.classList.toggle('is-active', isActive);
					tab.setAttribute('aria-selected', String(isActive));
				});

				screens.forEach((screen, index) => {
					const screenIndex = Number(screen.getAttribute('data-demo-screen'));
					const isActive = screenIndex === activeIndex;
					const isNext = screenIndex === upcomingIndex && screens.length > 1;
					const wasActive = screen.classList.contains('is-active');
					clearScreenTransitionTimer(screen);
					if (isActive) {
						screen.removeAttribute('hidden');
						screen.classList.remove('is-leaving', 'is-next');
						screen.classList.add('is-active');
						if (isChangingScreen) {
							screen.classList.add('is-entering');
							const enterTimer = window.setTimeout(() => {
								screen.classList.remove('is-entering');
								screen.removeAttribute('data-demo-transition-timer');
							}, demoTransitionDuration);
							screen.setAttribute('data-demo-transition-timer', String(enterTimer));
						} else {
							screen.classList.remove('is-entering');
						}
					} else if (wasActive && isChangingScreen) {
						screen.removeAttribute('hidden');
						screen.classList.remove('is-active', 'is-entering', 'is-next');
						screen.classList.add('is-leaving');
						const leaveTimer = window.setTimeout(() => {
							screen.classList.remove('is-leaving');
							screen.setAttribute('hidden', '');
							screen.removeAttribute('data-demo-transition-timer');
						}, demoTransitionDuration);
						screen.setAttribute('data-demo-transition-timer', String(leaveTimer));
					} else if (isNext) {
						screen.removeAttribute('hidden');
						screen.classList.remove('is-active', 'is-entering', 'is-leaving');
						screen.classList.add('is-next');
					} else {
						screen.classList.remove('is-active', 'is-entering', 'is-leaving', 'is-next');
						screen.setAttribute('hidden', '');
					}
				});

				restartProgress();
				scheduleNextDemoScreen();
			};

			const pauseDemoProgress = () => {
				if (!(tabList instanceof HTMLElement)) return;
				tabList.classList.remove('is-progress-running');
			};

			const startDemoSequence = () => {
				if (isDemoInView) return;
				isDemoInView = true;
				setActiveDemoScreen(0);
			};

			const stopDemoSequence = () => {
				if (!isDemoInView) return;
				isDemoInView = false;
				stopDemoTimer();
				pauseDemoProgress();
			};

			tabs.forEach((tab, index) => {
				tab.addEventListener('click', () => {
					isDemoInView = true;
					setActiveDemoScreen(index);
				});
			});

			syncDemoScale();
			const demoResizeObserver = 'ResizeObserver' in window ? new ResizeObserver(syncDemoScale) : null;
			demoResizeObserver?.observe(demoRoot);
			window.addEventListener('resize', syncDemoScale);
			setActiveDemoScreen(0);
			stopDemoSequence();

			const demoVisibilityObserver = 'IntersectionObserver' in window
				? new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (entry.target !== demoRoot) return;
						if (entry.isIntersecting) {
							startDemoSequence();
						} else {
							stopDemoSequence();
						}
					});
				}, { rootMargin: '0px 0px -12% 0px', threshold: 0.08 })
				: null;
			if (demoVisibilityObserver) {
				demoVisibilityObserver.observe(demoRoot);
			} else {
				startDemoSequence();
			}

			window.addEventListener('garna:page-will-unmount', () => {
				stopDemoTimer();
				if (demoTransitionTimer !== null) {
					window.clearTimeout(demoTransitionTimer);
				}
				demoVisibilityObserver?.disconnect();
				demoResizeObserver?.disconnect();
				window.removeEventListener('resize', syncDemoScale);
			}, { once: true });
		});

		if (creatorAccountFlowSection instanceof HTMLElement) {
			let creatorAccountFlowFrame = null;
			const clampAccountFlowProgress = (value) => Math.min(1, Math.max(0, value));
			const easeAccountFlowProgress = (value) => {
				const progress = clampAccountFlowProgress(value);
				return progress * progress * (3 - progress * 2);
			};
			const syncCreatorAccountFlowHeight = () => {
				const container = creatorAccountFlowSection.querySelector('.creator-account-flow-container');
				const grid = creatorAccountFlowSection.querySelector('.creator-account-flow-grid');
				const cards = creatorAccountFlowSection.querySelectorAll('.creator-account-stack-card');
				const firstCard = cards[0];

				if (!(container instanceof HTMLElement) || !(grid instanceof HTMLElement) || !(firstCard instanceof HTMLElement)) {
					return { container, grid, animationDistance: 1, holdDistance: 0 };
				}

				if (!creatorAccountFlowDesktop.matches) {
					container.style.removeProperty('--creator-account-flow-height');
					creatorAccountFlowSection.style.removeProperty('--creator-account-stack-bottom-space');
					return { container, grid, animationDistance: 1, holdDistance: 0 };
				}

				const styles = window.getComputedStyle(creatorAccountFlowSection);
				const gap = Number.parseFloat(styles.getPropertyValue('--creator-account-card-gap')) || 18;
				const peek = Number.parseFloat(styles.getPropertyValue('--creator-account-card-peek')) || 76;
				const cardHeight = firstCard.offsetHeight;
				creatorAccountFlowSection.style.setProperty(
					'--creator-account-stack-bottom-space',
					`${Math.round(peek * 2)}px`
				);
				const gridHeight = grid.offsetHeight;
				const animationDistance = Math.max(560, Math.round((cardHeight + gap) * 2.65));
				container.style.setProperty(
					'--creator-account-flow-height',
					`${Math.round(gridHeight + animationDistance)}px`
				);

				return { container, grid, animationDistance, holdDistance: 0 };
			};
			const setCreatorAccountCardOffsets = (stepTwo, stepThree, collapseProgress = 0) => {
				const cards = creatorAccountFlowSection.querySelectorAll('.creator-account-stack-card');
				const firstCard = cards[0];
				const styles = window.getComputedStyle(creatorAccountFlowSection);
				const cardHeight = firstCard instanceof HTMLElement ? firstCard.offsetHeight : 0;
				const gap = Number.parseFloat(styles.getPropertyValue('--creator-account-card-gap')) || 18;
				const peek = Number.parseFloat(styles.getPropertyValue('--creator-account-card-peek')) || 76;
				const secondStart = cardHeight + gap;
				const thirdStart = (cardHeight + gap) * 2;
				const secondPeekY = peek;
				const thirdPeekY = peek * 2;
				const clampedCollapse = clampAccountFlowProgress(collapseProgress);
				const secondStackY = secondStart + (secondPeekY - secondStart) * stepTwo;
				const thirdStackY = thirdStart + (thirdPeekY - thirdStart) * stepThree;
				const secondY = secondStackY + (0 - secondStackY) * clampedCollapse;
				const thirdY = thirdStackY + (0 - thirdStackY) * clampedCollapse;

				creatorAccountFlowSection.style.setProperty('--creator-account-step-two', stepTwo.toFixed(4));
				creatorAccountFlowSection.style.setProperty('--creator-account-step-three', stepThree.toFixed(4));
				creatorAccountFlowSection.style.setProperty('--creator-account-collapse', clampedCollapse.toFixed(4));
				creatorAccountFlowSection.style.setProperty('--creator-account-card-two-y', `${secondY.toFixed(2)}px`);
				creatorAccountFlowSection.style.setProperty('--creator-account-card-three-y', `${thirdY.toFixed(2)}px`);
			};

			const updateCreatorAccountFlow = () => {
				creatorAccountFlowFrame = null;

				if (!creatorAccountFlowDesktop.matches) {
					syncCreatorAccountFlowHeight();
					creatorAccountFlowSection.style.removeProperty('--creator-account-step-two');
					creatorAccountFlowSection.style.removeProperty('--creator-account-step-three');
					creatorAccountFlowSection.style.removeProperty('--creator-account-collapse');
					creatorAccountFlowSection.style.removeProperty('--creator-account-card-two-y');
					creatorAccountFlowSection.style.removeProperty('--creator-account-card-three-y');
					return;
				}

				if (reduceCreatorProcessMotion.matches) {
					syncCreatorAccountFlowHeight();
					setCreatorAccountCardOffsets(1, 1, 0);
					return;
				}

				const { container, grid, animationDistance } = syncCreatorAccountFlowHeight();
				if (!(container instanceof HTMLElement) || !(grid instanceof HTMLElement)) return;

				const rect = container.getBoundingClientRect();
				const styles = window.getComputedStyle(creatorAccountFlowSection);
				const stickyOffset = Number.parseFloat(styles.getPropertyValue('--creator-account-stack-top')) || 112;
				const gridHeight = Math.max(1, grid.offsetHeight);
				const stickyReleaseDistance = Math.max(1, container.offsetHeight - gridHeight);
				const animationScrollDistance = Math.max(1, Math.min(animationDistance, stickyReleaseDistance));
				const progress = clampAccountFlowProgress((stickyOffset - rect.top) / animationScrollDistance);
				const cards = creatorAccountFlowSection.querySelectorAll('.creator-account-stack-card');
				const firstCard = cards[0];
				const cardHeight = firstCard instanceof HTMLElement ? firstCard.offsetHeight : 0;
				const gap = Number.parseFloat(styles.getPropertyValue('--creator-account-card-gap')) || 18;
				const peek = Number.parseFloat(styles.getPropertyValue('--creator-account-card-peek')) || 76;
				const secondTravel = Math.max(1, cardHeight + gap - peek);
				const thirdTravel = Math.max(1, (cardHeight + gap) * 2 - peek * 2);
				const cardMotionDuration = 0.26;
				const stepTwoStart = 0.12;
				const stepThreeStart = stepTwoStart + cardMotionDuration - 0.1;
				const stepThreeDuration = Math.max(0.1, 1 - stepThreeStart);
				const stepTwo = easeAccountFlowProgress((progress - stepTwoStart) / cardMotionDuration);
				const stepThree = easeAccountFlowProgress((progress - stepThreeStart) / stepThreeDuration);
				const collapseProgress = 0;

				setCreatorAccountCardOffsets(stepTwo, stepThree, collapseProgress);
			};

			const requestCreatorAccountFlowUpdate = () => {
				if (creatorAccountFlowFrame !== null) return;
				creatorAccountFlowFrame = window.requestAnimationFrame(updateCreatorAccountFlow);
			};

			updateCreatorAccountFlow();
			window.addEventListener('scroll', requestCreatorAccountFlowUpdate, { passive: true });
			window.addEventListener('resize', requestCreatorAccountFlowUpdate);
			creatorAccountFlowDesktop.addEventListener('change', requestCreatorAccountFlowUpdate);
			reduceCreatorProcessMotion.addEventListener('change', requestCreatorAccountFlowUpdate);
		}

		if (creatorProcess && creatorProcessSteps.length && creatorProcessVisuals.length) {
			const creatorProcessScroll = creatorProcess.closest('.creator-process-scroll');
			let creatorProcessFrame = null;
			let creatorProcessCurrentIndex = -1;

			const setCreatorProcessStep = (index, stepProgress = 1) => {
				if (index !== creatorProcessCurrentIndex) {
					creatorBalanceActiveStartedAt = index === 5 ? performance.now() : null;
					creatorProcessCurrentIndex = index;
				}

				const clampedStepProgress = Math.min(1, Math.max(0, stepProgress));
				const progressTrack = creatorProcessProgress[0]?.parentElement;
				if (progressTrack instanceof HTMLElement) {
					progressTrack.style.setProperty('--creator-process-step-progress', `${clampedStepProgress * 100}%`);
				}

				creatorProcessSteps.forEach((step) => {
					step.classList.toggle('is-active', step.getAttribute('data-process-step') === String(index));
				});
				creatorProcessVisuals.forEach((visual, visualIndex) => {
					const isActiveVisual = visual.getAttribute('data-process-visual') === String(index);
					const stackDistance = (visualIndex - index + creatorProcessVisuals.length) % creatorProcessVisuals.length;

					visual.classList.toggle('is-active', isActiveVisual);
					visual.classList.toggle('is-stack-one', !isActiveVisual && stackDistance === 1);
					visual.classList.toggle('is-stack-two', !isActiveVisual && stackDistance === 2);
					visual.classList.toggle('is-stack-three', !isActiveVisual && stackDistance === 3);
					visual.classList.toggle('is-stack-four', !isActiveVisual && stackDistance === 4);
					visual.classList.toggle('is-stack-five', !isActiveVisual && stackDistance === 5);
				});
				creatorProcessProgress.forEach((dot, dotIndex) => {
					dot.classList.toggle('is-active', dotIndex === index);
				});
			};

			const updateCreatorProcessStep = () => {
				creatorProcessFrame = null;
				if (!creatorProcessScroll) return;

				const rect = creatorProcessScroll.getBoundingClientRect();
				const scrollDistance = Math.max(1, rect.height - window.innerHeight);
				const processStyles = window.getComputedStyle(creatorProcessScroll);
				const cssStickyOffset = Number.parseFloat(processStyles.getPropertyValue('--creator-process-top-offset'));
				const computedStickyTop =
					creatorProcess instanceof HTMLElement
						? Number.parseFloat(window.getComputedStyle(creatorProcess).top)
						: Number.NaN;
				const stickyOffset =
					window.innerWidth > 980
						? Number.isFinite(computedStickyTop)
							? computedStickyTop
							: Number.isFinite(cssStickyOffset)
								? cssStickyOffset
								: 0
						: 0;
				const progress = Math.min(1, Math.max(0, (stickyOffset - rect.top) / scrollDistance));
				const rawStepProgress = progress * creatorProcessSteps.length;
				const index = Math.min(creatorProcessSteps.length - 1, Math.floor(rawStepProgress));
				const stepProgress = Math.min(1, rawStepProgress - index);

				setCreatorProcessStep(index, stepProgress);
			};

			const requestCreatorProcessUpdate = () => {
				if (creatorProcessFrame !== null) return;
				creatorProcessFrame = window.requestAnimationFrame(updateCreatorProcessStep);
			};

			updateCreatorProcessStep();
			window.addEventListener('scroll', requestCreatorProcessUpdate, { passive: true });
			window.addEventListener('resize', requestCreatorProcessUpdate);
		}

		if (creatorProcessFallback && creatorProcessSteps.length && creatorProcessVisuals.length) {
			creatorProcessSteps.forEach((step, index) => {
				const visual = creatorProcessVisuals[index];
				const visualContent = visual?.firstElementChild?.cloneNode(true);
				const stepContent = step.cloneNode(true);
				const fallbackItem = document.createElement('article');
				const visualShell = document.createElement('div');

				fallbackItem.className = 'creator-process-fallback-item';
				visualShell.className = 'creator-process-fallback-visual';
				visualShell.setAttribute('data-process-fallback-visual', String(index));
				stepContent.className = 'creator-process-fallback-copy';
				stepContent.removeAttribute('data-process-step');

				if (visualContent) {
					visualShell.appendChild(visualContent);
				}

				fallbackItem.append(visualShell, stepContent);
				creatorProcessFallback.appendChild(fallbackItem);
			});

			const animateCreatorFallbackBalance = (visual) => {
				if (!(visual instanceof HTMLElement) || visual.dataset.creatorBalanceAnimated === 'true') return;

				const counter = visual.querySelector('[data-process-balance-counter]');
				const bar = visual.querySelector('.creator-balance-bar');
				if (!(counter instanceof HTMLElement)) return;

				visual.dataset.creatorBalanceAnimated = 'true';
				if (reduceCreatorProcessMotion.matches) {
					counter.textContent = formatCreatorBalance(targetCreatorBalance);
					if (bar instanceof HTMLElement) {
						bar.style.setProperty('--creator-balance-progress', '1');
					}
					return;
				}

				let startedAt = null;
				const delay = 720;
				const duration = 1300;
				const animate = (timestamp) => {
					startedAt ??= timestamp;
					const elapsed = Math.max(0, timestamp - startedAt - delay);
					const rawProgress = Math.min(1, elapsed / duration);
					const easedProgress = 1 - Math.pow(1 - rawProgress, 3);
					counter.textContent = formatCreatorBalance(targetCreatorBalance * easedProgress);
					if (bar instanceof HTMLElement) {
						bar.style.setProperty('--creator-balance-progress', String(easedProgress));
					}
					if (rawProgress < 1) {
						window.requestAnimationFrame(animate);
					}
				};

				counter.textContent = formatCreatorBalance(0);
				if (bar instanceof HTMLElement) {
					bar.style.setProperty('--creator-balance-progress', '0');
				}
				window.requestAnimationFrame(animate);
			};

			const activateCreatorFallbackVisual = (visual) => {
				visual.classList.add('is-active');
				animateCreatorFallbackBalance(visual);
			};

			const creatorFallbackVisuals = Array.from(
				creatorProcessFallback.querySelectorAll('.creator-process-fallback-visual'),
			);

			if (reduceCreatorProcessMotion.matches || !('IntersectionObserver' in window)) {
				creatorFallbackVisuals.forEach(activateCreatorFallbackVisual);
			} else {
				const creatorFallbackObserver = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							activateCreatorFallbackVisual(entry.target);
							creatorFallbackObserver.unobserve(entry.target);
						});
					},
					{ threshold: 0.28, rootMargin: '0px 0px -12% 0px' },
				);

				creatorFallbackVisuals.forEach((visual) => creatorFallbackObserver.observe(visual));
			}
		}

		const creatorBalanceCounter = document.querySelector('[data-process-balance-counter]');
		const creatorBalanceBar = document.querySelector('.creator-balance-bar');

		if (creatorBalanceCounter) {
			if (reduceCreatorProcessMotion.matches) {
				creatorBalanceCounter.textContent = formatCreatorBalance(targetCreatorBalance);
				if (creatorBalanceBar instanceof HTMLElement) {
					creatorBalanceBar.style.setProperty('--creator-balance-progress', '1');
				}
			} else {
				const balanceBarAppearDelay = 0.72;
				const balanceBarFullyVisibleAt = 0.24;
				const fillStart = (balanceBarAppearDelay + creatorBalanceDuration * balanceBarFullyVisibleAt) / creatorBalanceDuration;
				const fillEnd = 0.68;

				const animateCreatorBalance = (timestamp) => {
					const cycle =
						creatorBalanceActiveStartedAt === null
							? 0
							: Math.min(1, (timestamp - creatorBalanceActiveStartedAt) / creatorBalanceDuration);
					const rawProgress = Math.min(1, Math.max(0, (cycle - fillStart) / (fillEnd - fillStart)));
					const easedProgress = 1 - Math.pow(1 - rawProgress, 3);
					creatorBalanceCounter.textContent = formatCreatorBalance(targetCreatorBalance * easedProgress);
					if (creatorBalanceBar instanceof HTMLElement) {
						creatorBalanceBar.style.setProperty('--creator-balance-progress', String(easedProgress));
					}
					window.requestAnimationFrame(animateCreatorBalance);
				};

				window.requestAnimationFrame(animateCreatorBalance);
			}
		}

		const platformLogoRotator = document.querySelector('[data-platform-logo-rotator]');
		const reducePlatformLogoMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		if (platformLogoRotator && !reducePlatformLogoMotion.matches) {
			const platformLogoCells = Array.from(platformLogoRotator.querySelectorAll('.creator-platform-logo'))
				.filter((cell) => cell.querySelector('.creator-platform-logo-alt'));
			const platformLogoLastChangedAt = new WeakMap();
			const platformLogoStartedAt = Date.now();
			let platformLogoTimer = 0;

			const randomBetween = (min, max) => min + Math.random() * (max - min);
			const clamp = (value, min, max) => Math.min(max, Math.max(min, value));

			const currentPlatformLogoEnergy = () => {
				const elapsed = (Date.now() - platformLogoStartedAt) / 1000;
				const slowWave = (Math.sin(elapsed * 0.37) + 1) / 2;
				const mediumWave = (Math.sin(elapsed * 0.91 + 1.7) + 1) / 2;
				const flicker = Math.random() ** 1.7;
				return clamp(0.3 + slowWave * 0.34 + mediumWave * 0.22 + flicker * 0.28, 0, 1);
			};

			const weightedPlatformLogoCell = (blocked = new Set()) => {
				const now = Date.now();
				const weights = platformLogoCells.map((cell) => {
					if (blocked.has(cell)) return 0;
					const lastChangedAt = platformLogoLastChangedAt.get(cell) || 0;
					const age = now - lastChangedAt;
					if (age < 1700) return 0;
					const cellIndex = platformLogoCells.indexOf(cell);
					const ageWeight = clamp(age / 8500, 0.22, 1.8);
					const centerBias = 1 + (1 - Math.abs(cellIndex - (platformLogoCells.length - 1) / 2) / platformLogoCells.length) * 0.28;
					return ageWeight * centerBias * randomBetween(0.72, 1.38);
				});
				const totalWeight = weights.reduce((sum, weight) => sum + weight, 0);
				if (totalWeight <= 0) return null;

				let cursor = Math.random() * totalWeight;
				for (let index = 0; index < weights.length; index += 1) {
					cursor -= weights[index];
					if (cursor <= 0) return platformLogoCells[index];
				}

				return platformLogoCells[platformLogoCells.length - 1];
			};

			const switchPlatformLogoCell = (cell) => {
				const freshTimer = cell.getAttribute('data-platform-logo-fresh-timer');
				if (freshTimer) {
					window.clearTimeout(Number(freshTimer));
				}
				cell.classList.remove('is-logo-fresh');
				cell.classList.toggle('is-alt-visible');
				void cell.offsetWidth;
				cell.classList.add('is-logo-fresh');
				const timer = window.setTimeout(() => {
					cell.classList.remove('is-logo-fresh');
					cell.removeAttribute('data-platform-logo-fresh-timer');
				}, 1700);
				cell.setAttribute('data-platform-logo-fresh-timer', String(timer));
				platformLogoLastChangedAt.set(cell, Date.now());
			};

			const schedulePlatformLogoWave = () => {
				if (platformLogoCells.length < 2) return;

				const energy = currentPlatformLogoEnergy();
				const elapsed = (Date.now() - platformLogoStartedAt) / 1000;
				const startupBoost = clamp(1 - elapsed / 14, 0, 1);
				const pairLogoChance = 0.5 + startupBoost * 0.08;
				const tripleLogoChance = 0.035 + energy * 0.025;
				const waveRoll = Math.random();
				const waveSize =
					waveRoll < tripleLogoChance
						? Math.min(3, platformLogoCells.length)
						: waveRoll < tripleLogoChance + pairLogoChance
							? Math.min(2, platformLogoCells.length)
							: 1;
				const blocked = new Set();

				for (let index = 0; index < waveSize; index += 1) {
					const cell = weightedPlatformLogoCell(blocked);
					if (!cell) continue;
					blocked.add(cell);
					const waveDelay = index === 0 ? 0 : index * randomBetween(220, 420) + randomBetween(0, 140);
					window.setTimeout(() => switchPlatformLogoCell(cell), Math.round(waveDelay));
				}

				const calmGap = randomBetween(620, 1350);
				const quickGap = randomBetween(380, 760);
				const breathingPause = Math.random() < 0.08 ? randomBetween(650, 1150) : 0;
				const startupGapPull = startupBoost * randomBetween(90, 240);
				const nextDelay = Math.round(Math.max(320, (Math.random() < energy * 0.45 ? quickGap : calmGap) - startupGapPull + breathingPause));
				platformLogoTimer = window.setTimeout(schedulePlatformLogoWave, nextDelay);
			};

			platformLogoTimer = window.setTimeout(schedulePlatformLogoWave, randomBetween(220, 520));
			window.addEventListener('garna:page-will-unmount', () => window.clearTimeout(platformLogoTimer), { once: true });
		}

		document.addEventListener('click', (event) => {
			const link = event.target instanceof Element ? event.target.closest('a') : null;
			if (!link || link.getAttribute('href') !== '#') return;
			if (!link.textContent || !link.textContent.toLowerCase().includes('book a demo')) return;

			event.preventDefault();
			if (window.GarnaWidget) {
				window.GarnaWidget.open({ trackingCta: 'for_creators_demo' });
			}
		});
	</script>
	<Fragment slot="widgets">
		<PayrollSolutionInteractions />
		<GarnaBookingWidget
			trackingSource="for-creators"
			trackingPage="for-creators"
			titleFallback="Start your journey with Garna"
			subtitleFallback="Fill in your details to book a demo"
		/>
	</Fragment>
</BaseLayout>

