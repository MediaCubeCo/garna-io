		display: inline-flex;
		width: 42px;
		height: 42px;
		align-items: center;
		justify-content: center;
		border: 1px solid rgba(203, 243, 0, 0.22);
		border-radius: 12px;
		background: rgba(203, 243, 0, 0.1);
		color: #CBF300;
		font-family: Manrope, sans-serif;
		font-size: 12px;
		font-weight: 700;
	}

	.creator-manager-route > div > div {
		min-width: 0;
