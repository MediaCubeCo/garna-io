	.creator-manager-dialog-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
	}

	.creator-manager-dialog-head span,
	.creator-manager-steps span {
		color: #9ca3af;
		font-family: Manrope, sans-serif;
		font-size: 12px;
		line-height: 1.35;
	}

	.creator-manager-dialog-head strong {
		color: #CBF300;
		font-family: Manrope, sans-serif;
		font-size: 12px;
		font-weight: 700;
	}

	.creator-manager-dialog p {
		margin: 0;
		width: fit-content;
		max-width: min(100%, 420px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 14px;
		background: rgba(255, 255, 255, 0.045);
		color: #ffffff;
		font-family: Manrope, sans-serif;
		font-size: 13px;
		line-height: 1.35;
		padding: 10px 12px;
