	.creator-manager-steps span {
		display: block;
		margin-bottom: 10px;
		color: #CBF300;
		font-size: 11px;
		font-weight: 700;
	}

	@media (max-width: 640px) {
		.creator-manager-route > div:not(.creator-manager-arrow) {
			grid-template-columns: 42px minmax(0, 1fr);
		}

		.creator-manager-route small {
			grid-column: 2;
			width: fit-content;
		}

		.creator-manager-steps {
			grid-template-columns: 1fr;
		}
