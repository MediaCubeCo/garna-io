		background: rgba(203, 243, 0, 0.06);
		color: #d9ff73;
		font-family: Manrope, sans-serif;
		font-size: 11px;
		font-weight: 700;
		line-height: 1;
		padding: 8px 10px;
		white-space: nowrap;
