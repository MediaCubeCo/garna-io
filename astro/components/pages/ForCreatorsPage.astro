	.creator-progress::after {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: -35%;
		width: 32%;
		border-radius: inherit;
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.82), transparent);
		filter: blur(0.5px);
		animation: creator-progress-sweep 1.65s ease-in-out infinite;
