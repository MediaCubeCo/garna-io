								</circle>
								<circle class="creator-wallet-simple-dot creator-wallet-flow-dot-two" r="5">
									<animateMotion dur="15s" repeatCount="indefinite" path="M500 102 V282" keyPoints="0;0;1;1" keyTimes="0;0.36;0.48;1" calcMode="linear" />
								</circle>
								<circle class="creator-wallet-simple-dot creator-wallet-flow-dot-three" r="5">
									<animateMotion dur="15s" repeatCount="indefinite" path="M834 102 V160 Q834 172 822 172 H512 Q500 172 500 184 V282" keyPoints="0;0;1;1" keyTimes="0;0.69;0.81;1" calcMode="linear" />
								</circle>
								<circle class="creator-wallet-simple-dot creator-wallet-flow-dot-six" r="5">
									<animateMotion dur="15s" repeatCount="indefinite" path="M500 338 V432 Q500 444 488 444 H178 Q166 444 166 456 V516" keyPoints="0;0;1;1" keyTimes="0;0.83;0.95;1" calcMode="linear" />
								</circle>
								<circle class="creator-wallet-simple-dot creator-wallet-flow-dot-five" r="5">
									<animateMotion dur="15s" repeatCount="indefinite" path="M500 338 V516" keyPoints="0;0;1;1" keyTimes="0;0.50;0.62;1" calcMode="linear" />
								</circle>
								<circle class="creator-wallet-simple-dot creator-wallet-flow-dot-four" r="5">
									<animateMotion dur="15s" repeatCount="indefinite" path="M500 338 V432 Q500 444 512 444 H822 Q834 444 834 456 V516" keyPoints="0;0;1;1" keyTimes="0;0.17;0.29;1" calcMode="linear" />
								</circle>
							</svg>
						</div>
						<div class="creator-wallet-balance-card" aria-label="Garna balance receives creator payout">
							<div class="creator-wallet-balance-head">
								<img src="/garna_logo.svg" alt="Garna" loading="lazy" />
								<span data-translate="heroVisual.balance.label">Creator balance</span>
							</div>
							<strong class="creator-wallet-simple-amount" aria-label="$2,840.00 credited to Garna balance">
								<span>$0.00</span>
								<span>$2,840.00</span>
								<span>$420.00</span>
								<span>$310.00</span>
							</strong>
							<div class="creator-wallet-card-strip">
								<span data-translate="heroVisual.balance.account">Account</span>
								<b>4461 **** **** 9821</b>
							</div>
						</div>

						<div class="creator-wallet-destination-stack">
							<div class="creator-wallet-destination-card creator-wallet-simple-card creator-wallet-destination-one">
								<span data-translate="heroVisual.destinations.bank.label">Bank transfer</span>
								<strong data-translate="heroVisual.destinations.bank.title">Alex Carter USD</strong>
								<small>•••• 9821</small>
							</div>
							<div class="creator-wallet-destination-card creator-wallet-simple-card creator-wallet-destination-two">
								<span data-translate="heroVisual.destinations.card.label">Card payout</span>
								<strong data-translate="heroVisual.destinations.card.title">Visa / Mastercard</strong>
								<small data-translate="heroVisual.destinations.card.meta">Card ending 4482</small>
							</div>
							<div class="creator-wallet-destination-card creator-wallet-simple-card creator-wallet-destination-three">
								<span data-translate="heroVisual.destinations.crypto.label">Crypto wallet</span>
								<strong data-translate="heroVisual.destinations.crypto.title">USDT wallet</strong>
								<small data-translate="heroVisual.destinations.crypto.meta">TRC20 • verified</small>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</HeroSection>
	<Section
		title={{ text: 'Built for creators who earn globally', translateKey: 'creatorTypes.title' }}
		description={{ text: 'Garna can help creators, freelancers and digital sellers who receive income from international platforms', translateKey: 'creatorTypes.description' }}
		class="border-y border-[#020202]/0"
		headerClass="mb-14 max-w-5xl lg:mb-16"
		titleClass="mx-auto max-w-4xl lg:text-5xl"
		contentClass="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4"
	>
		<Card
			class="p-6"
			titleClass="text-lg"
			descriptionClass="text-sm"
			title={{ text: 'Designers & illustrators', translateKey: 'creatorTypes.cards.designers.title' }}
			description={{ text: 'For creators selling graphics, templates, fonts, digital assets and visual products', translateKey: 'creatorTypes.cards.designers.description' }}
		>
			<CardIconVisual slot="visual" icon="lucide:palette" />
		</Card>
		<Card
			class="p-6"
			titleClass="text-lg"
			descriptionClass="text-sm"
			title={{ text: 'Photographers & stock contributors', translateKey: 'creatorTypes.cards.photographers.title' }}
			description={{ text: 'For contributors receiving royalties or payouts from stock photo and media platforms', translateKey: 'creatorTypes.cards.photographers.description' }}
		>
			<CardIconVisual slot="visual" icon="lucide:camera" />
		</Card>
		<Card
			class="p-6"
			titleClass="text-lg"
			descriptionClass="text-sm"
			title={{ text: '3D artists & game asset creators', translateKey: 'creatorTypes.cards.gameAssets.title' }}
			description={{ text: 'For creators selling 3D models, plugins, textures, game assets and marketplace products', translateKey: 'creatorTypes.cards.gameAssets.description' }}
		>
			<CardIconVisual slot="visual" icon="lucide:box" />
		</Card>
		<Card
			class="p-6"
			titleClass="text-lg"
			descriptionClass="text-sm"
			title={{ text: 'Freelancers & digital sellers', translateKey: 'creatorTypes.cards.freelancers.title' }}
			description={{ text: 'For people earning from freelance platforms, subscriptions, courses, music, content or digital products', translateKey: 'creatorTypes.cards.freelancers.description' }}
		>
			<CardIconVisual slot="visual" icon="lucide:store" />
		</Card>
	</Section>
	<Section
		layout="split"
		spacing="none"
		width="content"
		class="py-16 lg:py-32"
		splitClass="gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start"
		copyClass="max-w-xl text-left lg:sticky lg:top-28 lg:self-start"
		align="left"
		title={{ text: 'One account for creator payouts', translateKey: 'accountFlow.title' }}
		description={{ text: 'A guided way to connect platform payouts, receive funds to your Garna balance and withdraw using available payout methods', translateKey: 'accountFlow.description' }}
		titleClass="lg:text-5xl"
		descriptionClass="text-lg"
		contentClass="grid gap-4"
	>
		<Card
			variant="compact"
			visualClass="creator-step-number shrink-0"
		>
			<span slot="visual">01</span>
			<div class="creator-step-copy">
				<h3 data-translate="accountFlow.steps.receive.title">Receive platform payouts</h3>
				<p data-translate="accountFlow.steps.receive.description">Use Garna details where supported to receive payments from international creator platforms</p>
			</div>
		</Card>
		<Card
			variant="compact"
			visualClass="creator-step-number shrink-0"
		>
			<span slot="visual">02</span>
			<div class="creator-step-copy">
				<h3 data-translate="accountFlow.steps.setup.title">Get guided setup</h3>
				<p data-translate="accountFlow.steps.setup.description">Tell us which platform you use. We will check the available payout method and guide you through setup</p>
			</div>
		</Card>
		<Card
			variant="compact"
			visualClass="creator-step-number shrink-0"
		>
			<span slot="visual">03</span>
			<div class="creator-step-copy">
				<h3 data-translate="accountFlow.steps.withdraw.title">Withdraw globally</h3>
				<p data-translate="accountFlow.steps.withdraw.description">Withdraw your money using bank transfer, card, PayPal, Payoneer, crypto and other supported options</p>
			</div>
		</Card>
	</Section>
	<Section
		title={{ text: 'From platform payout to your Garna balance', translateKey: 'process.title' }}
		description={{ text: 'The flow is simple, but setup may differ by platform. During Early Access, we guide you through the important details', translateKey: 'process.description' }}
		headerClass="mb-14 max-w-4xl lg:mb-16"
		titleClass="mx-auto max-w-4xl lg:text-5xl"
		contentClass="creator-process-scroll"
	>
		<div class="creator-process-pin" data-creator-process>
			<div class="creator-process-visual-stage" aria-label="Creator payout setup visual">
				<div class="creator-process-visual is-active" data-process-visual="0">
				<div class="creator-mini-window">
					<div class="creator-mini-row"><span data-translate="process.visual.account.profile">Profile</span><strong data-translate="process.visual.account.setup">Setup</strong></div>
					<div class="creator-mini-amount">
						<span data-translate="process.visual.account.statusLabel">Account status</span>
						<strong data-translate="process.visual.account.statusValue">Opening</strong>
					</div>
