	.creator-process-scroll {
		--creator-process-top-offset: 124px;
		--creator-process-bottom-offset: 64px;
		display: grid;
		min-height: 780vh;
		grid-template-columns: minmax(0, 1.06fr) minmax(320px, 0.94fr);
		align-items: start;
		gap: clamp(28px, 5vw, 72px);
	}

	.creator-process-pin {
		position: sticky;
		top: var(--creator-process-top-offset);
		display: grid;
		min-width: 0;
		gap: 0;
	}

	.creator-process-visual-stage {
		--creator-process-card-height: 360px;
		--creator-process-progress-y: calc(50% + 180px + 32px);
		position: relative;
		width: 100%;
		height: calc(100vh - var(--creator-process-top-offset) - var(--creator-process-bottom-offset));
		min-height: 420px;
		overflow: hidden;
		border: 0;
		border-radius: 28px;
		background: transparent;
		box-shadow: none;
	}

	.creator-process-visual-stage::before {
		content: none;
	}

	.creator-process-visual {
		position: absolute;
		inset: 0;
		z-index: 1;
		display: grid;
		place-items: center;
		overflow: hidden;
		padding: clamp(34px, 5vw, 74px);
		opacity: 0.06;
		filter: brightness(0.64) saturate(0.86);
		transform: translateY(-70px) scale(0.84);
		transform-origin: center center;
		transition:
			filter 720ms cubic-bezier(0.22, 1, 0.36, 1),
			transform 720ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.creator-process-visual.is-active {
		z-index: 5;
		opacity: 1;
		filter: none;
		transform: translateY(0) scale(1);
	}

	.creator-process-visual.is-stack-one {
		z-index: 4;
		opacity: 1;
		filter: brightness(0.94) saturate(0.98);
		transform: translateY(-26px) scale(0.92);
	}

	.creator-process-visual.is-stack-two {
		z-index: 3;
		opacity: 1;
		filter: brightness(0.9) saturate(0.96);
		transform: translateY(-50px) scale(0.84);
	}

	.creator-process-visual.is-stack-three {
		z-index: 2;
		opacity: 1;
		filter: brightness(0.86) saturate(0.94);
		transform: translateY(-70px) scale(0.77);
	}

	.creator-process-visual.is-stack-four {
		z-index: 1;
		opacity: 1;
		filter: brightness(0.82) saturate(0.92);
		transform: translateY(-88px) scale(0.71);
	}

	.creator-process-visual.is-stack-five {
		z-index: 0;
		opacity: 1;
		filter: brightness(0.78) saturate(0.9);
		transform: translateY(-104px) scale(0.66);
	}

	.creator-process-visual.is-active .creator-mini-window,
	.creator-process-visual.is-active .creator-chat-card,
	.creator-process-visual.is-active .creator-details-sheet,
	.creator-process-visual.is-active .creator-withdraw-panel,
	.creator-process-visual.is-active .creator-invoice-doc,
	.creator-process-visual.is-active .creator-balance-card {
		background: #0c0c0c;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
	}

	.creator-process-progress {
		--creator-process-step-progress: 0%;
		position: absolute;
		left: 50%;
		top: clamp(22px, var(--creator-process-progress-y), calc(100% - 10px));
		z-index: 6;
		display: flex;
		justify-content: center;
		gap: 8px;
		pointer-events: none;
		transform: translate(-50%, -50%);
	}

	.creator-process-progress span {
		width: 8px;
		height: 8px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.16);
		box-shadow: none;
		transition:
			width 240ms ease,
			background 180ms ease,
			box-shadow 180ms ease;
	}

	.creator-process-progress span.is-active {
		width: 112px;
		background:
			linear-gradient(
				90deg,
				#CBF300 0 var(--creator-process-step-progress),
				rgba(203, 243, 0, 0.18) var(--creator-process-step-progress) 100%
			);
		box-shadow: inset 0 0 0 1px rgba(203, 243, 0, 0.18);
	}

	.creator-process-copy {
		position: sticky;
		top: var(--creator-process-top-offset);
		min-width: 0;
		height: calc(100vh - var(--creator-process-top-offset) - var(--creator-process-bottom-offset));
		min-height: 420px;
	}

	.creator-process-step {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		border: 0;
		padding: clamp(
				104px,
				calc((100vh - var(--creator-process-top-offset) - var(--creator-process-bottom-offset) - 244px) / 2),
				280px
			)
			0 0;
		opacity: 0;
		pointer-events: none;
		transform: none;
		transition: opacity 280ms ease;
	}

	.creator-process-step.is-active {
		opacity: 1;
		pointer-events: auto;
		transform: none;
	}

	.creator-process-step > span {
		display: inline-flex;
		width: fit-content;
		margin-bottom: 22px;
		border: 1px solid rgba(203, 243, 0, 0.16);
		border-radius: 999px;
		background: rgba(203, 243, 0, 0.07);
		padding: 7px 10px;
		color: #CBF300;
		font-family: "Geist Mono", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.creator-process-step h3 {
		margin: 0 0 -0.08em;
		padding-bottom: 0.08em;
		color: #ffffff;
		font-family: Manrope, sans-serif;
		font-size: clamp(2rem, 3.8vw, 3.8rem);
		font-weight: 400;
		line-height: 1.08;
		letter-spacing: 0;
		clip-path: inset(0 100% 0 0);
		filter: blur(8px);
		opacity: 0;
		transform: translateY(12px);
	}

	.creator-process-step.is-active h3 {
		animation: creator-process-title-reveal 560ms cubic-bezier(0.2, 0.8, 0.2, 1) 40ms both;
	}

	.creator-process-step p {
		max-width: 520px;
		margin: 22px 0 0;
		color: #a1a1aa;
		font-family: Manrope, sans-serif;
		font-size: clamp(1rem, 1.4vw, 1.2rem);
		line-height: 1.55;
	}

	.creator-process-fallback {
		display: none;
	}

	.creator-process-fallback-item {
		min-width: 0;
	}

	.creator-process-fallback-visual {
		--creator-process-card-height: 360px;
		min-width: 0;
	}

	.creator-process-fallback-copy {
		min-width: 0;
	}

	.creator-process-fallback-copy > span {
		display: inline-flex;
		width: fit-content;
		margin-bottom: 22px;
		border: 1px solid rgba(203, 243, 0, 0.16);
		border-radius: 999px;
		background: rgba(203, 243, 0, 0.07);
		padding: 7px 10px;
		color: #CBF300;
		font-family: "Geist Mono", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 12px;
		font-weight: 700;
