		color: #101010;
		font-family: Manrope, sans-serif;
		font-size: 20px;
		font-weight: 700;
		box-shadow: 0 0 28px rgba(203, 243, 0, 0.34);
	}

	.creator-manager-dialog {
		display: grid;
		gap: 10px;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 20px;
		background: rgba(0, 0, 0, 0.24);
		padding: 14px;
