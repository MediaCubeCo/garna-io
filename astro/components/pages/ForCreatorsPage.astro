	.creator-manager-chat {
		display: grid;
		gap: 10px;
	}

	.creator-manager-chat p {
		margin: 0;
		width: fit-content;
		max-width: min(100%, 420px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.045);
