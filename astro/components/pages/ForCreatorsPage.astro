		align-content: center;
		align-items: start;
		border: 1px solid #d7d2cc;
		border-radius: 12px;
		background: #ffffff;
		padding: 10px 13px;
		color: var(--creator-platform-muted);
		font-family: Manrope, sans-serif;
		text-align: left;
	}

	.creator-platform-destination-options button span {
		align-self: end;
		min-width: 0;
		overflow: hidden;
		color: var(--creator-platform-text);
		font-size: 15px;
		font-weight: 720;
		line-height: 1;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.creator-platform-destination-options button.is-selected span {
		color: var(--creator-platform-text);
	}

	.creator-payout-window--platform.is-platform-flow .creator-platform-destination-options button.creator-platform-destination-garna span {
		animation: none;
	}

	.creator-platform-destination-options button small {
		grid-column: 2;
		align-self: start;
		color: var(--creator-platform-muted);
		font-size: 11.5px;
		font-weight: 560;
		line-height: 1.05;
		white-space: nowrap;
	}

	.creator-platform-destination-options button i {
		grid-row: 1 / span 2;
		align-self: center;
		display: inline-flex;
		width: 28px;
		height: 28px;
		align-items: center;
		justify-content: center;
		border-radius: 7px;
		background: #f6f2ee;
	}

	.creator-platform-destination-options button.creator-platform-destination-bank i::before {
		content: '';
		display: block;
		width: 19px;
		height: 19px;
		background: #171717;
