	@keyframes creator-process-line-fill {
		0%,
		12% {
			opacity: 0;
			transform: scaleX(0.18);
		}

		34%,
		76% {
			opacity: 1;
			transform: scaleX(1);
		}

		100% {
			opacity: 0;
			transform: scaleX(0.18);
		}
	}

	@keyframes creator-process-row-live {
		0%,
		16% {
			opacity: 0;
			transform: translateY(8px);
		}

		32%,
		78% {
			opacity: 1;
			transform: translateY(0);
		}

		100% {
			opacity: 0;
			transform: translateY(-4px);
		}
	}

	@keyframes creator-process-balance-sequence {
		0%,
		12% {
			opacity: 0;
			transform: translateY(7px);
		}

		24%,
		66% {
			opacity: 1;
			transform: translateY(0);
		}

		78%,
		100% {
			opacity: 0;
			transform: translateY(-4px);
		}
	}

	@keyframes creator-process-status-dot {
		0%,
		28%,
		100% {
			box-shadow: 0 0 0 0 rgba(203, 243, 0, 0);
		}

		46%,
		68% {
			box-shadow: 0 0 0 5px rgba(203, 243, 0, 0.14);
		}
	}

	@keyframes creator-process-chat-message {
		0%,
		12% {
			opacity: 0;
			transform: translateY(10px) scale(0.98);
		}

		25%,
		84% {
			opacity: 1;
			transform: translateY(0) scale(1);
		}

		100% {
			opacity: 0;
			transform: translateY(-4px) scale(0.99);
		}
	}

	@keyframes creator-process-detail-type {
		0%,
		14% {
			clip-path: inset(0 100% 0 0);
			opacity: 0.35;
		}

		38%,
		82% {
			clip-path: inset(0 0 0 0);
			opacity: 1;
		}

		100% {
			clip-path: inset(0 100% 0 0);
			opacity: 0.35;
		}
	}

	@keyframes creator-process-live-highlight {
		0%,
		24%,
		100% {
			border-color: rgba(255, 255, 255, 0.08);
			background-color: rgba(255, 255, 255, 0.045);
		}

		46%,
		68% {
			border-color: rgba(203, 243, 0, 0.28);
			background-color: rgba(203, 243, 0, 0.09);
		}
	}

	@keyframes creator-process-action-press {
		0%,
		38%,
		100% {
			filter: brightness(1);
			transform: translateY(0);
		}

