	.creator-fee-rate {
		--garna-card-glow-x: 50%;
		--garna-card-glow-y: 50%;
		--garna-card-glow-radius: 60vw;
		--garna-card-border-glow-radius: 14rem;
		position: relative;
		isolation: isolate;
		min-height: clamp(380px, 38vw, 500px);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		overflow: hidden;
		border: 1px solid var(--garna-border);
		border-radius: 20px;
		background: rgba(12, 12, 12, 0.72);
		box-shadow: var(--garna-shadow-card);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		padding: clamp(20px, 2.8vw, 34px);
		transition:
			border-color 300ms ease,
			transform 300ms ease;
	}

	.creator-fee-rate::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
		border-radius: inherit;
		background: radial-gradient(
			circle var(--garna-card-glow-radius) at var(--garna-card-glow-x) var(--garna-card-glow-y),
			rgba(255, 255, 255, 0.12) 0%,
			rgba(255, 255, 255, 0.075) 18%,
			rgba(255, 255, 255, 0.035) 40%,
			transparent 70%
		);
		opacity: 0;
		pointer-events: none;
		transition: opacity 300ms ease;
	}

	.creator-fee-rate > * {
		position: relative;
		z-index: 1;
	}

	@supports ((-webkit-mask-composite: xor) or (mask-composite: exclude)) {
		.creator-fee-rate::after {
			content: '';
			position: absolute;
			inset: 0;
			z-index: 2;
			padding: 1px;
			border-radius: inherit;
			background: radial-gradient(
				circle var(--garna-card-border-glow-radius) at var(--garna-card-glow-x) var(--garna-card-glow-y),
				rgba(255, 255, 255, 0.9) 0%,
				rgba(255, 255, 255, 0.52) 24%,
				rgba(255, 255, 255, 0.2) 50%,
				transparent 76%
			);
			opacity: 0;
			pointer-events: none;
			transition: opacity 300ms ease;
			-webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
			-webkit-mask-composite: xor;
			mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
			mask-composite: exclude;
		}
	}

	.creator-fee-rate:is(:hover, :focus-within) {
		border-color: rgba(255, 255, 255, 0.15);
		transform: translateY(-4px);
	}

	@media (hover: hover) and (pointer: fine) {
		.creator-fee-rate:is(:hover, :focus-within)::before {
			opacity: 1;
		}

		@supports ((-webkit-mask-composite: xor) or (mask-composite: exclude)) {
			.creator-fee-rate:is(:hover, :focus-within)::after {
				opacity: 1;
			}
		}
