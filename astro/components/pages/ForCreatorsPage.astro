	.creator-balance-card > strong {
		display: block;
		margin-top: 10px;
		color: #ffffff;
		font-size: 28px;
		letter-spacing: -0.03em;
	}

	.creator-balance-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		margin-bottom: 4px;
	}

	.creator-balance-top em {
		border-radius: 999px;
		background: rgba(203, 243, 0, 0.12);
		padding: 4px 7px;
		color: #CBF300;
		font-family: Manrope, sans-serif;
		font-size: 10px;
		font-style: normal;
		font-weight: 700;
		line-height: 1;
	}

	.creator-balance-bar {
		--creator-balance-progress: 0;
		height: 8px;
		margin-top: 14px;
		overflow: hidden;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.12);
	}

	.creator-balance-bar::before {
		content: '';
		display: block;
		width: 76%;
		height: 100%;
		border-radius: inherit;
		background: #CBF300;
		transform: scaleX(var(--creator-balance-progress));
		transform-origin: left center;
	}

	.creator-platform-row {
		position: relative;
		display: grid;
		grid-template-columns: 40px minmax(0, 1fr) auto;
		align-items: center;
		gap: 12px;
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 16px;
		background: rgba(255, 255, 255, 0.035);
		padding: 10px 12px;
		overflow: hidden;
		animation: creator-platform-focus 9s ease-in-out infinite;
	}

	.creator-platform-row:nth-child(2) {
		animation-delay: 1.8s;
	}

	.creator-platform-row:nth-child(3) {
		animation-delay: 3.6s;
	}

	.creator-platform-row:nth-child(4) {
		animation-delay: 5.4s;
	}

	.creator-platform-row:nth-child(5) {
		animation-delay: 7.2s;
	}

	.creator-platform-row::before,
	.creator-withdraw-row::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: linear-gradient(90deg, rgba(203, 243, 0, 0.12), transparent 68%);
		opacity: 0;
		pointer-events: none;
		animation: creator-platform-glow 9s ease-in-out infinite;
	}

	.creator-platform-row:nth-child(2)::before {
		animation-delay: 1.8s;
	}

	.creator-platform-row:nth-child(3)::before {
		animation-delay: 3.6s;
	}

	.creator-platform-row:nth-child(4)::before {
		animation-delay: 5.4s;
	}

	.creator-platform-row:nth-child(5)::before {
		animation-delay: 7.2s;
	}

	.creator-platform-row > *,
	.creator-withdraw-row > * {
		position: relative;
		z-index: 1;
	}

	.creator-platform-row > div {
		min-width: 0;
	}

	.creator-platform-row strong,
	.creator-withdraw-row strong,
	.creator-status-tile strong {
		display: block;
		color: #ffffff;
		font-family: Manrope, sans-serif;
		font-size: 14px;
		font-weight: 600;
		line-height: 1.2;
	}

	.creator-platform-row strong,
	.creator-platform-row p {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.creator-platform-row p,
	.creator-status-tile p {
		margin: 4px 0 0;
		color: #71717a;
		font-family: Manrope, sans-serif;
		font-size: 12px;
		line-height: 1.25;
	}

	.creator-platform-row > span:last-child {
