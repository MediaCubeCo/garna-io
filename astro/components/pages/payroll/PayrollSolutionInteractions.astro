                document.getElementById('flow-eor').classList.remove('hidden');
                document.getElementById('flow-cor').classList.add('hidden');
            }
        }

        function switchStep(flow, index) {
            const triggers = document.querySelectorAll('.step-trigger-' + flow);
            const contents = document.querySelectorAll('.step-content-' + flow);

            triggers.forEach((trigger, i) => {
