---
interface Props { image: string; name: string; role: string; }
const { image, name, role } = Astro.props;
---
<div class="flex items-center gap-3 border-t border-white/5 pt-6">
	<div class="h-10 w-10 overflow-hidden rounded-full border border-white/5 bg-white/10">
		<img src={image} alt="" class="h-full w-full object-cover opacity-80" loading="lazy" />
	</div>
	<div><div class="text-sm font-medium text-white">{name}</div><div class="text-xs text-gray-500">{role}</div></div>
</div>
