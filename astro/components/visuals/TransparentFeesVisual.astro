<div class="transparent-fees-visual mx-auto flex min-h-[255px] w-full max-w-[420px] scale-[0.96] flex-col overflow-hidden rounded-[1.25rem] border border-white/[0.08] bg-[#050505] text-left font-sans">
	<div class="flex items-center justify-between border-b border-white/[0.06] px-4 py-3.5">
		<div>
			<div class="text-[10.5px] font-medium uppercase tracking-[0.16em] text-gray-500" data-translate="manageGlobalPayroll.visual.fees.paymentInformation">Payment information</div>
			<div class="mt-0.5 text-[15px] font-medium text-white" data-translate="manageGlobalPayroll.visual.fees.sendPayout">Send payout</div>
		</div>
		<span class="payment-status inline-flex h-6 items-center rounded-full border border-[#CBF300]/20 bg-[#CBF300]/10 px-2.5 text-[10px] font-semibold uppercase leading-none tracking-wide text-[#CBF300]" data-translate="manageGlobalPayroll.visual.fees.ready">Ready</span>
	</div>

	<div class="px-4 pt-3.5">
		<div class="flex items-center gap-3.5 rounded-[1.05rem] border border-white/[0.08] bg-[#0b0b0b] p-3.5">
			<img
				src="/pages/payroll-solution-new/assets/alex-rivera-avatar-light.png"
				alt="Alex Rivera"
				class="payment-avatar h-11 w-11 shrink-0 rounded-full object-cover"
			/>
			<div class="min-w-0 flex-1">
				<div class="truncate text-[15px] font-medium text-white">Alex Rivera</div>
				<div class="mt-0.5 text-[12.5px] text-gray-500" data-translate="manageGlobalPayroll.visual.fees.recipientRole">Contractor · United States</div>
			</div>
			<div class="text-right">
				<div class="payment-input text-[22px] font-semibold leading-none tracking-[-0.04em] text-white">100.00</div>
				<div class="mt-1 text-[12.5px] font-medium text-gray-500" data-translate="manageGlobalPayroll.visual.fees.usdReceives">USD receives</div>
			</div>
		</div>
	</div>

	<div class="mx-4 mt-3.5 grid grid-cols-3 overflow-hidden rounded-[1.05rem] border border-white/[0.08] bg-[#0b0b0b] text-[12.5px]">
		<div class="p-3.5">
			<span class="text-gray-500" data-translate="manageGlobalPayroll.visual.fees.youSend">You send</span>
			<span class="mt-1 block font-medium text-white">€94.42</span>
		</div>
		<div class="border-l border-white/[0.06] p-3.5">
			<span class="text-gray-500" data-translate="manageGlobalPayroll.visual.fees.rate">Rate</span>
			<span class="mt-1 block font-medium text-white">1.0591</span>
		</div>
		<div class="border-l border-white/[0.06] p-3.5">
			<span class="text-gray-500" data-translate="manageGlobalPayroll.visual.fees.fee">Fee</span>
			<span class="mt-1 block font-medium text-white">€0.00</span>
		</div>
	</div>

	<div class="px-4 py-3.5">
		<div class="flex items-center justify-between rounded-[1.05rem] border border-[#CBF300]/25 bg-[#0b0b0b] p-3.5">
			<div>
				<div class="text-[10.5px] uppercase tracking-[0.14em] text-gray-500" data-translate="manageGlobalPayroll.visual.fees.totalToCharge">Total to charge</div>
				<div class="mt-0.5 text-xl font-medium text-white">€94.42</div>
			</div>
			<div class="flex items-center gap-1.5 text-[12.5px] text-gray-400">
				<span class="h-1.5 w-1.5 rounded-full bg-[#CBF300]"></span>
				<span data-translate="manageGlobalPayroll.visual.fees.noHiddenFees">No hidden fees</span>
			</div>
		</div>
	</div>
</div>
