<script>
	const payoutPhoneVisuals = document.querySelectorAll<HTMLElement>('.payout-phone-composition');

	for (const visual of payoutPhoneVisuals) {
		if (visual.dataset.viewportAnimationReady === 'true') continue;
		visual.dataset.viewportAnimationReady = 'true';
		let isVisible = false;
		let restartFrame = 0;

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						isVisible = true;
						cancelAnimationFrame(restartFrame);
						visual.classList.remove('is-animating');
						void visual.offsetWidth;
						restartFrame = requestAnimationFrame(() => {
							if (isVisible) visual.classList.add('is-animating');
						});
					} else {
						isVisible = false;
						cancelAnimationFrame(restartFrame);
						visual.classList.remove('is-animating');
					}
				}
			},
			{ threshold: 0.35 },
		);

		observer.observe(visual);
	}
</script>
