---
interface Props {
	icon: string;
	class?: string;
}

const { icon, class: className = '' } = Astro.props;
---

<div class:list={['mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-[#CBF300]/10 text-[#CBF300] transition-transform duration-300 group-hover:scale-110', className]} aria-hidden="true">
	<iconify-icon icon={icon} width="24"></iconify-icon>
</div>
