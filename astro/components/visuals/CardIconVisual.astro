---
interface Props {
	icon: string;
	class?: string;
	surface?: 'soft' | 'none';
}

const { icon, class: className = '', surface = 'soft' } = Astro.props;
---

<div
	class:list={['card-icon-visual mb-6 flex h-12 w-12 items-center justify-center text-[#CBF300] transition-transform duration-300 group-hover:scale-110', className]}
	data-icon-surface={surface}
	aria-hidden="true"
>
	<iconify-icon icon={icon} width="24"></iconify-icon>
</div>

<style>
	.card-icon-visual {
		border: 1px solid rgba(203, 243, 0, 0.08);
		border-radius: 14px;
		background: rgba(203, 243, 0, 0.1);
	}

	.card-icon-visual[data-icon-surface='none'] {
		border-color: transparent;
		background: transparent;
		box-shadow: none;
	}

	:global(html[data-theme='light']) .card-icon-visual[data-icon-surface='soft'] {
		border-color: rgba(255, 255, 255, 0.08);
		background: #11130f;
		box-shadow:
			0 12px 28px -18px rgba(16, 19, 10, 0.72),
			0 1px 0 rgba(255, 255, 255, 0.04) inset;
		color: #cbf300;
	}
</style>
