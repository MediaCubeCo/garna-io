---
interface Props {
	quietZone?: 'left' | 'center';
}

const { quietZone = 'left' } = Astro.props;
---

<div class="eor-particle-field" data-eor-particle-field data-particle-quiet-zone={quietZone} aria-hidden="true"><canvas></canvas></div>

<style>
	.eor-particle-field { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 76%, transparent 100%); mask-image: linear-gradient(180deg, #000 0%, #000 76%, transparent 100%); }
	.eor-particle-field[data-particle-quiet-zone='center'] { -webkit-mask-image: none; mask-image: none; }
	.eor-particle-field canvas { display: block; width: 100%; height: 100%; opacity: .82; }
	@media (max-width: 767px) { .eor-particle-field canvas { opacity: .62; } }
	@media (prefers-reduced-motion: reduce) { .eor-particle-field canvas { opacity: .54; } }
</style>

<script>
	const initialiseParticleFields = () => {
		document.querySelectorAll<HTMLElement>('[data-eor-particle-field]').forEach((root) => {
			if (root.dataset.ready === 'true') return;
			root.dataset.ready = 'true';
			const canvas = root.querySelector('canvas');
			const context = canvas?.getContext('2d');
			if (!canvas || !context) return;

			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const quietZone = root.dataset.particleQuietZone === 'center' ? 'center' : 'left';
			let width = 0, height = 0, frame = 0;
			let pointerX = .5, pointerY = .5, pointerTargetX = .5, pointerTargetY = .5;
			let pointerStrength = 0, pointerTargetStrength = 0;
			let points: Array<{ x: number; y: number; phase: number; size: number; tone: number }> = [];

			const handlePointer = (event: PointerEvent) => {
				const bounds = root.getBoundingClientRect();
				const inside = event.clientX >= bounds.left && event.clientX <= bounds.right && event.clientY >= bounds.top && event.clientY <= bounds.bottom;
				if (!inside) { pointerTargetStrength = 0; return; }
				pointerTargetX = (event.clientX - bounds.left) / Math.max(1, bounds.width);
				pointerTargetY = (event.clientY - bounds.top) / Math.max(1, bounds.height);
				pointerTargetStrength = 1;
			};
			const handlePointerLeave = () => { pointerTargetStrength = 0; };
			window.addEventListener('pointermove', handlePointer, { passive: true });
			window.addEventListener('pointerout', handlePointerLeave, { passive: true });

			const build = () => {
				const ratio = Math.min(window.devicePixelRatio || 1, 1.5);
				const bounds = root.getBoundingClientRect();
				width = Math.max(1, bounds.width); height = Math.max(1, bounds.height);
				canvas.width = Math.round(width * ratio); canvas.height = Math.round(height * ratio);
				context.setTransform(ratio, 0, 0, ratio, 0, 0);
				const spacing = width < 780 ? 17 : 14;
				points = [];
				let i = 0;
				for (let y = spacing; y < height - spacing; y += spacing) {
					for (let x = spacing; x < width - spacing; x += spacing) {
						const seedA = ((i * 47) % 103) / 103;
						const seedB = ((i * 71) % 107) / 107;
						points.push({
							x, y,
							phase: seedA * Math.PI * 2,
							size: .72 + seedB * .72,
							tone: i % 13,
						});
						i += 1;
					}
				}
			};

			const smoothstep = (a: number, b: number, value: number) => { const n = Math.max(0, Math.min(1, (value - a) / (b - a))); return n * n * (3 - 2 * n); };
			const cloudState = (seconds: number) => {
				const motion = reduced ? 0 : seconds;
				return [
					{ x: .34 + Math.sin(motion * .44) * .24, y: .34 + Math.cos(motion * .31) * .16, rx: .145 + Math.sin(motion * .63) * .025, ry: .19 + Math.cos(motion * .51) * .035 },
					{ x: .48 + Math.sin(motion * .37 + 2.2) * .27, y: .48 + Math.sin(motion * .46 + .8) * .20, rx: .17 + Math.cos(motion * .57) * .035, ry: .16 + Math.sin(motion * .48) * .03 },
					{ x: .55 + Math.cos(motion * .41 + 1.1) * .25, y: .30 + Math.sin(motion * .35 + 2.7) * .17, rx: .14 + Math.sin(motion * .71) * .03, ry: .20 + Math.cos(motion * .43) * .035 },
					{ x: .42 + Math.cos(motion * .33 + 3.4) * .30, y: .60 + Math.cos(motion * .39 + 1.5) * .15, rx: .16 + Math.cos(motion * .52) * .03, ry: .17 + Math.sin(motion * .62) * .03 },
				];
			};

			const draw = (time: number) => {
				const seconds = time / 1000;
				const clouds = cloudState(seconds);
				pointerX += (pointerTargetX - pointerX) * .075;
				pointerY += (pointerTargetY - pointerY) * .075;
				pointerStrength += (pointerTargetStrength - pointerStrength) * .065;
				context.clearRect(0, 0, width, height);
				points.forEach((point) => {
					let field = 0;
					clouds.forEach((cloud, index) => {
						const dx = point.x / width - cloud.x, dy = point.y / height - cloud.y;
						const distance = (dx * dx) / (cloud.rx * cloud.rx) + (dy * dy) / (cloud.ry * cloud.ry);
						const influence = Math.exp(-distance * 2.05);
						field += influence;
					});
					if (!reduced && pointerStrength > .002) {
						const pointerDx = point.x / width - pointerX;
						const pointerDy = point.y / height - pointerY;
						const pointerDistance = (pointerDx * pointerDx) / .0108 + (pointerDy * pointerDy) / .023;
						field += Math.exp(-pointerDistance * 2.05) * .92 * pointerStrength;
					}

					const body = smoothstep(.09, .56, field);
					if (body < .012) return;
					const shimmer = reduced ? 1 : .9 + Math.sin(seconds * 1.25 + point.phase) * .1;
					// EOR keeps its left-side copy attenuation. The centered Business Account
					// hero only softens the texture immediately behind its copy and CTAs.
					const normalizedX = point.x / width;
					const normalizedY = point.y / height;
					const attenuation = quietZone === 'center'
						? 1 - Math.exp(-(
							Math.pow((normalizedX - .5) / .34, 2)
							+ Math.pow((normalizedY - .31) / .22, 2)
						) * 2.4) * .65
						: .22 + smoothstep(.10, .42, normalizedX) * .78;
					const alpha = Math.min(.29, body * .27 * shimmer) * attenuation;
					const px = point.x;
					const py = point.y;
					const radius = point.size * (.82 + body * .34);
					context.fillStyle = point.tone === 0 ? `rgba(75, 116, 151, ${alpha * .86})` : `rgba(92, 121, 145, ${alpha})`;

					// Every particle stays pinned to its grid cell. The perceived motion comes
					// from a filled circle being progressively revealed by a vertical mask.
					const reveal = smoothstep(.06, .86, body);
					const direction = Math.sin(point.phase) >= 0 ? 1 : -1;
					const visibleWidth = Math.max(.34, radius * 2 * reveal);
					const clipX = direction > 0 ? px - radius : px + radius - visibleWidth;
					context.save();
					context.beginPath();
					context.rect(clipX, py - radius - .5, visibleWidth, radius * 2 + 1);
					context.clip();
					context.beginPath();
					context.arc(px, py, radius, 0, Math.PI * 2);
					context.fill();
					context.restore();
				});
				if (!reduced) frame = requestAnimationFrame(draw);
			};

			const observer = new ResizeObserver(build); observer.observe(root); build(); draw(performance.now());
			window.addEventListener('pagehide', () => {
				cancelAnimationFrame(frame); observer.disconnect();
				window.removeEventListener('pointermove', handlePointer);
				window.removeEventListener('pointerout', handlePointerLeave);
			}, { once: true });
		});
	};
	initialiseParticleFields();
	document.addEventListener('astro:page-load', initialiseParticleFields);
</script>
