---
import Section from '../../layout/Section.astro';
---

<Section contained={false} spacing="none" class="lg:pt-32 lg:pb-32 bg-[#050505] border-white/0 border-t pt-16 pb-16">
        <div class="max-w-7xl mr-auto ml-auto pr-6 pl-6">
            <div class="lg:mb-20 text-center mb-16">
                <h2
                    class="md:text-4xl lg:text-5xl text-4xl font-normal text-white tracking-tight font-manrope max-w-4xl mr-auto mb-6 ml-auto"
                    data-translate="payout.title">
                    Pay them as contractors or hire with Garna</h2>
                <p data-garna-subtitle class="text-xl font-light text-gray-400 font-manrope max-w-3xl mr-auto ml-auto" data-translate="payout.description">Pay your
                    international team seamlessly. We handle the currency exchange, local compliance, and distribution
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-x-8 gap-y-8">

                <!-- Col 1: Multiple Payout Methods -->
                <div
                    class="group flex flex-col hover:border-white/10 transition-all duration-300 overflow-hidden bg-[#0b0b0b] border-white/5 border rounded-3xl pt-8 pr-8 pb-8 pl-8 relative justify-between">
                    <div class="z-10 mb-2 relative">
                        <h3 class="text-xl font-medium text-white font-manrope mb-3" data-translate="payout.flexibleFundingTitle">Flexible funding options</h3>
                        <p class="leading-relaxed text-gray-400 font-manrope" data-translate="payout.flexibleFundingDesc">Pay your entire team with one bulk payment
                            via bank, card, or crypto</p>
                    </div>

                    <!-- List Visual -->
                    <div class="w-full mt-6 relative justify-center">


                        <!-- List Items -->
                        <div
                            class="flex flex-col bg-[#0b0b0b] max-w-xs z-10 mx-auto relative gap-x-2 gap-y-2 justify-center">
                            <!-- Method 1: Bank -->
                            <div
                                class="group/item flex hover:border-white/10 hover:bg-white/5 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 cursor-pointer bg-[#111111] border-white/5 border rounded-xl pt-2 pr-2 pb-2 pl-2 items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div
                                        class="flex group-hover/item:border-white/20 group-hover/item:bg-white/5 group-hover/item:text-white transition-colors text-gray-400 w-8 h-8 border-white/5 border rounded-lg items-center justify-center">
                                        <iconify-icon icon="lucide:landmark" width="16" class=""></iconify-icon>
                                    </div>
                                    <div
                                        class="group-hover/item:text-white transition-colors text-xs font-medium text-gray-200"
                                        data-translate="payout.bankTransfer">
                                        Bank transfer</div>
                                </div>
                                <iconify-icon icon="lucide:chevron-right"
                                    class="text-gray-600 group-hover/item:text-white group-hover/item:translate-x-0.5 transition-all"
                                    width="14"></iconify-icon>
                            </div>

                            <!-- Method 2: Card -->
                            <div
                                class="group/item flex hover:border-white/10 hover:bg-white/5 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 cursor-pointer bg-[#111111] border-white/5 border rounded-xl px-2 py-2 items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div
                                        class="w-8 h-8 rounded-lg flex items-center justify-center text-gray-400 border border-white/5 group-hover/item:border-white/20 group-hover/item:bg-white/5 group-hover/item:text-white transition-colors">
                                        <iconify-icon icon="solar:card-linear" width="16" class=""></iconify-icon>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <div
                                            class="text-xs font-medium text-gray-200 group-hover/item:text-white transition-colors"
                                            data-translate="payout.transferToCard">
                                            Transfer to a card</div>
                                        <span
                                            class="text-[9px] font-bold text-[#CBF300] bg-[#CBF300]/10 border border-[#CBF300]/20 px-1.5 py-0.5 rounded tracking-wide" data-translate="payout.newBadge">NEW</span>
                                    </div>
                                </div>
                                <iconify-icon icon="lucide:chevron-right"
                                    class="text-gray-600 group-hover/item:text-white group-hover/item:translate-x-0.5 transition-all"
                                    width="14"></iconify-icon>
                            </div>

                            <!-- Method 3: Wallets -->
                            <div
                                class="group/item flex hover:border-white/10 hover:bg-white/5 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 cursor-pointer bg-[#111111] border-white/5 border rounded-xl px-2 py-2 items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div
                                        class="w-8 h-8 rounded-lg flex items-center justify-center text-gray-400 border border-white/5 group-hover/item:border-white/20 group-hover/item:bg-white/5 group-hover/item:text-white transition-colors">
                                        <iconify-icon icon="lucide:scan" width="16" class=""></iconify-icon>
                                    </div>
                                    <div
                                        class="group-hover/item:text-white transition-colors text-xs font-medium text-gray-200"
                                        data-translate="payout.electronicWallets">
                                        Electronic wallets</div>
                                </div>
                                <iconify-icon icon="lucide:chevron-right"
                                    class="text-gray-600 group-hover/item:text-white group-hover/item:translate-x-0.5 transition-all"
                                    width="14"></iconify-icon>
                            </div>

                            <!-- Method 4: Crypto -->
                            <div
                                class="group/item flex hover:border-white/10 hover:bg-white/5 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 cursor-pointer bg-[#111111] border-white/5 border rounded-xl px-2 py-2 items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div
                                        class="w-8 h-8 rounded-lg flex items-center justify-center text-gray-400 border border-white/5 group-hover/item:border-white/20 group-hover/item:bg-white/5 group-hover/item:text-white transition-colors">
                                        <iconify-icon icon="lucide:bitcoin" width="16" class=""></iconify-icon>
                                    </div>
                                    <div
                                        class="text-xs font-medium text-gray-200 group-hover/item:text-white transition-colors"
                                        data-translate="payout.cryptocurrencies">
                                        Cryptocurrencies</div>
                                </div>
                                <iconify-icon icon="lucide:chevron-right"
                                    class="text-gray-600 group-hover/item:text-white group-hover/item:translate-x-0.5 transition-all"
                                    width="14"></iconify-icon>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Col 2: Global Availability -->
                <div
                    class="group flex flex-col hover:border-white/10 transition-all duration-300 overflow-hidden min-h-[320px] bg-[#0b0b0b] border-white/5 border rounded-3xl pt-8 pr-8 pb-8 pl-8 relative justify-between">

                    <!-- Background Map Visual -->
                    <div
                        class="group-hover:scale-105 transition-transform duration-1000 ease-out absolute top-0 right-0 bottom-0 left-0">
                        <!-- Background Image - Grayscale and Blended -->
                        <div class="bg-center transition-all duration-500 md:h-[450px] lg:h-auto opacity-30 bg-cover absolute top-0 right-0 bottom-0 left-0 grayscale"
                            style="background-image: url('https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=800&amp;q=80')">

                        </div>

                        <!-- Transfer Path Visualization - Full Color -->
                        <svg viewBox="0 0 100 100" preserveAspectRatio="none"
                            class="absolute inset-0 w-full h-full pointer-events-none overflow-visible">
                            <defs>
                                <linearGradient id="path-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
                                    <stop offset="0%" style="stop-color:#CBF300;stop-opacity:0;"></stop>
                                    <stop offset="50%" style="stop-color:#CBF300;stop-opacity:0.8;"></stop>
                                    <stop offset="100%" style="stop-color:#CBF300;stop-opacity:0;"></stop>
                                </linearGradient>
                                <filter id="glow-effect" x="-50%" y="-50%" width="200%" height="200%">
                                    <feGaussianBlur stdDeviation="1" result="blur"></feGaussianBlur>
                                    <feComposite in="SourceGraphic" in2="blur" operator="over"></feComposite>
                                </filter>
                            </defs>

                            <!-- Flight Path Line -->
                            <path d="M 25 65 Q 50 25 85 45" fill="none" stroke="rgba(255,255,255,0.15)"
                                stroke-width="0.3" stroke-dasharray="1 1"></path>

                            <!-- Moving Money Particle -->
                            <circle r="1" fill="#CBF300" filter="url(#glow-effect)">
                                <animateMotion dur="3s" repeatCount="indefinite" path="M 25 65 Q 50 25 85 45"
                                    keyPoints="0;1" keyTimes="0;1" calcMode="linear"></animateMotion>
                                <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.2;0.8;1" dur="3s"
                                    repeatCount="indefinite"></animate>
                                <animate attributeName="r" values="1;1.5;1" dur="3s" repeatCount="indefinite"></animate>
                            </circle>
                        </svg>

                        <!-- Start Location Point -->
                        <div
                            class="absolute left-[25%] top-[65%] -translate-x-1/2 -translate-y-1/2 w-4 h-4 flex items-center justify-center">
                            <div
                                class="animate-[ping_2s_cubic-bezier(0,0,0.2,1)_infinite] bg-[#CBF300] opacity-100 rounded-full absolute top-0 right-0 bottom-0 left-0">
                            </div>
                            <div
                                class="relative w-1.5 h-1.5 bg-[#CBF300] rounded-full shadow-[0_0_10px_#CBF300] ring-1 ring-[#CBF300]/50">
                            </div>
                        </div>

                        <!-- End Location Point with Notification -->
                        <div
                            class="absolute left-[85%] top-[45%] -translate-x-1/2 -translate-y-1/2 w-4 h-4 flex items-center justify-center">
                            <div class="animate-ping bg-[#CBF300] opacity-60 rounded-full absolute top-0 right-0 bottom-0 left-0"
                                style="animation-delay: 1.5s"></div>
                            <div
                                class="relative w-1.5 h-1.5 bg-[#CBF300] rounded-full shadow-[0_0_10px_#CBF300] ring-1 ring-[#CBF300]/50">
                            </div>

                            <!-- Floating Payment Received Label -->
                            <div class="absolute bottom-full mb-3 bg-[#111]/90 backdrop-blur-md border border-[#CBF300]/30 px-2.5 py-1 rounded-md text-[9px] font-semibold text-[#CBF300] whitespace-nowrap shadow-xl flex items-center gap-1.5 transform translate-y-2 opacity-0"
                                style="animation: float-up-fade 3s infinite linear; animation-delay: 2.2s;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24"
                                    fill="currentColor" class="w-2.5 h-2.5">
                                    <path
                                        d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z">
                                    </path>
                                </svg>
                                +$2,450.00
                            </div>
                        </div>


                    </div>

                    <!-- Header Content -->
                    <div class="z-10 mb-2 relative">
                        <h3 class="text-xl font-medium text-white font-manrope mb-3" data-translate="payout.borderlessTitle">Borderless payments</h3>
                        <p class="leading-relaxed text-gray-400 font-manrope" data-translate="payout.borderlessDesc">Send secure payments to contractors in
                            150+ countries in local
                            currencies</p>
                    </div>

                    <!-- Notification Card (Bottom Overlay) -->
                    <div
                        class="flex flex-col gap-3 z-10 pr-8 pl-8 absolute right-0 bottom-8 left-0 gap-x-3 gap-y-3 items-center">
                        <div
                            class="flex transform group-hover:translate-y-0 transition-transform duration-500 font-manrope bg-[#111]/80 w-full max-w-xs border-white/10 border rounded-xl pt-3 pr-3 pb-3 pl-3 shadow-2xl backdrop-blur-md translate-y-2 gap-x-3 gap-y-3 items-center">
                            <div
                                class="flex flex-shrink-0 text-[#CBF300] bg-[#CBF300]/10 w-8 h-8 border-[#CBF300]/20 border rounded-full relative items-center justify-center pt-0.5">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                    class="z-10 relative -rotate-45 w-[18px] h-[18px]"
                                    style="width: 18px; height: 18px; color: currentColor;" stroke-width="2">
                                    <path fill="currentColor"
                                        d="m18.636 15.67l1.716-5.15c1.5-4.498 2.25-6.747 1.062-7.934s-3.436-.438-7.935 1.062L8.33 5.364C4.7 6.574 2.885 7.18 2.37 8.067a2.72 2.72 0 0 0 0 2.73c.515.888 2.33 1.493 5.96 2.704c.45.15.957.042 1.294-.291l5.506-5.455a.79.79 0 1 1 1.11 1.122l-5.416 5.366a1.4 1.4 0 0 0-.324 1.427c1.21 3.63 1.816 5.446 2.703 5.962a2.72 2.72 0 0 0 2.731 0c.887-.516 1.492-2.331 2.703-5.962"
                                        class=""></path>
                                </svg>
                                <div
                                    class="animate-ping bg-[#CBF300]/20 opacity-20 rounded-full absolute top-0 right-0 bottom-0 left-0">
                                </div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex text-xs font-medium text-white mb-1 items-center justify-between">
                                    <span class="" data-translate="payout.paymentSent">Payment Sent</span>
                                    <span
                                        class="text-[10px] text-xs font-normal text-gray-500 bg-white/5 border-white/5 border rounded pt-0 pr-1.5 pb-0 pl-1.5" data-translate="payout.instant">Instant</span>
                                </div>
                                <div
                                    class="text-[10px] truncate flex gap-1.5 text-gray-400 gap-x-1.5 gap-y-1.5 items-center">
                                    <span class="w-1 h-1 rounded-full bg-[#CBF300]"></span>
                                    <span data-translate="payout.toSarahJenkins">To: Sarah Jenkins (London, UK)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Col 3: Full Transparency -->
                <div
                    class="group bg-[#0a0a0a] border border-white/5 rounded-3xl p-8 flex flex-col justify-between hover:border-white/10 transition-all duration-300">
                    <div class="text-center mb-8">
                        <h3 class="text-xl font-medium text-white font-manrope text-left mb-3" data-translate="payout.transparentBillingTitle">Transparent billing</h3>
                        <p class="leading-relaxed text-gray-400 font-manrope text-left" data-translate="payout.transparentBillingDesc">No hidden fees. Get clear
                            breakdowns of hours, rates, and costs per hire</p>
                    </div>

                    <!-- Visual -->
                    <div class="flex-1 flex relative items-center justify-center">
                        <div
                            class="overflow-hidden group-hover:-translate-y-1 transition-transform duration-300 bg-[#111] w-full max-w-xs border-white/5 border rounded-2xl relative shadow-2xl">
                            <div class="flex border-white/5 border-b pt-3 pr-4 pb-3 pl-4 items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <div
                                        class="w-1.5 h-1.5 rounded-full bg-[#CBF300] shadow-[0_0_8px_rgba(203, 243, 0,0.6)]">
                                    </div>
                                    <span
                                        class="text-[10px] uppercase font-semibold text-gray-300 tracking-wide" data-translate="payout.billingStatement">BILLING
                                        STATEMENT</span>
                                </div>
                                <button class="text-gray-500 hover:text-white transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round" class="lucide lucide-share">
                                        <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                                        <polyline points="16 6 12 2 8 6"></polyline>
                                        <line x1="12" x2="12" y1="2" y2="15"></line>
                                    </svg>
                                </button>
                            </div>

                            <!-- Body -->
                            <div class="pt-5 pr-5 pb-5 pl-5 space-y-3">
                                <div class="flex justify-between items-center">
                                    <span class="text-xs text-gray-500" data-translate="payout.rateHr">Rate / hr</span>
                                    <span class="text-xs font-mono text-gray-300">$120.00</span>
                                </div>
                                <div class="flex justify-between items-center">
                                    <span class="text-xs text-gray-500" data-translate="payout.billableHours">Billable Hours</span>
                                    <span class="text-xs font-mono text-gray-300">42.5</span>
                                </div>
                                <div class="flex justify-between items-center">
                                    <span class="text-xs text-gray-500" data-translate="payout.platformFee">Platform Fee</span>
                                    <span
                                        class="text-xs font-mono text-[#CBF300] bg-[#CBF300]/10 px-1.5 py-0.5 rounded border border-[#CBF300]/10">0.0%</span>
                                </div>
                                <div class="flex justify-between items-center">
                                    <span class="text-xs text-gray-500" data-translate="payout.processing">Processing</span>
                                    <span class="text-xs font-mono text-gray-500">$0.00</span>
                                </div>
                            </div>
                            <div
                                class="flex bg-gradient-to-b from-[#CBF300]/5 to-transparent border-[#CBF300]/10 border-t pt-3 pr-5 pb-3 pl-5 items-center justify-between">
                                <span class="text-xs font-medium text-[#CBF300]" data-translate="payout.netTotal">Net Total</span>
                                <span class="text-lg font-semibold text-white tracking-tight">$5,100.00</span>
                            </div>
                        </div>

                        <!-- Floating element behind -->
                        <div
                            class="absolute -z-10 -right-4 -bottom-4 w-32 h-32 bg-[#CBF300]/10 blur-[60px] rounded-full opacity-40 pointer-events-none">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Section>
