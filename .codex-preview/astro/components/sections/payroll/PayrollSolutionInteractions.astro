<script is:inline>
        (function() {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const el = entry.target;
                        const target = parseInt(el.getAttribute('data-target'));
                        const prefix = el.getAttribute('data-prefix') || '';
                        const suffix = el.getAttribute('data-suffix') || '';
                        const grouping = el.getAttribute('data-grouping');
                        const duration = 2500;
                        const startTime = performance.now();

                        function update(currentTime) {
                            const elapsed = currentTime - startTime;
                            const progress = Math.min(elapsed / duration, 1);
                            // Ease out quart
                            const ease = 1 - Math.pow(1 - progress, 4);

                            const current = Math.floor(target * ease);
                            const formattedCurrent = grouping === 'space'
                                ? String(current).replace(/\B(?=(\d{3})+(?!\d))/g, ' ')
                                : String(current);
                            el.textContent = prefix + formattedCurrent + suffix;

                            if (progress < 1) {
                                requestAnimationFrame(update);
                            } else {
                                const formattedTarget = grouping === 'space'
                                    ? String(target).replace(/\B(?=(\d{3})+(?!\d))/g, ' ')
                                    : String(target);
                                el.textContent = prefix + formattedTarget + suffix;
                            }
                        }

                        requestAnimationFrame(update);
                        observer.unobserve(el);
                    }
                });
            }, { threshold: 0.2 });

            document.querySelectorAll('.garna-stat-anim').forEach(el => observer.observe(el));
        })();
    </script>
<script is:inline>
        (function() {
            const el = document.querySelector('[data-element-id="aura-emkb8ctmf2ri4n2da"]');
            if(!el) return;
            const obs = new IntersectionObserver(e => {
                e.forEach(entry => {
                    if (entry.isIntersecting) {
                        el.querySelectorAll('.num-anim').forEach(n => {
                            const t = parseFloat(n.getAttribute('data-val'));
                            const d = parseInt(n.getAttribute('data-dec'));
                            const dur = 1500;
                            const start = performance.now();
                            const step = (now) => {
                                const p = Math.min((now - start) / dur, 1);
                                const v = t * (1 - Math.pow(1 - p, 3));
                                n.textContent = v.toLocaleString('en-US', {minimumFractionDigits: d, maximumFractionDigits: d});
                                if (p < 1) requestAnimationFrame(step);
                            };
                            requestAnimationFrame(step);
                        });
                        obs.disconnect();
                    }
                });
            }, { threshold: 0.1 });
            obs.observe(el);
        })();
    </script>
<script is:inline>
                (function() {
                    function formatValue(value, decimals) {
                        return value.toLocaleString('en-US', {
                            minimumFractionDigits: decimals,
                            maximumFractionDigits: decimals
                        });
                    }

                    function initCounterAnimation() {
                        const elements = document.querySelectorAll('.counter-anim');
                        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

                        elements.forEach(el => {
                            const target = parseFloat(el.getAttribute('data-target'));
                            const prefix = el.getAttribute('data-prefix') || '';
                            const suffix = el.getAttribute('data-suffix') || '';
                            const decimals = parseInt(el.getAttribute('data-decimals') || 0);
                            const finalValue = prefix + formatValue(target, decimals) + suffix;

                            if (prefersReducedMotion) {
                                el.innerText = finalValue;
                                return;
                            }

                            function animate() {
                                if (el.dataset.counterAnimated === 'true') return;
                                el.dataset.counterAnimated = 'true';
                                const start = 0;
                                const duration = 2000;
                                const startTime = performance.now();

                                function update(currentTime) {
                                    const elapsed = currentTime - startTime;
                                    const progress = Math.min(elapsed / duration, 1);
                                    const ease = 1 - Math.pow(1 - progress, 4); // Ease out quart

                                    const current = start + (target - start) * ease;

                                    el.innerText = prefix + formatValue(current, decimals) + suffix;

                                    if (progress < 1) {
                                        requestAnimationFrame(update);
                                    } else {
                                        el.innerText = finalValue;
                                    }
                                }

                                requestAnimationFrame(update);
                            }

                            if ('IntersectionObserver' in window) {
                                const observer = new IntersectionObserver((entries) => {
                                    entries.forEach(entry => {
                                        if (entry.isIntersecting) {
                                            animate();
                                            observer.disconnect();
                                        }
                                    });
                                }, { threshold: 0.1 });

                                observer.observe(el);
                            } else {
                                animate();
                            }
                        });
                    }

                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', initCounterAnimation, { once: true });
                    } else {
                        initCounterAnimation();
                    }
                })();
            </script>
<script is:inline>
            (function() {
                const wrapper = document.currentScript.parentElement;
                const content = wrapper.querySelector('.glass');

                if (wrapper && content) {
                    const updateHeight = () => {
                        const rect = content.getBoundingClientRect();
                        // Set the wrapper height to match the exact visual height of the scaled child
                        if(rect.height > 0) {
                            wrapper.style.height = rect.height + 'px';
                        }
                    };

                    // Update immediately, on resize, and on load
                    updateHeight();
                    window.addEventListener('resize', updateHeight);
                    new ResizeObserver(updateHeight).observe(content);
                    window.addEventListener('load', updateHeight);

                    // Fallback polling for slow loads
                    setTimeout(updateHeight, 500);
                    setTimeout(updateHeight, 1500);
                }
            })();
        </script>
<script is:inline>
        (function() {
            const startCounter = () => {
                document.querySelectorAll('.rolling-number').forEach(el => {
                    const target = parseInt(el.getAttribute('data-target'));
                    const prefix = el.getAttribute('data-prefix') || '';
                    const suffix = el.getAttribute('data-suffix') || '';
                    const duration = 2000;
                    const frameDuration = 1000 / 60;
                    const totalFrames = Math.round(duration / frameDuration);
                    let frame = 0;

                    const count = () => {
                        frame++;
                        const progress = frame / totalFrames;
                        // Ease out quart
                        const ease = 1 - Math.pow(1 - progress, 4);
                        const current = Math.round(ease * target);

                        el.innerText = prefix + current.toLocaleString('en-US') + suffix;

                        if (frame < totalFrames) {
                            requestAnimationFrame(count);
                        } else {
                            el.innerText = prefix + target.toLocaleString('en-US') + suffix;
                        }
                    };
                    count();
                });
            };

            // Loop animation
            startCounter();
            setInterval(startCounter, 6000);
        })();
    </script>
<script is:inline>
    (() => {
        if (window.__garnaPayrollStepsInitialized) return;
        window.__garnaPayrollStepsInitialized = true;

        window.switchStep = (flow, index) => {
            const triggers = document.querySelectorAll('.step-trigger-' + flow);
            const contents = document.querySelectorAll('.step-content-' + flow);

            triggers.forEach((trigger, itemIndex) => {
                const circle = trigger.querySelector('.step-circle-' + flow);
                const title = trigger.querySelector('h3');
                const isActive = itemIndex === index;
                trigger.classList.toggle('opacity-50', !isActive);
                trigger.classList.toggle('hover:opacity-80', !isActive);
                trigger.classList.toggle('opacity-100', isActive);
                circle?.classList.toggle('text-[#CBF300]', isActive);
                circle?.classList.toggle('border-[#CBF300]', isActive);
                circle?.classList.toggle('shadow-[0_0_15px_rgba(203, 243, 0,0.3)]', isActive);
                circle?.classList.toggle('text-gray-500', !isActive);
                circle?.classList.toggle('border-white/10', !isActive);
                title?.classList.toggle('text-[#CBF300]', isActive);
                title?.classList.toggle('text-white', !isActive);
            });

            contents.forEach((content, itemIndex) => {
                const isActive = itemIndex === index;
                content.classList.toggle('opacity-0', !isActive);
                content.classList.toggle('translate-y-8', !isActive);
                content.classList.toggle('scale-95', !isActive);
                content.classList.toggle('-z-10', !isActive);
                content.classList.toggle('pointer-events-none', !isActive);
                content.classList.toggle('opacity-100', isActive);
                content.classList.toggle('translate-y-0', isActive);
                content.classList.toggle('scale-100', isActive);
                content.classList.toggle('z-10', isActive);
            });
        };

        window.addEventListener('garna:segment-change', (event) => {
            if (event.detail?.group === 'start-paying') window.switchStep(event.detail.value, 0);
        });
    })();
</script>
