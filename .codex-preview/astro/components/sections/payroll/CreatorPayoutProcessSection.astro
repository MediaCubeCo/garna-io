---
import Section from '../../layout/Section.astro';
---

<Section
	title={{ text: 'How to get started' }}
	description={{ text: 'Start using Garna in a few simple steps' }}
	spacing="none"
	class="creator-process-section pt-16 pb-8 lg:pt-32 lg:pb-0"
	headerClass="mb-14 max-w-4xl lg:mb-16"
	titleClass="mx-auto max-w-4xl lg:text-5xl"
	contentClass="creator-process-scroll"
>
	<div class="creator-process-pin" data-creator-process>
		<div class="creator-process-visual-stage" aria-label="Creator payout setup visual">
			<div class="creator-process-visual is-active" data-process-visual="0">
				<div class="creator-mini-window">
					<h4 class="creator-mini-title">Sign up in Garna</h4>
					<div class="creator-mini-form">
						<label class="creator-mini-field creator-mini-field--wide">
							<span>Company name</span>
							<strong>Northstar Labs Ltd.</strong>
						</label>
						<div class="creator-mini-grid">
							<label class="creator-mini-field">
								<span>Registration number</span>
								<strong>HE 482913</strong>
							</label>
							<label class="creator-mini-field">
								<span>Country</span>
								<strong>Cyprus</strong>
							</label>
						</div>
						<label class="creator-mini-field creator-mini-field--wide">
							<span>Business email</span>
							<strong>finance@northstarlabs.io</strong>
						</label>
						<label class="creator-mini-field creator-mini-field--wide">
							<span>Payout currency</span>
							<strong>USD</strong>
						</label>
						<button class="creator-mini-button" type="button">Continue</button>
					</div>
				</div>
			</div>
			<div class="creator-process-visual" data-process-visual="1">
				<div class="creator-mini-window creator-team-window">
					<h4 class="creator-mini-title">Invite contractors</h4>
					<div class="creator-mini-form">
						<label class="creator-mini-field creator-mini-field--wide">
							<span>Role</span>
							<strong>Design contractor</strong>
						</label>
						<label class="creator-mini-field creator-mini-field--wide">
							<span>Email</span>
							<div class="creator-invite-emails" aria-hidden="true">
								<span>maya@northstarlabs.io</span>
								<span>alex@northstarlabs.io</span>
								<span>sarah@northstarlabs.io</span>
							</div>
						</label>
						<div class="creator-mini-grid">
							<label class="creator-mini-field">
								<span>Agreement</span>
								<strong>Client terms</strong>
							</label>
							<label class="creator-mini-field">
								<span>Access</span>
								<strong>Contractor</strong>
							</label>
						</div>
						<button class="creator-mini-button" type="button">Send invites</button>
					</div>
				</div>
			</div>
			<div class="creator-process-visual" data-process-visual="2">
				<div class="creator-details-sheet">
					<div class="creator-details-header">
						<span>Garna details</span>
						<strong>USD</strong>
					</div>
					<div class="creator-details-grid">
						<span>Routing</span>
						<strong>021000021</strong>
						<span>Account</span>
						<strong>4461 9571</strong>
						<span>Method</span>
						<strong>SWIFT</strong>
						<span>Beneficiary</span>
						<strong>Garna LLC</strong>
						<span>Reference</span>
						<strong>ENV-2048</strong>
					</div>
					<div class="creator-detail-tags">
						<span>Envato ready</span>
						<span>Adobe Stock manual</span>
						<span>Invoice required</span>
					</div>
					<div class="creator-details-status">
						<div><span>Route status</span><strong>Checked</strong></div>
						<div><span>Use in platform</span><strong>Ready to paste</strong></div>
					</div>
					<div class="creator-visual-action">Copy payout details</div>
				</div>
			</div>
			<div class="creator-process-visual" data-process-visual="3">
				<div class="creator-withdraw-panel">
					<div class="creator-withdraw-header">
						<span>Envato withdrawal</span>
						<strong>$2,840</strong>
					</div>
					<div class="creator-visual-section-label">Payout summary</div>
					<div class="creator-visual-list">
						<div><span>Available now</span><strong>$2,840.00</strong></div>
						<div><span>Marketplace fee</span><strong>Paid</strong></div>
					</div>
					<div class="creator-visual-section-label">Route details</div>
					<div class="creator-withdraw-select">
						<span>Destination</span>
						<strong>Garna USD</strong>
					</div>
					<div class="creator-withdraw-note">
						<span>Request</span>
						<strong>Prepared</strong>
					</div>
					<div class="creator-visual-action">Request payout</div>
				</div>
			</div>
			<div class="creator-process-progress" aria-hidden="true">
				<span class="is-active"></span>
				<span></span>
				<span></span>
				<span></span>
			</div>
		</div>
	</div>
	<div class="creator-process-copy">
		<article class="creator-process-step is-active" data-process-step="0">
			<span>01</span>
			<h3>Setup your account</h3>
			<p>Create your company profile and verify your business details to get access to the platform</p>
		</article>
		<article class="creator-process-step" data-process-step="1">
			<span>02</span>
			<h3>Invite your team</h3>
			<p>Add contractors to the dashboard and assign roles, access, and agreement terms</p>
		</article>
		<article class="creator-process-step" data-process-step="2">
			<span>03</span>
			<h3>Fund your balance</h3>
			<p>Top up your corporate wallet using bank transfer, SWIFT, SEPA, or crypto assets</p>
		</article>
		<article class="creator-process-step" data-process-step="3">
			<span>04</span>
			<h3>Send payouts</h3>
			<p>Execute global payrolls in one click with automated tax handling and compliance</p>
		</article>
	</div>
	<div class="creator-process-fallback" data-process-fallback></div>
</Section>

<script is:inline>
	(() => {
		const creatorProcess = document.querySelector('[data-creator-process]');
		const creatorProcessSteps = Array.from(document.querySelectorAll('[data-process-step]'));
		const creatorProcessVisuals = Array.from(document.querySelectorAll('[data-process-visual]'));
		const creatorProcessProgress = Array.from(document.querySelectorAll('.creator-process-progress span'));
		const creatorProcessFallback = document.querySelector('[data-process-fallback]');
		const reduceCreatorProcessMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const targetCreatorBalance = 2840;
		let creatorBalanceActiveStartedAt = null;

		const formatCreatorBalance = (value) =>
			new Intl.NumberFormat('en-US', {
				style: 'currency',
				currency: 'USD',
				minimumFractionDigits: 2,
				maximumFractionDigits: 2,
			}).format(value);

		if (creatorProcess && creatorProcessSteps.length && creatorProcessVisuals.length) {
			const creatorProcessScroll = creatorProcess.closest('.creator-process-scroll');
			let creatorProcessFrame = null;
			let creatorProcessCurrentIndex = -1;

			const setCreatorProcessStep = (index, stepProgress = 1) => {
				if (index !== creatorProcessCurrentIndex) {
					creatorBalanceActiveStartedAt = null;
					creatorProcessCurrentIndex = index;
				}

				const clampedStepProgress = Math.min(1, Math.max(0, stepProgress));
				const progressTrack = creatorProcessProgress[0]?.parentElement;
				if (progressTrack instanceof HTMLElement) {
					progressTrack.style.setProperty('--creator-process-step-progress', `${clampedStepProgress * 100}%`);
				}

				creatorProcessSteps.forEach((step) => {
					step.classList.toggle('is-active', step.getAttribute('data-process-step') === String(index));
				});

				creatorProcessVisuals.forEach((visual, visualIndex) => {
					const isActiveVisual = visual.getAttribute('data-process-visual') === String(index);
					const stackDistance = (visualIndex - index + creatorProcessVisuals.length) % creatorProcessVisuals.length;

					visual.classList.toggle('is-active', isActiveVisual);
					visual.classList.toggle('is-stack-one', !isActiveVisual && stackDistance === 1);
					visual.classList.toggle('is-stack-two', !isActiveVisual && stackDistance === 2);
					visual.classList.toggle('is-stack-three', !isActiveVisual && stackDistance === 3);
					visual.classList.toggle('is-stack-four', !isActiveVisual && stackDistance === 4);
					visual.classList.toggle('is-stack-five', !isActiveVisual && stackDistance === 5);
				});

				creatorProcessProgress.forEach((dot, dotIndex) => {
					dot.classList.toggle('is-active', dotIndex === index);
				});
			};

			const updateCreatorProcessStep = () => {
				creatorProcessFrame = null;
				if (!creatorProcessScroll) return;

				const rect = creatorProcessScroll.getBoundingClientRect();
				const scrollDistance = Math.max(1, rect.height - window.innerHeight);
				const processStyles = window.getComputedStyle(creatorProcessScroll);
				const cssStickyOffset = Number.parseFloat(processStyles.getPropertyValue('--creator-process-top-offset'));
				const computedStickyTop =
					creatorProcess instanceof HTMLElement
						? Number.parseFloat(window.getComputedStyle(creatorProcess).top)
						: Number.NaN;
				const stickyOffset =
					window.innerWidth > 980
						? Number.isFinite(computedStickyTop)
							? computedStickyTop
							: Number.isFinite(cssStickyOffset)
								? cssStickyOffset
								: 0
						: 0;
				const progress = Math.min(1, Math.max(0, (stickyOffset - rect.top) / scrollDistance));
				const rawStepProgress = progress * creatorProcessSteps.length;
				const index = Math.min(creatorProcessSteps.length - 1, Math.floor(rawStepProgress));
				const stepProgress = Math.min(1, rawStepProgress - index);

				setCreatorProcessStep(index, stepProgress);
			};

			const requestCreatorProcessUpdate = () => {
				if (creatorProcessFrame !== null) return;
				creatorProcessFrame = window.requestAnimationFrame(updateCreatorProcessStep);
			};

			updateCreatorProcessStep();
			window.addEventListener('scroll', requestCreatorProcessUpdate, { passive: true });
			window.addEventListener('resize', requestCreatorProcessUpdate);
		}

		if (creatorProcessFallback && creatorProcessSteps.length && creatorProcessVisuals.length) {
			creatorProcessSteps.forEach((step, index) => {
				const visual = creatorProcessVisuals[index];
				const visualContent = visual?.firstElementChild?.cloneNode(true);
				const stepContent = step.cloneNode(true);
				const fallbackItem = document.createElement('article');
				const visualShell = document.createElement('div');

				fallbackItem.className = 'creator-process-fallback-item';
				visualShell.className = 'creator-process-fallback-visual';
				visualShell.setAttribute('data-process-fallback-visual', String(index));
				stepContent.className = 'creator-process-fallback-copy';
				stepContent.removeAttribute('data-process-step');

				if (visualContent) {
					visualShell.appendChild(visualContent);
				}

				fallbackItem.append(visualShell, stepContent);
				creatorProcessFallback.appendChild(fallbackItem);
			});

			const activateCreatorFallbackVisual = (visual) => visual.classList.add('is-active');
			creatorProcessFallback
				.querySelectorAll('.creator-process-fallback-visual')
				.forEach(activateCreatorFallbackVisual);
		}

		const animateCreatorBalance = () => {
			document.querySelectorAll('[data-process-balance-counter]').forEach((counter) => {
				if (!(counter instanceof HTMLElement)) return;
				const bar = counter.closest('.creator-balance-card')?.querySelector('.creator-balance-bar');
				if (reduceCreatorProcessMotion.matches) {
					counter.textContent = formatCreatorBalance(targetCreatorBalance);
					if (bar instanceof HTMLElement) bar.style.setProperty('--creator-balance-progress', '1');
					return;
				}

				const start = creatorBalanceActiveStartedAt ?? performance.now();
				const progress = Math.min(1, Math.max(0, (performance.now() - start - 720) / 1300));
				const easedProgress = 1 - Math.pow(1 - progress, 3);
				counter.textContent = formatCreatorBalance(targetCreatorBalance * easedProgress);
				if (bar instanceof HTMLElement) bar.style.setProperty('--creator-balance-progress', String(easedProgress));
			});

			window.requestAnimationFrame(animateCreatorBalance);
		};

		window.requestAnimationFrame(animateCreatorBalance);
	})();
</script>

<style>
	:global(.creator-process-scroll) {
		--creator-process-card-height: 360px;
		--creator-process-top-offset: 124px;
		--creator-process-bottom-offset: 64px;
		--creator-process-content-height: calc(var(--creator-process-card-height) + 120px);
		--creator-process-sticky-offset: calc((100vh - var(--creator-process-content-height)) / 2 + 36px);
		--creator-process-visual-offset-y: -28px;
		display: grid;
		min-height: 540vh;
		grid-template-columns: minmax(0, 1.06fr) minmax(320px, 0.94fr);
		align-items: start;
		gap: clamp(28px, 5vw, 72px);
	}

	.creator-process-pin {
		position: sticky;
		top: var(--creator-process-sticky-offset);
		display: grid;
		min-width: 0;
	}

	.creator-process-visual-stage {
		--creator-process-progress-y: calc(50% + 180px + 32px + var(--creator-process-visual-offset-y));
		position: relative;
		width: 100%;
		height: var(--creator-process-content-height);
		min-height: 420px;
		overflow: hidden;
		border-radius: 28px;
		background: transparent;
	}

	.creator-process-visual {
		position: absolute;
		inset: 0;
		z-index: 1;
		display: grid;
		place-items: center;
		overflow: hidden;
		padding: clamp(34px, 5vw, 74px);
		opacity: 0.06;
		filter: brightness(0.64) saturate(0.86);
		transform: translateY(calc(-70px + var(--creator-process-visual-offset-y))) scale(0.84);
		transform-origin: center center;
		transition:
			filter 720ms cubic-bezier(0.22, 1, 0.36, 1),
			transform 720ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.creator-process-visual.is-active {
		z-index: 5;
		opacity: 1;
		filter: none;
		transform: translateY(var(--creator-process-visual-offset-y)) scale(1);
	}

	.creator-process-visual.is-stack-one {
		z-index: 4;
		opacity: 1;
		filter: brightness(0.94) saturate(0.98);
		transform: translateY(calc(-26px + var(--creator-process-visual-offset-y))) scale(0.92);
	}

	.creator-process-visual.is-stack-two {
		z-index: 3;
		opacity: 1;
		filter: brightness(0.9) saturate(0.96);
		transform: translateY(calc(-50px + var(--creator-process-visual-offset-y))) scale(0.84);
	}

	.creator-process-visual.is-stack-three {
		z-index: 2;
		opacity: 1;
		filter: brightness(0.86) saturate(0.94);
		transform: translateY(calc(-70px + var(--creator-process-visual-offset-y))) scale(0.77);
	}

	.creator-process-visual.is-stack-four {
		z-index: 1;
		opacity: 1;
		filter: brightness(0.82) saturate(0.92);
		transform: translateY(calc(-88px + var(--creator-process-visual-offset-y))) scale(0.71);
	}

	.creator-process-visual.is-stack-five {
		z-index: 0;
		opacity: 1;
		filter: brightness(0.78) saturate(0.9);
		transform: translateY(calc(-104px + var(--creator-process-visual-offset-y))) scale(0.66);
	}

	.creator-process-progress {
		--creator-process-step-progress: 0%;
		position: absolute;
		left: 50%;
		top: clamp(22px, var(--creator-process-progress-y), calc(100% - 10px));
		z-index: 6;
		display: flex;
		justify-content: center;
		gap: 8px;
		pointer-events: none;
		transform: translate(-50%, -50%);
	}

	.creator-process-progress span {
		width: 8px;
		height: 8px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.16);
		transition:
			width 240ms ease,
			background 180ms ease;
	}

	.creator-process-progress span.is-active {
		width: 76px;
		background:
			linear-gradient(
				90deg,
				#CBF300 0 var(--creator-process-step-progress),
				rgba(203, 243, 0, 0.18) var(--creator-process-step-progress) 100%
			);
		box-shadow: inset 0 0 0 1px rgba(203, 243, 0, 0.18);
	}

	.creator-process-copy {
		position: sticky;
		top: var(--creator-process-sticky-offset);
		min-width: 0;
		height: var(--creator-process-content-height);
		min-height: 420px;
	}

	.creator-process-step {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		padding: clamp(104px, calc((var(--creator-process-content-height) - 244px) / 2), 132px) 0 0;
		opacity: 0;
		pointer-events: none;
		transition: opacity 280ms ease;
	}

	.creator-process-step.is-active {
		opacity: 1;
		pointer-events: auto;
	}

	.creator-process-step > span,
	.creator-process-fallback-copy > span {
		display: inline-flex;
		width: fit-content;
		margin-bottom: 22px;
		border: 1px solid rgba(203, 243, 0, 0.16);
		border-radius: 999px;
		background: rgba(203, 243, 0, 0.07);
		padding: 7px 10px;
		color: #CBF300;
		font-family: "Geist Mono", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.creator-process-step h3,
	.creator-process-fallback-copy h3 {
		max-width: 560px;
		margin: 0;
		color: #fff;
		font-family: Manrope, sans-serif;
		font-size: clamp(2rem, 3.8vw, 3.8rem);
		font-weight: 400;
		line-height: 1.08;
		letter-spacing: 0;
	}

	.creator-process-step p,
	.creator-process-fallback-copy p {
		max-width: 520px;
		margin: 22px 0 0;
		color: #a1a1aa;
		font-family: Manrope, sans-serif;
		font-size: clamp(1rem, 1.4vw, 1.2rem);
		line-height: 1.55;
	}

	.creator-process-fallback {
		display: none;
	}

	.creator-process-fallback-item {
		min-width: 0;
	}

	.creator-process-fallback-visual,
	.creator-process-fallback-copy {
		min-width: 0;
	}

	.creator-mini-window,
	.creator-balance-card,
	.creator-chat-card,
	.creator-details-sheet,
	.creator-withdraw-panel,
	.creator-invoice-doc {
		display: flex;
		width: min(100%, 430px);
		height: var(--creator-process-card-height);
		max-height: calc(100% - 72px);
		box-sizing: border-box;
		flex-direction: column;
		justify-content: space-between;
		margin: auto;
		border: 1px solid var(--garna-border);
		border-radius: 24px;
		background: #0c0c0c;
		padding: 24px;
		color: #fff;
		font-family: Manrope, sans-serif;
	}

	.creator-mini-row,
	.creator-balance-top,
	.creator-chat-meta,
	.creator-details-header,
	.creator-withdraw-header,
	.creator-doc-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	.creator-mini-row span,
	.creator-balance-top span,
	.creator-chat-meta span,
	.creator-details-header span,
	.creator-withdraw-header span,
	.creator-visual-list span,
	.creator-details-grid span,
	.creator-visual-section-label,
	.creator-withdraw-select span,
	.creator-withdraw-note span {
		color: #71717a;
		font-size: 11px;
		font-weight: 600;
	}

	.creator-mini-row strong,
	.creator-chat-meta strong,
	.creator-details-header strong,
	.creator-withdraw-header strong,
	.creator-visual-list strong,
	.creator-details-grid strong,
	.creator-withdraw-select strong,
	.creator-withdraw-note strong {
		color: #fff;
		font-size: 12px;
		font-weight: 700;
	}

	.creator-mini-title {
		margin: 4px 0 0;
		color: #fff;
		font-family: Manrope, sans-serif;
		font-size: 18px;
		font-weight: 600;
		line-height: 1.18;
		text-align: center;
	}

	.creator-mini-form {
		display: flex;
		flex: 1;
		flex-direction: column;
		justify-content: space-between;
		gap: 8px;
		min-height: 0;
	}

	.creator-mini-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}

	.creator-mini-field {
		display: grid;
		gap: 5px;
		min-width: 0;
	}

	.creator-mini-field span {
		display: block;
		color: #71717a;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.01em;
		line-height: 1.1;
	}

	.creator-mini-field strong {
		display: block;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 10px;
		background: #1A1A1A;
		padding: 9px 10px;
		color: rgb(255 255 255 / 0.84);
		font-size: 11px;
		font-weight: 700;
		line-height: 1.15;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.creator-process-visual[data-process-visual='0'] .creator-mini-window,
	.creator-process-visual[data-process-visual='1'] .creator-mini-window,
	.creator-process-fallback-visual[data-process-fallback-visual='0'] .creator-mini-window,
	.creator-process-fallback-visual[data-process-fallback-visual='1'] .creator-mini-window {
		justify-content: flex-start;
		gap: 16px;
		padding: 24px;
	}

	.creator-invite-emails {
		display: flex;
		min-height: 72px;
		flex-wrap: wrap;
		align-content: flex-start;
		gap: 7px;
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 10px;
		background: #1A1A1A;
		padding: 9px 10px;
	}

	.creator-invite-emails span {
		display: inline-flex;
		align-items: center;
		max-width: 100%;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.07);
		padding: 6px 8px;
		color: rgb(255 255 255 / 0.84);
		font-size: 10px;
