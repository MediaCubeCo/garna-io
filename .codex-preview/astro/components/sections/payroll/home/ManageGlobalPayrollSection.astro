---
import Section from '../../../layout/Section.astro';
import GarnaModularPlatformVisual from '../../../visuals/GarnaModularPlatformVisual.astro';
import GlobalReachVisual from '../../../visuals/GlobalReachVisual.astro';
import PayoutMethodsPhoneVisual from '../../../visuals/PayoutMethodsPhoneVisual.astro';
import TransparentFeesVisual from '../../../visuals/TransparentFeesVisual.astro';
---

<Section
	title={{ text: 'Manage Global Payroll Effortlessly' }}
	description={{ text: 'One platform to run payroll for freelancers, remote employees, and full-time teams' }}
	spacing="none"
	class="pb-16 lg:pb-32"
	headerClass="mb-16 max-w-4xl lg:mb-20"
	titleClass="lg:text-5xl"
	contentClass="grid grid-cols-1 gap-4 md:grid-cols-2"
>
	<article class="payroll-feature-card flex h-[560px] min-w-0 flex-col overflow-hidden rounded-3xl border border-white/[0.08] bg-[#0c0c0c]/[0.72] px-8 pb-8 pt-14 text-center lg:px-12" role="link" tabindex="0" data-feature-card data-href="">
		<h3 class="mx-auto max-w-md font-manrope text-3xl font-medium leading-tight text-white">Automated Payroll Platform</h3>
		<p data-garna-subtitle class="mx-auto mt-4 max-w-md font-manrope text-base leading-relaxed">Automate global payout processes with a flexible, user-friendly platform</p>
		<div class="mt-6 flex min-h-0 flex-1 items-start justify-center overflow-hidden px-6 pt-2">
			<div class="flex h-full w-full max-w-md items-start justify-center"><GarnaModularPlatformVisual /></div>
		</div>
	</article>

	<article class="payroll-feature-card flex h-[560px] min-w-0 flex-col overflow-hidden rounded-3xl border border-white/[0.08] bg-[#0c0c0c]/[0.72] px-8 pb-8 pt-14 text-center lg:px-12" role="link" tabindex="0" data-feature-card data-href="">
		<h3 class="mx-auto max-w-md font-manrope text-3xl font-medium leading-tight text-white">Global Reach</h3>
		<p data-garna-subtitle class="mx-auto mt-4 max-w-md font-manrope text-base leading-relaxed">Pay in 150+ countries with local currencies and crypto</p>
		<div class="-mx-8 -mb-8 mt-8 flex min-h-0 flex-1 items-start justify-center overflow-hidden lg:-mx-12">
			<div class="h-full w-full"><GlobalReachVisual /></div>
		</div>
	</article>

	<article class="payroll-feature-card flex h-[560px] min-w-0 flex-col overflow-hidden rounded-3xl border border-white/[0.08] bg-[#0c0c0c]/[0.72] px-8 pb-8 pt-14 text-center lg:px-12" role="link" tabindex="0" data-feature-card data-href="">
		<h3 class="mx-auto max-w-md font-manrope text-3xl font-medium leading-tight text-white">Flexible Payout Methods</h3>
		<p data-garna-subtitle class="mx-auto mt-4 max-w-md font-manrope text-base leading-relaxed">Pay teams by bank transfer, card, electronic wallet, or crypto</p>
		<div class="mt-10 flex min-h-0 flex-1 items-end justify-center overflow-visible px-8 pt-8">
			<div class="w-full max-w-md"><PayoutMethodsPhoneVisual /></div>
		</div>
	</article>

	<article class="payroll-feature-card flex h-[560px] min-w-0 flex-col overflow-hidden rounded-3xl border border-white/[0.08] bg-[#0c0c0c]/[0.72] px-8 pb-8 pt-14 text-center lg:px-12" role="link" tabindex="0" data-feature-card data-href="">
		<h3 class="mx-auto max-w-md font-manrope text-3xl font-medium leading-tight text-white">No hidden Fees</h3>
		<p data-garna-subtitle class="mx-auto mt-4 max-w-md font-manrope text-base leading-relaxed">Transparent pricing, zero setup cost</p>
		<div class="mt-10 flex min-h-0 flex-1 items-center justify-center overflow-hidden p-8">
			<div class="w-full max-w-md"><TransparentFeesVisual /></div>
		</div>
	</article>
</Section>

<script>
	for (const card of document.querySelectorAll('[data-feature-card]')) {
		if (!(card instanceof HTMLElement) || card.dataset.clickableReady === 'true') continue;
		card.dataset.clickableReady = 'true';

		const openCard = (event) => {
			const target = event.target;
			if (target instanceof Element && target.closest('button, a') && target.closest('button, a') !== card) return;
			const href = card.dataset.href?.trim();
			if (href) window.location.assign(href);
		};

		card.addEventListener('click', openCard);
		card.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter' && event.key !== ' ') return;
			event.preventDefault();
			openCard(event);
		});
	}
</script>

<style>
	.payroll-feature-card {
		cursor: pointer;
	}

	.payroll-feature-card:focus-visible {
		outline: 2px solid rgb(203 243 0 / 0.4);
		outline-offset: 3px;
	}
</style>
