---
import Section from '../../../layout/Section.astro';
import SegmentedControl from '../../../ui/SegmentedControl.astro';
import Card from '../../../ui/Card.astro';
import CardIconVisual from '../../../visuals/CardIconVisual.astro';
---

<Section
	title={{ text: 'Why Companies Choose Garna' }}
	description={{ text: 'Why Garna? There are plenty of benefits we offer while handling every payment process on time and accurately' }}
	id="why-garna"
	headerClass="mb-10 max-w-5xl lg:mb-12"
	titleClass="text-3xl md:text-4xl lg:text-5xl"
	controlsClass="relative z-20 mb-16 flex justify-center"
	actionClass="relative z-20"
	action={{ label: { text: 'Book a demo' }, href: '#', variant: 'primary', icon: 'arrow-right' }}
>
	<Fragment slot="controls">
		<SegmentedControl group="why-garna" items={[
			{ id: 'cor', label: { text: 'Contractor of Record' }, panelId: 'grid-cor' },
			{ id: 'eor', label: { text: 'Employer of Record' }, panelId: 'grid-eor' },
		]} />
	</Fragment>

	<div id="grid-cor" class="grid w-full grid-cols-1 gap-6 transition-opacity duration-500 md:grid-cols-2 lg:grid-cols-6">
		<Card variant="tab" title="Cut Admin Work by 70%" description="Our contract and payment automation frees your HR and finance department from routine tasks" class="lg:col-span-3">
			<CardIconVisual slot="visual" icon="lucide:clock-3" />
		</Card>
		<Card variant="tab" title="Flexible Funding: From Bank transfers to Crypto" description="You can make payments via traditional banking or digital assets for maximum speed" class="lg:col-span-3">
			<CardIconVisual slot="visual" icon="lucide:wallet-cards" />
		</Card>
		<Card variant="tab" title="Flawless Reporting and Analytics" description="All invoices, transactions, and tax reports are gathered in one place" class="lg:col-span-2">
			<CardIconVisual slot="visual" icon="lucide:chart-no-axes-column-increasing" />
		</Card>
		<Card variant="tab" title="100% Intellectual Property Protection" description="We legally guarantee that all work produced by your contractors belongs exclusively to you" class="lg:col-span-2">
			<CardIconVisual slot="visual" icon="lucide:shield-check" />
		</Card>
		<Card variant="tab" title="Scale with the API" description="Integrate bulk payments directly into your internal systems and automate workflows programmatically" class="lg:col-span-2">
			<CardIconVisual slot="visual" icon="lucide:code-xml" />
		</Card>
	</div>

	<div id="grid-eor" class="hidden grid w-full grid-cols-1 gap-6 transition-opacity duration-500 md:grid-cols-2 lg:grid-cols-6">
		<Card variant="tab" title="Access to the best specialists in 150+ countries" description="Hunt the best specialists wherever they are without wasting time and money on registering legal entities" class="lg:col-span-3">
			<CardIconVisual slot="visual" icon="lucide:globe-2" />
		</Card>
		<Card variant="tab" title="24/7 support" description="We provide quick solutions to any issues both for the company and for each employee around the clock" class="lg:col-span-3">
			<CardIconVisual slot="visual" icon="lucide:headset" />
		</Card>
		<Card variant="tab" title="100% compliance with the laws" description="We assume full responsibility for compliance with the labor code of each country, from taxes to social benefits. Our team is monitoring any legal changes" class="lg:col-span-2">
			<CardIconVisual slot="visual" icon="lucide:file-check-2" />
		</Card>
		<Card variant="tab" title="Automated payments" description="Make payments in one click in any currency. The system calculates taxes and other contributions immediately" class="lg:col-span-2">
			<CardIconVisual slot="visual" icon="lucide:zap" />
		</Card>
		<Card variant="tab" title="Shared dashboard" description="Management of contracts, expenses, income, and vacations is available in one interface" class="lg:col-span-2">
			<CardIconVisual slot="visual" icon="lucide:layout-dashboard" />
		</Card>
	</div>
</Section>
