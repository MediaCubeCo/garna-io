		tags: [
			{ text: 'Global payouts', translateKey: 'deferredPayments.cards.immediate.tags.0' },
			{ text: 'Pay now', translateKey: 'deferredPayments.cards.immediate.tags.1' },
			{ text: 'Settle later', translateKey: 'deferredPayments.cards.immediate.tags.2' },
		],
	},
	{
		key: 'terms',
		title: { text: 'Flexible terms: 30, 60, or 90 days', translateKey: 'deferredPayments.cards.terms.title' },
		description: { text: 'Choose a repayment schedule that follows your incoming cash flow', translateKey: 'deferredPayments.cards.terms.description' },
		tags: [
			{ text: 'Flexible terms', translateKey: 'deferredPayments.cards.terms.tags.0' },
			{ text: 'Cash flow', translateKey: 'deferredPayments.cards.terms.tags.1' },
			{ text: 'Your schedule', translateKey: 'deferredPayments.cards.terms.tags.2' },
		],
	},
	{
		key: 'limits',
		title: { text: 'Facility limits from $50K to one million', translateKey: 'deferredPayments.cards.limits.title' },
		description: { text: 'Scale available funding as your contractor network grows', translateKey: 'deferredPayments.cards.limits.description' },
