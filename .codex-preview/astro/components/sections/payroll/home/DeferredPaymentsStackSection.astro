			{ text: 'More capacity', translateKey: 'deferredPayments.cards.limits.tags.2' },
		],
	},
	{
		key: 'processing',
		title: { text: 'Instant allocation & processing', translateKey: 'deferredPayments.cards.processing.title' },
		description: { text: 'Move from approved allocation to processed payouts in one flow', translateKey: 'deferredPayments.cards.processing.description' },
		tags: [
			{ text: 'Allocation', translateKey: 'deferredPayments.cards.processing.tags.0' },
