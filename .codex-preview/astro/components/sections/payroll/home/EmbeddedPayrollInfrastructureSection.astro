---
import Section from '../../../layout/Section.astro';
---

<Section
	title={{ text: "Embedded Payroll Infrastructure", translateKey: "sectionHeadings.embeddedPayrollInfrastructure" }}
	description={{ text: "Use Garna as your backend provider: integrate contractor management and payments into your product or launch full-fledged payroll services under your own brand", translateKey: "sectionDescriptions.embeddedPayrollInfrastructure" }}
	class="overflow-hidden border-[#020202]/0" containerClass="relative z-10" headerClass="mb-16 max-w-5xl break-words whitespace-normal lg:mb-20" titleClass="lg:text-5xl" contentClass="grid grid-cols-1 items-center gap-x-12 gap-y-12 lg:grid-cols-2 lg:gap-16"
>
<!-- Centered Text -->


    <!-- Two-column layout: Feature Cards (Left) & Product Showcase (Right) -->


        <!-- Feature Minimal List with Text Links -->
        <div class="space-y-10 lg:space-y-12 w-full order-2 lg:order-1">

  <!-- Feature Item 1 -->
  <div class="group flex gap-4 sm:gap-6 gap-x-4 gap-y-4 items-start">
    <div class="flex-shrink-0 mt-1 flex items-center justify-center text-[#CBF300] bg-[#141414] border border-white/10 rounded-2xl w-14 h-14 sm:w-16 sm:h-16 shadow-sm transition-all duration-300 group-hover:bg-[#1a1a1a] group-hover:border-white/20">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-code-xml w-6 h-6 sm:w-7 sm:h-7 transition-transform duration-300 group-hover:scale-110">
        <path d="m18 16 4-4-4-4"></path>
        <path d="m6 8-4 4 4 4"></path>
        <path d="m14.5 4-5 16"></path>
      </svg>
    </div>
    <div class="flex flex-col gap-3 gap-x-3 gap-y-3">
      <h3 class="text-xl sm:text-2xl text-white font-manrope font-thin tracking-tight">API contractor management and payments</h3>
      <p class="text-base sm:text-lg text-gray-400 font-thin font-manrope leading-relaxed">Integrate global contractor payments directly into your platform</p>
    </div>
  </div>

  <!-- Separator Line -->
  <div class="w-full h-px bg-white/10"></div>

  <!-- Feature Item 2 -->
  <div class="group flex sm:gap-6 gap-x-4 gap-y-4 items-start">
    <div class="flex-shrink-0 mt-1 flex items-center justify-center text-[#CBF300] bg-[#141414] border border-white/10 rounded-2xl w-14 h-14 sm:w-16 sm:h-16 shadow-sm transition-all duration-300 group-hover:bg-[#1a1a1a] group-hover:border-white/20">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layout-template w-6 h-6 sm:w-7 sm:h-7 transition-transform duration-300 group-hover:scale-110">
        <rect width="18" height="7" x="3" y="3" rx="1"></rect>
        <rect width="9" height="7" x="3" y="14" rx="1"></rect>
        <rect width="5" height="7" x="16" y="14" rx="1"></rect>
      </svg>
    </div>
    <div class="flex flex-col gap-3">
      <h3 class="text-xl sm:text-2xl text-white font-manrope font-thin tracking-tight">White-label contractor dashboard and payments</h3>
      <p class="text-base sm:text-lg text-gray-400 font-thin font-manrope leading-relaxed">Launch professional payment software under your own brand</p>
    </div>
  </div>

</div>

        <!-- Product Showcase (Scaled Down Proportionally) -->
        <div class="relative w-[100%] sm:w-[95%] lg:w-[90%] max-w-[500px] z-20 order-3 lg:order-2 mt-4 lg:mt-0 lg:ml-auto mx-auto lg:mr-0">


            <!-- API Code Card (Centerpiece) -->
            <div class="flex flex-col overflow-hidden z-10 bg-[#0c0c0c] w-full border-white/10 border rounded-2xl relative shadow-[0_30px_60px_-15px_rgba(0,0,0,0.7)] backdrop-blur-xl">
                <div class="flex w-full border-white/5 border-b p-3 sm:p-4 items-center gap-1.5 sm:gap-2 bg-white/[0.02]">
                    <div class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></div>
                    <div class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></div>
                    <div class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></div>
                    <div class="ml-1.5 sm:ml-2 text-[10px] text-gray-500 font-mono tracking-wider">api.garna.com/v1</div>
                </div>

                <div class="p-4 sm:p-5 md:p-6 font-mono text-[9.5px] sm:text-[11px] md:text-xs leading-relaxed text-gray-300 w-full overflow-hidden">
                    <div class="flex gap-3 sm:gap-4">
                        <span class="text-gray-600 select-none text-right w-4 sm:w-5">1</span>
                        <div class="whitespace-nowrap"><span class="text-[#c678dd]">import</span> &#123; <span class="text-[#e5c07b]">Garna</span> &#125; <span class="text-[#c678dd]">from</span> <span class="text-[#98c379]">'@garna/node'</span>;</div>
                    </div>
                    <div class="flex gap-3 sm:gap-4">
                        <span class="text-gray-600 select-none text-right w-4 sm:w-5">2</span>
                        <div class="whitespace-nowrap"></div>
                    </div>
                    <div class="flex gap-3 sm:gap-4">
                        <span class="text-gray-600 select-none text-right w-4 sm:w-5">3</span>
                        <div class="whitespace-nowrap"><span class="text-[#c678dd]">const</span> <span class="text-[#e5c07b]">garna</span> <span class="text-[#56b6c2]">=</span> <span class="text-[#56b6c2]">new</span> <span class="text-[#e5c07b]">Garna</span>(<span class="text-[#98c379]">'sk_live_...'</span>);</div>
                    </div>
                    <div class="flex gap-3 sm:gap-4">
                        <span class="text-gray-600 select-none text-right w-4 sm:w-5">4</span>
                        <div class="whitespace-nowrap"></div>
                    </div>
                    <div class="flex gap-3 sm:gap-4">
                        <span class="text-gray-600 select-none text-right w-4 sm:w-5">5</span>
                        <div class="whitespace-nowrap"><span class="text-[#5c6370] italic" data-translate="legacy.visual.verifyCompliance">// 1. Verify compliance</span></div>
                    </div>
                    <div class="flex gap-3 sm:gap-4">
                        <span class="text-gray-600 select-none text-right w-4 sm:w-5">6</span>
                        <div class="whitespace-nowrap"><span class="text-[#c678dd]">const</span> <span class="text-[#e5c07b]">status</span> <span class="text-[#56b6c2]">=</span> <span class="text-[#c678dd]">await</span> <span class="text-[#e5c07b]">garna</span>.<span class="text-[#61afef]">contractors</span>.<span class="text-[#61afef]">verify</span>(<span class="text-[#98c379]">'c_892'</span>);</div>
                    </div>
                    <div class="flex gap-3 sm:gap-4">
                        <span class="text-gray-600 select-none text-right w-4 sm:w-5">7</span>
                        <div class="whitespace-nowrap"><span class="text-[#c678dd]">if</span> (<span class="text-[#56b6c2]">!</span><span class="text-[#e5c07b]">status</span>.<span class="text-[#e06c75]">ready</span>) <span class="text-[#c678dd]">throw new</span> <span class="text-[#e5c07b]">Error</span>(<span class="text-[#98c379]" data-translate="legacy.visual.notCompliant">'Not compliant'</span>);</div>
                    </div>
                    <div class="flex gap-3 sm:gap-4">
                        <span class="text-gray-600 select-none text-right w-4 sm:w-5">8</span>
                        <div class="whitespace-nowrap"></div>
                    </div>
                    <div class="flex gap-3 sm:gap-4">
                        <span class="text-gray-600 select-none text-right w-4 sm:w-5">9</span>
                        <div class="whitespace-nowrap"><span class="text-[#5c6370] italic" data-translate="legacy.visual.processPayout">// 2. Process automated payout</span></div>
                    </div>
                    <div class="flex gap-3 sm:gap-4">
                        <span class="text-gray-600 select-none text-right w-4 sm:w-5">10</span>
                        <div class="whitespace-nowrap"><span class="text-[#c678dd]">const</span> <span class="text-[#e5c07b]">payout</span> <span class="text-[#56b6c2]">=</span> <span class="text-[#c678dd]">await</span> <span class="text-[#e5c07b]">garna</span>.<span class="text-[#61afef]">payouts</span>.<span class="text-[#61afef]">create</span>(&#123;</div>
                    </div>
                    <div class="flex gap-3 sm:gap-4">
                        <span class="text-gray-600 select-none text-right w-4 sm:w-5">11</span>
                        <div class="pl-4 sm:pl-6 whitespace-nowrap"><span class="text-[#d19a66]">contractorId</span>: <span class="text-[#98c379]">'c_892'</span>,</div>
                    </div>
                    <div class="flex gap-3 sm:gap-4">
                        <span class="text-gray-600 select-none text-right w-4 sm:w-5">12</span>
                        <div class="pl-4 sm:pl-6 whitespace-nowrap"><span class="text-[#d19a66]">amount</span>: <span class="text-[#d19a66]">4500.00</span>,</div>
                    </div>
                    <div class="flex gap-3 sm:gap-4">
                        <span class="text-gray-600 select-none text-right w-4 sm:w-5">13</span>
                        <div class="pl-4 sm:pl-6 whitespace-nowrap"><span class="text-[#d19a66]">currency</span>: <span class="text-[#98c379]">'USD'</span>,</div>
                    </div>
                    <div class="flex gap-3 sm:gap-4">
                        <span class="text-gray-600 select-none text-right w-4 sm:w-5">14</span>
                        <div class="pl-4 sm:pl-6 whitespace-nowrap"><span class="text-[#d19a66]">routing</span>: <span class="text-[#98c379]">'local_rail'</span></div>
                    </div>
                    <div class="flex gap-3 sm:gap-4">
                        <span class="text-gray-600 select-none text-right w-4 sm:w-5">15</span>
                        <div class="whitespace-nowrap">&#125;);</div>
                    </div>
                    <div class="flex gap-3 sm:gap-4">
                        <span class="text-gray-600 select-none text-right w-4 sm:w-5">16</span>
                        <div class="whitespace-nowrap"><span class="inline-block w-1.5 h-3 sm:h-3.5 bg-gray-400 ml-1 translate-y-0.5 align-middle" style="animation: blinkCenter 1s step-end infinite;"></span></div>
                    </div>
                </div>

                <div class="bg-[#CBF300]/5 border-t border-[#CBF300]/10 p-4 flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <div class="w-2 h-2 rounded-full bg-[#CBF300] animate-pulse"></div>
                        <span class="text-[11px] sm:text-xs text-[#CBF300] font-mono" data-translate="legacy.visual.payoutCreated">200 OK - Payout Created</span>
                    </div>
                    <span class="text-[10px] text-gray-500 font-mono">24ms</span>
                </div>
            </div>

            <!-- Floating White Label Card Overlap -->
            <div class="z-20 absolute -bottom-8 md:-bottom-10 -right-2 md:-right-5 lg:-right-5 w-[220px] sm:w-[250px] bg-[#141414] border border-white/10 rounded-2xl p-4 sm:p-4 shadow-[0_20px_50px_-10px_rgba(0,0,0,0.8)] backdrop-blur-md" style="animation: floatCardCenter 6s ease-in-out infinite">
    <div class="flex border-white/5 border-b mb-2 pb-3 items-center justify-between">
        <div class="flex items-center gap-2">
            <div class="w-6 h-6 rounded-lg bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center shadow-inner">
                <span class="text-[10px] text-white font-thin tracking-tighter">YB</span>
            </div>
            <span class="text-[12px] font-thin text-white tracking-tight">YourBrand</span>
        </div>
        <span class="text-[8px] sm:text-[7px] uppercase text-gray-500 tracking-wider bg-white/5 border-white/5 border rounded pt-0.5 pr-1.5 pb-0.5 pl-1.5">Powered by Garna</span>
    </div>
    <div class="space-y-3">
        <div class="">
            <div class="text-[10px] sm:text-xs text-gray-500 mb-1 font-light">Pending Payouts</div>
            <div class="sm:text-xl text-xl text-white tracking-tight font-thin">$45,000.00</div>
        </div>
        <div class="space-y-2.5">
            <div class="flex bg-[#1A1A1A] border-white/5 border rounded-lg pt-2 pr-2.5 pb-2 pl-2.5 items-center justify-between gap-2">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-5 h-5 rounded-full bg-gray-800 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400 lucide lucide-users" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4" class=""></circle>
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <span class="text-[9px] sm:text-[10px] text-gray-300 font-light truncate">Contractor Batch</span>
                </div>
                <span class="text-[8px] text-[#CBF300] font-mono bg-[#CBF300]/10 rounded pt-0.5 pr-1.5 pb-0.5 pl-1.5 shrink-0 whitespace-nowrap">18 records</span>
            </div>
            <button class="hover:bg-gray-200 transition-colors text-[10px] sm:text-xs font-light text-black tracking-wide bg-white w-full rounded-lg pt-2 pb-2 shadow-sm">
                            Approve &amp; Pay
                        </button>
        </div>
    </div>
</div>
        </div>
</Section>
<style is:global>
                @keyframes floatCardCenter {
                    0%, 100% { transform: translateY(0); }
                    50% { transform: translateY(-12px); }
                }
                @keyframes blinkCenter {
                    0%, 100% { opacity: 1; }
                    50% { opacity: 0; }
                }
            </style>
