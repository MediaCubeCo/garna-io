---
import Section from '../../layout/Section.astro';
import Card from '../../ui/Card.astro';

const cards = [
	{
		title: 'Simplify Contractor Management',
		description: 'Handle contracts, onboarding, invoices, approvals, and documentation from one platform',
		icon: 'file',
		key: 'management',
	},
	{
		title: 'Pay Globally, Your Way',
		description: 'Pay contractors in USD and 80+ local currencies through bank transfers, cards, e-wallets, or crypto',
		icon: 'globe',
		key: 'payments',
	},
	{
		title: 'Avoid misclassification',
		description:
			'With us as your Contractor and Agent of Record, legal liability and talent-related risks stay on our side, protecting your business from legal complications',
		icon: 'shield',
		key: 'risk',
	},
];
---

<Section
	spacing="default"
	title={{ text: "Build to Simplify Contractors' Operations", translateKey: 'whyGarna.title' }}
	description={{ text: 'Discover the key benefits that make payroll simple, secure, and global', translateKey: 'whyGarna.description' }}
	class="border-y border-[#020202]/0"
	headerClass="mb-8 max-w-5xl lg:mb-10"
	titleClass="mx-auto max-w-4xl lg:text-5xl"
	contentClass="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3"
>
	{cards.map((card, index) => (
		<Card
			class={index === 2 ? 'md:col-span-2 lg:col-span-1' : ''}
			title={{ text: card.title, translateKey: `whyGarna.cards.${card.key}.title` }}
			description={{ text: card.description, translateKey: `whyGarna.cards.${card.key}.description` }}
		>
			{card.icon === 'file' && (
				<svg slot="visual" class="mb-5 block h-6 w-6 text-[#CBF300]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.7.7l3.6 3.6A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path>
					<path d="M14 2v5a1 1 0 0 0 1 1h5"></path>
					<path d="M8 13h8"></path>
					<path d="M8 17h5"></path>
				</svg>
			)}
			{card.icon === 'globe' && (
				<svg slot="visual" class="mb-5 block h-6 w-6 text-[#CBF300]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="12" cy="12" r="10"></circle>
					<path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z"></path>
				</svg>
			)}
			{card.icon === 'shield' && (
				<svg slot="visual" class="mb-5 block h-6 w-6 text-[#CBF300]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M20 13c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V5l8-3 8 3v8Z"></path>
					<path d="m9 12 2 2 4-4"></path>
				</svg>
			)}
		</Card>
	))}
</Section>
