---
import Section from '../../layout/Section.astro';
---

<Section contained={false} spacing="none" class="border-y border-white/5 bg-[#080808] py-8">
            <div class="mx-auto grid max-w-7xl gap-8 px-6 sm:grid-cols-3">
                <div class="flex items-center justify-between rounded-xl border border-white/10 px-5 py-4">
                    <span class="text-3xl font-semibold text-white">400+</span>
                    <span class="max-w-[9rem] text-right text-sm text-gray-400" data-translate="stats.businesses">businesses using Garna</span>
                </div>
                <div class="flex items-center justify-between rounded-xl border border-white/10 px-5 py-4">
                    <span class="text-3xl font-semibold text-white">24/7</span>
                    <span class="max-w-[10rem] text-right text-sm text-gray-400" data-translate="stats.availability">global payroll service availability</span>
                </div>
                <div class="flex items-center justify-between rounded-xl border border-white/10 px-5 py-4">
                    <span class="text-3xl font-semibold text-white">150+</span>
                    <span class="max-w-[8rem] text-right text-sm text-gray-400" data-translate="stats.countries">countries covered</span>
                </div>
            </div>
        </Section>
