---
import Section from '../../layout/Section.astro';
---

<Section contained={false} spacing="none" class="border-y md:pt-16 md:pb-16 lg:pt-24 lg:pb-24 bg-[#020202] border-white/0 pt-16 pb-16">
        <div class="max-w-7xl mx-auto px-6">
            <div class="flex flex-col lg:flex-row gap-16 gap-x-16 gap-y-16 items-center">
                <!-- Left: Content -->
                <div class="lg:w-1/2 text-left">
                    <h2 class="lg:text-5xl text-4xl font-normal text-white tracking-tight font-manrope mb-6 text-left">
                        <span data-translate="fees.title">Zero tolerance to hidden fees.</span>
                        <span class="text-gray-500" data-translate="fees.titleAccent">Ever.</span>
                    </h2>
                    <p data-garna-subtitle class="leading-relaxed text-lg text-gray-400 font-manrope mb-8"
                        data-translate="fees.description">
                        We believe you should keep what you earn. Our fee structure is simple, transparent, and
                        displayed upfront
                        before you withdraw
                    </p>

                    <ul class="space-y-4">
                        <li class="flex items-start gap-3">
                            <iconify-icon icon="solar:check-circle-linear"
                                class="text-[#CBF300] text-xl mt-0.5"></iconify-icon>
                            <span class="text-gray-300 font-manrope" data-translate="fees.bullets.exchangeRates">
                                Real-time market exchange rates
                            </span>
                        </li>
                        <li class="flex gap-3 gap-x-3 gap-y-3 items-start">
                            <iconify-icon icon="solar:check-circle-linear"
                                class="text-[#CBF300] text-xl mt-0.5"></iconify-icon>
                            <span class="text-gray-300 font-manrope" data-translate="fees.bullets.noMarkup">
                                No hidden markups or spreads on currency conversion
                            </span>
                        </li>
                        <li class="flex items-start gap-3">
                            <iconify-icon icon="solar:check-circle-linear"
                                class="text-[#CBF300] text-xl mt-0.5"></iconify-icon>
                            <span class="text-gray-300 font-manrope" data-translate="fees.bullets.noMonthly">
                                Zero monthly maintenance fees for contractors
                            </span>
                        </li>
                    </ul>
                </div>

                <!-- Right: Visual -->
                <div class="lg:w-1/2 flex lg:justify-end w-full justify-center">
                    <div
                        class="glass transition-all duration-300 hover:scale-[1.02] hover:border-[#CBF300]/50 hover:shadow-[0_0_40px_-10px_rgba(203, 243, 0,0.3)] bg-[#0c0c0c] w-full max-w-md border-white/10 border rounded-2xl pt-6 pr-6 pb-6 pl-6 relative shadow-2xl">
                        <div class="flex justify-between items-center mb-6 pb-4 border-b border-white/5">
                            <span class="text-lg font-medium text-white font-manrope"
                                data-translate="fees.receipt.title">
                                Transaction Receipt
                            </span>
                            <span class="text-xs text-gray-500 font-manrope" data-translate="fees.receipt.id">ID:
                                #8829-XJ</span>
                        </div>

                        <div class="space-y-3 mb-6">
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-400 font-manrope"
                                    data-translate="fees.receipt.receivedAmountLabel">
                                    Received Amount
                                </span>
                                <span class="text-white font-medium font-manrope">$1,000.00</span>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-400 font-manrope"
                                    data-translate="fees.receipt.exchangeRateLabel">
                                    Exchange Rate
                                </span>
                                <span class="text-[#CBF300] font-manrope">1 USD = 0.92 EUR</span>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-400 font-manrope" data-translate="fees.receipt.platformFeeLabel">
                                    Platform Fee
                                </span>
                                <span class="text-white font-medium font-manrope">$0.00</span>
                            </div>
                        </div>

                        <div
                            class="flex bg-[#1A1A1A] border-white/5 border rounded-lg pt-3 pr-4 pb-3 pl-4 items-center justify-between">
                            <span class="text-sm font-medium text-gray-300 font-manrope"
                                data-translate="fees.receipt.youReceiveLabel">
                                You Receive
                            </span>
                            <span class="text-xl font-semibold text-white font-manrope">€920.00</span>
                        </div>

                        <!-- Floating badge -->
                        <div class="absolute -top-3 -right-3 bg-[#CBF300] text-[#101010] text-[10px] font-bold px-3 py-1 rounded-full shadow-lg font-manrope uppercase tracking-wide"
                            data-translate="fees.receipt.setupFeeBadge">
                            0% Setup Fee
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Section>
