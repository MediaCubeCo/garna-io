---
import Section from '../../layout/Section.astro';
---

<Section contained={false} spacing="none" class="border-y lg:py-32 bg-[#020202] border-white/0 pt-16 pb-16">
        <div class="max-w-7xl mr-auto ml-auto pr-6 pl-6">
            <div class="lg:mb-20 text-center mb-16">
                <h2 class="lg:text-5xl text-4xl font-normal text-white tracking-tight font-manrope mb-6"
                    data-translate="howItWorks.pocketTitle">
                    Your finances, right in your pocket
                </h2>
                <p data-garna-subtitle class="text-xl font-light text-gray-400 font-manrope max-w-2xl mr-auto ml-auto"
                    data-translate="howItWorks.pocketDescription">
                    The Garna app is your all-in-one freelance hub. Create offers, automate compliance, and withdraw
                    earnings
                    globally in a few taps
                </p>
            </div>

            <div class="grid lg:grid-cols-2 gap-x-16 gap-y-16 items-center justify-start">
                <div class="self-start z-0 mt-auto mb-auto relative space-y-10">
                    <div onclick="switchStep(0)"
                        class="step-trigger group relative pl-14 cursor-pointer transition-all duration-300 opacity-100"
                        data-index="0">
                        <div class="-bottom-11 w-px bg-white/10 -z-10 absolute top-11 left-5"></div>
                        <h3 class="group-hover:text-[#CBF300] transition-colors text-2xl font-normal text-white tracking-tight font-manrope"
                            data-translate="howItWorks.steps.sendOffer.title">
                            Send an offer
                        </h3>
                        <div
                            class="step-circle flex transition-all duration-300 z-10 w-10 h-10 border-[#CBF300] border rounded-full absolute top-1 left-0 shadow-[0_0_15px_rgba(203, 243, 0,0.3)] items-center justify-center font-sans">
                            1
                        </div>
                        <p class="leading-relaxed text-base text-gray-500 font-manrope mt-3"
                            data-translate="howItWorks.steps.sendOffer.description">
                            Create a professional service offer in seconds. Your client pays instantly via their
                            preferred corporate
                            method
                        </p>
                    </div>

                    <div onclick="switchStep(1)"
                        class="step-trigger group cursor-pointer transition-all duration-300 hover:opacity-80 opacity-50 pl-14 relative"
                        data-index="1">
                        <div class="absolute left-5 top-11 -bottom-11 w-px bg-white/10 -z-10"></div>
                        <div
                            class="step-circle flex transition-all duration-300 z-10 text-sm font-semibold text-gray-500 bg-[#050505] w-10 h-10 border-white/10 border rounded-full absolute top-1 left-0 items-center justify-center font-sans">
                            2
                        </div>
                        <h3 class="group-hover:text-[#CBF300] transition-colors text-2xl font-normal text-white tracking-tight font-manrope"
                            data-translate="howItWorks.steps.automated.title">
                            Automated processing
                        </h3>
                        <p class="leading-relaxed text-base text-gray-500 font-manrope mt-3"
                            data-translate="howItWorks.steps.automated.description">
                            We handle the compliance and currency exchange in the background while you track the status
                            in real-time
                        </p>
                    </div>

                    <div onclick="switchStep(2)"
                        class="step-trigger group cursor-pointer transition-all duration-300 hover:opacity-80 opacity-50 pr-0 pl-14 relative left-0"
                        data-index="2">
                        <div
                            class="step-circle flex transition-all duration-300 text-sm font-semibold text-gray-500 bg-[#050505] border border-white/10 w-10 h-10 z-10 rounded-full absolute top-1 left-0 items-center justify-center font-sans">
                            3
                        </div>
                        <h3 class="group-hover:text-[#CBF300] transition-colors text-white text-2xl tracking-tight font-manrope"
                            data-translate="howItWorks.steps.instantWithdraw.title">
                            Instant withdrawal
                        </h3>
                        <p class="leading-relaxed text-base text-gray-500 font-manrope mt-3 ml-0"
                            data-translate="howItWorks.steps.instantWithdraw.description">
                            Move your funds anywhere — to your bank, card, or crypto wallet with a single swipe in the
                            app
                        </p>
                    </div>
                </div>

                <div class="w-full h-[420px] relative perspective-1000">
                    <!-- Step 1 Content: Creating Offer -->
                    <div class="step-content transition-all duration-500 ease-out flex overflow-hidden z-10 md:pt-10 md:px-0 opacity-100 h-full border-[#CBF300]/50 border rounded-3xl pt-6 pr-6 pl-6 absolute top-0 right-0 left-0 translate-y-0 scale-100 items-center"
                        data-index="0">
                        <div
                            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] h-[350px] bg-[#CBF300]/15 blur-[100px] rounded-full pointer-events-none">
                        </div>
                        <div
                            class="flex flex-col overflow-hidden select-none border-x bg-[#050505] w-[330px] h-full border-white/10 rounded-t-3xl border-t mr-auto ml-auto relative">
                            <div class="flex shrink-0 z-20 pt-5 pr-6 pb-2 pl-6 items-center justify-between">
                                <span class="text-sm font-medium text-white tracking-wide font-sans">9:41</span>
                                <div class="flex gap-1.5 text-white opacity-90 items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="12" viewBox="0 0 16 12"
                                        fill="currentColor" class="">
                                        <rect x="0.5" y="9" width="3" height="3" rx="1"></rect>
                                        <rect x="4.5" y="6" width="3" height="6" rx="1"></rect>
                                        <rect x="8.5" y="3" width="3" height="9" rx="1" class="opacity-30"></rect>
                                        <rect x="12.5" y="0" width="3" height="12" rx="1" class="opacity-30"></rect>
                                    </svg>
                                    <span class="text-xs font-semibold font-sans">5G</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="12" viewBox="0 0 24 12"
                                        fill="none" class="">
                                        <rect x="1" y="1" width="19" height="10" rx="2.5" stroke="currentColor"
                                            stroke-width="1.3" class=""></rect>
                                        <rect x="3" y="3" width="15" height="6" rx="1" fill="currentColor"></rect>
                                        <path d="M23 4v4" stroke="currentColor" stroke-width="1.5"
                                            stroke-linecap="round"></path>
                                    </svg>
                                </div>
                            </div>
                            <div
                                class="flex shrink-0 sticky bg-[#050505]/90 z-10 pt-2 pr-5 pb-2 pl-5 top-0 backdrop-blur-md items-center">
                                <div class="text-[17px] font-semibold text-white tracking-tight font-sans mx-auto">
                                    Creating an offer
                                </div>
                            </div>
                            <div class="flex-1 overflow-y-auto custom-scrollbar pr-5 pl-5 space-y-4">
                                <p class="text-[11px] leading-relaxed text-gray-500 font-sans text-center">
                                    Fill in the offer details to send to the customer
                                </p>
                                <div class="space-y-1.5">
                                    <label class="text-[10px] text-gray-400 font-sans font-medium">Service name</label>
                                    <div class="relative group">
                                        <div class="relative w-full">
                                            <input type="text" value="Design Services"
                                                class="focus:outline-none focus:border-[#CBF300] placeholder:text-gray-600 text-xs text-white font-sans bg-[#121212] w-full border-white/10 border rounded-xl pt-2.5 pr-8 pb-2.5 pl-3 shadow-sm" />
                                            <button type="button"
                                                class="absolute right-3 top-2.5 text-gray-600 hover:text-gray-400 transition-colors">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                                    viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                    stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                                                    class="lucide lucide-circle-x">
                                                    <circle cx="12" cy="12" r="10"></circle>
                                                    <path d="m15 9-6 6"></path>
                                                    <path d="m9 9 6 6"></path>
                                                </svg>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div class="space-y-1.5">
                                    <label class="text-[10px] text-gray-400 font-sans font-medium">Service type</label>
                                    <div class="relative cursor-pointer group">
                                        <div
                                            class="group-hover:border-[#CBF300] group-hover:border transition-all flex text-xs text-white font-sans bg-[#121212] w-full border-white/10 border rounded-xl pt-2.5 pr-3 pb-2.5 pl-3 shadow-sm items-center justify-between">
                                            <span class="">Design Services</span>
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round"
                                                class="lucide lucide-chevron-down text-gray-500">
                                                <path d="m6 9 6 6 6-6"></path>
                                            </svg>
                                        </div>
                                    </div>
                                </div>
                                <div class="space-y-1.5">
                                    <label class="text-[10px] text-gray-400 font-sans font-medium">Customer</label>
                                    <div class="relative group">
                                        <input type="text" value="Google"
                                            class="focus:outline-none focus:border-[#CBF300] text-xs text-white font-sans bg-[#121212] w-full border-white/10 border rounded-xl pt-2.5 pr-8 pb-2.5 pl-3 shadow-sm" />
                                        <button
                                            class="absolute right-3 top-2.5 text-gray-600 hover:text-gray-400 transition-colors">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round"
                                                class="lucide lucide-circle-x">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <path d="m15 9-6 6"></path>
                                                <path d="m9 9 6 6"></path>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2 Content: Automated Processing -->
                    <div class="step-content transition-all duration-500 ease-out flex overflow-hidden opacity-0 h-full -z-10 border-[#CBF300]/50 border rounded-3xl pt-6 px-6 md:pt-10 md:px-0 absolute top-0 right-0 left-0 translate-y-8 scale-95 pointer-events-none items-center"
                        data-index="1">
                        <div
                            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] h-[350px] bg-[#CBF300]/15 blur-[100px] rounded-full pointer-events-none">
                        </div>
                        <div
                            class="flex flex-col overflow-hidden select-none border-x bg-[#050505] w-[330px] h-full border-white/10 rounded-t-3xl border-t mr-auto ml-auto relative">
                            <div class="flex shrink-0 z-20 pt-5 pr-6 pb-2 pl-6 items-center justify-between">
                                <span class="text-sm font-medium text-white tracking-wide font-sans">9:41</span>
                                <div class="flex gap-1.5 text-white opacity-90 items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="12" viewBox="0 0 16 12"
                                        fill="currentColor">
                                        <rect x="0.5" y="9" width="3" height="3" rx="1"></rect>
                                        <rect x="4.5" y="6" width="3" height="6" rx="1"></rect>
                                        <rect x="8.5" y="3" width="3" height="9" rx="1" class="opacity-30"></rect>
                                        <rect x="12.5" y="0" width="3" height="12" rx="1" class="opacity-30"></rect>
                                    </svg>
                                    <span class="text-xs font-semibold font-sans">5G</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="12" viewBox="0 0 24 12"
                                        fill="none">
                                        <rect x="1" y="1" width="19" height="10" rx="2.5" stroke="currentColor"
                                            stroke-width="1.3"></rect>
                                        <rect x="3" y="3" width="15" height="6" rx="1" fill="currentColor"></rect>
                                        <path d="M23 4v4" stroke="currentColor" stroke-width="1.5"
                                            stroke-linecap="round"></path>
                                    </svg>
                                </div>
                            </div>
                            <div class="flex flex-col h-full relative z-10">
                                <div class="flex items-center justify-between px-6 pt-2 pb-[18px]">
                                    <div class="w-16"></div>
                                    <div class="text-[17px] font-semibold text-white tracking-tight font-sans">Offers
                                    </div>
                                    <div class="flex items-center gap-1.5 md:gap-3 w-16 justify-end pr-[4px]">
                                        <button class="text-white hover:text-gray-300 transition-colors">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round"
                                                class="lucide lucide-message-circle">
                                                <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
                                            </svg>
                                        </button>
                                        <button class="text-white hover:text-gray-300 transition-colors relative">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round"
                                                class="lucide lucide-bell">
                                                <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
                                                <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
                                            </svg>
                                            <div
                                                class="absolute top-0 right-0 w-2 h-2 bg-red-500 rounded-full border-2 border-[#050505]">
                                            </div>
                                        </button>
                                    </div>
                                </div>
                                <div class="px-6 pb-[18px] select-none w-full">
                                    <div class="grid grid-cols-2 gap-3">
                                        <div
                                            class="w-full p-3 rounded-xl bg-[#141414] border border-white/10 relative overflow-hidden group hover:border-[#CBF300]/50 hover:bg-[#1A1A1A] transition-all cursor-pointer backdrop-blur-md">
                                            <div
                                                class="mb-2 w-6 h-6 rounded-full overflow-hidden border border-white/20 relative shrink-0">
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 28 20"
                                                    preserveAspectRatio="xMidYMid slice"
                                                    class="w-full h-full object-cover">
                                                    <rect width="28" height="20" fill="#fff"></rect>
                                                    <rect y="1.54" width="28" height="1.54" fill="#B22234"></rect>
                                                    <rect y="4.62" width="28" height="1.54" fill="#B22234"></rect>
                                                    <rect y="7.7" width="28" height="1.54" fill="#B22234"></rect>
                                                    <rect y="10.78" width="28" height="1.54" fill="#B22234"></rect>
                                                    <rect y="13.86" width="28" height="1.54" fill="#B22234"></rect>
                                                    <rect y="16.94" width="28" height="1.54" fill="#B22234"></rect>
                                                    <rect width="11" height="10.78" fill="#3C3B6E"></rect>
                                                    <g fill="#fff">
                                                        <circle cx="1.5" cy="1.5" r="0.5"></circle>
                                                        <circle cx="3.5" cy="1.5" r="0.5"></circle>
                                                        <circle cx="5.5" cy="1.5" r="0.5"></circle>
                                                        <circle cx="7.5" cy="1.5" r="0.5"></circle>
                                                        <circle cx="9.5" cy="1.5" r="0.5"></circle>
                                                        <circle cx="2.5" cy="3.5" r="0.5"></circle>
                                                        <circle cx="4.5" cy="3.5" r="0.5"></circle>
                                                        <circle cx="6.5" cy="3.5" r="0.5"></circle>
                                                        <circle cx="8.5" cy="3.5" r="0.5"></circle>
                                                        <circle cx="1.5" cy="5.5" r="0.5"></circle>
                                                        <circle cx="3.5" cy="5.5" r="0.5"></circle>
                                                        <circle cx="5.5" cy="5.5" r="0.5"></circle>
                                                        <circle cx="7.5" cy="5.5" r="0.5"></circle>
                                                        <circle cx="9.5" cy="5.5" r="0.5"></circle>
                                                        <circle cx="2.5" cy="7.5" r="0.5"></circle>
                                                        <circle cx="4.5" cy="7.5" r="0.5"></circle>
                                                        <circle cx="6.5" cy="7.5" r="0.5"></circle>
                                                        <circle cx="8.5" cy="7.5" r="0.5"></circle>
                                                        <circle cx="1.5" cy="9.5" r="0.5"></circle>
                                                        <circle cx="3.5" cy="9.5" r="0.5"></circle>
                                                        <circle cx="5.5" cy="9.5" r="0.5"></circle>
                                                        <circle cx="7.5" cy="9.5" r="0.5"></circle>
                                                        <circle cx="9.5" cy="9.5" r="0.5"></circle>
                                                    </g>
                                                </svg>
                                            </div>
                                            <div class="text-[9px] font-medium text-gray-400 mb-1 font-sans">Awaiting
                                                payment in USD</div>
                                            <div class="text-base font-semibold text-white font-sans tracking-tight">
                                                $950.00</div>
                                        </div>
                                        <div
                                            class="w-full p-3 rounded-xl bg-[#141414] border border-white/10 relative overflow-hidden group hover:border-[#CBF300]/50 hover:bg-[#1A1A1A] transition-all cursor-pointer backdrop-blur-md">
                                            <div
                                                class="mb-2 w-6 h-6 rounded-full overflow-hidden border border-white/20 relative shrink-0">
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 30 20"
                                                    preserveAspectRatio="xMidYMid slice"
                                                    class="w-full h-full object-cover">
                                                    <rect width="30" height="20" fill="#003399"></rect>
                                                    <g fill="#FFCC00">
                                                        <circle cx="15" cy="4" r="0.8"></circle>
                                                        <circle cx="15" cy="16" r="0.8"></circle>
                                                        <circle cx="9" cy="10" r="0.8"></circle>
                                                        <circle cx="21" cy="10" r="0.8"></circle>
                                                        <circle cx="12" cy="4.8" r="0.8"></circle>
                                                        <circle cx="18" cy="4.8" r="0.8"></circle>
                                                        <circle cx="12" cy="15.2" r="0.8"></circle>
                                                        <circle cx="18" cy="15.2" r="0.8"></circle>
                                                        <circle cx="9.8" cy="7" r="0.8"></circle>
                                                        <circle cx="20.2" cy="7" r="0.8"></circle>
                                                        <circle cx="9.8" cy="13" r="0.8"></circle>
                                                        <circle cx="20.2" cy="13" r="0.8"></circle>
                                                    </g>
                                                </svg>
                                            </div>
                                            <div class="text-[9px] font-medium text-gray-400 mb-1 font-sans">Awaiting
                                                payment in EUR</div>
                                            <div class="text-base font-semibold text-white font-sans tracking-tight">
                                                €0.00</div>
                                        </div>
                                    </div>
                                </div>
                                <div
                                    class="flex-1 bg-[#0c0c0c] rounded-t-[28px] border-t border-white/10 relative overflow-hidden flex flex-col pt-[18px] px-5 shadow-[0_-10px_40px_-15px_rgba(0,0,0,0.8)]">
                                    <div class="relative mb-[14px]">
                                        <div
                                            class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round" class="text-gray-500">
                                                <circle cx="11" cy="11" r="8"></circle>
                                                <path d="m21 21-4.3-4.3"></path>
                                            </svg>
                                        </div>
                                        <input type="text" placeholder="Service name or type" disabled
                                            class="w-full bg-[#121212] text-xs text-white placeholder-gray-500 rounded-xl py-3 pl-9 pr-4 border border-white/10 focus:outline-none focus:border-[#CBF300] transition-colors font-sans" />
                                    </div>
                                    <div class="space-y-3 overflow-y-auto custom-scrollbar pb-4">
                                        <div class="group cursor-pointer">
                                            <div
                                                class="inline-flex items-center px-2.5 py-1 rounded-md bg-blue-500/10 border border-blue-500/20 text-[9px] font-semibold text-blue-400 mb-2">
                                                Under review
                                            </div>
                                            <div class="flex justify-between items-start">
                                                <div>
                                                    <div
                                                        class="text-[13px] font-semibold text-white font-sans mb-1 group-hover:text-[#CBF300] transition-colors">
                                                        Business Development Services
                                                    </div>
                                                    <p class="text-[10px] text-gray-500 font-sans">ABC LLC •
                                                        contact@abcllc.com</p>
                                                </div>
                                                <div class="text-right">
                                                    <div class="text-[13px] font-bold text-white font-sans mb-1">$950.00
                                                    </div>
                                                    <p class="text-[9px] text-gray-500 font-sans">Feb 04, 2026</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3 Content: Instant Withdrawal -->
                    <div class="step-content transition-all duration-500 ease-out flex overflow-hidden opacity-0 h-full -z-10 border-[#CBF300]/50 border rounded-3xl pt-6 px-6 md:pt-10 md:px-0 absolute top-0 right-0 left-0 translate-y-8 scale-95 pointer-events-none items-center"
                        data-index="2">
                        <div
                            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] h-[350px] bg-[#CBF300]/15 blur-[100px] rounded-full pointer-events-none">
                        </div>
                        <div
                            class="flex flex-col overflow-hidden select-none border-x bg-[#050505] w-[330px] h-full border-white/10 rounded-t-3xl border-t mr-auto ml-auto relative">
                            <div class="flex shrink-0 z-20 pt-4 pr-6 pb-2 pl-6 items-center justify-between">
                                <span class="text-sm font-medium text-white tracking-wide font-sans">9:41</span>
                                <div class="flex gap-1.5 text-white opacity-90 items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="12" viewBox="0 0 16 12"
                                        fill="currentColor">
                                        <rect x="0.5" y="9" width="3" height="3" rx="1"></rect>
                                        <rect x="4.5" y="6" width="3" height="6" rx="1"></rect>
                                        <rect x="8.5" y="3" width="3" height="9" rx="1" class="opacity-30"></rect>
                                        <rect x="12.5" y="0" width="3" height="12" rx="1" class="opacity-30"></rect>
                                    </svg>
                                    <span class="text-xs font-semibold font-sans">5G</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="12" viewBox="0 0 24 12"
                                        fill="none">
                                        <rect x="1" y="1" width="19" height="10" rx="2.5" stroke="currentColor"
                                            stroke-width="1.3"></rect>
                                        <rect x="3" y="3" width="15" height="6" rx="1" fill="currentColor"></rect>
                                        <path d="M23 4v4" stroke="currentColor" stroke-width="1.5"
                                            stroke-linecap="round"></path>
                                    </svg>
                                </div>
                            </div>
                            <div class="flex-1 flex flex-col relative z-10 font-sans">
                                <div class="flex items-center justify-between px-5 pt-1 pb-1">
                                    <div class="w-16"></div>
                                    <div
                                        class="flex items-center justify-center gap-[5px] md:gap-2 bg-[#1A1A1A] border border-white/10 rounded-full px-2 md:px-3 py-1.5 cursor-pointer hover:border-[#CBF300]/50 transition-colors mt-px">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
