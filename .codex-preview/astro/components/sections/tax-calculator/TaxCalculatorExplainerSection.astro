---
import Section from '../../layout/Section.astro';
---

<Section contained={false} spacing="none" class="tax-explainer"><div class="garna-container"><span data-translate="info.kicker">Compare before you hire</span><h2 data-translate="info.title">Turn one salary budget into a global hiring decision</h2><div class="tax-steps"><article><b>01</b><h3 data-translate="info.grossTitle">Set one annual salary</h3><p data-translate="info.grossText">Use the same salary and currency for a fair comparison.</p></article><article><b>02</b><h3 data-translate="info.taxTitle">Add a second market</h3><p data-translate="info.taxText">Compare two countries and their employer obligations.</p></article><article><b>03</b><h3 data-translate="info.netTitle">Choose with full context</h3><p data-translate="info.netText">Review total annual cost and every employer contribution.</p></article></div></div></Section>
