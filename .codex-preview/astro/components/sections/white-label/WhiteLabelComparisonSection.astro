---
import Section from '../../layout/Section.astro';
---

<Section contained={false} spacing="none" class="lg:pt-32 lg:pb-32 border-white/0 border-t pt-16 pb-16">
    <div class="max-w-7xl mr-auto ml-auto pr-6 pl-6">
        <!-- Section Header -->
        <div class="lg:mb-16 text-center mb-16">
    <h2 class="md:text-4xl lg:text-5xl text-4xl font-normal text-white tracking-tight font-manrope max-w-4xl mr-auto mb-6 ml-auto"><span data-translate="comparison.title">Independent build contractor management platform vs use Garna</span></h2>

</div>

        <!-- Part 1: Benefits Grid -->


        <!-- Part 2: Comparison Widget -->
        <div class="max-w-5xl mx-auto">


            <!-- Desktop View -->
            <div class="hidden md:grid grid-cols-3 font-manrope bg-black/40 border-white/5 border rounded-3xl relative backdrop-blur-sm">
    <!-- Highlight Background -->
    <div class="absolute -right-px -top-px -bottom-px w-[33.333%] bg-[#050505] border border-[#CBF300] rounded-r-3xl rounded-l-2xl shadow-[0_0_30px_rgba(203, 243, 0,0.15)] pointer-events-none z-0">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#CBF300] to-transparent opacity-50"></div>
    </div>

    <!-- Headers -->
    <div class="px-8 py-6 text-gray-400 font-medium border-b border-white/10 uppercase tracking-wider text-xs"><span data-translate="comparison.features">Features</span></div>
    <div class="px-8 py-6 text-gray-400 font-medium border-b border-white/10 uppercase tracking-wider text-xs"><span data-translate="comparison.buildIndependently">Build Independently</span></div>
    <div class="z-10 flex gap-2 uppercase text-xs font-medium text-[#CBF300] tracking-wider bg-[#CBF300]/5 border-white/5 rounded-tr-3xl border-b pt-6 pr-8 pb-6 pl-8 relative gap-x-2 gap-y-2 items-center">
        <span data-translate="comparison.useGarna">Use Garna</span>
    </div>

    <!-- Row 1 -->
    <div class="px-8 py-6 text-gray-300 border-b border-white/10 text-sm flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-white shrink-0"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        <span data-translate="comparison.launchTime">Launch Time</span>
    </div>
    <div class="flex gap-3 text-sm text-gray-400 border-white/10 border-b pt-6 pr-8 pb-6 pl-8 gap-x-3 gap-y-3 items-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-red-500 shrink-0"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        <span data-translate="comparison.sixToTwelveMonths">6 to 12 months</span>
    </div>
    <div class="z-10 flex gap-3 text-sm font-medium text-white border-white/5 border-b pt-6 pr-8 pb-6 pl-8 relative gap-x-3 gap-y-3 items-center">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-[#CBF300] shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg>
    <span data-translate="comparison.twoDays">2 days</span>
</div>

    <!-- Row 2 -->
    <div class="px-8 py-6 text-gray-300 border-b border-white/10 text-sm flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-white shrink-0"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
        <span data-translate="comparison.maintenance">Maintenance</span>
    </div>
    <div class="px-8 py-6 text-gray-400 border-b border-white/10 text-sm flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-red-500 shrink-0"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        <span data-translate="comparison.high">High</span>
    </div>
    <div class="z-10 flex gap-3 text-sm font-medium text-white border-white/5 border-b px-8 py-6 relative gap-x-3 gap-y-3 items-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-[#CBF300] shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span data-translate="comparison.handledByGarna">Handled by Garna</span>
    </div>

    <!-- Row 3 -->
    <div class="flex gap-3 text-sm text-gray-300 border-white/10 border-b pt-6 pr-8 pb-6 pl-8 gap-x-3 gap-y-3 items-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-white shrink-0"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
        <span data-translate="comparison.infrastructure">Infrastructure</span>
    </div>
    <div class="flex gap-3 text-sm text-gray-400 border-white/10 border-b pt-6 pr-8 pb-6 pl-8 gap-x-3 gap-y-3 items-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-red-500 shrink-0"><line x1="18" y1="6" x2="6" y2="18" class=""></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        <span data-translate="comparison.highIntegrationCosts">High integration costs, long in time</span>
    </div>
    <div class="z-10 flex gap-3 text-sm font-medium text-white border-white/5 border-b px-8 py-6 relative gap-x-3 gap-y-3 items-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-[#CBF300] shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span data-translate="comparison.establishedNetwork">Established Global Network</span>
    </div>

    <!-- Row 4 -->
    <div class="px-8 py-6 text-gray-300 text-sm flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-white shrink-0"><path d="M3 11h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5Zm0 0a9 9 0 1 1 18 0m0 0v5a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3Z"></path><path d="M21 16v2a4 4 0 0 1-4 4h-5"></path></svg>
        <span data-translate="comparison.support">Support</span>
    </div>
    <div class="px-8 py-6 text-gray-400 text-sm flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-red-500 shrink-0"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        <span data-translate="comparison.none">None</span>
    </div>
    <div class="flex text-sm font-medium text-white z-10 rounded-br-3xl pt-6 pr-8 pb-6 pl-8 relative gap-x-3 gap-y-3 items-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-[#CBF300] shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span data-translate="comparison.teamSupport">24/7 Team Support</span>
    </div>
</div>

            <!-- Mobile View -->
            <div class="md:hidden flex flex-col gap-6 font-manrope">
                <!-- Independent Build Card -->
                <div class="border border-[#333] rounded-3xl p-6 bg-black">
                    <h4 class="text-xl font-medium text-gray-400 mb-6 tracking-tight"><span data-translate="comparison.buildIndependently">Build Independently</span></h4>
                    <div class="text-sm space-y-4">
                        <div class="flex justify-between border-b border-[#333] pb-4 gap-4 items-center">
                            <span class="text-gray-500 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-white shrink-0"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                <span data-translate="comparison.launchTime">Launch Time</span>
                            </span>
                            <span class="text-gray-300 flex items-center gap-2 text-right justify-end">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-red-500 shrink-0 hidden md:block"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                <span data-translate="comparison.twelveToTwentyFourMonths">12–24 months</span>
                            </span>
                        </div>
                        <div class="flex justify-between border-b border-[#333] pb-4 gap-4 items-center">
                            <span class="text-gray-500 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-white shrink-0"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
                                <span data-translate="comparison.maintenance">Maintenance</span>
                            </span>
                            <span class="text-gray-300 flex items-center gap-2 text-right justify-end">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-red-500 shrink-0 hidden md:block"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                <span data-translate="comparison.high">High</span>
                            </span>
                        </div>
                        <div class="flex border-[#333] border-b pb-4 gap-x-4 gap-y-4 items-center justify-between">
                            <span class="flex items-center gap-2 text-gray-500 mt-0.5">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-white shrink-0"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
                                <span data-translate="comparison.infrastructure">Infrastructure</span>
                            </span>
                            <span class="text-gray-300 flex items-start gap-2 justify-end text-right max-w-[150px]">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-red-500 shrink-0 mt-1 hidden md:block"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                <span class="text-right"><span data-translate="comparison.highIntegrationCosts">High integration costs, long in time</span></span>
                            </span>
                        </div>
                        <div class="flex justify-between gap-4 items-center">
                            <span class="text-gray-500 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-white shrink-0"><path d="M3 11h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5Zm0 0a9 9 0 1 1 18 0m0 0v5a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3Z"></path><path d="M21 16v2a4 4 0 0 1-4 4h-5"></path></svg>
                                <span data-translate="comparison.support">Support</span>
                            </span>
                            <span class="text-gray-300 flex items-center gap-2 text-right justify-end">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-red-500 shrink-0 hidden md:block"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                <span data-translate="comparison.none">None</span>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Garna Card -->
                <div class="border border-[#CBF300] rounded-3xl p-6 bg-[#050505] shadow-[0_0_30px_rgba(203, 243, 0,0.15)] relative overflow-hidden">
                    <div class="absolute inset-x0] to-transparent opacity-50"></div>
                    <h4 class="text-xl font-medium text-[#CBF300] mb-6 tracking-tight flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check-circle-2"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>
                        <span data-translate="comparison.useGarna">Use Garna</span>
                    </h4>
                    <div class="space-y-4 text-sm">
                        <div class="flex justify-between border-b border-white/5 pb-4 gap-4 items-center">
                            <span class="text-gray-400 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-white shrink-0"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                <span data-translate="comparison.launchTime">Launch Time</span>
                            </span>
                            <span class="text-white font-medium flex items-center gap-2 text-right justify-end">
                                <span data-translate="comparison.oneWeek">1 Week</span>
                            </span>
                        </div>
                        <div class="flex justify-between border-b border-white/5 pb-4 gap-4 items-center">
                            <span class="text-gray-400 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-white shrink-0"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
                                <span data-translate="comparison.maintenance">Maintenance</span>
                            </span>
                            <span class="text-white font-medium flex items-center gap-2 text-right justify-end">
                                <span data-translate="comparison.handledByGarna">Handled by Garna</span>
                            </span>
                        </div>
                        <div class="flex border-white/5 border-b pb-4 gap-x-4 gap-y-4 items-center justify-between">
                            <span class="text-gray-400 flex items-center gap-2 mt-0.5">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-white shrink-0"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
                                <span data-translate="comparison.infrastructure">Infrastructure</span>
                            </span>
                            <span class="text-white font-medium max-w-[150px] flex items-start gap-2 justify-end text-right">
                                <span class="text-right"><span data-translate="comparison.establishedNetwork">Established Global Network</span></span>
                            </span>
                        </div>
                        <div class="flex justify-between gap-4 items-center">
                            <span class="text-gray-400 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-white shrink-0"><path d="M3 11h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5Zm0 0a9 9 0 1 1 18 0m0 0v5a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3Z"></path><path d="M21 16v2a4 4 0 0 1-4 4h-5"></path></svg>
                                <span data-translate="comparison.support">Support</span>
                            </span>
                            <span class="text-white font-medium flex items-center gap-2 text-right justify-end">
                                <span data-translate="comparison.teamSupport">24/7 Team Support</span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Section>
