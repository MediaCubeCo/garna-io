---
import BaseLayout from '../layouts/BaseLayout.astro';
import FinalCTASection from '../components/sections/FinalCTASection.astro';
import GarnaBookingWidget from '../components/ui/GarnaBookingWidget.astro';
import ContractorOfRecordHeroSection from '../components/sections/payroll/ContractorOfRecordHeroSection.astro';
import GarnaDifferentiatorsSection from '../components/sections/payroll/GarnaDifferentiatorsSection.astro';
import ContractorWorldwideFeatureSection from '../components/sections/payroll/ContractorWorldwideFeatureSection.astro';
import ContractorOnboardingStepsSection from '../components/sections/payroll/ContractorOnboardingStepsSection.astro';
import CreatorPayoutProcessSection from '../components/sections/payroll/CreatorPayoutProcessSection.astro';
import DeferredContractorPaymentsSection from '../components/sections/payroll/home/DeferredPaymentsStackSection.astro';
import TrustedByBuildersSection from '../components/sections/payroll/home/TrustedByBuildersSection.astro';
import ContractorBenefitsSection from '../components/sections/payroll/ContractorBenefitsSection.astro';
import ContractorOfRecordSectionStyles from '../components/sections/payroll/ContractorOfRecordSectionStyles.astro';
import ContractorOfRecordInteractions from '../components/sections/payroll/ContractorOfRecordInteractions.astro';
import PayrollLandingEnhancements from '../components/sections/payroll/PayrollLandingEnhancements.astro';
import { pageFinalCtas } from '../content/page-final-ctas';
import { pageShells } from '../content/page-shells';
---

<BaseLayout shell={pageShells.contractorOfRecord} showRainbow={false}>
	<ContractorOfRecordHeroSection />
	<GarnaDifferentiatorsSection />
	<ContractorWorldwideFeatureSection />
	<DeferredContractorPaymentsSection />
	<ContractorBenefitsSection />
	<ContractorOnboardingStepsSection />
	<CreatorPayoutProcessSection />
	<TrustedByBuildersSection />
	<ContractorOfRecordSectionStyles />
	<FinalCTASection {...pageFinalCtas.contractorOfRecord} />
	<PayrollLandingEnhancements />
	<Fragment slot="widgets">
		<ContractorOfRecordInteractions />
		<GarnaBookingWidget
			trackingSource="contractor-of-record"
			trackingPage="contractor-of-record"
			titleFallback="Start your journey with Garna"
			subtitleFallback="Fill in your details to book a demo"
		/>
	</Fragment>
</BaseLayout>
